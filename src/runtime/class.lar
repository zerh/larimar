// runtime.class: classes: virtual tables, clone, casts.
// Part of the runtime: the compiler takes from here what a program uses (it is not imported).
ccode {
/* ---- runtime: classes ------------------------------------------------- */

typedef struct LarClass { const char* name; const struct LarClass* parent; } LarClass;

static inline bool lar_is_a(const LarClass* c, const LarClass* target) {
    for (; c; c = c->parent) if (c == target) return true;
    return false;
}

/* Remembers already cloned objects so that cyclic graphs clone correctly (a hash table of addresses).
   only != NULL: Memory.compact, which copies only what lives in those blocks and keeps the rest. */
typedef struct LarCloneMap { void** keys; void** vals; int32_t len; int32_t cap; const struct LarMemoryBlock* only; } LarCloneMap;

static inline LarCloneMap lar_clone_map(void) {
    LarCloneMap m;
    m.keys = NULL;
    m.vals = NULL;
    m.len = 0;
    m.cap = 0;
    m.only = NULL;
    return m;
}

static inline size_t lar_clone_slot(const LarCloneMap* m, const void* key) {
    uint64_t h = (uint64_t)(uintptr_t)key;
    h ^= h >> 33;
    h *= 0xff51afd7ed558ccdULL;
    h ^= h >> 33;
    return (size_t)h & (size_t)(m->cap - 1);
}

static inline void* lar_clone_get(LarCloneMap* m, void* key) {
    if (m->cap == 0) return NULL;
    for (size_t i = lar_clone_slot(m, key);; i = (i + 1) & (size_t)(m->cap - 1)) {
        if (m->keys[i] == key) return m->vals[i];
        if (m->keys[i] == NULL) return NULL;
    }
}

static inline void lar_clone_put(LarCloneMap* m, void* key, void* val) {
    if ((m->len + 1) * 2 > m->cap) {
        LarCloneMap g = *m;
        g.cap = m->cap ? m->cap * 2 : 64;
        g.len = 0;
        g.keys = (void**)calloc((size_t)g.cap, sizeof(void*));
        g.vals = (void**)calloc((size_t)g.cap, sizeof(void*));
        if (!g.keys || !g.vals) lar_panic("out of memory while cloning", 0);
        for (int32_t i = 0; i < m->cap; i++) if (m->keys[i]) lar_clone_put(&g, m->keys[i], m->vals[i]);
        free(m->keys);
        free(m->vals);
        *m = g;
    }
    size_t i = lar_clone_slot(m, key);
    while (m->keys[i] != NULL && m->keys[i] != key) i = (i + 1) & (size_t)(m->cap - 1);
    if (m->keys[i] == NULL) m->len++;
    m->keys[i] = key;
    m->vals[i] = val;
}

/* Memory.compact: whether a value is left where it is (it does not live in the memory being compacted). */
static inline bool lar_clone_keeps(const LarCloneMap* m, const void* p) {
    return m->only != NULL && (p == NULL || !lar_owned(m->only, p));
}

static inline void lar_clone_done(LarCloneMap* m) {
    free(m->keys);
    free(m->vals);
}

/* Every class object starts with this header, and every vtable with LarMethodTable. */
typedef struct LarMethodTable {
    const LarClass* cls;
    void* (*clone)(void* self, LarMemory* mem, LarCloneMap* cm);
} LarMethodTable;

typedef struct LarObjectHeader { const void* vt; LarMemory* mem; } LarObjectHeader;

static inline const LarMethodTable* lar_object_vt(const void* obj) {
    return (const LarMethodTable*)((const LarObjectHeader*)obj)->vt;
}

static inline const LarClass* lar_object_class(const void* obj) { return lar_object_vt(obj)->cls; }

static inline LarMemory* lar_object_mem(const void* obj) { return ((const LarObjectHeader*)obj)->mem; }

/* The object if it is of class c (or a subclass), NULL otherwise. */
static inline void* lar_as_class(void* obj, const LarClass* c) {
    return obj && lar_is_a(lar_object_class(obj), c) ? obj : NULL;
}

static inline void* lar_unwrap(void* p, int line) {
    if (!p) lar_panic("'!' used on a null value", line);
    return p;
}
}
