// runtime.base: the C headers every program includes.
// Part of the runtime: the compiler takes from here what a program uses (it is not imported).
ccode {
#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* The line of the .lar a check of the runtime reports when it fails (a panic says it). */
#define LINE(n) (n)

}
