// runtime.thread: Thread and synchronized objects.
// Part of the runtime: the compiler takes from here what a program uses (it is not imported).
ccode {
/* ---- runtime: Thread and synchronized objects ------------------------- */

typedef struct LarThread {
    LarThreadHandle handle;
    void (*fn)(void*);
    void* arg;
    int32_t state;      /* 0 created, 1 running, 2 joined */
} LarThread;

#ifdef _WIN32
static inline DWORD WINAPI lar_thread_main(LPVOID p) { LarThread* t = (LarThread*)p; t->fn(t->arg); return 0; }
#else
static inline void* lar_thread_main(void* p) { LarThread* t = (LarThread*)p; t->fn(t->arg); return NULL; }
#endif

static inline void lar_thread_join(LarThread* t) {
    if (t->state != 1) return;
#ifdef _WIN32
    WaitForSingleObject(t->handle, INFINITE);
    CloseHandle(t->handle);
#else
    pthread_join(t->handle, NULL);
#endif
    t->state = 2;
}

static inline void lar_thread_final(void* p) { lar_thread_join((LarThread*)p); }

/* The thread is waited for before the memory of its Thread object is freed. */
static inline void lar_thread_start(LarThread* t, LarMemory* mem, void (*fn)(void*), void* arg, int line) {
    if (t->state != 0) lar_panic("this thread was already started", line);
    t->fn = fn;
    t->arg = arg;
#ifdef _WIN32
    t->handle = CreateThread(NULL, 0, lar_thread_main, t, 0, NULL);
    if (t->handle == NULL) lar_panic("the system could not create a thread", line);
#else
    if (pthread_create(&t->handle, NULL, lar_thread_main, t) != 0) lar_panic("the system could not create a thread", line);
#endif
    t->state = 1;
    lar_memory_on_free(mem, lar_thread_final, t, line);
}

/* A synchronized object: a recursive lock, a condition, and its own memory for its fields. */
typedef struct LarSync {
    LarMutex m;
    LarCondition c;
    int32_t depth;
    int32_t waiting;            /* threads in lar_sync_wait (wait until) */
    LarMemory own;
} LarSync;

static inline void lar_sync_final(void* p) {
    LarSync* s = (LarSync*)p;
    lar_memory_free(&s->own);
    lar_condition_destroy(&s->c);
    lar_mutex_destroy(&s->m);
}

static inline LarSync* lar_sync_new(LarMemory* mem, int line) {
    LarSync* s = (LarSync*)lar_memory_alloc(mem, sizeof(LarSync), line);
    lar_mutex_init(&s->m);
    lar_condition_init(&s->c);
    s->depth = 0;
    s->waiting = 0;
    s->own = lar_memory_growable();
    lar_memory_on_free(mem, lar_sync_final, s, line);
    return s;
}

static inline void lar_sync_lock(LarSync* s) { lar_mutex_lock(&s->m); s->depth++; }
/* Leaving the last method of the object: whoever waits (wait until) looks at its condition again. */
static inline void lar_sync_unlock(LarSync* s) {
    s->depth--;
    if (s->depth == 0 && s->waiting > 0) lar_condition_broadcast(&s->c);
    lar_mutex_unlock(&s->m);
}

/* wait until: releases the lock completely while waiting (the others it held may have changed the
 * object: they look again too), and takes it back as it was. */
static inline void lar_sync_wait(LarSync* s) {
    int32_t d = s->depth;
    if (s->waiting > 0) lar_condition_broadcast(&s->c);
    for (int32_t i = 1; i < d; i++) lar_mutex_unlock(&s->m);
    s->depth = 0;
    s->waiting++;
    lar_condition_wait(&s->c, &s->m);
    s->waiting--;
    for (int32_t i = 1; i < d; i++) lar_mutex_lock(&s->m);
    s->depth = d;
}
#endif

}
