// syntax.lexer: source text -> tokens (Lexer.java).
//
// String literals keep their raw text (escapes and ${...} included); the parser splits
// them and lexes each ${...} again with a Lexer of its own.

import std.text { isDigit, isIdentifierPart, isUpper, isLower };

public enum TT {
    Let, Const, Function, Return, If, Else, While, For, In, Is, Break, Continue,
    Struct, Class, Interface, Enum, Extends, Implements, Override, Super, Self, New, Native,
    True, False, Null, CInclude, CCode, CText, Switch, Case, Default, Yield, When,
    Try, Catch, Throw, Throws, Heap, Operator, As, Import, Public, Private, Synchronized, Static,
    Ident, Int, Float, Str,
    Assign, Eq, Ne, Lt, Le, Gt, Ge, Plus, Minus, Star, Slash, Percent,
    Amp, Pipe, Caret, Tilde, Shl, Shr, And, Or, Not, Question, QQ,
    Arrow, Dot, DotDot, Ellipsis, Comma, Colon, ColonColon, Semi, OpAssign,
    LParen, RParen, LBrace, RBrace, LBracket, RBracket, Eof
}

public class Token {
    let kind: TT;
    let text: String;
    let line: int32;
    let num: int64 = 0;      // Int: the value (as uint64 when big)
    let big: bool = false;   // Int: above the int64 range, inside uint64
    let huge: bool = false;  // Int: does not fit in 64 bits
}

/**
 * Reads a source text into tokens: Lexer { src, line }, run(), then its toks. `line` is the encoded line of its first
 * byte (file * 1000000 + line). An error stops it: `error` says why ("" when there is none).
 */
public class Lexer {
    let src: String;
    let line: int32 = 0;
    let pos: int32 = 0;
    let toks: Token[*] = [];
    let error: String = "";

    /** Reads src into toks, ending in Eof (or stops at the first error). */
    function run(): void {
        while (self.pos < self.src.length && self.error == "") {
            let c: byte = self.src[self.pos];
            switch (c) {
                case '\n' -> {
                    self.line += 1;
                    self.pos += 1;
                }
                case ' ', '\t', '\r', 12, 11 -> { self.pos += 1; }
                case '/' when self.peek(1) == '/' -> {
                    while (self.pos < self.src.length && self.src[self.pos] != '\n') { self.pos += 1; }
                }
                case '/' when self.peek(1) == '*' -> self.blockComment();
                case 'r' when self.peek(1) == 'a' && self.peek(2) == 'w' && self.peek(3) == '"' && self.peek(4) == '"' && self.peek(5) == '"' -> self.rawTextBlock();
                case 'c' when self.peek(1) == '"' -> self.cText();
                case '"' when self.peek(1) == '"' && self.peek(2) == '"' -> self.textBlock();
                case '"' -> self.stringLiteral();
                case '\'' -> self.charLiteral();
                case '{' when self.inNativeHeader() -> self.cCode();       // native function f(...): T { C }
                default -> {
                    if (isLetter(c) || c == '_') {
                        self.identifier();
                    } else if (isDigit(c)) {
                        self.number();
                    } else {
                        self.punctuation(c);
                    }
                }
            }
        }
        self.toks.push(Token { kind: TT.Eof, text: "", line: self.line });
    }

    /** After the header of a native function (native function f(...): T): its body is C, not Larimar. */
    function inNativeHeader(): bool {
        let depth: int32 = 0;
        let i: int32 = self.toks.length - 1;
        while (i >= 0) {
            switch (self.toks[i].kind) {
                case RParen, RBracket -> { depth += 1; }
                case LParen, LBracket -> { depth -= 1; }
                case Semi, LBrace, RBrace, Assign -> { if (depth == 0) { return false; } }
                case CCode, Class, Interface, Struct, Enum, Let, Const, Import -> { return false; }
                case Function -> { return i > 0 && self.toks[i - 1].kind == TT.Native; }
                default -> {}
            }
            i -= 1;
        }
        return false;
    }

    /** Records the first error and stops. */
    function fail(at: int32, msg: String): void {
        if (self.error == "") { self.error = "Lexical Error [Line ${at}]: ${msg}" in default; }
        self.pos = self.src.length;
    }

    function peek(k: int32): byte {
        return self.pos + k < self.src.length ? self.src[self.pos + k] : 0;
    }

    function add(kind: TT, text: String in self, length: int32): void {
        self.toks.push(Token { kind, text, line: self.line });
        self.pos += length;
    }

    function blockComment(): void {
        let start: int32 = self.line;
        self.pos += 2;
        while (self.pos < self.src.length && !(self.src[self.pos] == '*' && self.peek(1) == '/')) {
            if (self.src[self.pos] == '\n') { self.line += 1; }
            self.pos += 1;
        }
        if (self.pos >= self.src.length) {
            self.fail(start, "Unterminated block comment");
            return;
        }
        self.pos += 2;
    }

    function identifier(): void {
        let start: int32 = self.pos;
        while (self.pos < self.src.length && isNameByte(self.src[self.pos])) { self.pos += 1; }
        let word: String = self.src.substring(start, self.pos);
        if (word.contains("__")) {
            self.fail(self.line, "'${word}': names cannot contain '__' (it is reserved for module names in the generated C).");
            return;
        }
        if (word == "ccode") {
            self.cCode();
            return;
        }
        self.toks.push(Token { kind: keyword(word), text: word, line: self.line });
    }

    /**
     * c"...": C text in a native declaration (= c"(http_listen)", = c"struct sqlite3*"). It is taken as it is
     * written up to the closing quote: no escapes of Larimar and no ${...}; a \" is a quote of C.
     */
    function cText(): void {
        let start: int32 = self.line;
        self.pos += 2;
        let begin: int32 = self.pos;
        while (self.pos < self.src.length && self.src[self.pos] != '"' && self.src[self.pos] != '\n') {
            if (self.src[self.pos] == '\\' && self.pos + 1 < self.src.length) { self.pos += 1; }
            self.pos += 1;
        }
        if (self.pos >= self.src.length || self.src[self.pos] != '"') {
            self.fail(start, "c\" without its closing quote: c\"C text\"");
            return;
        }
        self.toks.push(Token { kind: TT.CText, text: self.src.substring(begin, self.pos), line: start });
        self.pos += 1;
    }

    /**
     * ccode { ... }: the C text up to the matching brace (braces in C strings and comments do not count).
     */
    function cCode(): void {
        let startLine: int32 = self.line;
        while (self.pos < self.src.length && (self.src[self.pos] == ' ' || self.src[self.pos] == '\t' || self.src[self.pos] == '\r' || self.src[self.pos] == '\n' || self.src[self.pos] == 12 || self.src[self.pos] == 11)) {
            if (self.src[self.pos] == '\n') { self.line += 1; }
            self.pos += 1;
        }
        if (self.pos >= self.src.length || self.src[self.pos] != '{') {
            self.fail(self.line, "Expected '{' after ccode: ccode { C }");
            return;
        }
        self.pos += 1;
        let begin: int32 = self.pos;
        let depth: int32 = 1;
        while (self.pos < self.src.length) {
            let c: byte = self.src[self.pos];
            if (c == '\n') {
                self.line += 1;
                self.pos += 1;
            } else if (c == '/' && self.peek(1) == '/') {
                while (self.pos < self.src.length && self.src[self.pos] != '\n') { self.pos += 1; }
            } else if (c == '/' && self.peek(1) == '*') {
                self.pos += 2;
                while (self.pos < self.src.length && !(self.src[self.pos] == '*' && self.peek(1) == '/')) {
                    if (self.src[self.pos] == '\n') { self.line += 1; }
                    self.pos += 1;
                }
                self.pos += 2;
            } else if (c == '"' || c == '\'') {
                self.pos += 1;
                while (self.pos < self.src.length && self.src[self.pos] != c && self.src[self.pos] != '\n') {
                    if (self.src[self.pos] == '\\') { self.pos += 1; }
                    self.pos += 1;
                }
                self.pos += 1;
            } else {
                if (c == '{') { depth += 1; }
                if (c == '}') {
                    depth -= 1;
                    if (depth == 0) {
                        self.toks.push(Token { kind: TT.CCode, text: self.src.substring(begin, self.pos), line: startLine });
                        self.pos += 1;
                        return;
                    }
                }
                self.pos += 1;
            }
        }
        self.fail(startLine, "ccode { is never closed");
    }

    /** A literal whose digits are `digits` (without '_') in base `radix`. */
    function intToken(digits: String, radix: int32, whole: String): void {
        let v: uint64 = 0;
        let huge: bool = false;
        let r: uint64 = radix as uint64;
        for (b in digits) {
            let d: int32 = digitValue(b);
            if (d >= radix) {
                let what: String = radix == 16 ? "hexadecimal" : "binary";
                self.fail(self.line, "Invalid ${what} literal '${whole}'");
                return;
            }
            let du: uint64 = d as uint64;
            if (v > (18446744073709551615 - du) / r) { huge = true; }
            v = v * r + du;
        }
        let text: String = "${v}";
        if (huge) {
            let t: String = digits;
            while (t.length > 1 && t.startsWith("0")) { t = t.substring(1); }
            text = t;
        }
        self.toks.push(Token { kind: TT.Int, text: text.clone(), line: self.line, num: v as int64, big: v > 9223372036854775807, huge });
    }

    /** Digits without '_', or "" after reporting an error. */
    function cleanDigits(digits: String, whole: String): String {
        if (digits.isEmpty() || digits.startsWith("_") || digits.endsWith("_") || digits.contains("__")) {
            self.fail(self.line, "Invalid number literal '${whole}'");
            return "";
        }
        return digits.replace("_", "");
    }

    function number(): void {
        let start: int32 = self.pos;
        if (self.src[self.pos] == '0' && (self.peek(1) == 'x' || self.peek(1) == 'X' || self.peek(1) == 'b' || self.peek(1) == 'B')) {   // 0x 0b
            let radix: int32 = self.peek(1) == 'x' || self.peek(1) == 'X' ? 16 : 2;
            self.pos += 2;
            let digitsStart: int32 = self.pos;
            while (self.pos < self.src.length && isNameByte(self.src[self.pos])) { self.pos += 1; }
            let whole: String = self.src.substring(start, self.pos);
            let clean: String = self.cleanDigits(self.src.substring(digitsStart, self.pos), whole);
            if (self.error != "") { return; }
            self.intToken(clean, radix, whole);
            return;
        }
        while (self.pos < self.src.length && (isDigit(self.src[self.pos]) || self.src[self.pos] == '_')) { self.pos += 1; }
        let isFloat: bool = false;
        if (self.pos < self.src.length && self.src[self.pos] == '.' && isDigit(self.peek(1))) {
            isFloat = true;
            self.pos += 1;
            while (self.pos < self.src.length && (isDigit(self.src[self.pos]) || self.src[self.pos] == '_')) { self.pos += 1; }
        }
        if (self.pos < self.src.length && (self.src[self.pos] == 'e' || self.src[self.pos] == 'E')
            && (isDigit(self.peek(1)) || ((self.peek(1) == '+' || self.peek(1) == '-') && isDigit(self.peek(2))))) {
            isFloat = true;
            self.pos += 2;
            while (self.pos < self.src.length && isDigit(self.src[self.pos])) { self.pos += 1; }
        }
        if (self.pos < self.src.length && (isLetter(self.src[self.pos]) || self.src[self.pos] == '_')) {
            self.fail(self.line, "Invalid number literal '${self.src.substring(start, self.pos + 1)}'");
            return;
        }
        let text: String = self.src.substring(start, self.pos);
        let clean: String = self.cleanDigits(text, text);
        if (self.error != "") { return; }
        if (isFloat) {
            self.toks.push(Token { kind: TT.Float, text: clean.clone(), line: self.line });
        } else {
            self.intToken(clean, 10, text);
        }
    }

    /** Keeps the raw text; ${...} pieces are lexed again by the parser. */
    function stringLiteral(): void {
        let start: int32 = self.line;
        self.pos += 1;
        let begin: int32 = self.pos;
        while (self.pos < self.src.length && self.src[self.pos] != '"') {
            let c: byte = self.src[self.pos];
            if (c == '\\' && self.pos + 1 < self.src.length) {
                self.pos += 2;
            } else if (c == '$' && self.peek(1) == '{') {
                if (!self.interpolation(start)) { return; }
            } else {
                if (c == '\n') { self.line += 1; }
                self.pos += 1;
            }
        }
        if (self.pos >= self.src.length) {
            self.fail(start, "Unterminated string literal");
            return;
        }
        self.toks.push(Token { kind: TT.Str, text: self.src.substring(begin, self.pos), line: start });
        self.pos += 1;
    }

    /** Skips ${...} (with the strings nested in it); false after reporting an error. */
    function interpolation(start: int32): bool {
        let depth: int32 = 0;
        while (self.pos < self.src.length) {
            let d: byte = self.src[self.pos];
            self.pos += 1;
            if (d == '\n') { self.line += 1; }
            if (d == '{') {
                depth += 1;
            } else if (d == '}') {
                depth -= 1;
                if (depth == 0) { return true; }
            } else if (d == '"') {
                while (self.pos < self.src.length && self.src[self.pos] != '"') {
                    if (self.src[self.pos] == '\\' && self.pos + 1 < self.src.length) { self.pos += 1; }
                    self.pos += 1;
                }
                if (self.pos < self.src.length) { self.pos += 1; }
            }
        }
        self.fail(start, "Unterminated '\${' in string literal");
        return false;
    }

    /** A text block (\"\"\" then a new line ... \"\"\"): the common indentation and the spaces at line ends go. */
    function textBlock(): void {
        let start: int32 = self.line;
        self.pos += 3;
        while (self.pos < self.src.length && (self.src[self.pos] == ' ' || self.src[self.pos] == '\t' || self.src[self.pos] == '\r')) { self.pos += 1; }
        if (self.pos >= self.src.length || self.src[self.pos] != '\n') {
            self.fail(start, "A text block starts with \"\"\" and a new line; write the text on the next line");
            return;
        }
        self.pos += 1;
        self.line += 1;
        let begin: int32 = self.pos;
        while (true) {
            if (self.pos >= self.src.length) {
                self.fail(start, "Unterminated text block (\"\"\")");
                return;
            }
            let c: byte = self.src[self.pos];
            if (c == '\\' && self.pos + 1 < self.src.length) {
                if (self.src[self.pos + 1] == '\n') { self.line += 1; }
                self.pos += 2;
            } else if (c == '"' && self.peek(1) == '"' && self.peek(2) == '"') {
                break;
            } else if (c == '$' && self.peek(1) == '{') {
                if (!self.interpolation(start)) { return; }
            } else {
                if (c == '\n') { self.line += 1; }
                self.pos += 1;
            }
        }
        let text: String = self.src.substring(begin, self.pos).replace("\r", "");
        self.pos += 3;
        self.toks.push(Token { kind: TT.Str, text: stripIndent(text).clone(), line: start });
    }

    /**
     * raw\"\"\" then a new line ... \"\"\": a text block taken as it is written. No escapes (a backslash is a
     * backslash) and no ${...}. The common indentation goes, as in a text block. If the text has three quotes in
     * a row, open with more (raw\"\"\"\") and close with as many.
     */
    function rawTextBlock(): void {
        let start: int32 = self.line;
        self.pos += 3;
        let quotes: int32 = 0;
        while (self.pos < self.src.length && self.src[self.pos] == '"') {
            quotes += 1;
            self.pos += 1;
        }
        while (self.pos < self.src.length && (self.src[self.pos] == ' ' || self.src[self.pos] == '\t' || self.src[self.pos] == '\r')) { self.pos += 1; }
        if (self.pos >= self.src.length || self.src[self.pos] != '\n') {
            self.fail(start, "A raw text block starts with raw\"\"\" and a new line; write the text on the next line");
            return;
        }
        self.pos += 1;
        self.line += 1;
        let begin: int32 = self.pos;
        while (true) {
            if (self.pos >= self.src.length) {
                self.fail(start, "Unterminated raw text block (raw\"\"\")");
                return;
            }
            if (self.src[self.pos] == '"' && self.closes(quotes)) { break; }
            if (self.src[self.pos] == '\n') { self.line += 1; }
            self.pos += 1;
        }
        let text: String = stripIndent(self.src.substring(begin, self.pos).replace("\r", ""));
        self.pos += quotes;
        // the rest of the compiler reads escapes in texts: write the same text with them
        let escaped: String = text.replace("\\", "\\\\").replace("$", "\\$");
        self.toks.push(Token { kind: TT.Str, text: escaped.clone(), line: start });
    }

    /** `quotes` quotes in a row at pos. */
    function closes(quotes: int32): bool {
        for (k in 0..quotes) {
            if (self.pos + k >= self.src.length || self.src[self.pos + k] != '"') { return false; }
        }
        return true;
    }

    /** 'a', '\n': the character's code (Unicode), as an integer literal. */
    function charLiteral(): void {
        let start: int32 = self.line;
        self.pos += 1;
        if (self.pos >= self.src.length || self.src[self.pos] == '\n') {
            self.fail(start, "Unterminated character literal");
            return;
        }
        let cp: int32 = 0;
        if (self.src[self.pos] == '\\') {
            let e: byte = self.peek(1);
            if (e == 'n') {
                cp = 10;
            } else if (e == 't') {
                cp = 9;
            } else if (e == 'r') {
                cp = 13;
            } else if (e == '0') {
                cp = 0;
            } else if (e == '\\' || e == '\'' || e == '"') {
                cp = e as int32;
            } else {
                self.fail(start, "Unknown escape '\\${self.src.substring(self.pos + 1, self.pos + 2)}' in a character literal");
                return;
            }
            self.pos += 2;
        } else if (self.src[self.pos] == '\'') {
            self.fail(start, "Empty character literal ''");
            return;
        } else {
            let b: int32 = self.src[self.pos] as int32;
            let need: int32 = 0;
            if (b >= 240) {
                cp = b & 7;
                need = 3;
            } else if (b >= 224) {
                cp = b & 15;
                need = 2;
            } else if (b >= 192) {
                cp = b & 31;
                need = 1;
            } else {
                cp = b;
            }
            self.pos += 1;
            let k: int32 = 0;
            while (k < need && self.pos < self.src.length) {
                cp = (cp << 6) | (self.src[self.pos] as int32 & 63);
                self.pos += 1;
                k += 1;
            }
        }
        if (self.pos >= self.src.length || self.src[self.pos] != '\'') {
            self.fail(start, "A character literal holds one character; use \"...\" for text");
            return;
        }
        self.pos += 1;
        self.toks.push(Token { kind: TT.Int, text: "${cp}", line: start, num: cp as int64 });
    }

    function punctuation(c: byte): void {
        let one: String = self.src.substring(self.pos, self.pos + 1);
        let two: String = self.src.substring(self.pos, self.pos + 2 <= self.src.length ? self.pos + 2 : self.pos + 1);
        if ("+-*/%&|^".contains(one) && self.peek(1) == '=') {
            self.add(TT.OpAssign, one, 2);        // compound assignment: the value is the operator
            return;
        }
        if (two == "=>") {
            self.fail(self.line, "'=>' is not valid, lambdas and switch cases use '->'");
            return;
        }
        if (two == ".." && self.peek(2) == '.') {
            self.add(TT.Ellipsis, "...", 3);
            return;
        }
        let pair: TT? = switch (two) {
            case "->" -> TT.Arrow;
            case "==" -> TT.Eq;
            case "!=" -> TT.Ne;
            case "<=" -> TT.Le;
            case "<<" -> TT.Shl;
            case ">=" -> TT.Ge;
            case ">>" -> TT.Shr;
            case "&&" -> TT.And;
            case "||" -> TT.Or;
            case "??" -> TT.QQ;
            case ".." -> TT.DotDot;
            case "::" -> TT.ColonColon;
            default -> null;
        };
        if (pair != null) {
            self.add(pair, two, 2);
            return;
        }
        let single: TT? = switch (c) {
            case '-' -> TT.Minus;
            case '=' -> TT.Assign;
            case '!' -> TT.Not;
            case '<' -> TT.Lt;
            case '>' -> TT.Gt;
            case '&' -> TT.Amp;
            case '|' -> TT.Pipe;
            case '?' -> TT.Question;
            case '.' -> TT.Dot;
            case '^' -> TT.Caret;
            case '~' -> TT.Tilde;
            case '+' -> TT.Plus;
            case '*' -> TT.Star;
            case '/' -> TT.Slash;
            case '%' -> TT.Percent;
            case ':' -> TT.Colon;
            case ';' -> TT.Semi;
            case ',' -> TT.Comma;
            case '(' -> TT.LParen;
            case ')' -> TT.RParen;
            case '{' -> TT.LBrace;
            case '}' -> TT.RBrace;
            case '[' -> TT.LBracket;
            case ']' -> TT.RBracket;
            default -> null;
        };
        if (single == null) {
            self.fail(self.line, "Unexpected character '${one}'");
            return;
        }
        self.add(single, one, 1);
    }
}

/** ASCII letters, and the bytes of any non-ASCII character (names can use any letter). */
function isLetter(b: byte): bool { return isUpper(b) || isLower(b) || b >= 128; }
/** A byte of a name: letters (any), digits and _. */
function isNameByte(b: byte): bool { return isIdentifierPart(b) || b >= 128; }

function keyword(w: String): TT {
    return switch (w) {
        case "let" -> TT.Let;
        case "const" -> TT.Const;
        case "function" -> TT.Function;
        case "return" -> TT.Return;
        case "if" -> TT.If;
        case "else" -> TT.Else;
        case "while" -> TT.While;
        case "for" -> TT.For;
        case "in" -> TT.In;
        case "is" -> TT.Is;
        case "break" -> TT.Break;
        case "continue" -> TT.Continue;
        case "struct" -> TT.Struct;
        case "class" -> TT.Class;
        case "interface" -> TT.Interface;
        case "enum" -> TT.Enum;
        case "extends" -> TT.Extends;
        case "implements" -> TT.Implements;
        case "override" -> TT.Override;
        case "super" -> TT.Super;
        case "self" -> TT.Self;
        case "new" -> TT.New;
        case "native" -> TT.Native;
        case "true" -> TT.True;
        case "false" -> TT.False;
        case "null" -> TT.Null;
        case "cinclude" -> TT.CInclude;
        case "switch" -> TT.Switch;
        case "case" -> TT.Case;
        case "default" -> TT.Default;
        case "yield" -> TT.Yield;
        case "when" -> TT.When;
        case "try" -> TT.Try;
        case "catch" -> TT.Catch;
        case "throw" -> TT.Throw;
        case "throws" -> TT.Throws;
        case "heap" -> TT.Heap;
        case "operator" -> TT.Operator;
        case "as" -> TT.As;
        case "import" -> TT.Import;
        case "public" -> TT.Public;
        case "private" -> TT.Private;
        case "synchronized" -> TT.Synchronized;
        case "static" -> TT.Static;
        default -> TT.Ident;
    };
}

function digitValue(b: byte): int32 {
    if (isDigit(b)) { return (b - '0') as int32; }
    if (b >= 'a' && b <= 'z') { return (b - 'a') as int32 + 10; }
    return b >= 'A' && b <= 'Z' ? (b - 'A') as int32 + 10 : 99;
}

public function stripIndent(raw: String): String {
    let lines: String[*] = raw.split("\n");
    let last: int32 = lines.length - 1;
    let min: int32 = 2147483647;
    for (i, l in lines) {
        if (!blank(l) || i == last) {
            let n: int32 = indent(l);
            if (n < min) { min = n; }
        }
    }
    let out: StringBuilder = {};
    for (i, l in lines) {
        if (i > 0) { out.add("\n"); }
        if (blank(l)) { continue; }
        let t: String = l.substring(min);
        let end: int32 = t.length;
        while (end > 0 && (t[end - 1] == ' ' || t[end - 1] == '\t')) { end -= 1; }
        out.add(t.substring(0, end));
    }
    return out.toString();
}

function blank(l: String): bool { return indent(l) == l.length; }

function indent(l: String): int32 {
    let n: int32 = 0;
    while (n < l.length && (l[n] == ' ' || l[n] == '\t')) { n += 1; }
    return n;
}
