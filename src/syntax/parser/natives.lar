// syntax.parser.natives: what comes from C (native functions, types, structs and values; cinclude and ccode).
// Each function reads one construction; the comment above it shows its form (the notation is in syntax.parser).

import syntax.ast {
    BlockStmt, Call, Expr, ExprStmt, ExternFunctionDecl, ExternTypeDecl, ExternValueDecl, FieldDecl, FunctionDecl,
    Ident, NativeTypeDecl, Node, Param, ReturnStmt, SelfExpr, StructDecl, TK, typeNamed
};
import syntax.lexer { Token, TT };
import syntax.parser { endedBySemicolon, lives, Parser };
import syntax.parser.declarations { cBodied, functionDeclaration, parameter, parameters, staticFunction };
import syntax.parser.expressions { expression };
import syntax.parser.types { type };

/**
 * (after `native`)
 *   function NAME ( [ parameter ( , parameter )* [ , ... ] ] ) [ : Type ] [ = C ] [ released by NAME ] ;  a C function
 *   const NAME : Type [ = C ] ;      let NAME : Type [ = NAME ] ;                        a C constant, macro or global
 *   struct NAME [ = C ] { ( let NAME : Type [ = NAME ] ; | function ... | static ... )* }  a C struct, by value
 *   type NAME [ = CTYPE | = ( Type, ... ) -> Type ] [ released by NAME ] ( ; | { member* } )   a C type
 *   type NAME { ... }                                                                   (std) a type the compiler knows
 */
public function nativeDeclaration(p: Parser in default, line: int32): Node {
    if (p.optional(TT.Function)) { return nativeFunctionOfC(p); }
    if (p.at(TT.Const) || p.at(TT.Let)) { return nativeValue(p); }
    if (p.optional(TT.Struct)) { return nativeStruct(p); }
    if (!p.atWord("type")) {
        p.error(p.current().line, "Expected 'function', 'type', 'struct', 'const' or 'let' after 'native' (got '${p.current().text}')");
        return BlockStmt { line } in default;
    }
    p.advance();
    let name: Token = p.expect(TT.Ident, "Expected the type's name after 'native type'");
    if (p.at(TT.LBrace)) { return nativeType(p, line, name); }
    return nativeCType(p, name);
}

/** At C text: c"...". */
function atCText(p: Parser in default): bool { return p.at(TT.CText); }

/** [ = NAME | = struct NAME | = c"C" ]: what a native declaration is in C; "" without '='. */
function cTarget(p: Parser in default, what: String): String {
    if (!p.optional(TT.Assign)) { return ""; }
    if (atCText(p)) {
        let text: Token = p.advance();
        if (text.text.trim() == "") { p.error(text.line, "The C of ${what} is empty"); }
        return text.text;
    }
    if (p.optional(TT.Struct)) {                  // = struct addrinfo: a C struct known by its tag
        return "struct ${p.expect(TT.Ident, "Expected the name of the C struct after 'struct' in ${what}").text}" in default;
    }
    return p.expect(TT.Ident, "Expected the C name, 'struct' and its name, or c\"C text\", after '=' in ${what}").text;
}

/** (after `native function`) NAME ( [ parameter ( , parameter )* [ , ... ] ] ) [ : Type ] [ = C ] [ released by NAME ] ; */
function nativeFunctionOfC(p: Parser in default): ExternFunctionDecl {
    let name: Token = p.expect(TT.Ident, "Expected function name");
    let declaration: ExternFunctionDecl = ExternFunctionDecl { line: name.line, name: name.text, cName: name.text, ret: typeNamed("void", name.line) } in default;
    p.expect(TT.LParen, "Expected '(' after function name");
    if (!p.at(TT.RParen)) {
        while (true) {
            if (p.optional(TT.Ellipsis)) {
                declaration.varargs = true;
                break;
            }
            declaration.params.push(parameter(p, true));
            if (!p.optional(TT.Comma)) { break; }
        }
    }
    p.expect(TT.RParen, declaration.varargs ? "'...' must be the last parameter" : "Expected ')' after parameters");
    if (p.optional(TT.Colon)) { declaration.ret = type(p); }
    if (p.at(TT.Assign) && !(p.next().kind == TT.Ident || p.next().kind == TT.Str || p.next().kind == TT.CText)) {
        p.error(p.current().line, "A native function of a module names its C function (= c_name;); to write it in Larimar, write a plain function");
    }
    let target: String = cTarget(p, "native function '${name.text}'");
    if (target != "") { declaration.cName = target; }
    if (p.atWord("released")) {                // a text C makes: copied into the memory of the call, then released
        p.advance();
        let by: Token = p.expect(TT.Ident, "Expected 'by' and the function that releases the text: released by free");
        if (by.text != "by") { p.error(by.line, "Expected 'by' after 'released': released by free"); }
        declaration.releasedBy = p.expect(TT.Ident, "Expected the function that releases the result of '${name.text}' after 'released by'").text;
    }
    if (p.at(TT.CCode)) {                         // native function f(...): T { C }: the compiler writes it
        if (target != "") { p.error(name.line, "A native function names its C function (= c_name;) or has a body of C, not both"); }
        declaration.cBody = p.advance().text;
        declaration.cName = "lm_${name.text}_${name.line}";
        return declaration;
    }
    p.expect(TT.Semi, "Expected ';' after native function (or its body of C: native function f(): T { ... })");
    return declaration;
}

/** (after `native`) ( const NAME : Type [ = C ] | let NAME : Type [ = NAME ] ) ; */
function nativeValue(p: Parser in default): Node {
    let isConst: bool = p.advance().kind == TT.Const;
    let what: String = isConst ? "native const" : "native let";
    let name: Token = p.expect(TT.Ident, "Expected a name after '${what}'");
    p.expect(TT.Colon, "Expected ':' and a type after '${name.text}'");
    let declaration: ExternValueDecl = ExternValueDecl { line: name.line, name: name.text, type: type(p), isConst, cName: name.text } in default;
    if (p.optional(TT.Assign)) {
        if (atCText(p)) {                   // what C writes for it: sizeof, a cast, a macro with arguments
            if (!isConst) { p.error(p.current().line, "A native let is a C variable: give its C name (= c_name), not C text"); }
            declaration.cExpr = p.advance().text;
            if (declaration.cExpr.trim() == "") { p.error(name.line, "The C of '${name.text}' is empty"); }
        } else {
            declaration.cName = p.expect(TT.Ident, "Expected the C name, or c\"C text\", after '='").text;
        }
    }
    return endedBySemicolon(p, declaration, what);
}

/** (after `native struct`) NAME [ = C ] { ( let NAME : Type [ = NAME ] ; | function ... | static ... )* } */
function nativeStruct(p: Parser in default): StructDecl {
    let name: Token = p.expect(TT.Ident, "Expected the struct's name after 'native struct'");
    let declaration: StructDecl = StructDecl { line: name.line, name: name.text, cName: name.text } in default;
    let target: String = cTarget(p, "native struct '${name.text}'");
    if (target != "") { declaration.cName = target; }
    p.expect(TT.LBrace, "Expected '{' with the fields of the C struct");
    while (!p.at(TT.RBrace) && !p.atEnd() && !p.hasFailed()) {
        if (p.at(TT.Let)) {
            declaration.fields.push(cField(p));
        } else if (p.at(TT.Function)) {
            declaration.methods.push(functionDeclaration(p, false, true));
        } else if (p.optional(TT.Static)) {
            staticFunction(p, declaration.name);
        } else {
            p.error(p.current().line, "A native struct has its C fields (let name: Type;) and Larimar functions (got '${p.current().text}')");
        }
    }
    p.expect(TT.RBrace, "Expected '}' to close the native struct");
    p.optional(TT.Semi);
    return declaration;
}

/** let NAME : Type [ = NAME ] ;      a field of a C struct (after '=': its name in C) */
function cField(p: Parser in default): FieldDecl {
    p.expect(TT.Let, "Expected 'let'");
    let name: Token = p.expect(TT.Ident, "Expected field name");
    p.expect(TT.Colon, "Expected ':' and a type after field '${name.text}'");
    let declaration: FieldDecl = FieldDecl { line: name.line, name: name.text, type: type(p) } in default;
    if (p.optional(TT.Assign)) {
        declaration.cName = p.expect(TT.Ident, "A field of C has no default value: after '=' goes its name in C (let size: int64 = st_size;)").text;
    }
    p.expect(TT.Semi, "Expected ';' after field declaration");
    return declaration;
}

/**
 * (after `native type NAME`) [ = CTYPE | = ( Type, ... ) -> Type ] [ released by NAME ] ( ; | { member* } )
 *     CTYPE: [ struct ] NAME *...  or c"C TYPE";  without '=' it is opaque (void*)
 */
function nativeCType(p: Parser in default, name: Token in default): Node {
    let declaration: ExternTypeDecl = ExternTypeDecl { line: name.line, name: name.text } in default;
    if (p.optional(TT.Assign)) {
        if (p.at(TT.LParen)) {
            declaration.func = type(p);
            if (declaration.func!.kind != TK.Func) { p.error(name.line, "Expected a function type after '=': (int32, int32) -> int32"); }
        } else if (atCText(p)) {
            declaration.cType = p.advance().text;
            if (declaration.cType.trim() == "") { p.error(name.line, "The C type of '${name.text}' is empty"); }
        } else {
            let tagged: String = p.optional(TT.Struct) ? "struct " : "";             // = struct tm*
            let cType: String = "${tagged}${p.expect(TT.Ident, "Expected the C type after 'native type ${name.text} =': a name (FILE*, struct tm*), c\"C text\" or a function type").text}";
            while (p.optional(TT.Star)) { cType = "${cType}*"; }
            declaration.cType = cType.clone() in default;
        }
    }
    if (p.atWord("released")) {
        p.advance();
        let by: Token = p.expect(TT.Ident, "Expected 'by' and the function that releases it: released by close");
        if (by.text != "by") { p.error(by.line, "Expected 'by' after 'released': released by close"); }
        declaration.releasedBy = p.expect(TT.Ident, "Expected the function that releases '${declaration.name}' after 'released by'").text;
    } else if (p.atWord("released_by")) {
        p.error(p.current().line, "Write 'released by' (two words): released by close");
    }
    if (p.at(TT.LBrace)) {
        nativeMembers(p, declaration);
        p.optional(TT.Semi);
        return declaration;
    }
    return endedBySemicolon(p, declaration, "native type");
}

/**
 * { ( let NAME : Type [ = NAME ] ; | native function ... | native let ... | function ... | static ... )* }
 * The members of a C type: its fields (when it is a pointer to a C struct), functions of C that take it
 * first (self), and functions written in Larimar.
 */
function nativeMembers(p: Parser in default, declaration: ExternTypeDecl in default): void {
    let line: int32 = p.expect(TT.LBrace, "Expected '{'").line;
    if (declaration.func != null) { p.error(line, "A pointer to a C function has no members"); }
    let methods: NativeTypeDecl = NativeTypeDecl { line: declaration.line, name: declaration.name } in default;
    let fields: StructDecl = StructDecl { line: declaration.line, name: "${declaration.name}__fields" in default } in default;
    while (!p.at(TT.RBrace) && !p.atEnd() && !p.hasFailed()) {
        if (p.at(TT.Let)) {
            fields.fields.push(cField(p));
        } else if (p.optional(TT.Native)) {
            let start: int32 = p.previous().line;
            if (p.optional(TT.Function)) {
                methods.methods.push(nativeMember(p, declaration.name, start, false, false));
            } else if (p.optional(TT.Let)) {
                methods.methods.push(nativeMember(p, declaration.name, start, true, false));
            } else {
                p.error(p.current().line, "Expected 'function' or 'let' after 'native'");
            }
        } else if (p.optional(TT.Static)) {
            if (p.optional(TT.Native)) {
                let start: int32 = p.previous().line;
                p.expect(TT.Function, "Expected 'function' after 'static native'");
                p.staticFunctions.push(nativeMember(p, declaration.name, start, false, true));
            } else {
                let f: FunctionDecl = functionDeclaration(p, false, true);
                f.typeName = declaration.name;
                f.isStatic = true;
                p.staticFunctions.push(f);
            }
        } else if (p.at(TT.Function)) {
            methods.methods.push(functionDeclaration(p, false, true));
        } else {
            p.error(p.current().line, "Inside a native type go its C fields (let), native functions and functions (got '${p.current().text}')");
        }
    }
    p.expect(TT.RBrace, "Expected '}' to close the native type");
    if (fields.fields.length > 0) {
        let c: String = declaration.cType.trim();
        if (!c.endsWith("*")) {
            p.error(fields.fields[0].line, "The fields of '${declaration.name}' are reached through its pointer: its C type must be a pointer to the struct (native type ${declaration.name} = c_struct*)");
        }
        fields.cName = c.substring(0, c.length - 1).trim().clone() in default;
        declaration.fieldsStruct = fields.name;
        p.nativeParts.push(fields);
    }
    if (methods.methods.length > 0) { p.nativeParts.push(methods); }
}

/**
 * (after `native function` or `native let`, in a native type)
 *   NAME parameters [ : Type ] [ in lives ] [ throws Type ] = ( C | expression ) ;      (let: NAME : Type = ...)
 * With `= C` (a name, or "C text"), the method calls that C function with self first: before it only the
 * memory of the call, when the first parameter is one (m: byte[*]). Any other expression is Larimar.
 */
function nativeMember(p: Parser in default, owner: String in default, line: int32, property: bool, isStatic: bool): FunctionDecl {
    let name: Token = p.expect(TT.Ident, "Expected a name");
    let declaration: FunctionDecl = FunctionDecl { line, name: name.text, ret: typeNamed("void", name.line), isProperty: property } in default;
    if (property) {
        p.expect(TT.Colon, "Expected ':' and the type after 'native let ${name.text}'");
        declaration.ret = type(p);
    } else {
        declaration.params = parameters(p);
        if (p.optional(TT.Colon)) { declaration.ret = type(p); }
        if (p.optional(TT.In)) { declaration.returnLives = lives(p); }
        if (p.optional(TT.Throws)) { declaration.throwsType = type(p); }
    }
    p.expect(TT.Assign, "Expected '=' and its C function (= c_name;) or a Larimar expression");
    let value: Expr? = null;
    if ((p.at(TT.Ident) || p.at(TT.CText)) && (p.next().kind == TT.Semi || p.next().kind == TT.Ident && p.next().text == "released")) {
        let c: Token = p.advance();
        let cFunction: ExternFunctionDecl = ExternFunctionDecl {
            line: c.line, name: "${owner}__${name.text}" in default, cName: c.text, ret: declaration.ret.clone() in default
        } in default;
        if (p.atWord("released")) {            // = c_f released by r: the text C makes is copied, then released
            p.advance();
            let by: Token = p.expect(TT.Ident, "Expected 'by' and the function that releases the text: released by free");
            if (by.text != "by") { p.error(by.line, "Expected 'by' after 'released': released by free"); }
            cFunction.releasedBy = p.expect(TT.Ident, "Expected the function that releases the result of '${name.text}' after 'released by'").text;
        }
        let args: Expr[*] = [] in default;
        let kept: Param[*] = [] in default;
        let late: Param[*] = [] in default;
        for (i, p in declaration.params) {
            let memory: bool = i == 0 && p.type != null && p.type!.kind == TK.Growable && p.type!.inner!.kind == TK.Named && p.type!.inner!.name == "byte";
            let context: bool = p.type != null && p.type!.kind == TK.Named && p.type!.name == "Context";
            if (memory) {
                cFunction.params.push(p.clone() in default);     // the memory of the call: before self, and not written in calls
            } else if (context) {
                late.push(p);                                    // C's Context: the compiler gives it, so the method has none
            } else {
                kept.push(p);
            }
        }
        if (!isStatic) {
            cFunction.params.push(Param { line: c.line, name: "receiver", type: typeNamed(owner, c.line) } in default);
            args.push(SelfExpr { line: c.line } in default);
        }
        for (p in declaration.params) {
            if (late.contains(p)) {
                cFunction.params.push(p.clone() in default);
            } else if (kept.contains(p)) {
                cFunction.params.push(p.clone() in default);
                args.push(Ident { line: c.line, name: p.name } in default);
            }
        }
        declaration.params = kept;
        declaration.forwardsToC = true;
        p.nativeParts.push(cFunction);
        value = Call { line: c.line, callee: Ident { line: c.line, name: cFunction.name } in default, args } in default;
    } else {
        value = expression(p);
    }
    if (declaration.ret.kind == TK.Named && declaration.ret.name == "void") {
        declaration.body.push(ExprStmt { line, expr: value! } in default);
    } else {
        declaration.body.push(ReturnStmt { line, value: value! } in default);
    }
    declaration.hasBody = true;
    if (isStatic) {
        declaration.typeName = owner;
        declaration.isStatic = true;
    }
    p.expect(TT.Semi, property ? "Expected ';' after native let" : "Expected ';' after native function");
    return declaration;
}

/**
 * (after `native type NAME`) { ( static ... | native function ... | native let ... | native operator ... | function ... )* }
 * The methods of a type the compiler knows (String, Any): only in the standard library.
 */
function nativeType(p: Parser in default, line: int32, name: Token in default): NativeTypeDecl {
    let declaration: NativeTypeDecl = NativeTypeDecl { line, name: name.text } in default;
    p.expect(TT.LBrace, "Expected '{' to open native type body");
    while (!p.at(TT.RBrace) && !p.atEnd()) {
        if (p.optional(TT.Static)) {
            staticFunction(p, declaration.name);
        } else if (p.optional(TT.Native)) {
            if (p.optional(TT.Function)) {
                declaration.methods.push(nativeFunction(p, p.previous().line));
            } else if (p.optional(TT.Operator)) {
                declaration.methods.push(nativeOperator(p, p.previous().line));
            } else if (p.optional(TT.Let)) {
                declaration.methods.push(nativeProperty(p, p.previous().line));
            } else {
                p.error(p.current().line, "Expected 'function', 'let' or 'operator' after 'native'");
            }
        } else if (p.at(TT.Function)) {
            declaration.methods.push(functionDeclaration(p, false, true));
        } else {
            p.error(p.current().line, "Expected 'native function', 'native operator' or 'function' inside native type");
        }
    }
    p.expect(TT.RBrace, "Expected '}' to close native type body");
    p.optional(TT.Semi);
    return declaration;
}

/** (after `native function`) NAME parameters [ : Type ] [ in lives ] [ throws Type ] [ = expression ] ; */
public function nativeFunction(p: Parser in default, line: int32): FunctionDecl {
    let name: Token = p.expect(TT.Ident, "Expected function name");
    let declaration: FunctionDecl = FunctionDecl { line, name: name.text, ret: typeNamed("void", name.line) } in default;
    declaration.params = parameters(p);
    if (p.optional(TT.Colon)) { declaration.ret = type(p); }
    if (p.optional(TT.In)) { declaration.returnLives = lives(p); }
    if (p.optional(TT.Throws)) { declaration.throwsType = type(p); }
    if (p.at(TT.CCode)) {                         // native function f(...): T { C }
        cBodied(p, declaration);
        return declaration;
    }
    if (p.optional(TT.Assign)) {
        let value: Expr = expression(p);
        if (declaration.ret.kind == TK.Named && declaration.ret.name == "void") {
            declaration.body.push(ExprStmt { line, expr: value } in default);
        } else {
            declaration.body.push(ReturnStmt { line, value } in default);
        }
        declaration.hasBody = true;
    }
    p.expect(TT.Semi, "Expected ';' after native function");
    return declaration;
}

/**
 * (after `native let`) NAME : Type [ = expression ] ;
 *
 * A value read without parentheses and never assigned (s.length). Without `= expression` the compiler
 * gives it; with it, it is that expression.
 */
public function nativeProperty(p: Parser in default, line: int32): FunctionDecl {
    let name: Token = p.expect(TT.Ident, "Expected a name after 'native let'");
    p.expect(TT.Colon, "Expected ':' and the type after 'native let ${name.text}'");
    let declaration: FunctionDecl = FunctionDecl { line, name: name.text, ret: type(p), isProperty: true } in default;
    if (p.optional(TT.Assign)) {
        declaration.body.push(ReturnStmt { line, value: expression(p) } in default);
        declaration.hasBody = true;
    }
    p.expect(TT.Semi, "Expected ';' after native let");
    return declaration;
}

/** (after `native operator`) ( [ ] | SYMBOL ) parameters : Type ; */
function nativeOperator(p: Parser in default, line: int32): FunctionDecl {
    let name: String = "";
    if (p.optional(TT.LBracket)) {
        p.expect(TT.RBracket, "Expected ']' after '[' in native operator");
        name = "[]";
    } else {
        name = p.advance().text;
    }
    let declaration: FunctionDecl = FunctionDecl { line, name, isOperator: true, params: parameters(p), ret: typeNamed("void", line) } in default;
    p.expect(TT.Colon, "Native operators must declare their return type");
    declaration.ret = type(p);
    p.expect(TT.Semi, "Expected ';' after native operator");
    return declaration;
}
