// syntax.parser: tokens -> syntax tree.
//
// A recursive descent parser: each function reads one construction of the language, and the comment above
// it shows that construction's form, in this notation:
//
//   word        that word (a keyword or a symbol)          [ x ]     x, optionally
//   NAME        an identifier                              x*        x, any number of times
//   x | y       x or y                                     ( ... )   grouping
//
// The first syntax error is kept; after it every token reads as the end of the file, so the parser
// unwinds quickly and its result is thrown away.

import syntax.ast {
    Node, Expr, Stmt, TK, TypeRef, typeNamed, Program, ImportDecl, CIncludeDecl, CCodeDecl, ExternTypeDecl,
    ExternFunctionDecl, ExternValueDecl, ConstDecl, Param, FunctionDecl, FieldDecl, StructDecl, ClassDecl, InterfaceDecl, EnumVariant,
    EnumDecl, NativeTypeDecl, declName, VarDecl, AssignStmt, ReturnStmt, ExprStmt, IfStmt, WhileStmt, ForStmt, BreakStmt,
    ContinueStmt, ThrowStmt, YieldStmt, CatchClause, TryStmt, SwitchStmt, BlockStmt, IntLit, FloatLit, StringLit,
    BoolLit, NullLit, Ident, SelfExpr, SuperMember, Member, Index, Call, Unary, Binary, Ternary, IsExpr, Cast, Unwrap,
    Lambda, FieldInit, ObjectLit, ArrayLit, Placed, Pattern, SwitchCase, SwitchExpr,
    PL_MEMORY, PL_HEAP, PL_STACK, PL_DEFAULT, PT_NAME, PT_TYPE, PT_DESTRUCTURE, PT_CONSTANT, PT_NULL
};
import syntax.lexer { TT, Token, Lexer };

/** The first error: a lexical or a syntax error ("" when there is none). */
public let parseError: String = "";

/** The tree of one source file. `startLine` is the number of its first line (it also says the file). */
public function parseProgram(source: String in default, startLine: int32): Program {
    parseError = "";
    let lexer: Lexer = { src: source, line: startLine } in default;
    lexer.run();
    tokens = lexer.toks;
    position = 0;
    if (lexer.error != "") { parseError = lexer.error; }
    return program(startLine);
}

/** What the parser reads past the last token. */
let endOfFile: Token = Token { kind: TT.Eof, text: "", line: 0 } in default;

/** The tokens being read, and the position of the next one. */
let tokens: Token[*] = [] in default;
let position: int32 = 0;
/** Reading the methods of a synchronized class: they may say `wait until (condition)`. */
let waitUntilAllowed: bool = false;
/** Reading the type after `as`: there a '?' may be the ternary's (n > MAX as int64 ? a : b). */
let readingCastType: bool = false;
/** Static functions written inside a type: they become top-level `function Type.name` declarations. */
let staticFunctions: FunctionDecl[*] = [] in default;
/** What a native type with members also declares: its methods, the C functions they call, the struct of its fields. */
let nativeParts: Node[*] = [] in default;
/** The class being read ("" outside one): what its cinclude, ccode and C bodies belong to. */
let cOwner: String = "";

// =========================================================================================
// Reading tokens
// =========================================================================================

function error(line: int32, message: String): void {
    if (parseError == "") { parseError = "Syntax Error [Line ${line}]: ${message}" in default; }
}

function hasFailed(): bool { return parseError != ""; }

/** The token to read next. */
function current(): Token {
    return hasFailed() || position >= tokens.length ? endOfFile : tokens[position];
}

/** The token after the current one. */
function next(): Token {
    if (hasFailed()) { return endOfFile; }
    return position + 1 < tokens.length ? tokens[position + 1] : tokens[tokens.length - 1];
}

/** The token just read. */
function previous(): Token { return position == 0 ? endOfFile : tokens[position - 1]; }

function atEnd(): bool { return current().kind == TT.Eof; }

/** Is the current token of this kind? */
function at(kind: TT): bool { return !atEnd() && current().kind == kind; }

/** Is the current token the identifier `word` (a word with a meaning only there: test, export, type...)? */
function atWord(word: String): bool { return at(TT.Ident) && current().text == word; }

/** Are the next two tokens the identifiers `first` and `second` (wait until, thread safe)? */
function atWords(first: String, second: String): bool {
    return atWord(first) && next().kind == TT.Ident && next().text == second;
}

/** Reads the current token and gives it. */
function advance(): Token {
    if (!atEnd()) { position += 1; }
    return previous();
}

/** [ kind ]: reads the token when it is of this kind, and says whether it was. */
function optional(kind: TT): bool {
    if (!at(kind)) { return false; }
    advance();
    return true;
}

/** [ first second ]: reads the two words when they come, and says whether they did. */
function optionalWords(first: String, second: String): bool {
    if (!atWords(first, second)) { return false; }
    advance();
    advance();
    return true;
}

/** kind: reads the token, which must be of this kind (else the error says what came instead). */
function expect(kind: TT, message: String): Token {
    if (at(kind)) { return advance(); }
    error(current().line, "${message} (got '${current().text}')");
    return endOfFile;
}

/** The node, after its ';'. */
function endedBySemicolon(node: Node, what: String): Node {
    expect(TT.Semi, "Expected ';' after ${what}");
    return node;
}

/** NAME ( . NAME )* */
function qualifiedName(message: String): String {
    let name: String = expect(TT.Ident, message).text;
    while (at(TT.Dot) && next().kind == TT.Ident) {
        advance();
        name = "${name}.${advance().text}" in default;
    }
    return name;
}

/** [ item ( , item )* ] before `close` (which is not read). */
function strictList(close: TT, readItem: () -> void): void {
    if (at(close)) { return; }
    while (true) {
        readItem();
        if (!optional(TT.Comma)) { break; }
    }
}

/** Like strictList, but a comma may also end the list. */
function looseList(close: TT, readItem: () -> void): void {
    while (!at(close) && !atEnd()) {
        readItem();
        if (!optional(TT.Comma)) { break; }
    }
}

/** in ( default | self | NAME ): where a parameter or a result lives. */
function lives(): String {
    if (optional(TT.Default)) { return "default"; }
    if (optional(TT.Self)) { return "self"; }
    return expect(TT.Ident, "Expected 'default', 'self' or a parameter name after 'in'").text;
}

// =========================================================================================
// The file
// =========================================================================================

/** import* ( [public] declaration | #when block )* */
function program(startLine: int32): Program {
    let program: Program = Program { line: startLine } in default;
    while (!atEnd()) {
        if (at(TT.Import)) {
            if (program.decls.length > 0) { error(current().line, "Imports go at the beginning of the file, before any declaration"); }
            program.imports.push(importDeclaration());
            continue;
        }
        if (at(TT.HashWhen)) {
            platformDeclarations(program);
            continue;
        }
        if (at(TT.HashElse) || at(TT.HashEnd)) {
            error(current().line, "'#${current().kind == TT.HashElse ? "else" : "end"}' without a '#when' above it");
            advance();
            continue;
        }
        if (at(TT.Private)) {
            error(current().line, "'private' is not needed: what a module declares is private unless it is marked 'public'");
            advance();
        }
        let isPublic: bool = optional(TT.Public);
        let start: Token = current();
        let declaration: Node = topLevelDeclaration();
        if (isPublic && declaration is FunctionDecl testFunction && testFunction.isTest) {
            error(start.line, "A test function cannot be 'public': only larimar test calls it");
        } else if (isPublic && declaration is FunctionDecl staticFunction && staticFunction.typeName != "") {
            error(start.line, "A static function is visible where its type is: mark the type 'public', not the function");
        } else if (isPublic) {
            let name: String = declName(declaration);
            if (name == "") { error(start.line, "Only declarations with a name can be 'public'"); } else { program.publics.push(name); }
        }
        program.decls.push(declaration);
        for (part in nativeParts) { program.decls.push(part); }
        nativeParts.clear();
        for (staticFunction in staticFunctions) { program.decls.push(staticFunction); }
        staticFunctions.clear();
    }
    return program;
}

/**
 * #when PLATFORM declaration* ( #when PLATFORM declaration* )* [ #else declaration* ] #end
 *
 * Declarations for one platform (each gets that platform). Only cinclude and native declarations:
 * what changes between platforms is how C is reached. Here #else follows only #when windows or
 * #when unix (the rest is then the other one).
 */
function platformDeclarations(program: Program in default): void {
    let opening: int32 = current().line;
    let platforms: String[*] = [] in default;
    let platformLines: int32[*] = [] in default;
    while (at(TT.HashWhen) || at(TT.HashElse)) {
        let directive: Token = advance();
        let platform: String = "";
        if (directive.kind == TT.HashWhen) {
            platform = directivePlatform(directive, platforms, platformLines);
        } else {
            let onlyWindows: bool = platforms.length == 1 && platforms[0] == "windows";
            let onlyUnix: bool = platforms.length == 1 && platforms[0] == "unix";
            platform = onlyWindows ? "unix" : onlyUnix ? "windows" : "";
            if (platform == "") { error(directive.line, "Outside a function '#else' only follows '#when windows' or '#when unix': name each platform with its own '#when'"); }
        }
        platforms.push(platform);
        platformLines.push(directive.line);
        while (!atDirective() && !atEnd() && !hasFailed()) {
            let isPublic: bool = optional(TT.Public);
            let start: Token = current();
            let declaration: Node = topLevelDeclaration();
            let allowed: bool = true;
            switch (declaration) {
                case CIncludeDecl include -> { include.platform = platform; }
                case ExternTypeDecl type -> { type.platform = platform; }
                case ExternFunctionDecl cFunction -> { cFunction.platform = platform; }
                case ExternValueDecl value -> { value.platform = platform; }
                default -> { allowed = false; }
            }
            if (!allowed) { error(start.line, "Outside a function, inside '#when' go only cinclude and native declarations"); }
            if (nativeParts.length > 0 || staticFunctions.length > 0) {
                error(start.line, "A native type with members is declared once, outside '#when': inside it, declare its C type for each platform (native type X = T;)");
            }
            if (isPublic) { program.publics.push(declName(declaration)); }
            program.decls.push(declaration);
        }
        if (directive.kind == TT.HashElse) { break; }
    }
    expect(TT.HashEnd, "Expected '#end' to close the '#when' of line ${opening % 1000000}");
}

/** #when, #else or #end next? */
function atDirective(): bool { return at(TT.HashWhen) || at(TT.HashElse) || at(TT.HashEnd); }

/**
 * The platform of a #when: windows, macos, linux or unix (every one but Windows). A branch that an
 * earlier one already covers would never be chosen: an error.
 */
function directivePlatform(directive: Token, earlier: String[*], earlierLines: int32[*]): String {
    let platform: String = directive.text;
    if (platform != "windows" && platform != "macos" && platform != "linux" && platform != "unix") {
        error(directive.line, "Unknown platform '${platform}': the platforms are windows, macos, linux and unix (every one but Windows)");
        return platform;
    }
    for (i, before in earlier) {
        if (platform == before || (before == "unix" && (platform == "macos" || platform == "linux"))) {
            error(directive.line, "'#when ${platform}' is never chosen: '#when ${before}' (line ${earlierLines[i] % 1000000}) already covers it");
        }
    }
    return platform;
}

/** `when` after a declaration was the old way: say the new one. */
function noWhenSuffix(): void {
    if (at(TT.When)) {
        error(current().line, "For one platform, put the declaration inside '#when <platform>' ... '#end' (each on its own line)");
    }
}

// =========================================================================================
// Declarations
// =========================================================================================

/** import NAME ( . NAME )* [ as NAME | { NAME ( , NAME )* } ] ; */
function importDeclaration(): ImportDecl {
    let line: int32 = expect(TT.Import, "Expected 'import'").line;
    let last: String = expect(TT.Ident, "Expected a module name after 'import'").text;
    let path: String = last;
    while (optional(TT.Dot)) {
        last = expect(TT.Ident, "Expected a name after '.' in the module path").text;
        path = "${path}.${last}" in default;
    }
    let declaration: ImportDecl = ImportDecl { line, path, alias: last } in default;
    if (optional(TT.As)) {
        declaration.alias = expect(TT.Ident, "Expected a name after 'as'").text;
    } else if (optional(TT.LBrace)) {
        declaration.hasNames = true;
        declaration.alias = "";
        looseList(TT.RBrace, () -> { declaration.names.push(expect(TT.Ident, "Expected a name to import").text); });
        expect(TT.RBrace, "Expected '}' after the imported names");
    }
    expect(TT.Semi, "Expected ';' after import");
    return declaration;
}

/**
 * ccode { C } | ccode "FILE" ; | cinclude "HEADER" ; | native ... | test function ... | export function ... | const ... |
 * let ... | function ... | struct ... | [synchronized] class ... | interface ... | enum ... | native type ...
 */
function topLevelDeclaration(): Node {
    let start: Token = current();
    if (optional(TT.CCode)) { return CCodeDecl { line: start.line, code: previous().text } in default; }
    if (optional(TT.CInclude)) {
        let include: CIncludeDecl = CIncludeDecl { line: start.line, header: expect(TT.Str, "Expected the header after 'cinclude': cinclude \"<math.h>\";").text } in default;
        noWhenSuffix();
        return endedBySemicolon(include, "'cinclude'");
    }
    if (atWord("test") && next().kind == TT.Function) {
        advance();
        return testFunction();
    }
    if (atWord("export") && next().kind == TT.Function) {
        advance();
        parsingExport = true;
        let exported: FunctionDecl = functionDeclaration(false, true);
        parsingExport = false;
        if (exported.typeName != "") { error(exported.line, "Only plain functions can be exported, not '${exported.typeName}.${exported.name}'"); }
        exported.exportName = exported.name;
        return exported;
    }
    if (optional(TT.Const)) { return constant(); }
    if (at(TT.Let)) { return variable(); }
    if (at(TT.Function)) { return functionDeclaration(false, true); }
    if (optional(TT.Struct)) { return structDeclaration(); }
    if (optional(TT.Class)) { return classDeclaration(false); }
    if (optional(TT.Synchronized)) {
        expect(TT.Class, "Expected 'class' after 'synchronized'");
        return classDeclaration(true);
    }
    if (optional(TT.Interface)) { return interfaceDeclaration(); }
    if (optional(TT.Enum)) { return enumDeclaration(); }
    if (optional(TT.Native)) { return nativeDeclaration(start.line); }
    if (at(TT.Override)) {
        error(start.line, "'override' is only valid inside a class");
        return BlockStmt { line: start.line } in default;
    }
    if (start.kind == TT.Ident && (next().kind == TT.Assign || next().kind == TT.OpAssign)) {
        let op: String = next().kind == TT.OpAssign ? "${next().text}=" : "=";
        error(start.line, "'${start.text} ${op} ...' is a statement: at top level only declarations are allowed. Move it into a function (main), or give the value where '${start.text}' is declared: let ${start.text}: T = ...;");
        return BlockStmt { line: start.line } in default;
    }
    if (start.kind == TT.Ident && (next().kind == TT.LParen || next().kind == TT.Dot)) {
        error(start.line, "'${start.text}${next().text}...' is a statement: at top level only declarations are allowed. Move it into a function (main).");
        return BlockStmt { line: start.line } in default;
    }
    error(start.line, "Only declarations (let, const, function, struct, class, interface, enum, native, cinclude, ccode, #when) are allowed at top level (got '${start.text}')");
    return BlockStmt { line: start.line } in default;
}

/** (after `test`) function NAME ( [ NAME : Type ] ) : void block */
function testFunction(): FunctionDecl {
    let test: FunctionDecl = functionDeclaration(false, true);
    if (test.typeName != "") {
        error(test.line, "A test function is a plain function, not '${test.typeName}.${test.name}'");
    } else if (test.params.length > 1) {
        error(test.line, "A test function takes nothing, or one setup: test function ${test.name}(s: MySetup)");
    } else if (test.ret.kind != TK.Named || test.ret.name != "void") {
        error(test.line, "A test function returns nothing: test function ${test.name}(): void");
    } else if (test.returnLives != "") {
        error(test.line, "A test function returns nothing, so it has no 'in ${test.returnLives}'");
    }
    test.isTest = true;
    return test;
}

/** (after `const`) NAME : Type = expression ; */
function constant(): Node {
    let name: Token = expect(TT.Ident, "Expected constant name");
    expect(TT.Colon, "Expected ':' and a type after constant '${name.text}'");
    let constantType: TypeRef = type();
    expect(TT.Assign, "Constants need a value");
    return endedBySemicolon(ConstDecl { line: name.line, name: name.text, type: constantType, value: expression() } in default, "constant");
}

// ---- native: what comes from C ---------------------------------------------------------------
//
// The left side is the name in Larimar; after '=' comes the name in C (a NAME), or C text in quotes when it is
// not a plain name ("struct tm", "(fio_start)", "sizeof(struct stat)"). Without '=', C's name is the same.

/**
 * (after `native`)
 *   function NAME ( [ parameter ( , parameter )* [ , ... ] ] ) [ : Type ] [ = C ] [ released by NAME ] ;  a C function
 *   const NAME : Type [ = C ] ;      let NAME : Type [ = NAME ] ;                        a C constant, macro or global
 *   struct NAME [ = C ] { ( let NAME : Type [ = NAME ] ; | function ... | static ... )* }  a C struct, by value
 *   type NAME [ = CTYPE | = ( Type, ... ) -> Type ] [ released by NAME ] ( ; | { member* } )   a C type
 *   type NAME { ... }                                                                   (std) a type the compiler knows
 */
function nativeDeclaration(line: int32): Node {
    if (optional(TT.Function)) { return nativeFunctionOfC(); }
    if (at(TT.Const) || at(TT.Let)) { return nativeValue(); }
    if (optional(TT.Struct)) { return nativeStruct(); }
    if (!atWord("type")) {
        error(current().line, "Expected 'function', 'type', 'struct', 'const' or 'let' after 'native' (got '${current().text}')");
        return BlockStmt { line } in default;
    }
    advance();
    let name: Token = expect(TT.Ident, "Expected the type's name after 'native type'");
    if (at(TT.LBrace)) { return nativeType(line, name); }
    return nativeCType(name);
}

/** At C text: c"...". */
function atCText(): bool { return at(TT.CText); }

/** [ = NAME | = c"C" ]: what a native declaration is in C; "" without '='. */
function cTarget(what: String): String {
    if (!optional(TT.Assign)) { return ""; }
    if (atCText()) {
        let text: Token = advance();
        if (text.text.trim() == "") { error(text.line, "The C of ${what} is empty"); }
        return text.text;
    }
    return expect(TT.Ident, "Expected the C name, or c\"C text\", after '=' in ${what}").text;
}

/** (after `native function`) NAME ( [ parameter ( , parameter )* [ , ... ] ] ) [ : Type ] [ = C ] [ released by NAME ] ; */
function nativeFunctionOfC(): ExternFunctionDecl {
    let name: Token = expect(TT.Ident, "Expected function name");
    let declaration: ExternFunctionDecl = ExternFunctionDecl { line: name.line, name: name.text, cName: name.text, ret: typeNamed("void", name.line) } in default;
    expect(TT.LParen, "Expected '(' after function name");
    if (!at(TT.RParen)) {
        while (true) {
            if (optional(TT.Ellipsis)) {
                declaration.varargs = true;
                break;
            }
            declaration.params.push(parameter(true));
            if (!optional(TT.Comma)) { break; }
        }
    }
    expect(TT.RParen, declaration.varargs ? "'...' must be the last parameter" : "Expected ')' after parameters");
    if (optional(TT.Colon)) { declaration.ret = type(); }
    if (at(TT.Assign) && !(next().kind == TT.Ident || next().kind == TT.Str || next().kind == TT.CText)) {
        error(current().line, "A native function of a module names its C function (= c_name;); to write it in Larimar, write a plain function");
    }
    let target: String = cTarget("native function '${name.text}'");
    if (target != "") { declaration.cName = target; }
    if (atWord("released")) {                // a text C makes: copied into the memory of the call, then released
        advance();
        let by: Token = expect(TT.Ident, "Expected 'by' and the function that releases the text: released by free");
        if (by.text != "by") { error(by.line, "Expected 'by' after 'released': released by free"); }
        declaration.releasedBy = expect(TT.Ident, "Expected the function that releases the result of '${name.text}' after 'released by'").text;
    }
    noWhenSuffix();
    if (at(TT.LBrace)) { error(current().line, "A native function has no body: it is a function of C (to write one in Larimar, write a plain function)"); }
    expect(TT.Semi, "Expected ';' after native function");
    return declaration;
}

/** (after `native`) ( const NAME : Type [ = C ] | let NAME : Type [ = NAME ] ) ; */
function nativeValue(): Node {
    let isConst: bool = advance().kind == TT.Const;
    let what: String = isConst ? "native const" : "native let";
    let name: Token = expect(TT.Ident, "Expected a name after '${what}'");
    expect(TT.Colon, "Expected ':' and a type after '${name.text}'");
    let declaration: ExternValueDecl = ExternValueDecl { line: name.line, name: name.text, type: type(), isConst, cName: name.text } in default;
    if (optional(TT.Assign)) {
        if (atCText()) {                   // what C writes for it: sizeof, a cast, a macro with arguments
            if (!isConst) { error(current().line, "A native let is a C variable: give its C name (= c_name), not C text"); }
            declaration.cExpr = advance().text;
            if (declaration.cExpr.trim() == "") { error(name.line, "The C of '${name.text}' is empty"); }
        } else {
            declaration.cName = expect(TT.Ident, "Expected the C name, or c\"C text\", after '='").text;
        }
    }
    noWhenSuffix();
    return endedBySemicolon(declaration, what);
}

/** (after `native struct`) NAME [ = C ] { ( let NAME : Type [ = NAME ] ; | function ... | static ... )* } */
function nativeStruct(): StructDecl {
    let name: Token = expect(TT.Ident, "Expected the struct's name after 'native struct'");
    let declaration: StructDecl = StructDecl { line: name.line, name: name.text, cName: name.text } in default;
    let target: String = cTarget("native struct '${name.text}'");
    if (target != "") { declaration.cName = target; }
    expect(TT.LBrace, "Expected '{' with the fields of the C struct");
    while (!at(TT.RBrace) && !atEnd() && !hasFailed()) {
        if (at(TT.Let)) {
            declaration.fields.push(cField());
        } else if (at(TT.Function)) {
            declaration.methods.push(functionDeclaration(false, true));
        } else if (optional(TT.Static)) {
            staticFunction(declaration.name);
        } else {
            error(current().line, "A native struct has its C fields (let name: Type;) and Larimar functions (got '${current().text}')");
        }
    }
    expect(TT.RBrace, "Expected '}' to close the native struct");
    optional(TT.Semi);
    return declaration;
}

/** let NAME : Type [ = NAME ] ;      a field of a C struct (after '=': its name in C) */
function cField(): FieldDecl {
    expect(TT.Let, "Expected 'let'");
    let name: Token = expect(TT.Ident, "Expected field name");
    expect(TT.Colon, "Expected ':' and a type after field '${name.text}'");
    let declaration: FieldDecl = FieldDecl { line: name.line, name: name.text, type: type() } in default;
    if (optional(TT.Assign)) {
        declaration.cName = expect(TT.Ident, "A field of C has no default value: after '=' goes its name in C (let size: int64 = st_size;)").text;
    }
    expect(TT.Semi, "Expected ';' after field declaration");
    return declaration;
}

/**
 * (after `native type NAME`) [ = CTYPE | = ( Type, ... ) -> Type ] [ released by NAME ] ( ; | { member* } )
 *     CTYPE: NAME *...  or "C TYPE";  without '=' it is opaque (void*)
 */
function nativeCType(name: Token in default): Node {
    let declaration: ExternTypeDecl = ExternTypeDecl { line: name.line, name: name.text } in default;
    if (optional(TT.Assign)) {
        if (at(TT.LParen)) {
            declaration.func = type();
            if (declaration.func!.kind != TK.Func) { error(name.line, "Expected a function type after '=': (int32, int32) -> int32"); }
        } else if (atCText()) {
            declaration.cType = advance().text;
            if (declaration.cType.trim() == "") { error(name.line, "The C type of '${name.text}' is empty"); }
        } else {
            let cType: String = expect(TT.Ident, "Expected the C type after 'native type ${name.text} =': a name (FILE*), c\"C text\" or a function type").text;
            while (optional(TT.Star)) { cType = "${cType}*"; }
            declaration.cType = cType.clone() in default;
        }
    }
    if (atWord("released")) {
        advance();
        let by: Token = expect(TT.Ident, "Expected 'by' and the function that releases it: released by close");
        if (by.text != "by") { error(by.line, "Expected 'by' after 'released': released by close"); }
        declaration.releasedBy = expect(TT.Ident, "Expected the function that releases '${declaration.name}' after 'released by'").text;
    } else if (atWord("released_by")) {
        error(current().line, "Write 'released by' (two words): released by close");
    }
    noWhenSuffix();
    if (at(TT.LBrace)) {
        nativeMembers(declaration);
        optional(TT.Semi);
        return declaration;
    }
    return endedBySemicolon(declaration, "native type");
}

/**
 * { ( let NAME : Type [ = NAME ] ; | native function ... | native let ... | function ... | static ... )* }
 * The members of a C type: its fields (when it is a pointer to a C struct), functions of C that take it
 * first (self), and functions written in Larimar.
 */
function nativeMembers(declaration: ExternTypeDecl in default): void {
    let line: int32 = expect(TT.LBrace, "Expected '{'").line;
    if (declaration.func != null) { error(line, "A pointer to a C function has no members"); }
    let methods: NativeTypeDecl = NativeTypeDecl { line: declaration.line, name: declaration.name } in default;
    let fields: StructDecl = StructDecl { line: declaration.line, name: "${declaration.name}__fields" in default } in default;
    while (!at(TT.RBrace) && !atEnd() && !hasFailed()) {
        if (at(TT.Let)) {
            fields.fields.push(cField());
        } else if (optional(TT.Native)) {
            let start: int32 = previous().line;
            if (optional(TT.Function)) {
                methods.methods.push(nativeMember(declaration.name, start, false, false));
            } else if (optional(TT.Let)) {
                methods.methods.push(nativeMember(declaration.name, start, true, false));
            } else {
                error(current().line, "Expected 'function' or 'let' after 'native'");
            }
        } else if (optional(TT.Static)) {
            if (optional(TT.Native)) {
                let start: int32 = previous().line;
                expect(TT.Function, "Expected 'function' after 'static native'");
                staticFunctions.push(nativeMember(declaration.name, start, false, true));
            } else {
                let f: FunctionDecl = functionDeclaration(false, true);
                f.typeName = declaration.name;
                f.isStatic = true;
                staticFunctions.push(f);
            }
        } else if (at(TT.Function)) {
            methods.methods.push(functionDeclaration(false, true));
        } else {
            error(current().line, "Inside a native type go its C fields (let), native functions and functions (got '${current().text}')");
        }
    }
    expect(TT.RBrace, "Expected '}' to close the native type");
    if (fields.fields.length > 0) {
        let c: String = declaration.cType.trim();
        if (!c.endsWith("*")) {
            error(fields.fields[0].line, "The fields of '${declaration.name}' are reached through its pointer: its C type must be a pointer to the struct (native type ${declaration.name} = c_struct*)");
        }
        fields.cName = c.substring(0, c.length - 1).trim().clone() in default;
        declaration.fieldsStruct = fields.name;
        nativeParts.push(fields);
    }
    if (methods.methods.length > 0) { nativeParts.push(methods); }
}

/**
 * (after `native function` or `native let`, in a native type)
 *   NAME parameters [ : Type ] [ in lives ] [ throws Type ] = ( C | expression ) ;      (let: NAME : Type = ...)
 * With `= C` (a name, or "C text"), the method calls that C function with self first: before it only the
 * memory of the call, when the first parameter is one (m: byte[*]). Any other expression is Larimar.
 */
function nativeMember(owner: String in default, line: int32, property: bool, isStatic: bool): FunctionDecl {
    let name: Token = expect(TT.Ident, "Expected a name");
    let declaration: FunctionDecl = FunctionDecl { line, name: name.text, ret: typeNamed("void", name.line), isProperty: property } in default;
    if (property) {
        expect(TT.Colon, "Expected ':' and the type after 'native let ${name.text}'");
        declaration.ret = type();
    } else {
        declaration.params = parameters();
        if (optional(TT.Colon)) { declaration.ret = type(); }
        if (optional(TT.In)) { declaration.returnLives = lives(); }
        if (optional(TT.Throws)) { declaration.throwsType = type(); }
    }
    expect(TT.Assign, "Expected '=' and its C function (= c_name;) or a Larimar expression");
    let value: Expr? = null;
    if ((at(TT.Ident) || at(TT.CText)) && (next().kind == TT.Semi || next().kind == TT.Ident && next().text == "released")) {
        let c: Token = advance();
        let cFunction: ExternFunctionDecl = ExternFunctionDecl {
            line: c.line, name: "${owner}__${name.text}" in default, cName: c.text, ret: declaration.ret.clone() in default
        } in default;
        if (atWord("released")) {            // = c_f released by r: the text C makes is copied, then released
            advance();
            let by: Token = expect(TT.Ident, "Expected 'by' and the function that releases the text: released by free");
            if (by.text != "by") { error(by.line, "Expected 'by' after 'released': released by free"); }
            cFunction.releasedBy = expect(TT.Ident, "Expected the function that releases the result of '${name.text}' after 'released by'").text;
        }
        let args: Expr[*] = [] in default;
        let kept: Param[*] = [] in default;
        let late: Param[*] = [] in default;
        for (i, p in declaration.params) {
            let memory: bool = i == 0 && p.type != null && p.type!.kind == TK.Growable && p.type!.inner!.kind == TK.Named && p.type!.inner!.name == "byte";
            let context: bool = p.type != null && p.type!.kind == TK.Named && p.type!.name == "Context";
            if (memory) {
                cFunction.params.push(p.clone() in default);     // the memory of the call: before self, and not written in calls
            } else if (context) {
                late.push(p);                                    // C's Context: the compiler gives it, so the method has none
            } else {
                kept.push(p);
            }
        }
        if (!isStatic) {
            cFunction.params.push(Param { line: c.line, name: "receiver", type: typeNamed(owner, c.line) } in default);
            args.push(SelfExpr { line: c.line } in default);
        }
        for (p in declaration.params) {
            if (late.contains(p)) {
                cFunction.params.push(p.clone() in default);
            } else if (kept.contains(p)) {
                cFunction.params.push(p.clone() in default);
                args.push(Ident { line: c.line, name: p.name } in default);
            }
        }
        declaration.params = kept;
        declaration.forwardsToC = true;
        nativeParts.push(cFunction);
        value = Call { line: c.line, callee: Ident { line: c.line, name: cFunction.name } in default, args } in default;
    } else {
        value = expression();
    }
    if (declaration.ret.kind == TK.Named && declaration.ret.name == "void") {
        declaration.body.push(ExprStmt { line, expr: value! } in default);
    } else {
        declaration.body.push(ReturnStmt { line, value: value! } in default);
    }
    declaration.hasBody = true;
    if (isStatic) {
        declaration.typeName = owner;
        declaration.isStatic = true;
    }
    expect(TT.Semi, property ? "Expected ';' after native let" : "Expected ';' after native function");
    return declaration;
}

/** NAME : Type [ in lives ]      (in a lambda: NAME [ : Type ]) */
function parameter(typeRequired: bool): Param {
    let name: Token = expect(TT.Ident, "Expected parameter name");
    let parameter: Param = Param { line: name.line, name: name.text } in default;
    if (!typeRequired) {
        if (optional(TT.Colon)) { parameter.type = type(); }
        return parameter;
    }
    expect(TT.Colon, "Expected ':' and a type after parameter '${name.text}'");
    parameter.type = type();
    if (optional(TT.In)) { parameter.lives = lives(); }
    return parameter;
}

/** ( [ parameter ( , parameter )* ] ) */
function parameters(): Param[*] {
    expect(TT.LParen, "Expected '('");
    let list: Param[*] = [] in default;
    strictList(TT.RParen, () -> { list.push(parameter(true)); });
    expect(TT.RParen, "Expected ')' after parameters");
    return list;
}

/**
 * function [ TYPE . ] NAME parameters [ : Type ] [ in lives ] [ throws Type ] [ wait until ( expression ) ]
 *     ( block | ; )
 *
 * `wait until` only on a method of a synchronized class; no body (`;`) in an interface.
 */
/** Inside `export function`: `= c_name` may come before the body. */
let parsingExport: bool = false;

function functionDeclaration(isOverride: bool, withBody: bool): FunctionDecl {
    expect(TT.Function, "Expected 'function'");
    let name: Token = expect(TT.Ident, "Expected function name");
    let typeName: String = "";
    if (optional(TT.Dot)) {                    // function Type.method(): a static function of Type
        typeName = name.text;
        name = expect(TT.Ident, "Expected method name after '${typeName}.'");
    }
    let parameterList: Param[*] = parameters();
    let declaration: FunctionDecl = FunctionDecl { line: name.line, name: name.text, isOverride, params: parameterList, ret: typeNamed("void", name.line) } in default;
    if (typeName != "") {
        declaration.typeName = typeName;
        declaration.isStatic = true;
    }
    if (optional(TT.Colon)) { declaration.ret = type(); }
    if (optional(TT.In)) { declaration.returnLives = lives(); }
    if (optional(TT.Throws)) { declaration.throwsType = type(); }
    if (parsingExport && optional(TT.Assign)) {     // export function f(...) = c_name { ... }
        declaration.exportC = expect(TT.Ident, "Expected the C name after '=' in export function '${name.text}'").text;
    }
    let waitToken: Token = current();
    if (atWord("wait_until")) {
        error(waitToken.line, "Write 'wait until' (two words): wait until (condition)");
    }
    if (optionalWords("wait", "until")) {
        if (!waitUntilAllowed) { error(waitToken.line, "'wait until' goes on a method of a synchronized class (whoever calls it waits there until the condition holds)"); }
        expect(TT.LParen, "Expected '(' and a condition after 'wait until'");
        declaration.waitUntil = expression();
        expect(TT.RParen, "Expected ')' after the condition of 'wait until'");
    }
    if (withBody && at(TT.CCode)) {
        if (declaration.waitUntil != null) { error(waitToken.line, "A method with a C body cannot say 'wait until'"); }
        cBodied(declaration);
    } else if (withBody) {
        declaration.body = block("body of '${name.text}'");
        declaration.hasBody = true;
        if (declaration.waitUntil != null) { declaration.body = waitFirst(waitToken.line, declaration.waitUntil!, declaration.body); }
    } else {
        expect(TT.Semi, "Expected ';' after the method signature");
    }
    return declaration;
}

/** operator ( + | - | * | / | % | == | < ) parameters : Type block */
function operatorDeclaration(): FunctionDecl {
    let keyword: Token = expect(TT.Operator, "Expected 'operator'");
    let symbol: Token = advance();
    let kind: TT = symbol.kind;
    if (!(kind == TT.Plus || kind == TT.Minus || kind == TT.Star || kind == TT.Slash || kind == TT.Percent || kind == TT.Eq || kind == TT.Lt)) {
        error(symbol.line, "Operator '${symbol.text}' cannot be overloaded (allowed: + - * / % == <)");
    }
    let parameterList: Param[*] = parameters();
    expect(TT.Colon, "Operators must declare their return type");
    let returnType: TypeRef = type();
    return FunctionDecl { line: keyword.line, name: symbol.text, isOperator: true, params: parameterList, ret: returnType, body: block("operator body"), hasBody: true } in default;
}

/** (after `struct`) NAME { ( field | static ... | function ... | operator ... )* } */
function structDeclaration(): StructDecl {
    let name: Token = expect(TT.Ident, "Expected struct name");
    let declaration: StructDecl = StructDecl { line: name.line, name: name.text } in default;
    expect(TT.LBrace, "Expected '{' to open struct body");
    while (!at(TT.RBrace) && !atEnd()) {
        if (at(TT.Let)) {
            declaration.fields.push(field());
        } else if (optional(TT.Static)) {
            staticFunction(declaration.name);
        } else if (at(TT.Function)) {
            declaration.methods.push(functionDeclaration(false, true));
        } else if (at(TT.Operator)) {
            declaration.methods.push(operatorDeclaration());
        } else if (at(TT.Override)) {
            error(current().line, "Structs have no inheritance, so 'override' is not allowed");
        } else {
            error(current().line, "Expected 'let', 'function' or 'operator' inside struct (got '${current().text}')");
        }
    }
    expect(TT.RBrace, "Expected '}' to close struct body");
    optional(TT.Semi);
    return declaration;
}

/**
 * (after `class`) NAME [ extends NAME ] [ implements NAME ( , NAME )* ]
 *     { ( field | static ... | [override] function ... | native function ... | native let ... | operator ... )* }
 */
function classDeclaration(isSynchronized: bool): ClassDecl {
    let name: Token = expect(TT.Ident, "Expected class name");
    let declaration: ClassDecl = ClassDecl { line: name.line, name: name.text, isSynchronized } in default;
    if (optional(TT.Extends)) { declaration.superName = qualifiedName("Expected superclass name"); }
    if (optional(TT.Implements)) {
        while (true) {
            declaration.interfaces.push(qualifiedName("Expected interface name"));
            if (!optional(TT.Comma)) { break; }
        }
    }
    cOwner = declaration.name;              // its system (implements UnixPlatform...) is known after linking
    expect(TT.LBrace, "Expected '{' to open class body");
    while (!at(TT.RBrace) && !atEnd()) {
        if (at(TT.CInclude)) {                  // the headers of its C: only on its system
            let include: CIncludeDecl = CIncludeDecl { line: advance().line, header: expect(TT.Str, "Expected the header after 'cinclude': cinclude \"<math.h>\";").text, owner: declaration.name } in default;
            expect(TT.Semi, "Expected ';' after the header of 'cinclude'");
            nativeParts.push(include);
        } else if (at(TT.CCode)) {              // C its methods share: only on its system
            let code: Token = advance();
            nativeParts.push(CCodeDecl { line: code.line, code: code.text, owner: declaration.name } in default);
        } else if (at(TT.Let)) {
            declaration.fields.push(field());
        } else if (optional(TT.Static)) {
            staticFunction(declaration.name);
        } else if (optional(TT.Override)) {
            if (!at(TT.Function)) {
                error(current().line, "Expected 'function' after 'override'");
            } else {
                declaration.methods.push(method(isSynchronized, true));
            }
        } else if (optional(TT.Native)) {
            if (optional(TT.Let)) {
                let property: FunctionDecl = nativeProperty(previous().line);
                if (!property.hasBody) { error(property.line, "A native let of a class needs its value: native let ${property.name}: T = expression;"); }
                declaration.methods.push(property);
            } else {
                expect(TT.Function, "Expected 'function' or 'let' after 'native' in class");
                declaration.methods.push(nativeFunction(previous().line));
            }
        } else if (at(TT.Function)) {
            declaration.methods.push(method(isSynchronized, false));
        } else if (at(TT.Operator)) {
            declaration.methods.push(operatorDeclaration());
        } else {
            error(current().line, "Expected 'let', 'function' or 'operator' inside class body (got '${current().text}')");
        }
    }
    cOwner = "";
    expect(TT.RBrace, "Expected '}' to close class body");
    optional(TT.Semi);
    return declaration;
}

/**
 * function f(params): T ccode { C }: the body is C. It becomes a C function the compiler writes (its
 * parameters with their C types and names), and f calls it. In a class for one system (it implements
 * UnixPlatform...), f calls it only there (elsewhere it panics; the C of that system reaches no other).
 */
function cBodied(declaration: FunctionDecl in default): void {
    let code: Token = advance();
    let line: int32 = declaration.line;
    let owner: String = cOwner != "" ? "${cOwner}_" : "";
    let cFunction: ExternFunctionDecl = ExternFunctionDecl {
        line, name: "${owner}c_${declaration.name}", params: declaration.params, ret: declaration.ret,
        cName: "lm_${owner}${declaration.name}_${line}", cBody: code.text, owner: cOwner
    } in default;
    nativeParts.push(cFunction);
    let call: Call = Call { line, callee: Ident { line, name: cFunction.name } in default } in default;
    for (p in declaration.params) { call.args.push(Ident { line, name: p.name } in default); }
    let run: Stmt = ReturnStmt { line, value: call } in default;
    if (declaration.ret.kind == TK.Named && declaration.ret.name == "void") { run = ExprStmt { line, expr: call } in default; }
    declaration.body.push(run);                 // in a class for one system, the analyzer puts it in its #when
    declaration.cBodied = cOwner != "";
    declaration.hasBody = true;
}

/** A method of a class: in a synchronized class it may say `wait until`. */
function method(ofSynchronizedClass: bool, isOverride: bool): FunctionDecl {
    waitUntilAllowed = ofSynchronizedClass;
    let method: FunctionDecl = functionDeclaration(isOverride, true);
    waitUntilAllowed = false;
    return method;
}

/** (after `interface`) NAME [ extends NAME ( , NAME )* ] { ( function NAME parameters [ : Type ] ... ; )* } */
function interfaceDeclaration(): InterfaceDecl {
    let name: Token = expect(TT.Ident, "Expected interface name");
    let declaration: InterfaceDecl = InterfaceDecl { line: name.line, name: name.text } in default;
    if (optional(TT.Extends)) {                 // interface LinuxPlatform extends UnixPlatform
        while (true) {
            declaration.parents.push(qualifiedName("Expected the name of the interface it extends"));
            if (!optional(TT.Comma)) { break; }
        }
    }
    expect(TT.LBrace, "Expected '{' to open interface body");
    while (!at(TT.RBrace) && !atEnd()) {
        if (at(TT.Static)) {
            error(current().line, "Interfaces cannot have static functions; declare them in a type or as plain functions");
            advance();
        } else if (at(TT.Let)) {
            error(current().line, "Interfaces only declare methods; fields belong in classes or structs");
        } else {
            declaration.methods.push(functionDeclaration(false, false));
        }
    }
    expect(TT.RBrace, "Expected '}' to close interface body");
    optional(TT.Semi);
    return declaration;
}

/** (after `static`, inside the type `owner`) function ... | native function ... = C ; */
function staticFunction(owner: String in default): void {
    let found: FunctionDecl? = null;
    if (optional(TT.Native)) {
        expect(TT.Function, "Expected 'function' after 'static native'");
        found = nativeFunction(previous().line);
        if (!found!.hasBody) { error(found!.line, "A static native function needs its C: static native function ${found!.name}(...) = c_function(...);"); }
    } else if (at(TT.Function)) {
        found = functionDeclaration(false, true);
    } else {
        error(current().line, "Expected 'function' after 'static'");
        return;
    }
    let staticFunction: FunctionDecl = found!;
    if (staticFunction.typeName != "") { error(staticFunction.line, "Inside '${owner}' a static function is written without the type: static function ${staticFunction.name}(...)"); }
    staticFunction.typeName = owner;
    staticFunction.isStatic = true;
    staticFunctions.push(staticFunction);
}

/**
 * (after `native type NAME`) { ( static ... | native function ... | native let ... | native operator ... | function ... )* }
 * The methods of a type the compiler knows (String, Any): only in the standard library.
 */
function nativeType(line: int32, name: Token in default): NativeTypeDecl {
    let declaration: NativeTypeDecl = NativeTypeDecl { line, name: name.text } in default;
    expect(TT.LBrace, "Expected '{' to open native type body");
    while (!at(TT.RBrace) && !atEnd()) {
        if (optional(TT.Static)) {
            staticFunction(declaration.name);
        } else if (optional(TT.Native)) {
            if (optional(TT.Function)) {
                declaration.methods.push(nativeFunction(previous().line));
            } else if (optional(TT.Operator)) {
                declaration.methods.push(nativeOperator(previous().line));
            } else if (optional(TT.Let)) {
                declaration.methods.push(nativeProperty(previous().line));
            } else {
                error(current().line, "Expected 'function', 'let' or 'operator' after 'native'");
            }
        } else if (at(TT.Function)) {
            declaration.methods.push(functionDeclaration(false, true));
        } else {
            error(current().line, "Expected 'native function', 'native operator' or 'function' inside native type");
        }
    }
    expect(TT.RBrace, "Expected '}' to close native type body");
    optional(TT.Semi);
    return declaration;
}

/** (after `native function`) NAME parameters [ : Type ] [ in lives ] [ throws Type ] [ = expression ] ; */
function nativeFunction(line: int32): FunctionDecl {
    let name: Token = expect(TT.Ident, "Expected function name");
    let declaration: FunctionDecl = FunctionDecl { line, name: name.text, ret: typeNamed("void", name.line) } in default;
    declaration.params = parameters();
    if (optional(TT.Colon)) { declaration.ret = type(); }
    if (optional(TT.In)) { declaration.returnLives = lives(); }
    if (optional(TT.Throws)) { declaration.throwsType = type(); }
    if (optional(TT.Assign)) {
        let value: Expr = expression();
        if (declaration.ret.kind == TK.Named && declaration.ret.name == "void") {
            declaration.body.push(ExprStmt { line, expr: value } in default);
        } else {
            declaration.body.push(ReturnStmt { line, value } in default);
        }
        declaration.hasBody = true;
    }
    expect(TT.Semi, "Expected ';' after native function");
    return declaration;
}

/**
 * (after `native let`) NAME : Type [ = expression ] ;
 *
 * A value read without parentheses and never assigned (s.length). Without `= expression` the compiler
 * gives it; with it, it is that expression.
 */
function nativeProperty(line: int32): FunctionDecl {
    let name: Token = expect(TT.Ident, "Expected a name after 'native let'");
    expect(TT.Colon, "Expected ':' and the type after 'native let ${name.text}'");
    let declaration: FunctionDecl = FunctionDecl { line, name: name.text, ret: type(), isProperty: true } in default;
    if (optional(TT.Assign)) {
        declaration.body.push(ReturnStmt { line, value: expression() } in default);
        declaration.hasBody = true;
    }
    expect(TT.Semi, "Expected ';' after native let");
    return declaration;
}

/** (after `native operator`) ( [ ] | SYMBOL ) parameters : Type ; */
function nativeOperator(line: int32): FunctionDecl {
    let name: String = "";
    if (optional(TT.LBracket)) {
        expect(TT.RBracket, "Expected ']' after '[' in native operator");
        name = "[]";
    } else {
        name = advance().text;
    }
    let declaration: FunctionDecl = FunctionDecl { line, name, isOperator: true, params: parameters(), ret: typeNamed("void", line) } in default;
    expect(TT.Colon, "Native operators must declare their return type");
    declaration.ret = type();
    expect(TT.Semi, "Expected ';' after native operator");
    return declaration;
}

/** (after `enum`) NAME { [ variant ( , variant )* [ , ] ] }      variant: NAME [ parameters ] */
function enumDeclaration(): EnumDecl {
    let name: Token = expect(TT.Ident, "Expected enum name");
    let declaration: EnumDecl = EnumDecl { line: name.line, name: name.text } in default;
    expect(TT.LBrace, "Expected '{' to open enum body");
    looseList(TT.RBrace, () -> {
        let variantName: Token = expect(TT.Ident, "Expected variant name");
        let variant: EnumVariant = EnumVariant { line: variantName.line, name: variantName.text } in default;
        if (at(TT.LParen)) {
            variant.hasPayload = true;
            variant.fields = parameters();
        }
        declaration.variants.push(variant);
    });
    expect(TT.RBrace, "Expected '}' to close enum body (variants are separated by commas)");
    optional(TT.Semi);
    return declaration;
}

/** let NAME : Type [ = expression ] ; */
function field(): FieldDecl {
    expect(TT.Let, "Expected 'let'");
    let name: Token = expect(TT.Ident, "Expected field name");
    expect(TT.Colon, "Expected ':' and a type after field '${name.text}'");
    let declaration: FieldDecl = FieldDecl { line: name.line, name: name.text, type: type() } in default;
    if (optional(TT.Assign)) { declaration.defaultValue = expression(); }
    expect(TT.Semi, "Expected ';' after field declaration");
    return declaration;
}

// =========================================================================================
// Types
// =========================================================================================

/**
 * ( qualified NAME | ( Type ) | ( [ Type ( , Type )* ] ) -> Type ) suffix*
 *     suffix: [ ] | [ * ] | [ expression ] | ? | *          and after a function type: [ thread safe ]
 */
function type(): TypeRef {
    let start: Token = current();
    let base: TypeRef = TypeRef { line: start.line, kind: TK.Named } in default;
    if (optional(TT.LParen)) {
        let parameterTypes: TypeRef[*] = [] in default;
        strictList(TT.RParen, () -> { parameterTypes.push(type()); });
        expect(TT.RParen, "Expected ')' in type");
        if (optional(TT.Arrow)) {              // suffixes after a function type belong to its return type
            return threadSafe(TypeRef { line: start.line, kind: TK.Func, params: parameterTypes, inner: type() } in default);
        }
        if (parameterTypes.length != 1) {
            error(start.line, "Expected '->' after the parameters of a function type");
            return base;
        }
        base = parameterTypes[0];
    } else {
        let line: int32 = current().line;
        base = typeNamed(qualifiedName("Expected a type"), line);
    }
    while (!hasFailed()) {
        if (optional(TT.LBracket)) {
            let line: int32 = previous().line;
            if (optional(TT.RBracket)) {
                base = TypeRef { line, kind: TK.Infer, inner: base } in default;
            } else if (at(TT.Star) && next().kind == TT.RBracket) {
                advance();
                advance();
                base = TypeRef { line, kind: TK.Growable, inner: base } in default;
            } else {
                base = TypeRef { line, kind: TK.Fixed, inner: base, size: coalesce() } in default;
                expect(TT.RBracket, "Expected ']' after array capacity");
            }
        } else if (at(TT.Question) && (!readingCastType || optionalFollows(next().kind))) {
            advance();
            base = TypeRef { line: previous().line, kind: TK.Opt, inner: base } in default;
        } else if (at(TT.Star) && (!readingCastType || optionalFollows(next().kind) || next().kind == TT.Star)) {
            advance();                     // T*: a C pointer (after `as`, only where a type can end: x as T* ; not x as T * 2)
            base = TypeRef { line: previous().line, kind: TK.Ptr, inner: base } in default;
        } else {
            return base.kind == TK.Func ? threadSafe(base) : base;      // ((A) -> B) thread safe
        }
    }
    return base;
}

/**
 * [ thread safe ] after a function type: other threads may call it at the same time. Two words, like
 * `wait until`; neither is reserved. With function types inside function types it goes to the nearest
 * one on its left; parentheses choose another: ((A) -> (B) -> C) thread safe.
 */
function threadSafe(functionType: TypeRef in default): TypeRef {
    if (optionalWords("thread", "safe")) {
        if (functionType.threadSafe) {
            error(previous().line, "'thread safe' is written once.");
        } else {
            functionType.threadSafe = true;
        }
    }
    return functionType;
}

// =========================================================================================
// Statements
// =========================================================================================

/** let NAME : Type [ = expression ] ; */
function variable(): VarDecl {
    let keyword: Token = expect(TT.Let, "Expected 'let'");
    let name: Token = expect(TT.Ident, "Expected variable name");
    expect(TT.Colon, "Expected ':' and a type after variable '${name.text}'");
    let declaration: VarDecl = VarDecl { line: keyword.line, name: name.text, type: type() } in default;
    if (optional(TT.Assign)) { declaration.init = expression(); }
    expect(TT.Semi, "Expected ';' after variable declaration");
    return declaration;
}

/** { statement* } */
function block(what: String): Stmt[*] {
    expect(TT.LBrace, "Expected '{' to open ${what}");
    let statements: Stmt[*] = [] in default;
    while (!at(TT.RBrace) && !atEnd()) { statements.push(statement()); }
    expect(TT.RBrace, "Expected '}' to close ${what}");
    return statements;
}

/**
 * let ... | return [ expression ] ; | if ... | while ( expression ) block | for ... | break ; | continue ; |
 * throw expression ; | yield expression ; | try ... | #when ... | block | switch ... | assignment or call
 */
function statement(): Stmt {
    let start: Token = current();
    let line: int32 = start.line;
    return switch (start.kind) {
        case Let -> variable();
        case Const -> misplaced(start, "Constants are declared at top level");
        case Function -> misplaced(start, "Functions are declared at top level or in a class; use a lambda inside a body");
        case Return -> {
            advance();
            let statement: ReturnStmt = ReturnStmt { line } in default;
            if (!at(TT.Semi)) { statement.value = expression(); }
            expect(TT.Semi, "Expected ';' after return");
            yield statement;
        }
        case If -> {
            advance();
            yield ifStatement(line);
        }
        case While -> {
            advance();
            expect(TT.LParen, "Expected '(' after 'while'");
            let condition: Expr = expression();
            expect(TT.RParen, "Expected ')' after while condition");
            yield WhileStmt { line, cond: condition, body: block("while body") } in default;
        }
        case For -> {
            advance();
            yield forStatement(line);
        }
        case Break, Continue -> {
            advance();
            expect(TT.Semi, "Expected ';' after ${start.text}");
            yield start.kind == TT.Break ? (BreakStmt { line } in default) : (ContinueStmt { line } in default);
        }
        case Throw -> {
            advance();
            let value: Expr = expression();
            expect(TT.Semi, "Expected ';' after throw");
            yield ThrowStmt { line, value } in default;
        }
        case Yield -> {
            advance();
            let value: Expr = expression();
            expect(TT.Semi, "Expected ';' after yield");
            yield YieldStmt { line, value } in default;
        }
        case Try -> {
            advance();
            yield tryStatement(line);
        }
        case HashWhen -> platformStatements();
        case HashElse -> misplaced(advance(), "'#else' does not line up with an open '#when' above it (the same column), or there is none");
        case HashEnd -> misplaced(advance(), "'#end' does not line up with an open '#when' above it (the same column), or there is none");
        case LBrace -> BlockStmt { line, body: block("block") } in default;
        case Switch -> {
            advance();
            let switchExpression: SwitchExpr = switchExpression(line);
            optional(TT.Semi);
            yield SwitchStmt { line, switchExpr: switchExpression } in default;
        }
        default -> assignmentOrCall(line);
    };
}

/** expression [ ( = | += | -= | ... ) expression ] ;      (a += b is a = a + b) */
function assignmentOrCall(line: int32): Stmt {
    let target: Expr = expression();
    let statement: Stmt = ExprStmt { line, expr: target } in default;
    let what: String = "expression";
    if (optional(TT.Assign)) {
        statement = AssignStmt { line, target, value: expression() } in default;
        what = "assignment";
    } else if (optional(TT.OpAssign)) {
        let operatorToken: Token = previous();
        let value: Expr = Binary { line: operatorToken.line, op: operatorToken.text, left: target, right: expression() } in default;
        statement = AssignStmt { line, target, value } in default;
        what = "assignment";
    }
    expect(TT.Semi, "Expected ';' after ${what}");
    return statement;
}

/** Something that does not go here: the error, and an empty statement. */
function misplaced(token: Token, message: String): Stmt {
    error(token.line, message);
    return BlockStmt { line: token.line } in default;
}

/** (after `if`) ( expression ) block [ else ( if ... | block ) ] */
function ifStatement(line: int32): IfStmt {
    expect(TT.LParen, "Expected '(' after 'if'");
    let condition: Expr = expression();
    expect(TT.RParen, "Expected ')' after if condition");
    let statement: IfStmt = IfStmt { line, cond: condition, thenBody: block("if body") } in default;
    if (optional(TT.Else)) {
        statement.hasElse = true;
        if (at(TT.If)) {
            statement.elseBody.push(ifStatement(advance().line));
        } else {
            statement.elseBody = block("else body");
        }
    }
    return statement;
}

/**
 * #when PLATFORM statement* ( #when PLATFORM statement* )* [ #else statement* ] #end
 *
 * The platform is chosen when the C is compiled. No braces and no block: the statements belong to the
 * block around, like the lines of C's #if. The directives of one choice start at the same column.
 */
function platformStatements(): IfStmt {
    let opening: Token = current();
    let column: int64 = opening.num;
    let platforms: String[*] = [] in default;
    let platformLines: int32[*] = [] in default;
    let first: IfStmt? = null;
    let last: IfStmt? = null;
    while (at(TT.HashWhen) && current().num == column) {
        let directive: Token = advance();
        let platform: String = directivePlatform(directive, platforms, platformLines);
        platforms.push(platform);
        platformLines.push(directive.line);
        let branch: IfStmt = IfStmt { line: directive.line, cond: BoolLit { line: directive.line, value: true } in default, platform, chained: first != null } in default;
        branch.thenBody = directiveBody(column);
        if (last == null) {
            first = branch;
        } else {
            last.hasElse = true;
            last.elseBody.push(branch);
        }
        last = branch;
    }
    if (at(TT.HashElse) && current().num == column) {
        advance();
        last!.hasElse = true;
        last!.elseBody = directiveBody(column);
    }
    if (atDirective() && current().num != column) {
        error(current().line, "'${directiveText(current())}' does not line up with its '#when' (line ${opening.line % 1000000}): #when, #else and #end of one choice start at the same column");
    }
    expect(TT.HashEnd, "Expected '#end' to close the '#when' of line ${opening.line % 1000000}");
    return first!;
}

/** The statements up to the next #when, #else or #end at `column` or before (a deeper #when is nested). */
function directiveBody(column: int64): Stmt[*] {
    let statements: Stmt[*] = [] in default;
    while (!(atDirective() && current().num <= column) && !at(TT.RBrace) && !atEnd() && !hasFailed()) {
        statements.push(statement());
    }
    return statements;
}

/** (after `for`) ( [ NAME , ] NAME in expression [ .. expression ] ) block */
function forStatement(line: int32): ForStmt {
    expect(TT.LParen, "Expected '(' after 'for'");
    let firstName: String = expect(TT.Ident, "Expected loop variable").text;
    let indexName: String = "";
    let valueName: String = firstName;
    if (optional(TT.Comma)) {
        indexName = firstName;
        valueName = expect(TT.Ident, "Expected value variable after ','").text;
    }
    expect(TT.In, "Expected 'in' in for loop");
    let loop: ForStmt = ForStmt { line, indexName, varName: valueName, iterable: expression() } in default;
    if (optional(TT.DotDot)) { loop.rangeEnd = coalesce(); }
    expect(TT.RParen, "Expected ')' after for header");
    loop.body = block("for body");
    if (loop.indexName != "" && loop.rangeEnd != null) { error(line, "A range loop has a single variable: for (i in a..b)"); }
    return loop;
}

/** (after `try`) block ( catch ( qualified NAME NAME ) block )+ */
function tryStatement(line: int32): TryStmt {
    let statement: TryStmt = TryStmt { line, body: block("try body") } in default;
    while (at(TT.Catch)) {
        let catchToken: Token = advance();
        expect(TT.LParen, "Expected '(' after 'catch'");
        let typeName: String = qualifiedName("Expected the error type in catch");
        let variableName: String = expect(TT.Ident, "Expected a variable name after the error type").text;
        expect(TT.RParen, "Expected ')' after catch");
        statement.catches.push(CatchClause { line: catchToken.line, typeName, varName: variableName, body: block("catch body") } in default);
    }
    if (statement.catches.length == 0) { error(line, "A 'try' needs at least one 'catch'"); }
    return statement;
}

// =========================================================================================
// Expressions, from the lowest precedence to the highest
// =========================================================================================

/** ternary [ in ( heap | default | byte[N] | expression ) ]: where a created value lives */
function expression(): Expr {
    let value: Expr = ternary();
    if (!optional(TT.In)) { return value; }
    let line: int32 = previous().line;
    if (optional(TT.Heap)) { return Placed { line, expr: value, mode: PL_HEAP } in default; }
    if (optional(TT.Default)) { return Placed { line, expr: value, mode: PL_DEFAULT } in default; }
    if (atWord("byte") && next().kind == TT.LBracket) {
        return Placed { line, expr: value, mode: PL_STACK, buffer: type() } in default;
    }
    return Placed { line, expr: value, mode: PL_MEMORY, memory: coalesce() } in default;
}

/** coalesce [ ? ternary : ternary ]      (right to left) */
function ternary(): Expr {
    let condition: Expr = coalesce();
    if (!optional(TT.Question)) { return condition; }
    let line: int32 = previous().line;
    let then: Expr = ternary();
    expect(TT.Colon, "Expected ':' in the conditional expression (condition ? a : b)");
    return Ternary { line, cond: condition, then, otherwise: ternary() } in default;
}

/** binary operators [ ?? coalesce ] */
function coalesce(): Expr {
    let left: Expr = binaryFrom(1);
    if (!optional(TT.QQ)) { return left; }
    let line: int32 = previous().line;
    return binary("??", left, coalesce(), line);
}

/**
 * The level of a binary operator, from the loosest (1) to the tightest; 0: not one.
 *     ||   &&   == != < <= > >= (and `is`)   |   ^   &   << >>   + -   * / %
 */
function level(kind: TT): int32 {
    return switch (kind) {
        case Or -> 1;
        case And -> 2;
        case Eq, Ne, Lt, Le, Gt, Ge -> 3;
        case Pipe -> 4;
        case Caret -> 5;
        case Amp -> 6;
        case Shl, Shr -> 7;
        case Plus, Minus -> 8;
        case Star, Slash, Percent -> 9;
        default -> 0;
    };
}

/**
 * cast ( OPERATOR cast ... | is qualified NAME [ NAME ] )*: the operators of level `minimum` or tighter,
 * each one left-associative (precedence climbing: the right side takes only tighter operators).
 */
function binaryFrom(minimum: int32): Expr {
    let left: Expr = cast();
    while (!hasFailed()) {
        if (minimum <= 3 && optional(TT.Is)) {             // x is Dog, x is Dog d: a comparison
            let line: int32 = previous().line;
            let typeName: String = expect(TT.Ident, "Expected a class name after 'is'").text;
            while (optional(TT.Dot)) { typeName = "${typeName}.${expect(TT.Ident, "Expected a name after '.'").text}" in default; }
            left = IsExpr { line, expr: left, typeName, binding: at(TT.Ident) ? advance().text : "" } in default;
            continue;
        }
        let tight: int32 = level(current().kind);
        if (tight == 0 || tight < minimum) { break; }
        let operatorToken: Token = advance();
        left = binary(operatorToken.text, left, binaryFrom(tight + 1), operatorToken.line);
    }
    return left;
}

/** unary ( as Type )* */
function cast(): Expr {
    let value: Expr = unary();
    while (optional(TT.As)) {
        let line: int32 = previous().line;
        let wasReadingCastType: bool = readingCastType;
        readingCastType = true;
        let castType: TypeRef = type();
        readingCastType = wasReadingCastType;
        value = Cast { line, expr: value, type: castType } in default;
    }
    return value;
}

/** ( - | ! | ~ | & ) unary | postfix */
function unary(): Expr {
    if (!(at(TT.Minus) || at(TT.Not) || at(TT.Tilde) || at(TT.Amp))) { return postfix(); }
    let operatorToken: Token = advance();
    return Unary { line: operatorToken.line, op: operatorToken.text, operand: unary() } in default;
}

/** primary ( ( arguments ) | . NAME | . NAME { fields } | [ expression ] | ! )* */
function postfix(): Expr {
    let value: Expr = primary();
    while (!hasFailed()) {
        if (optional(TT.LParen)) {
            let call: Call = Call { line: previous().line, callee: value } in default;
            strictList(TT.RParen, () -> { call.args.push(expression()); });
            expect(TT.RParen, "Expected ')' after arguments");
            value = call;
        } else if (optional(TT.Dot)) {
            let name: Token = expect(TT.Ident, "Expected a name after '.'");
            let path: String = dottedPath(value);
            if (path != "" && at(TT.LBrace)) {        // Enum.Variant { field: value }, module.Type { ... }
                value = objectLiteral("${path}.${name.text}" in default, name.line);
            } else {
                value = Member { line: name.line, object: value, name: name.text } in default;
            }
        } else if (optional(TT.ColonColon)) {
            value = methodReference(value);
        } else if (optional(TT.LBracket)) {
            let line: int32 = previous().line;
            value = Index { line, object: value, index: expression() } in default;
            expect(TT.RBracket, "Expected ']' after index");
        } else if (at(TT.Not)) {
            value = Unwrap { line: advance().line, expr: value } in default;
        } else {
            return value;
        }
    }
    return value;
}

/**
 * Module::function, variable::method, self::method: a lambda that calls it with its own parameters. The
 * parameters come from the function type expected there (the analyzer adds them).
 */
function methodReference(target: Expr in default): Expr {
    let name: Token = expect(TT.Ident, "Expected a function or method name after '::'");
    if (!(target is Ident || target is SelfExpr || dottedPath(target) != "")) {
        error(name.line, "'::' goes after a module, a variable or 'self' (like Pages::show or panel::create)");
    }
    return referenceLambda(Member { line: name.line, object: target, name: name.text } in default);
}

/** The lambda of a reference: its body calls `callee` (the analyzer adds the parameters). */
function referenceLambda(callee: Expr in default): Lambda {
    let call: Call = Call { line: callee.line, callee } in default;
    return Lambda { line: callee.line, body: [ReturnStmt { line: callee.line, value: call } in default], ref: call } in default;
}

/**
 * NUMBER | "TEXT" | true | false | null | self | super . NAME | { fields } | [ expressions ] | switch ... |
 * NAME [ { fields } ] | lambda | ( expression )
 */
function primary(): Expr {
    let start: Token = current();
    let line: int32 = start.line;
    if (optional(TT.Int)) { return IntLit { line, num: start.num, big: start.big, huge: start.huge, text: start.text } in default; }
    if (optional(TT.Float)) { return FloatLit { line, text: start.text } in default; }
    if (optional(TT.Str)) { return string(start); }
    if (optional(TT.True) || optional(TT.False)) { return BoolLit { line, value: start.kind == TT.True } in default; }
    if (optional(TT.Null)) { return NullLit { line } in default; }
    if (optional(TT.Self)) { return SelfExpr { line } in default; }
    if (optional(TT.ColonColon)) {             // ::name: a function of this module
        let name: Token = expect(TT.Ident, "Expected a function name after '::'");
        return referenceLambda(Ident { line: name.line, name: name.text } in default);
    }
    if (optional(TT.Super)) {
        expect(TT.Dot, "Expected '.' after 'super'");
        let name: Token = expect(TT.Ident, "Expected method name after 'super.'");
        return SuperMember { line: name.line, name: name.text } in default;
    }
    if (optional(TT.New)) {
        let className: String = at(TT.Ident) ? qualifiedName("") : "Type";
        error(line, "Larimar creates objects without 'new': write ${className} { field: value } in memory");
        return NullLit { line } in default;
    }
    if (at(TT.LBrace)) { return objectLiteral("", line); }
    if (optional(TT.LBracket)) {
        let array: ArrayLit = ArrayLit { line } in default;
        while (!at(TT.RBracket)) {                   // a trailing comma is fine
            array.elems.push(expression());
            if (!optional(TT.Comma)) { break; }
        }
        expect(TT.RBracket, "Expected ']' to close array literal");
        return array;
    }
    if (optional(TT.Switch)) { return switchExpression(line); }
    if (optional(TT.Ident)) { return at(TT.LBrace) ? objectLiteral(start.text, line) : (Ident { line, name: start.text } in default); }
    if (at(TT.LParen)) {
        if (lambdaAhead()) { return lambda(); }
        advance();
        let inner: Expr = expression();
        expect(TT.RParen, "Expected ')'");
        return inner;
    }
    error(line, "Unexpected '${start.text}' in expression");
    return NullLit { line } in default;
}

/** { [ field ( , field )* [ , ] ] }      field: NAME : expression | NAME | expression */
function objectLiteral(typeName: String in default, line: int32): ObjectLit {
    let literal: ObjectLit = ObjectLit { line, typeName } in default;
    expect(TT.LBrace, "Expected '{' to open object literal");
    looseList(TT.RBrace, () -> {
        let start: Token = current();
        if (at(TT.Ident) && next().kind == TT.Colon) {                  // name: value
            advance();
            advance();
            literal.fields.push(FieldInit { line: start.line, name: start.text, value: expression() } in default);
        } else if (at(TT.Ident) && (next().kind == TT.Comma || next().kind == TT.RBrace)) {
            advance();                                                         // { x } = { x: x }
            literal.fields.push(FieldInit { line: start.line, name: start.text, shorthand: true, value: Ident { line: start.line, name: start.text } in default } in default);
        } else {
            literal.fields.push(FieldInit { line: start.line, value: expression() } in default);    // positional (Any)
        }
    });
    expect(TT.RBrace, "Expected '}' to close object literal");
    return literal;
}

/** Is a lambda next: ( ... ) followed by -> ? */
function lambdaAhead(): bool {
    let depth: int32 = 0;
    let i: int32 = position;
    while (i < tokens.length) {
        let kind: TT = tokens[i].kind;
        if (kind == TT.LParen) {
            depth += 1;
        } else if (kind == TT.RParen) {
            depth -= 1;
            if (depth == 0) { return i + 1 < tokens.length && tokens[i + 1].kind == TT.Arrow; }
        } else if (kind == TT.Eof) {
            return false;
        }
        i += 1;
    }
    return false;
}

/** ( [ parameter ( , parameter )* ] ) -> block */
function lambda(): Lambda {
    let lambda: Lambda = Lambda { line: expect(TT.LParen, "Expected '('").line } in default;
    strictList(TT.RParen, () -> { lambda.params.push(parameter(false)); });
    expect(TT.RParen, "Expected ')' after lambda parameters");
    expect(TT.Arrow, "Expected '->' after lambda parameters");
    lambda.body = block("lambda body");
    return lambda;
}

/**
 * (after `switch`) ( expression ) { case* }
 *     case: ( case pattern ( , pattern )* | default ) [ when expression ] -> ( block | throw expression ; | expression ; )
 */
function switchExpression(line: int32): SwitchExpr {
    expect(TT.LParen, "Expected '(' after 'switch'");
    let switchNode: SwitchExpr = SwitchExpr { line, subject: expression() } in default;
    expect(TT.RParen, "Expected ')' after switch subject");
    expect(TT.LBrace, "Expected '{' to open switch");
    while (!at(TT.RBrace) && !atEnd()) {
        let caseToken: Token = current();
        let switchCase: SwitchCase = SwitchCase { line: caseToken.line } in default;
        if (optional(TT.Default)) {
            switchCase.isDefault = true;
        } else {
            expect(TT.Case, "Expected 'case' or 'default' in switch");
            while (true) {
                switchCase.patterns.push(pattern());
                if (!optional(TT.Comma)) { break; }
            }
        }
        if (optional(TT.When)) {
            if (switchCase.isDefault) { error(caseToken.line, "'default' cannot have a 'when' condition"); }
            switchCase.guard = expression();
        }
        expect(TT.Arrow, "Expected '->' after the case (this switch uses arrows, like Java)");
        if (at(TT.LBrace)) {
            switchCase.hasBlock = true;
            switchCase.block = block("case body");
        } else if (at(TT.Throw)) {
            let throwToken: Token = advance();
            switchCase.throwStmt = ThrowStmt { line: throwToken.line, value: expression() } in default;
            expect(TT.Semi, "Expected ';' after throw");
        } else {
            switchCase.expr = expression();
            expect(TT.Semi, "Expected ';' after the case value");
        }
        switchNode.cases.push(switchCase);
    }
    expect(TT.RBrace, "Expected '}' to close switch");
    return switchNode;
}

/**
 * null | constant | qualified NAME [ NAME ] | qualified NAME { [ NAME [ : NAME ] ( , ... )* ] } [ NAME ]
 *     (a value, a type with its binding, or an enum variant with its fields)
 */
function pattern(): Pattern {
    let start: Token = current();
    if (optional(TT.Null)) { return Pattern { line: start.line, kind: PT_NULL } in default; }
    if (at(TT.Int) || at(TT.Float) || at(TT.Str) || at(TT.True) || at(TT.False) || at(TT.Minus)) {
        return Pattern { line: start.line, kind: PT_CONSTANT, constant: unary() } in default;
    }
    let pattern: Pattern = Pattern { line: start.line, kind: PT_NAME, name: qualifiedName("Expected a pattern (a value, an enum variant or a type)") } in default;
    if (at(TT.LParen)) {
        error(pattern.line, "Patterns take their fields by name with braces: case ${pattern.name} { campo } or case ${pattern.name} { campo: nombre }");
        return pattern;
    }
    if (optional(TT.LBrace)) {
        pattern.kind = PT_DESTRUCTURE;
        looseList(TT.RBrace, () -> {
            let fieldName: String = expect(TT.Ident, "Expected a field name").text;
            pattern.fields.push(fieldName);
            pattern.bindings.push(optional(TT.Colon) ? expect(TT.Ident, "Expected a name after ':'").text : fieldName);
        });
        expect(TT.RBrace, "Expected '}' after the fields of the pattern");
        if (at(TT.Ident)) { pattern.binding = advance().text; }
    } else if (at(TT.Ident)) {
        pattern.kind = PT_TYPE;
        pattern.binding = advance().text;
    }
    return pattern;
}

/** "Hello ${name}": the texts, and the parsed expressions between them. */
function string(token: Token in default): StringLit {
    let literal: StringLit = StringLit { line: token.line } in default;
    let raw: String = token.text;
    let textStart: int32 = 0;
    let line: int32 = token.line;
    let i: int32 = 0;
    while (i < raw.length && !hasFailed()) {
        let character: byte = raw[i];
        if (character == '\\' && i + 1 < raw.length) {
            i += 2;
        } else if (character == '$' && i + 1 < raw.length && raw[i + 1] == '{') {
            let closing: int32 = interpolationEnd(raw, i + 1);
            let inner: String = raw.substring(i + 2, closing);
            if (inner.isBlank()) {
                error(line, "Empty '\${}' in string");
                return literal;
            }
            literal.texts.push(raw.substring(textStart, i));
            literal.exprs.push(interpolation(inner, line));
            let k: int32 = i;
            while (k <= closing && k < raw.length) {
                if (raw[k] == '\n') { line += 1; }
                k += 1;
            }
            i = closing + 1;
            textStart = i;
        } else {
            if (character == '\n') { line += 1; }
            i += 1;
        }
    }
    literal.texts.push(raw.substring(textStart));
    return literal;
}

/** The expression inside ${...}: its own tokens, read with this parser, then back to the string's. */
function interpolation(inner: String in default, line: int32): Expr {
    let savedTokens: Token[*] = tokens;
    let savedPosition: int32 = position;
    let lexer: Lexer = { src: inner, line } in default;
    lexer.run();
    tokens = lexer.toks;
    position = 0;
    let value: Expr = NullLit { line } in default;
    if (lexer.error != "") {
        if (parseError == "") { parseError = lexer.error; }
    } else {
        value = expression();
        if (!atEnd()) { error(line, "Unexpected '${current().text}' inside '\${...}'"); }
    }
    tokens = savedTokens;
    position = savedPosition;
    return value;
}

// =========================================================================================
// Helpers that need no parser
// =========================================================================================

function binary(operatorText: String in default, left: Expr in default, right: Expr in default, line: int32): Expr {
    return Binary { line, op: operatorText, left, right } in default;
}

/**
 * wait until (cond): the body starts with `while (!(cond)) { self.__wait(); }`. The lock is held when
 * the body starts; __wait (a name no program can write) lets it go while waiting, and every method of
 * the object that ends wakes the waiters to look at their condition again.
 */
function waitFirst(line: int32, condition: Expr in default, body: Stmt[*] in default): Stmt[*] {
    let wait: Expr = Call { line, callee: Member { line, object: SelfExpr { line } in default, name: "__wait" } in default } in default;
    let loop: Stmt = WhileStmt { line, cond: Unary { line, op: "!", operand: condition, waitUntil: true } in default, body: [ExprStmt { line, expr: wait } in default] } in default;
    let statements: Stmt[*] = [loop] in default;
    for (statement in body) { statements.push(statement); }
    return statements;
}

/**
 * After `as T`, a '?' makes T optional only when what follows can come after a type (x as int64? ?? 0,
 * (x as T?), x as T?;). Followed by the start of an expression it is a ternary: x as int64 ? a : b.
 */
function optionalFollows(next: TT): bool {
    switch (next) {
        case RParen, Semi, Comma, RBracket, RBrace, LBracket, QQ, Eq, Ne, Colon, As, Is, And, Or, In, Question, Eof -> { return true; }
        default -> { return false; }
    }
}

/** a, a.b, a.b.c (only names), or "". */
function dottedPath(value: Expr): String {
    if (value is Ident identifier) { return identifier.name; }
    if (value is Member member) {
        let path: String = dottedPath(member.object);
        if (path != "") { return "${path}.${member.name}"; }
    }
    return "";
}

function directiveText(token: Token): String {
    return switch (token.kind) {
        case HashWhen -> "#when ${token.text}";
        case HashElse -> "#else";
        default -> "#end";
    };
}

/** Where the ${ that starts at `open` (the '{') closes: its '}' (strings inside are skipped). */
function interpolationEnd(raw: String, open: int32): int32 {
    let depth: int32 = 0;
    let j: int32 = open;
    while (j < raw.length) {
        let character: byte = raw[j];
        if (character == '"') {
            j += 1;
            while (j < raw.length && raw[j] != '"') {
                if (raw[j] == '\\') { j += 1; }
                j += 1;
            }
        } else if (character == '{') {
            depth += 1;
        } else if (character == '}') {
            depth -= 1;
            if (depth == 0) { return j; }
        }
        j += 1;
    }
    return j;
}
