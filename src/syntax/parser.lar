// syntax.parser: tokens -> syntax tree.
//
// A recursive descent parser. Parser holds what is being read (the tokens, where it is, the first
// error) and reads them one by one; the constructions of the language are functions over it, in the
// modules of syntax/parser/: declarations, natives (what comes from C), types, statements, expressions.
// Each reads one construction, and the comment above it shows its form, in this notation:
//
//   word        that word (a keyword or a symbol)          [ x ]     x, optionally
//   NAME        an identifier                              x*        x, any number of times
//   x | y       x or y                                     ( ... )   grouping
//
// The first syntax error is kept; after it every token reads as the end of the file, so the parser
// unwinds quickly and its result is thrown away.

import syntax.ast { declName, FunctionDecl, Ident, ImportDecl, Node, Program };
import syntax.lexer { Lexer, Token, TT };
import syntax.parser.declarations { topLevelDeclaration };

/** The tree of one source file; its `error` is the first lexical or syntax error. `startLine`: the number of its first line (it also says the file). */
public function parseProgram(source: String in default, startLine: int32): Program {
    let lexer: Lexer = { src: source, line: startLine } in default;
    lexer.run();
    let p: Parser = Parser { tokens: lexer.toks, failed: lexer.error } in default;
    let tree: Program = program(p, startLine);
    tree.error = p.failed;
    return tree;
}

/** What the parser reads past the last token. */
let endOfFile: Token = Token { kind: TT.Eof, text: "", line: 0 } in default;

/** The tokens of a source text, read one by one. */
public class Parser {
    let tokens: Token[*];
    let position: int32 = 0;                    // of the next token
    let failed: String = "";                    // the first error, lexical or of syntax ("" when there is none)
    let waitUntilAllowed: bool = false;         // reading the methods of a synchronized class: they may say `wait until (condition)`
    let readingCastType: bool = false;          // reading the type after `as`: there a '?' may be the ternary's (n > MAX as int64 ? a : b)
    let parsingExport: bool = false;            // reading an export function
    let cOwner: String = "";                    // the class being read ("" outside one): what its cinclude, ccode and C bodies belong to
    let staticFunctions: FunctionDecl[*] = [];  // written inside a type: they become top-level `function Type.name` declarations
    let nativeParts: Node[*] = [];              // what a type also declares at the top level: its C functions, its cinclude and ccode

    function error(line: int32, message: String): void {
        if (self.failed == "") { self.failed = "Syntax Error [Line ${line}]: ${message}" in default; }
    }

    function hasFailed(): bool { return self.failed != ""; }

    /** The token to read next. */
    function current(): Token {
        return self.hasFailed() || self.position >= self.tokens.length ? endOfFile : self.tokens[self.position];
    }

    /** The token after the current one. */
    function next(): Token {
        if (self.hasFailed()) { return endOfFile; }
        return self.position + 1 < self.tokens.length ? self.tokens[self.position + 1] : self.tokens[self.tokens.length - 1];
    }

    /** The token just read. */
    function previous(): Token { return self.position == 0 ? endOfFile : self.tokens[self.position - 1]; }

    function atEnd(): bool { return self.current().kind == TT.Eof; }

    /** Is the current token of this kind? */
    function at(kind: TT): bool { return !self.atEnd() && self.current().kind == kind; }

    /** Is the current token the identifier `word` (a word with a meaning only there: test, export, type...)? */
    function atWord(word: String): bool { return self.at(TT.Ident) && self.current().text == word; }

    /** Are the next two tokens the identifiers `first` and `second` (wait until, thread safe)? */
    function atWords(first: String, second: String): bool {
        return self.atWord(first) && self.next().kind == TT.Ident && self.next().text == second;
    }

    /** Reads the current token and gives it. */
    function advance(): Token {
        if (!self.atEnd()) { self.position += 1; }
        return self.previous();
    }

    /** [ kind ]: reads the token when it is of this kind, and says whether it was. */
    function optional(kind: TT): bool {
        if (!self.at(kind)) { return false; }
        self.advance();
        return true;
    }

    /** [ first second ]: reads the two words when they come, and says whether they did. */
    function optionalWords(first: String, second: String): bool {
        if (!self.atWords(first, second)) { return false; }
        self.advance();
        self.advance();
        return true;
    }

    /** kind: reads the token, which must be of this kind (else the error says what came instead). */
    function expect(kind: TT, message: String): Token {
        if (self.at(kind)) { return self.advance(); }
        self.error(self.current().line, "${message} (got '${self.current().text}')");
        return endOfFile;
    }
}

// ---- what every part uses -----------------------------------------------------------------------

/** The node, after its ';'. */
public function endedBySemicolon(p: Parser in default, node: Node, what: String): Node {
    p.expect(TT.Semi, "Expected ';' after ${what}");
    return node;
}

/** NAME ( . NAME )* */
public function qualifiedName(p: Parser in default, message: String): String {
    let name: String = p.expect(TT.Ident, message).text;
    while (p.at(TT.Dot) && p.next().kind == TT.Ident) {
        p.advance();
        name = "${name}.${p.advance().text}" in default;
    }
    return name;
}

/** [ item ( , item )* ] before `close` (which is not read). */
public function strictList(p: Parser in default, close: TT, readItem: () -> void): void {
    if (p.at(close)) { return; }
    while (true) {
        readItem();
        if (!p.optional(TT.Comma)) { break; }
    }
}

/** Like strictList, but a comma may also end the list. */
public function looseList(p: Parser in default, close: TT, readItem: () -> void): void {
    while (!p.at(close) && !p.atEnd()) {
        readItem();
        if (!p.optional(TT.Comma)) { break; }
    }
}

/** in ( default | self | NAME ): where a parameter or a result lives. */
public function lives(p: Parser in default): String {
    if (p.optional(TT.Default)) { return "default"; }
    if (p.optional(TT.Self)) { return "self"; }
    return p.expect(TT.Ident, "Expected 'default', 'self' or a parameter name after 'in'").text;
}

/** import* ( [public] declaration )* */
function program(p: Parser in default, startLine: int32): Program {
    let program: Program = Program { line: startLine } in default;
    while (!p.atEnd()) {
        if (p.at(TT.Import)) {
            if (program.decls.length > 0) { p.error(p.current().line, "Imports go at the beginning of the file, before any declaration"); }
            program.imports.push(importDeclaration(p));
            continue;
        }
        if (p.at(TT.Private)) {
            p.error(p.current().line, "'private' is not needed: what a module declares is private unless it is marked 'public'");
            p.advance();
        }
        let isPublic: bool = p.optional(TT.Public);
        let start: Token = p.current();
        let declaration: Node = topLevelDeclaration(p);
        if (isPublic && declaration is FunctionDecl testFunction && testFunction.isTest) {
            p.error(start.line, "A test function cannot be 'public': only larimar test calls it");
        } else if (isPublic && declaration is FunctionDecl staticFunction && staticFunction.typeName != "") {
            p.error(start.line, "A static function is visible where its type is: mark the type 'public', not the function");
        } else if (isPublic) {
            let name: String = declName(declaration);
            if (name == "") { p.error(start.line, "Only declarations with a name can be 'public'"); } else { program.publics.push(name); }
        }
        program.decls.push(declaration);
        for (part in p.nativeParts) { program.decls.push(part); }
        p.nativeParts.clear();
        for (staticFunction in p.staticFunctions) { program.decls.push(staticFunction); }
        p.staticFunctions.clear();
    }
    return program;
}

/** import NAME ( . NAME )* [ as NAME | { NAME ( , NAME )* } ] ; */
function importDeclaration(p: Parser in default): ImportDecl {
    let line: int32 = p.expect(TT.Import, "Expected 'import'").line;
    let last: String = p.expect(TT.Ident, "Expected a module name after 'import'").text;
    let path: String = last;
    while (p.optional(TT.Dot)) {
        last = p.expect(TT.Ident, "Expected a name after '.' in the module path").text;
        path = "${path}.${last}" in default;
    }
    let declaration: ImportDecl = ImportDecl { line, path, alias: last } in default;
    if (p.optional(TT.As)) {
        declaration.alias = p.expect(TT.Ident, "Expected a name after 'as'").text;
    } else if (p.optional(TT.LBrace)) {
        declaration.hasNames = true;
        declaration.alias = "";
        looseList(p, TT.RBrace, () -> { declaration.names.push(p.expect(TT.Ident, "Expected a name to import").text); });
        p.expect(TT.RBrace, "Expected '}' after the imported names");
    }
    p.expect(TT.Semi, "Expected ';' after import");
    return declaration;
}
