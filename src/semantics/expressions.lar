// semantics.expressions: semantic analysis (Analyzer.java), part 2: types as written, constants,
// expressions, conversions, calls, switch and patterns.

import syntax.ast {
    ArrayLit, Binary, BoolLit, Call, Cast, Expr, ExternValueDecl, FloatLit, Ident, Index, IntLit, IsExpr, Lambda,
    Member, NullLit, ObjectLit, PL_DEFAULT, PL_HEAP, PL_STACK, Placed, SelfExpr, StringLit, SuperMember, SwitchExpr,
    Ternary, TK, TypeRef, Unary, Unwrap
};
import semantics.types {
    arrayT, ArrK, classOf, Conversion, cTypeOf, EnumInfo, enumOf, externInfoOf, externSig, FieldInfo, findField,
    findMethod, Frame, FrameK, funcT, FunctionInfo, funcTypes, hasThreadSafe, interfaceMethod, interfaceOf,
    isByteArray, isClass, isEnumT, isError, isExternStruct, isExternT, isExternTypeName, isFloat, isInteger,
    isMemory, isNumeric, isOpt, isPrimName, isPtr, isResource, isStruct, maxText, MbK, MemberInfo, MemK, MethodInfo,
    minOf, named, NamedK, nativeMethods, optT, P_GLOBAL, P_TEMP, Place, PlaceK, platformWithin, pointable,
    primByName, ptrT, R_STATIC, rMemory, rStaticMemory, Scope, structField, structMethod, structOf, Symbol, SymK,
    T_ANY, T_BOOL, T_BYTE, T_ERROR, T_FLOAT32, T_FLOAT64, T_INT32, T_INT64, T_NULL, T_STRING, T_VOID, TyK, Type,
    usedTypes, usesAny, VariantInfo, variantOf
};
import semantics.analyzer {
    anyFieldsLoop, declare, error, frame, frames, frameTop, lookup, narrowedType, noteCapture, scope, wrong
};
import semantics.analyzer.compact { platformCtx };
import semantics.analyzer.statements { staticName };
import semantics.analyzer.threads { callTargets, currentOwner, edge, useGlobal };
import semantics.expressions.calls { checkCall, placedResult };
import semantics.expressions.constants { ConstVal, evalSize, intFits, literalValue };
import semantics.expressions.conversions { conv, hasRefs, placeRegion, regionOf, setRegion };
import semantics.expressions.literals { checkArrayLit, checkCast, checkLambda, checkObjectLit };
import semantics.expressions.operators { checkBinary, checkIs, checkTernary, checkUnary, optional };
import semantics.expressions.switches { analyzeSwitch };

public const TC_PARAM: int32 = 0;
public const TC_LET: int32 = 1;
public const TC_OTHER: int32 = 2;

// =====================================================================================
// Types as written
// =====================================================================================

public function resolveTop(t: TypeRef in default, ctx: int32, what: String): Type {
    if (t.kind == TK.Infer) {
        let elem: Type = resolveValue(t.inner!, "An array element");
        if (isError(elem)) { return T_ERROR; }
        if (ctx == TC_PARAM) { return noted(arrayT(elem, ArrK.Slice, 0)); }
        if (ctx == TC_LET) { return arrayT(elem, ArrK.Fixed, -1); }
        return wrong(t.line, "${elem.text}[] (capacity taken from the value) is only valid for parameters and for variables with an initializer.");
    }
    return resolveValue(t, what);
}

public function resolveValue(t: TypeRef in default, what: String): Type {
    let r: Type = resolveType(t);
    return r == T_VOID ? wrong(t.line, "${what} cannot have type void.") : r;
}

public function resolveType(t: TypeRef in default): Type {
    let r: Type = switch (t.kind) {
        case Named -> resolveNamed(t);
        case Func -> {
            let ps: Type[*] = [] in default;
            let bad: bool = false;
            for (p in t.params) {
                let pt: Type = resolveTop(p, TC_PARAM, "A function parameter");      // T[]: a view, as in a parameter
                if (isError(pt)) { bad = true; }
                ps.push(pt);
            }
            let ret: Type = resolveType(t.inner!);
            yield !bad && !isError(ret) ? funcT(ps, ret, t.threadSafe) : T_ERROR;
        }
        case Fixed -> {
            let elem: Type = resolveValue(t.inner!, "An array element");
            let n: int64 = evalSize(t.size!);
            yield !isError(elem) && n >= 0 ? arrayT(elem, ArrK.Fixed, n) : T_ERROR;
        }
        case Growable -> {
            let elem: Type = resolveValue(t.inner!, "A list element");
            yield isError(elem) ? T_ERROR : arrayT(elem, ArrK.Growable, 0);
        }
        case Opt -> {
            let inner: Type = resolveValue(t.inner!, "An optional");
            if (isOpt(inner)) { error(t.line, "A type cannot be optional twice."); }
            if (isPtr(inner)) { yield wrong(t.line, "A C pointer can already be null: write ${inner.text}, not ${inner.text}?."); }
            yield isOpt(inner) || isError(inner) ? T_ERROR : optT(inner);
        }
        case Infer -> wrong(t.line, "T[] (capacity taken from the value) is only valid for parameters and for variables with an initializer.");
        case Ptr -> {
            let inner: Type = resolveValue(t.inner!, "A pointer");
            if (isError(inner)) { yield T_ERROR; }
            if (!pointable(inner)) {
                yield wrong(t.line, isResource(inner)
                    ? "${inner.text} is a resource (released by ${externInfoOf(inner.name)!.decl.releasedBy}): it is passed to C as it is, not through a pointer."
                    : "A C pointer (T*) points to numbers, bool, C structs, native types or other pointers, not to ${inner.text}.");
            }
            yield ptrT(inner);
        }
    };
    note(r);
    return r;
}

function resolveNamed(t: TypeRef in default): Type {
    let n: String = t.name;
    let p: Type? = primByName(n);
    if (p != null) { return p; }
    if (structOf(n) != null) { return named(n, NamedK.Struct); }
    if (classOf(n) != null) { return named(n, NamedK.Class); }
    if (interfaceOf(n) != null) { return named(n, NamedK.Interface); }
    if (enumOf(n) != null) { return named(n, NamedK.Enum); }
    if (isExternTypeName(n)) { return named(n, NamedK.Extern); }
    let hint: String = switch (n) {
        case "Function" -> " Function types are written as (Params) -> Return, e.g. (int32) -> bool.";
        case "List", "ArrayList" -> " Growable lists are written T[*], e.g. int32[*].";
        case "Arena" -> " Memories are byte arrays: let m: byte[*] = [] in heap;";
        case "Int", "int" -> " Integer types are int8..int64 and uint8 (byte)..uint64.";
        case "string" -> " Text is String (with a capital S: it is not a primitive).";
        default -> isPrimName(n.toLowerCase()) ? " Primitive types are written in lowercase: ${n.toLowerCase()}." : "";
    };
    return wrong(t.line, "Unknown type '${n}'.${hint}");
}

/** Registers a type (and its parts) so the generator emits it. */
public function note(t: Type in default): void {
    if (isError(t) || t.kind == TyK.Null) { return; }
    if (t == T_ANY) { usesAny = true; }
    if (t.kind == TyK.Array && t.ak == ArrK.Fixed && t.size < 0) { return; }
    if (t.used) { return; }
    if (hasThreadSafe(t)) {                       // C uses the type without `thread safe`
        t.used = true;
        let c: Type = cTypeOf(t);
        note(c);
        if (t.kind == TyK.Func) { t.funcId = c.funcId; }
        return;
    }
    t.used = true;
    usedTypes.push(t);
    if (t.kind == TyK.Func) {
        for (p in t.params) { note(p); }
        note(t.elem!);
        if (t.funcId < 0) {
            t.funcId = funcTypes.length;
            funcTypes.push(t);
        }
    } else if (t.kind == TyK.Array) {
        note(t.elem!);
        if (t.ak != ArrK.Slice) { note(arrayT(t.elem!, ArrK.Slice, 0)); }
    } else if (t.kind == TyK.Opt || t.kind == TyK.Ptr) {
        note(t.elem!);
    }
}

/** Notes that the generated C needs the type, and returns it. */
public function noted(t: Type in default): Type {
    note(t);
    return t;
}

// =====================================================================================
// Expressions
// =====================================================================================

public function check(e: Expr in default, expected: Type? in default, place: Place in default): Type {
    let t: Type = checkInner(e, expected, place);
    e.ty = t;
    note(t);
    if (e.region == null) { e.region = R_STATIC; }
    return t;
}

function checkInner(e: Expr in default, expected: Type? in default, place: Place in default): Type {
    return switch (e) {
        case IntLit n -> checkIntValue(literalValue(n, false), e.line, expected);
        case FloatLit -> expected != null && expected == T_FLOAT32 ? T_FLOAT32 : T_FLOAT64;
        case BoolLit -> T_BOOL;
        case NullLit -> T_NULL;
        case StringLit s -> checkString(s, place);
        case Ident id -> checkIdent(id, expected);
        case SelfExpr -> checkSelf(e);
        case SuperMember s -> wrong(e.line, "'super' can only be used to call a parent method: super.${s.name}(...)");
        case Member m -> checkMember(m, place);
        case Index x -> checkIndex(x);
        case Call c -> checkCall(c, expected, place);
        case Unary u -> checkUnary(u, expected, place);
        case Binary b -> checkBinary(b, expected, place);
        case Ternary t -> checkTernary(t, expected, place);
        case IsExpr x -> checkIs(x);
        case Cast c -> checkCast(c);
        case Unwrap u -> checkUnwrap(u, expected, place);
        case Lambda l -> checkLambda(l, expected);
        case ObjectLit o -> checkObjectLit(o, expected, place);
        case ArrayLit a -> checkArrayLit(a, expected, place);
        case Placed p -> checkPlaced(p, expected);
        case SwitchExpr sw -> analyzeSwitch(sw, true, expected, place);
        default -> wrong(e.line, "Unsupported expression.");
    };
}

function checkUnwrap(u: Unwrap in default, expected: Type? in default, place: Place in default): Type {
    let t: Type = check(u.expr, expected != null ? optT(expected) : null, place);
    setRegion(u, regionOf(u.expr));
    if (isError(t)) { return T_ERROR; }
    if (isOpt(t)) { return t.elem!; }
    if (u.expr is Ident && u.expr.narrowed) { return t; }    // already known not to be null
    return wrong(u.line, "'!' is only for optional values (T?), got ${t.text}.");
}

/** An integer literal where `expected` is wanted. */
public function checkIntValue(v: ConstVal, line: int32, expected: Type? in default): Type {
    let t: Type? = expected;
    if (t != null && isOpt(t)) { t = t.elem; }
    if (t != null && t == T_ANY) { t = T_INT64; }         // an integer stored in an Any is an int64
    if (t != null && isFloat(t)) { return t; }
    let p: Type = t != null && isInteger(t) ? t : T_INT32;
    if (intFits(v.i, v.big, v.huge, p)) { return p; }
    let text: String = v.text == "" ? "${v.i}" : v.text;
    if (p == T_INT32 && (t == null || !isInteger(t)) && !v.big && !v.huge) {
        error(line, "${text} does not fit in int32; give it a type, e.g. let n: int64 = ${text};");
    } else {
        error(line, "${text} does not fit in ${p.text} (${minOf(p)}..${maxText(p)}).");
    }
    return T_ERROR;
}

function checkString(s: StringLit in default, place: Place in default): Type {
    if (s.exprs.length == 0) { return T_STRING; }
    for (x in s.exprs) {
        let t: Type = check(x, null, P_TEMP);
        if (isError(t)) { continue; }
        let ok: bool = isNumeric(t) || t == T_BOOL || t == T_STRING || isEnumT(t) || t == T_ANY;
        if (!ok) { error(x.line, "A value of type ${t.text} cannot be put inside a string."); }
    }
    s.place = place;
    setRegion(s, placeRegion(place));
    return T_STRING;
}

function checkIdent(id: Ident in default, expected: Type? in default): Type {
    let n: String = id.name;
    let s: Symbol? = lookup(n);
    if (s == null) {
        if (structOf(n) != null || classOf(n) != null || enumOf(n) != null || interfaceOf(n) != null) {
            return wrong(id.line, "'${n}' is a type, not a value.");
        }
        return wrong(id.line, "Use of undeclared variable '${n}'.");
    }
    id.symbol = s;
    if (s.kind == SymK.Function) {
        let et: Type? = expected != null && isOpt(expected) ? expected.elem : expected;
        let sig: Type? = et != null ? externSig(et) : null;
        let f: FunctionInfo? = s.func;
        if (sig != null && f != null) { return cFunctionValue(id, f, et!, sig); }
        return wrong(id.line, "'${s.name}' is a function, not a value: pass ::${s.name} (a lambda that calls it), or write the lambda: (x) -> { return ${s.name}(x); }");
    }
    if (isMemory(s)) {
        return wrong(id.line, "'${s.name}' is a memory: it can be used after 'in', passed to a memory parameter, or asked for .length, .capacity and .peak.");
    }
    if (isByteArray(s.type) && s.dataUseLine < 0) { s.dataUseLine = id.line; }
    let xv: ExternValueDecl? = s.externValue;
    if (xv != null && xv.platform != "" && !platformWithin(platformCtx, xv.platform)) {
        error(id.line, "'${s.name}' exists only on ${xv.platform}: use it in a class for that platform.");
    }
    if (s.kind == SymK.Global && xv == null) { useGlobal(s, id.line); }
    s.used = true;
    noteCapture(s, id.line);
    setRegion(id, s.region);
    let nt: Type? = narrowedType(s);
    if (nt != null) {
        id.narrowed = true;
        return nt;
    }
    return s.type;
}

/** A function given where a pointer to a C function is expected: it must exist in C with that signature. */
function cFunctionValue(id: Ident in default, f: FunctionInfo in default, ft: Type in default, sig: Type in default): Type {
    if (!f.isExtern && f.exportName == "") {
        return wrong(id.line, "'${f.name}' is a Larimar function: mark it 'export function ${f.name}' so C can call it as ${ft.text}.");
    }
    if (f.varargs) { return wrong(id.line, "'${f.name}' takes a variable number of arguments: it cannot be used as ${ft.text}."); }
    if (f.sig == null || f.sig! != sig) {
        let has: String = f.sig != null ? f.sig!.text : "?";
        return wrong(id.line, "'${f.name}' is ${has}, but ${ft.text} is ${sig.text}.");
    }
    if (!f.isExtern) { edge(currentOwner(), f.owner); }
    return ft;
}

/** The last self checked was reached from inside a lambda of the method. */
public let selfInLambda: bool = false;

function checkSelf(se: Expr in default): Type {
    let i: int32 = frameTop - 1;
    while (i >= 0) {
        let f: Frame = frames[i];
        let st: Type? = f.selfType;
        if (st != null) {
            selfInLambda = i < frameTop - 1;       // its fields, then, are not under the lock (checkMember)
            let s: Symbol = lookupIn(f.root!, "self")!;
            se.symbol = s;
            noteCapture(s, se.line);
            setRegion(se, s.region);
            return st;
        }
        if (f.kind != FrameK.Lambda) { break; }
        i -= 1;
    }
    if (staticName != "" && frame().kind != FrameK.Global) { return wrong(se.line, "'${staticName}' is static: it has no 'self'."); }
    return wrong(se.line, "'self' can only be used inside a method.");
}

public function lookupIn(sc: Scope in default, name: String): Symbol? {
    let s0: Scope = scope;
    scope = sc;
    let r: Symbol? = lookup(name);
    scope = s0;
    return r;
}

public function variantFieldNames(v: VariantInfo in default): String {
    let parts: String[*] = [] in default;
    for (f in v.fields) { parts.push(f.name); }
    return parts.join(", ");
}

/** The enum a name like `State` refers to (when no variable hides it). */
/** The type an expression names (Order, String, a type of another module), or "". */
public function typeNamed(e: Expr): String {
    if (!(e is Ident id) || lookup(id.name) != null) { return ""; }
    let n: String = id.name;
    return structOf(n) != null || classOf(n) != null || interfaceOf(n) != null || enumOf(n) != null || primByName(n) != null || isExternTypeName(n) ? n : "";
}

public function enumNamed(e: Expr): EnumInfo? {
    return e is Ident id && lookup(id.name) == null ? enumOf(id.name) : null;
}

/** The memory a name refers to, if it is one. */
public function memoryNamed(e: Expr): Symbol? {
    if (!(e is Ident id)) { return null; }
    let s: Symbol? = lookup(id.name);
    return s != null && isMemory(s) ? s : null;
}

function checkMember(m: Member in default, place: Place in default): Type {
    let obj: Expr = m.object;
    // Enum constants: State.On
    let e: EnumInfo? = enumNamed(obj);
    if (e != null) {
        let v: VariantInfo? = variantOf(e, m.name);
        if (v == null) { return wrong(m.line, "Enum '${e.name}' has no variant '${m.name}'."); }
        if (v.hasPayload) { return wrong(m.line, "${e.name}.${v.name} carries data: create it with ${e.name}.${v.name}(${variantFieldNames(v)})."); }
        m.member = MemberInfo { kind: MbK.EnumConst, enumInfo: e, variant: v } in default;
        return named(e.name, NamedK.Enum);
    }
    // Memory statistics: m.length, m.capacity, m.peak
    let s: Symbol? = memoryNamed(obj);
    if (s != null) {
        obj.symbol = s;
        if (!(m.name == "length" || m.name == "capacity" || m.name == "peak")) { return wrong(m.line, "A memory only has .length, .capacity and .peak (got '${m.name}')."); }
        s.used = true;
        noteCapture(s, obj.line);
        m.member = MemberInfo { kind: MbK.MemoryStat, memory: s, stat: m.name } in default;
        return T_INT64;
    }
    let ot: Type = check(obj, null, P_TEMP);
    if (isError(ot)) { return T_ERROR; }
    setRegion(m, regionOf(obj));
    if (isOpt(ot)) { return wrong(m.line, "'${describeExpr(obj)}' may be null: check it with != null first, or use ! or ??."); }
    if (ot == T_ANY) {
        if (m.name == "length") {
            m.member = MemberInfo { kind: MbK.Length, objectType: ot } in default;
            setRegion(m, R_STATIC);
            return T_INT32;
        }
        if (m.name == "fields" && anyFieldsLoop != null && anyFieldsLoop! == m) {
            m.anyFields = true;
            return T_ANY;
        }
        if (m.name == "fields") { return wrong(m.line, "'fields' is used to go through the named entries: for (name, value in table.fields) { ... }. For an entry called 'fields', write table[\"fields\"]."); }
        m.member = MemberInfo { kind: MbK.AnyKey, key: m.name } in default;
        return T_ANY;
    }
    if (m.name == "length" && (ot.kind == TyK.Array || ot == T_STRING)) {
        m.member = MemberInfo { kind: MbK.Length, objectType: ot } in default;
        setRegion(m, R_STATIC);
        return T_INT32;
    }
    if (isPtr(ot)) {                        // p.field: the field of the C struct p points to (C's p->field)
        let pf: FieldInfo? = isExternStruct(ot.elem!) ? fieldOf(ot.elem!, m.name) : null;
        if (pf == null) {
            return wrong(m.line, isExternStruct(ot.elem!) ? "'${ot.elem!.text}' has no field '${m.name}'." : "A ${ot.text} points to a ${ot.elem!.text}, which has no fields.");
        }
        m.member = MemberInfo { kind: MbK.Field, field: pf, objectType: ot } in default;
        setRegion(m, R_STATIC);
        return pf.type;
    }
    if (ot.kind != TyK.Named) { return wrong(m.line, "A value of type ${ot.text} has no field '${m.name}'."); }
    let through: String = isExternT(ot) ? externInfoOf(ot.name)!.decl.fieldsStruct : "";
    if (through != "") {                    // native type X = c_struct* { let f: T; }: x.f is x->f
        let pointee: Type = ptrT(named(through, NamedK.Struct));
        let cf: FieldInfo? = fieldOf(pointee.elem!, m.name);
        if (cf != null) {
            m.member = MemberInfo { kind: MbK.Field, field: cf, objectType: pointee } in default;
            setRegion(m, R_STATIC);
            return cf.type;
        }
    }
    let f: FieldInfo? = fieldOf(ot, m.name);
    if (f != null) {
        if (ot.nk == NamedK.Class && classOf(ot.name)!.sync && !(obj is SelfExpr)) {
            error(m.line, "The fields of synchronized class '${ot.name}' are only used inside its methods (through self), where the object is locked.");
        } else if (obj is SelfExpr && selfInLambda && ot.nk == NamedK.Class && classOf(ot.name)!.sync) {
            error(m.line, "'self.${m.name}' of a synchronized class cannot be used inside a lambda: the lambda could run later, without the lock. Call a method instead, which takes the lock: self::method, or () -> { self.method(); }");
        }
        m.member = MemberInfo { kind: MbK.Field, field: f, objectType: ot } in default;
        if (!hasRefs(f.type)) { setRegion(m, R_STATIC); }
        return f.type;
    }
    let pm: MethodInfo? = methodOf(ot, m.name);
    if (pm != null && pm.decl.isProperty) {         // native let: read like a field
        let pt: Type = pm.sig!.elem!;
        let text: bool = pt == T_STRING || pt == optT(T_STRING);
        if (hasRefs(pt) && !text) { return wrong(m.line, "A native let gives a number, bool, String or String? ('${m.name}' is ${pt.text})."); }
        for (t in callTargets(ot, pm)) { edge(currentOwner(), t.own); }
        m.member = MemberInfo { kind: MbK.Property, method: pm, objectType: ot } in default;
        if (text) {                          // a text: made where the value goes, like the result of a call
            m.place = place;
            setRegion(m, placedResult(m, pt, place));
        } else {
            setRegion(m, R_STATIC);
        }
        return pt;
    }
    if (pm != null) { return wrong(m.line, "Method '${m.name}' must be called: ${m.name}(...)"); }
    return wrong(m.line, "'${ot.text}' has no field '${m.name}'.");
}

/** A value read without parentheses: the length of a String, an array, a list or an Any, or a native let. */
public function isProperty(t: Type in default, name: String): bool {
    if (t == T_STRING || t == T_ANY || t.kind == TyK.Array) { return name == "length"; }
    let mi: MethodInfo? = t.kind == TyK.Named ? methodOf(t, name) : null;
    return mi != null && mi.decl.isProperty;
}

public function fieldOf(t: Type in default, name: String): FieldInfo? {
    if (isStruct(t)) { return structField(structOf(t.name)!, name); }
    return isClass(t) ? findField(t.name, name) : null;
}

/** A method of a struct, class or interface (not an operator). */
public function methodOf(t: Type in default, name: String): MethodInfo? {
    return switch (t.nk) {
        case Struct -> structMethod(structOf(t.name)!, name, false, 0);
        case Class -> findMethod(t.name, name, false, 0);
        case Interface -> interfaceMethod(interfaceOf(t.name)!, name);
        case Extern -> nativeMethodOf(t.name, name);
        default -> null;
    };
}

/** A method that a native type declares for a C type. */
function nativeMethodOf(owner: String, name: String): MethodInfo? {
    for (mi in nativeMethods) {
        if (mi.owner == owner && mi.name == name && !mi.isOperator) { return mi; }
    }
    return null;
}

public function describeExpr(e: Expr): String {
    return switch (e) {
        case Ident id -> id.name;
        case Member m -> "${describeExpr(m.object)}.${m.name}";
        case SelfExpr -> "self";
        default -> "this value";
    };
}

function checkIndex(ix: Index in default): Type {
    let ot: Type = check(ix.object, null, P_TEMP);
    let it: Type = check(ix.index, null, P_TEMP);
    let line: int32 = ix.index.line;
    if (ot == T_STRING) {
        if (!isError(it) && !isInteger(it)) { error(line, "A String is indexed by an integer (its bytes), got ${it.text}."); }
        return T_BYTE;
    }
    if (ot == T_ANY) {
        if (!isError(it) && !isInteger(it) && it != T_STRING) { error(line, "An Any is indexed by position (an integer) or by name (a String), got ${it.text}."); }
        setRegion(ix, regionOf(ix.object));
        return T_ANY;
    }
    if (!isError(it) && !isInteger(it)) { error(line, "An index must be an integer, got ${it.text}."); }
    if (isError(ot)) { return T_ERROR; }
    if (ot.kind != TyK.Array) { return wrong(ix.line, "A value of type ${ot.text} cannot be indexed."); }
    setRegion(ix, hasRefs(ot.elem!) ? regionOf(ix.object) : R_STATIC);
    return ot.elem!;
}

/** The Place written after `in`, or null after reporting an error. */
public function resolvePlacement(p: Placed in default): Place? {
    if (p.mode == PL_HEAP) {
        error(p.line, "'in heap' creates memories: let m: byte[*] = [] in heap; Values are then created 'in m'.");
        return null;
    }
    if (p.mode == PL_DEFAULT) { return P_GLOBAL; }
    if (p.mode == PL_STACK) {
        let buf: TypeRef = p.buffer!;
        if (buf.kind != TK.Fixed) {
            error(p.line, "A temporary buffer needs a size: in byte[64]");
            return null;
        }
        let n: int64 = evalSize(buf.size!);
        if (frame().kind == FrameK.Global) { error(p.line, "'in byte[N]' is a temporary buffer and cannot be used for globals."); }
        if (n > 65536) { error(p.line, "A temporary buffer is limited to 64 KB; use a memory in the heap."); }
        return Place { kind: PlaceK.Stack, bytes: n < 1 ? 1 : n } in default;
    }
    let mem: Symbol? = resolveMemory(p.memory!);
    return mem == null ? null : (Place { kind: PlaceK.Memory, memory: mem } in default);
}

function checkPlaced(p: Placed in default, expected: Type? in default): Type {
    let inner: Expr = p.expr;
    let place: Place? = resolvePlacement(p);
    if (place == null) { return check(inner, expected, P_TEMP); }
    let t: Type = check(inner, expected, place);
    if (expected != null && expected == T_ANY && (isStruct(t) || isEnumT(t))) { inner.place = place; }
    let branches: bool = inner is Ternary || inner is SwitchExpr || inner is Binary b && b.op == "??";
    if (inner.place == null && !branches && !isError(t)) {   // (branches: each says it)
        error(p.line, "'in' has no effect here: this value does not need memory (it is a number, a literal or a plain value).");
    }
    setRegion(p, regionOf(inner));
    let c: Conversion? = inner.conv;
    if (c != null) {
        inner.conv = null;
        p.conv = c;
    }
    return t;
}

/** `in m`: m must be a memory (a heap memory, or an empty byte[N] that becomes one). */
public function resolveMemory(e: Expr in default): Symbol? {
    if (!(e is Ident id)) {
        error(e.line, "After 'in' write a memory variable, 'heap', or byte[N] for a temporary buffer.");
        return null;
    }
    let s: Symbol? = lookup(id.name);
    if (s == null) {
        error(e.line, "Use of undeclared memory '${id.name}'.");
        return null;
    }
    e.symbol = s;
    if (!isMemory(s)) {
        if (s.memoryCandidate && s.type.kind == TyK.Array) {
            let global: bool = s.kind == SymK.Global;
            if (!global && s.type.size > 65536) {
                error(e.line, "'${s.name}' (${s.type.size} bytes) is too big for the stack; declare it with 'in heap' or as a global.");
            }
            s.memKind = global ? MemK.FixedStatic : MemK.FixedLocal;
            s.memRegion = global ? rStaticMemory(s) : rMemory(s);
        } else if (isByteArray(s.type)) {
            error(e.line, "'${s.name}' is not a memory. Memories are created as let ${s.name}: byte[N] = []; or let ${s.name}: byte[*] = [] in heap;");
            return null;
        } else {
            error(e.line, "'${s.name}' is not a memory (it is ${s.type.text}).");
            return null;
        }
    }
    s.used = true;
    if (s.kind == SymK.Global) { useGlobal(s, e.line); }
    noteCapture(s, e.line);
    return s;
}
