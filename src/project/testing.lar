// project.testing: larimar test, the test runner.
//
//   larimar test [file|folder]... [--only <text>] [--test <name>]... [--list] [--json] [--no-sanitize]
//
// --list shows the tests without running them. --json writes one JSON object per line, for editors:
//
//   {"event": "found", "file": "tests/a_test.lar", "path": "/.../tests/a_test.lar", "name": "adds", "line": 4}
//   {"event": "result", "file": ..., "path": ..., "name": "adds", "line": 4, "result": "passed", "message": ""}
//   {"event": "summary", "passed": 3, "failed": 1, "skipped": 0}
//
// "result" is passed, failed or skipped.
//
// A test passes (exit 0), fails (1: a check failed; 101: a panic; a memory error...) or is skipped (3:
// std.test's skip(), when it cannot run here).
//
// It runs the test functions (`test function name(): void { ... }`) of the .lar files under tests/ (or the
// ones given). For each file, `larimarc test-main` writes the file again with a main of its own
// (build/test/<file>.lar, to read), and compiles it. Each test then runs alone, in its own process:
// `program <test name>`.
//
// Other .lar files (modules that the tests import) are not run. With AddressSanitizer and UBSan, except
// on Windows or with --no-sanitize.

import std.os;
import std.text { isIdentifierPart };
import std.io.path as Paths;
import std.io.files as Files;
import std.io { IoError };
import syntax.ast { Program, FunctionDecl, TK };
import syntax.parser { parseProgram };
import project.cc { windows, quote, commandLine, systemLibraries, selfPath, installHint };
import std.io.console as Console;
import std.encoding.json as Json;

/** How the tests are compiled: the project's [c] settings, or the defaults when there is no project. */
public class TestSettings {
    let compiler: String;
    let first: String[*] = [];   // arguments right after the compiler (the bundled tcc's)
    let bundled: bool = false;   // the tcc of $LARIMAR_HOME/toolchain: no sanitizers, no TLS
    let links: String[*];      // how the project links its libraries (static ones by their path, -L/-l, rpath)
    let includePaths: String[*];
    let sources: String[*];
    let root: String;          // where the tests' `import a.b` looks ("" = next to each file)
    let outDir: String;        // build/test
}

// =========================================================================
// test-main: a file of tests, with a main
// =========================================================================

/** A test function of a file. */
public class TestFunction {
    let name: String;
    let line: int32;           // where it is declared
    let setup: String;         // the type of its parameter ("" when it has none)
    let error: String;         // what it says it throws ("" when nothing)
}

/** The test functions of a file, in order (none when it has syntax errors: the compiler shows them). */
public function testFunctions(source: String in default): TestFunction[*] {
    let out: TestFunction[*] = [];
    let p: Program = parseProgram(source, 1);
    if (p.error != "") { return out; }
    for (d in p.decls) {
        if (d is FunctionDecl f && f.isTest) {
            let setup: String = "";
            if (f.params.length == 1 && f.params[0].type != null) { setup = f.params[0].type!.name; }
            let error: String = f.throwsType != null ? f.throwsType!.name : "";
            out.push(TestFunction { name: f.name.clone(), line: f.line, setup: setup.clone(), error: error.clone() });
        }
    }
    return out;
}

/** Whether the file declares a main of its own. */
public function hasMain(source: String in default): bool {
    let p: Program = parseProgram(source, 1);
    for (d in p.decls) {
        if (d is FunctionDecl f && f.name == "main" && f.typeName == "") { return true; }
    }
    return false;
}

/**
 * The file with a main added: `program <name>` runs that test and ends with 0 (it passed), 1 (a check
 * failed), 3 (it was skipped) or 2 (no test has that name). std.test is imported on the first line,
 * so the lines of the file do not move and its errors keep their line numbers.
 */
public function withMain(source: String, tests: TestFunction[*]): String {
    let sb: StringBuilder = {};
    sb.add("import std.test as lmtest; ");
    sb.add(source);
    if (!source.endsWith("\n")) { sb.add("\n"); }
    sb.add("\n// ---- added by larimar test: runs one test, the one named by the argument ----\n");
    sb.add("function main(args: String[]): int32 {\n");
    sb.add("    if (args.length != 1) {\n");
    sb.add("        println(\"This program runs one test, by name: larimar test runs it once for each.\");\n");
    sb.add("        return 2;\n");
    sb.add("    }\n");
    for (t in tests) {
        sb.add("    if (args[0] == \"${t.name}\") {\n");
        let call: String = t.setup != "" ? "${t.name}(setup)" : "${t.name}()";
        let run: String = t.error != "" ? "try { ${call}; } catch (${t.error} e) { lmtest.fail(\"the test threw ${t.error}\"); }" : "${call};";
        if (t.setup != "") {
            sb.add("        let setup: ${t.setup} = ${t.setup} {};\n");
            sb.add("        setup.beforeEach();\n");
            sb.add("        if (lmtest.failedChecks() == 0) {\n");
            sb.add("            ${run}\n");
            sb.add("        } else {\n");
            sb.add("            lmtest.fail(\"beforeEach() failed, so the test did not run\");\n");
            sb.add("        }\n");
            sb.add("        setup.afterEach();\n");
        } else {
            sb.add("        ${run}\n");
        }
        sb.add("        if (lmtest.failedChecks() > 0) { return 1; }\n");
        sb.add("        return lmtest.skipReason() != \"\" ? 3 : 0;\n");
        sb.add("    }\n");
    }
    sb.add("    println(\"No test is named '\${args[0]}'.\");\n");
    sb.add("    return 2;\n");
    sb.add("}\n");
    return sb.toString();
}

// =========================================================================
// larimar test
// =========================================================================

let passed: int32 = 0;
let failedCount: int32 = 0;
let skipped: int32 = 0;
let failedNames: String[*] = [] in default;

let settings: TestSettings? = null;
let sanitize: bool = true;
let only: String = "";
let json: bool = false;                         // --json: one JSON object per line
let listing: bool = false;                      // --list: what would run, without running it
let exact: String[*] = [] in default;           // --test <name>: only the tests with these names
let lines: Any = {} in default;                 // the line of each test of the file that runs

public function runTests(args: String[*], s: TestSettings in default): int32 {
    settings = s;
    sanitize = !windows();
    let paths: String[*] = [];
    let i: int32 = 0;
    while (i < args.length) {
        if (args[i] == "--no-sanitize") {
            sanitize = false;
        } else if (args[i] == "--json") {
            json = true;
        } else if (args[i] == "--list") {
            listing = true;
        } else if (args[i] == "--test") {
            if (i + 1 >= args.length) {
                println("larimar: --test needs the name of a test: larimar test tests/a_test.lar --test adds");
                return 2;
            }
            exact.push(args[i + 1].clone() in default);
            i += 1;
        } else if (args[i] == "--only") {
            if (i + 1 >= args.length) {
                println("larimar: --only needs a text: larimar test --only parse");
                return 2;
            }
            only = args[i + 1].clone() in default;
            i += 1;
        } else {
            paths.push(args[i]);
        }
        i += 1;
    }
    if (s.bundled && sanitize) {           // tcc has no AddressSanitizer
        sanitize = false;
        if (!json) { Console.printError("note: the bundled tcc builds the tests, without AddressSanitizer. To have it: ${installHint()}"); }
    }
    if (paths.length == 0) { paths.push("tests"); }
    let files: String[*] = [];
    for (p in paths) {
        if (Files.isDirectory(p)) {
            collect(p, files);
        } else if (Files.isFile(p)) {
            files.push(p);
        } else {
            println("larimar: ${p} does not exist");
            return 2;
        }
    }
    sortTexts(files);
    try {
        Files.createDirectories(s.outDir);
    } catch (IoError e) {
        println("larimar: cannot create ${s.outDir}");
        return 2;
    }
    for (f in files) {
        let source: String? = null;
        try { source = Files.readString(f); } catch (IoError e) { continue; }
        let shown: String = Paths.relative(os.cwd(), Paths.absolute(f));
        if (!hasTestFunctions(source!)) { continue; }
        lines.clear();
        let tests: TestFunction[*] = testFunctions(source!.clone() in default);
        for (t in tests) { lines[t.name] = t.line; }
        if (listing) {
            list(shown, tests);
        } else {
            runTestFile(f, shown, source!);
        }
    }
    if (listing) { return 0; }
    if (json) {
        println(Json.stringify({ event: "summary", passed: passed, failed: failedCount, skipped: skipped }));
        return failedCount > 0 ? 1 : 0;
    }
    println("");
    let tail: String = skipped > 0 ? ", ${skipped} skipped" : "";
    println("${passed} passed, ${failedCount} failed${tail}");
    if (failedCount > 0) {
        println("failed:");
        for (n in failedNames) { println("  ${n}"); }
        return 1;
    }
    return 0;
}

/** The .lar files of a folder and its folders. */
function collect(dir: String, into: String[*]): void {
    let names: String[*] = [];
    try { names = Files.list(dir); } catch (IoError e) { return; }
    for (n in names) {
        let path: String = Paths.join(dir, n);
        if (Files.isDirectory(path)) {
            collect(path, into);
        } else if (n.endsWith(".lar")) {
            into.push(path.clone());
        }
    }
}

/** Sorts texts by their bytes (the order of the files every time). */
function sortTexts(xs: String[*]): void {
    let i: int32 = 1;
    while (i < xs.length) {
        let j: int32 = i;
        while (j > 0 && before(xs[j], xs[j - 1])) {
            let t: String = xs[j];
            xs[j] = xs[j - 1];
            xs[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
}

function before(a: String, b: String): bool {
    let n: int32 = a.length < b.length ? a.length : b.length;
    let i: int32 = 0;
    while (i < n) {
        if (a[i] != b[i]) { return a[i] < b[i]; }
        i += 1;
    }
    return a.length < b.length;
}

function hasTestFunctions(source: String): bool {
    for (line in source.lines()) {
        if (line.trim().startsWith("test function ")) { return true; }
    }
    return false;
}

/** build/test/<the file's path, with '_' for the folders>: where the files of one test go. */
function base(shown: String): String {
    let name: String = shown.replace("\\", "/").replace("../", "").replace("/", "_");
    if (name.endsWith(".lar")) { name = name.substring(0, name.length - 4); }
    return Paths.join(settings!.outDir, name);
}

/** Whether a test runs: the names given with --test, else the ones --only matches ("": the file itself). */
function selected(shown: String, name: String): bool {
    if (exact.length > 0) { return name != "" && exact.contains(name); }
    return only == "" || shown.contains(only) || name != "" && name.contains(only);
}

/** --list: the tests of a file. */
function list(shown: String, tests: TestFunction[*]): void {
    for (t in tests) {
        if (selected(shown, t.name)) { found(shown, t.name, t.line); }
    }
}

function found(shown: String, name: String, line: int32): void {
    if (json) {
        println(Json.stringify({ event: "found", file: shown, path: Paths.absolute(shown), name: name, line: line }));
    } else {
        println(name == "" ? shown : "${shown}: ${name}");
    }
}

/** The line of a test of the file that runs (1 for the file itself). */
function lineOf(name: String): int32 {
    return name == "" ? 1 : lines[name] as int32 ?? 1;
}

/** A result: a line for a person (ok, FAIL, skip), or a JSON object with --json. */
function report(shown: String, name: String, result: String, message: String): void {
    if (json) {
        println(Json.stringify({
            event: "result", file: shown, path: Paths.absolute(shown), name: name, line: lineOf(name), result: result,
            message: message.trim()
        }));
        return;
    }
    let full: String = name == "" ? shown : "${shown}: ${name}";
    if (result == "passed") {
        println("  ok    ${full}");
    } else if (result == "skipped") {
        println("  skip  ${full} (${message})");
    } else {
        failedNames.push(full.clone());
        println("  FAIL  ${full}");
        for (line in message.trim().lines()) { println("        ${line}"); }
    }
}

function pass(shown: String, name: String): void {
    passed += 1;
    report(shown, name, "passed", "");
}

function failed(shown: String, name: String, problem: String): void {
    failedCount += 1;
    report(shown, name, "failed", problem);
}

function skip(shown: String, name: String, why: String): void {
    skipped += 1;
    report(shown, name, "skipped", why);
}

/**
 * A file of tests that did not get to run (it did not compile): for a person, one failure; with --json,
 * each of its tests fails with that message, so an editor marks them.
 */
function fileFailed(shown: String, problem: String): void {
    if (!json) {
        failed(shown, "", problem);
        return;
    }
    for (name, _ in lines.fields) {
        if (selected(shown, name)) { failed(shown, name, problem); }
    }
}

function read(path: String): String {
    try { return Files.readString(path).replace("\r", ""); } catch (IoError e) { return ""; }
}

/** The first lines of a text (what a failure shows). */
function head(text: String, count: int32): String {
    let lines: String[*] = text.trim().lines();
    let out: String[*] = [];
    for (i, line in lines) {
        if (i >= count) {
            out.push("...");
            break;
        }
        out.push(line);
    }
    return out.join("\n");
}

/** Compiles the C of a test into an executable; "" when it worked, else what the C compiler said. */
function compileC(cFile: String, exe: String): String {
    let s: TestSettings = settings!;
    let c: String = read(cFile);
    if (s.bundled && c.contains("#define LM_NET_TLS")) {
        return "it uses TLS (https), which the bundled tcc cannot build. Install a C compiler: ${installHint()}";
    }
    let cmd: String[*] = [s.compiler];
    for (a in s.first) { cmd.push(a); }
    cmd.push("-std=c99");
    cmd.push("-g");
    if (sanitize) {
        let flags: String[] = ["-O1", "-fno-omit-frame-pointer", "-fsanitize=address,undefined", "-fno-sanitize-recover=undefined"];
        for (f in flags) { cmd.push(f); }
    } else {
        cmd.push("-O0");
    }
    cmd.push("-o");
    cmd.push(exe);
    cmd.push(cFile);
    for (src in s.sources) { cmd.push(src); }
    for (ip in s.includePaths) { cmd.push("-I${ip}"); }
    for (l in s.links) { cmd.push(l); }
    if (!windows()) { cmd.push("-lm"); }
    for (l in systemLibraries(c)) { cmd.push(l.clone()); }
    let log: String = "${cFile}.cc.txt";
    let code: int32 = os.run("${commandLine(cmd)} > ${quote(log)} 2>&1");
    if (code == 0) { return ""; }
    if (code == 127) { return "cannot run the C compiler '${s.compiler}'"; }
    return "the C compiler failed:\n${head(read(log), 20)}";
}

/** Runs a program, its output to <base>.out and <base>.err; gives its exit code. */
function runProgram(exe: String, args: String[*], outFile: String, errFile: String): int32 {
    // without the sanitizers, the programs a test builds (tests.support.compiler) go without them too
    let env: String = sanitize ? "ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=print_stacktrace=1 " : windows() ? "" : "LARIMAR_TEST_SANITIZE=0 ";
    let all: String[*] = [exe];
    for (a in args) { all.push(a); }
    return os.run("${env}${commandLine(all)} > ${quote(outFile)} 2> ${quote(errFile)}");
}

function memoryError(err: String): bool {
    return err.contains("ERROR: AddressSanitizer") || err.contains("runtime error:");
}

/** The lines of a sanitizer's report that say what happened. */
function memoryReport(err: String): String {
    let out: String[*] = [];
    for (line in err.lines()) {
        let t: String = line.trim();
        if (t.contains("ERROR") || t.contains("SUMMARY") || t.contains("runtime error") || t.startsWith("#0 ") || t.startsWith("#1 ") || t.startsWith("#2 ") || t.startsWith("#3 ")) {
            out.push(line.clone());
        }
        if (out.length >= 12) { break; }
    }
    return out.join("\n");
}

/** What a skipped test said: the text after "skipped: ". */
function skipText(out: String): String {
    for (line in out.lines()) {
        if (line.startsWith("skipped: ")) { return line.substring(9).clone(); }
    }
    return "skipped";
}

function exeName(b: String): String { return windows() ? "${b}.exe" : b; }

/** A file of test functions: compiled once with a main, then each test runs alone. */
function runTestFile(file: String, shown: String, source: String): void {
    let b: String = base(shown);
    let cFile: String = "${b}.c";
    let exe: String = exeName(b);
    let log: String = "${b}.compile.txt";
    let cmd: String[*] = [selfPath(), "test-main", file, "-o", cFile];
    if (settings!.root != "") {
        cmd.push("--root");
        cmd.push(settings!.root);
    }
    if (os.run("${commandLine(cmd)} > ${quote(log)} 2>&1") != 0) {
        fileFailed(shown, "did not compile (the file with its main: ${b}.lar):\n${head(read(log), 30)}");
        return;
    }
    let problem: String = compileC(cFile, exe);
    if (problem != "") {
        fileFailed(shown, problem);
        return;
    }
    for (name in read("${b}.tests").trim().lines()) {
        if (name == "" || !selected(shown, name)) { continue; }
        let outFile: String = "${b}.${name}.out";
        let errFile: String = "${b}.${name}.err";
        let code: int32 = runProgram(exe, [name], outFile, errFile);
        let out: String = read(outFile);
        let err: String = read(errFile);
        if (memoryError(err)) {
            failed(shown, name, "memory error:\n${memoryReport(err)}");
        } else if (code == 0) {
            pass(shown, name);
        } else if (code == 1) {
            failed(shown, name, head(out, 20));
        } else if (code == 3) {
            skip(shown, name, skipText(out));
        } else if (code == 101) {
            failed(shown, name, "${head(out, 10)}\n${head(err, 5)}");
        } else {
            failed(shown, name, "exit ${code}:\n${head(out, 10)}\n${head(err, 10)}");
        }
    }
}
