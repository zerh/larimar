// project.services: a service is a project whose public functions another program calls in another process.
//
//   [project]
//   name = "imagen"
//   kind = "service"
//   main = "src/imagen.lar"            # its public functions are what it gives
//
// larimar build makes its executable (build/imagen): a main that answers calls (std.os.rpc.serve) by
// calling those functions. A program that names it in [dependencies] (imagen = "../imagen") imports a module
// written for it instead of its code: a class with the same functions, each one a call to that executable.
//
//   import imagen { Imagen };
//   let img: Imagen = Imagen.start();               // starts build/imagen: shared memory between the two
//   let small: String = img.resize("casa.jpg", 800);
//
// What crosses is what JSON carries: numbers, bool, String, optionals and lists of them, and Any. A
// function of the service throws nothing (an error cannot cross); a call of the program can throw
// RpcError, when the service cannot answer.

import syntax.ast { FunctionDecl, Param, Program, TK, TypeRef };
import syntax.parser { parseProgram };

/** A function the service gives: its name, its parameters (name and type) and what it returns. */
public class ServiceFunction {
    let name: String;
    let params: String[*] = [];
    let types: TypeRef[*] = [];
    let ret: TypeRef;
    let doc: String = "";
}

const SCALARS: String = " int8 int16 int32 int64 uint8 uint16 uint32 uint64 byte float32 float64 bool String ";

function scalar(t: TypeRef): bool { return t.kind == TK.Named && SCALARS.contains(" ${t.name} "); }

/** Whether a value of this type crosses: a scalar, an optional or a list of one, or Any. */
function crosses(t: TypeRef): bool {
    if (scalar(t) || (t.kind == TK.Named && t.name == "Any")) { return true; }
    if ((t.kind == TK.Opt || t.kind == TK.Growable) && t.inner != null) { return scalar(t.inner!); }
    return false;
}

/** The type as Larimar writes it. */
function text(t: TypeRef): String {
    if (t.kind == TK.Opt) { return "${text(t.inner!)}?"; }
    if (t.kind == TK.Growable) { return "${text(t.inner!)}[*]"; }
    return t.name;
}

/** The class of the program for a service: imagen -> Imagen, image_tools -> ImageTools. */
public function className(service: String): String {
    let out: StringBuilder = {};
    let upper: bool = true;
    for (i, b in service) {
        if (b == '_') {
            upper = true;
            continue;
        }
        let c: String = service.substring(i, i + 1);
        out.add(upper ? c.toUpperCase() : c);
        upper = false;
    }
    return out.toString();
}

/** The public functions of the service's main file (its source): what it gives. Problems go to `problems`. */
public function contract(source: String in default, line: int32, problems: String[*]): ServiceFunction[*] {
    let out: ServiceFunction[*] = [];
    let p: Program = parseProgram(source, line);
    if (p.error != "") { return out; }                  // the service's own build says it
    for (d in p.decls) {
        if (!(d is FunctionDecl f) || f.typeName != "" || f.isTest || !p.publics.contains(f.name)) { continue; }
        if (f.throwsType != null) {
            problems.push("function ${f.name} of the service throws: an error cannot cross to the program that calls it (give it as a value)".clone());
            continue;
        }
        let sf: ServiceFunction = { name: f.name.clone(), ret: f.ret };
        let ok: bool = true;
        for (prm in f.params) {
            if (prm.type == null || !crosses(prm.type!)) {
                problems.push("parameter ${prm.name} of ${f.name}: what crosses to a service is a number, a bool, a String, an optional or a list of one of them, or Any".clone());
                ok = false;
                continue;
            }
            sf.params.push(prm.name.clone());
            sf.types.push(prm.type!);
        }
        if (!(f.ret.kind == TK.Named && f.ret.name == "void") && !crosses(f.ret)) {
            problems.push("${f.name} returns ${text(f.ret)}: what comes back from a service is a number, a bool, a String, an optional or a list of one of them, or Any".clone());
            ok = false;
        }
        if (ok) { out.push(sf); }
    }
    return out;
}

/** A value of type `t` read from the Any `x`. */
function fromAny(t: TypeRef, x: String): String {
    if (t.kind == TK.Named) {
        if (t.name == "Any") { return x; }
        if (t.name == "String") { return "(${x} as String ?? \"\").clone()"; }
        if (t.name == "bool") { return "${x} as bool ?? false"; }
        if (t.name == "float32" || t.name == "float64") { return "${x} as ${t.name} ?? 0.0"; }
        return "${x} as ${t.name} ?? 0";
    }
    return x;
}

function isVoid(t: TypeRef): bool { return t.kind == TK.Named && t.name == "void"; }

/** Statements that put the value `v` (of type `t`) into the table `into` under `key` (or that return it, when key is ""). */
function toAny(t: TypeRef, v: String, into: String, key: String, indent: String): String {
    let put: String = key != "" ? "${into}[\"${key}\"] = " : "return ";
    if (t.kind == TK.Opt) {
        if (key == "") { return "${indent}if (${v} == null) { return null; }\n${indent}return ${v}!;\n"; }
        return "${indent}if (${v} != null) { ${put}${v}!; }\n";
    }
    if (t.kind == TK.Growable) {
        let l: String = "l_${key != "" ? key : "result"}";
        return "${indent}let ${l}: Any = {};\n${indent}for (x in ${v}) { ${l}.push(x); }\n${indent}${put}${l};\n";
    }
    return "${indent}${put}${v};\n";
}

/** The statements that make the variable `name` (of type `t`) from the Any `x`. */
function declareFrom(t: TypeRef, name: String, x: String, indent: String): String {
    if (t.kind == TK.Opt) {
        if (t.inner!.name == "String") {
            return "${indent}let ${name}: String? = null;\n${indent}if (${x} != null) { ${name} = (${x} as String ?? \"\").clone(); }\n";
        }
        return "${indent}let ${name}: ${text(t)} = ${x} as ${t.inner!.name};\n";
    }
    if (t.kind == TK.Growable) {
        return "${indent}let ${name}: ${text(t)} = [];\n${indent}for (i, v in ${x}) { ${name}.push(${fromAny(t.inner!, "v")}); }\n";
    }
    return "${indent}let ${name}: ${text(t)} = ${fromAny(t, x)};\n";
}

/**
 * The module a program imports for the service: a class with a function for each one of the service's,
 * each a call to its executable (next to the program's, or else where the service was built).
 */
public function clientSource(service: String, functions: ServiceFunction[*], built: String): String {
    let cls: String = className(service);
    let sb: StringBuilder = {};
    sb.add("// Written by larimar for the service '${service}' of [dependencies]: each function calls its executable.\n");
    sb.add("import std.os;\nimport std.io.files as Files;\nimport std.io.path as Paths;\nimport std.os.rpc { Rpc, RpcError };\n\n");
    sb.add("/** The service ${service}, running in a process of its own. It ends when its memory is freed (or close()). */\n");
    sb.add("public class ${cls} {\n    let rpc: Rpc;\n\n");
    sb.add("    /** Starts the service: its executable next to this program's, or else where it was built. */\n");
    sb.add("    static function start(): ${cls} throws RpcError {\n");
    sb.add("        let here: String = Paths.join(os.programDir(), \"${service}${built.endsWith(".exe") ? ".exe" : ""}\");\n");
    sb.add("        return ${cls}.startAt(Files.isFile(here) ? here : ${quoted(built)});\n    }\n\n");
    sb.add("    /** Starts the service from its executable. */\n");
    sb.add("    static function startAt(program: String): ${cls} throws RpcError {\n");
    sb.add("        return ${cls} { rpc: Rpc.startShared(program, []) };\n    }\n\n");
    sb.add("    /** How long a call may wait for its answer, in ms (0: as long as it takes). */\n");
    sb.add("    function setTimeout(ms: int32): void { self.rpc.timeout = ms; }\n\n");
    sb.add("    /** Ends the service. */\n    function close(): void { self.rpc.close(); }\n");
    for (f in functions) {
        let ps: String[*] = [];
        for (i, n in f.params) { ps.push("${n}: ${text(f.types[i])}"); }
        let ret: String = text(f.ret);
        sb.add("\n    function ${f.name}(${ps.join(", ")}): ${ret} throws RpcError {\n");
        sb.add("        let p: Any = {};\n");
        for (i, n in f.params) { sb.add(toAny(f.types[i], n, "p", n, "        ")); }
        if (isVoid(f.ret)) {
            sb.add("        self.rpc.call(\"${f.name}\", p);\n    }\n");
            continue;
        }
        sb.add("        let r: Any = self.rpc.call(\"${f.name}\", p);\n");
        if (f.ret.kind == TK.Named && f.ret.name == "Any") {
            sb.add("        return r;\n    }\n");
        } else {
            sb.add(declareFrom(f.ret, "result", "r", "        "));
            sb.add("        return result;\n    }\n");
        }
    }
    sb.add("}\n");
    return sb.toString();
}

/** The main of the service's executable: it answers each call with the function of the same name. */
public function serverSource(service: String, functions: ServiceFunction[*]): String {
    let sb: StringBuilder = {};
    sb.add("// Written by larimar build: the main of the service '${service}'.\n");
    sb.add("import ${service};\nimport std.os.rpc { RpcCall, serve };\n\n");
    sb.add("function main(): int32 {\n    serve((call) -> {\n");
    for (f in functions) {
        sb.add("        if (call.method == \"${f.name}\") {\n");
        let args: String[*] = [];
        for (i, n in f.params) {
            sb.add(declareFrom(f.types[i], "a_${n}", "call.params[\"${n}\"]", "            "));
            args.push("a_${n}");
        }
        let callText: String = "${service}.${f.name}(${args.join(", ")})";
        if (isVoid(f.ret)) {
            sb.add("            ${callText};\n            return null;\n        }\n");
            continue;
        }
        sb.add("            let r: ${text(f.ret)} = ${callText};\n");
        sb.add(toAny(f.ret, "r", "", "", "            "));
        sb.add("        }\n");
    }
    sb.add("        call.fail(-32601, \"the service ${service} has no function \${call.method}\");\n        return null;\n    });\n    return 0;\n}\n");
    return sb.toString();
}

function quoted(s: String): String { return "\"${s.replace("\\", "\\\\").replace("\"", "\\\"")}\""; }
