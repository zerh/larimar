// project.libraries: the libraries written in Larimar, as larimar build makes them and as the programs
// that use them find them. A library is a folder, a package, that larimar build fills:
//
//   textkit.interface       its name, version, type, the interface hash, and what goes with it
//   textkit.lar             for Larimar: its export functions as native declarations (import textkit)
//   textkit.h               for C: the same functions, its handles, how to free what they give
//   textkit.c               the library, translated to C: it is compiled with the program that uses it
//   c/...                   the C the library brings (the sources and include_paths of its [c])
//
// That is type "package", the default: the same folder serves every platform. With --static or --dynamic the
// library is compiled here instead (libtextkit.a; libtextkit.so, libtextkit.dylib, textkit.dll), for a C program.
// A program names the folder in [packages] of its larimar.toml, whatever its type, or the package's .lpk:
// the same folder in one file (project.lpk).
//
// The interface hash is the first 8 hex digits of the SHA-256 of the .lar, and the library has it inside
// ("larimar-interface:<hash>"). A program builds only when the three agree: a .lar edited by hand, or
// copied from another build, is found out before the C compiler runs.

import std.os { Platform };
import std.io.path as Paths;
import std.io.files as Files;
import std.io { IoError };
import std.io.files { File };
import std.crypto { sha256 };
import std.encoding.hex as Hex;
import std.encoding.toml as Toml;
import std.encoding.toml { TomlError };
import project.lpk { unpack };

/** A library written in Larimar that a project links. */
public class LarimarLibrary {
    let name: String;
    let dir: String;
    let kind: String;               // "package", "static" or "dynamic"
    let links: String[*] = [];      // what the program links too (-l...), unless the library is dynamic
    let sources: String[*] = [];    // a package: its C files, compiled with the program (the library's first)
    let includePaths: String[*] = [];
    let objects: String[*] = [];    // a package: the compiled C libraries it brings for this platform (lib<name>.a)
    let needs: String[*] = [];      // a package: the packages its library uses, which the program names too
}

/** The interface hash of a library: the first 8 hex digits of the SHA-256 of its .lar. */
public function interfaceHash(module: String): String {
    let digest: byte[*] = sha256(module.bytes());
    return Hex.encode(digest).substring(0, 8).clone();
}

/** The file of a library: <name>.c in a package, lib<name>.a, or the dynamic one of this platform. */
public function libraryFile(name: String, kind: String): String {
    if (kind == "package") { return "${name}.c"; }
    if (kind == "static") { return "lib${name}.a"; }
    if (Platform.name() == "windows") { return "${name}.dll"; }
    return Platform.name() == "macos" ? "lib${name}.dylib" : "lib${name}.so";
}

/** The marker the library has inside, with its hash. */
public function interfaceMarker(hash: String): String { return "larimar-interface:${hash}"; }

/**
 * The libraries of [packages] (name = "folder"): each folder has the <name>.interface that larimar build
 * wrote. With `verify`, the interface is checked against the .lar and the library (larimar build); without
 * it, only found (the editor).
 */
public function larimarLibraries(dir: String, config: Any, verify: bool, problems: String[*]): LarimarLibrary[*] {
    let out: LarimarLibrary[*] = [];
    for (name, where in config.packages.fields) {
        let path: String? = where as String;
        if (path == null) {
            problems.push("${name} in [packages] is the folder of the package: ${name} = \"libs/${name}\"".clone());
            continue;
        }
        let folder: String = Paths.normalize(Paths.join(dir, path!));
        if (path!.endsWith(".lpk")) {                 // a package in one file: unpacked in the build folder, once
            if (!Files.isFile(folder)) {
                problems.push("package '${name}': ${path!} does not exist".clone());
                continue;
            }
            let buildDir: String = config.project.build_dir as String ?? "build";
            let unpacked: String = Paths.normalize(Paths.join(Paths.join(Paths.join(dir, buildDir), "packages"), name));
            let wrong: String = unpack(folder, unpacked);
            if (wrong != "") {
                problems.push("package '${name}': ${wrong}".clone());
                continue;
            }
            folder = unpacked;
        }
        if (!Files.isFile(Paths.join(folder, "${name}.interface"))) {
            problems.push("package '${name}': ${path!} has no ${name}.interface (a package is the folder that larimar build makes of a library, or its .lpk)".clone());
            continue;
        }
        let found: LarimarLibrary? = read(name, folder, verify, problems);
        if (found != null) { out.push(found!); }
    }
    for (l in out) {
        for (n in l.needs) {
            if (config.packages[n] == null) {
                problems.push("package '${l.name}' uses the package '${n}': name it in [packages] too (${n} = \"...\")".clone());
            }
        }
    }
    return out;
}

/** The strings of a list of a section, added to `into` (nothing when there is no such list). */
function strings(section: Any, key: String, into: String[*]): void {
    let value: Any = section[key];
    if (value == null) { return; }
    for (i, item in value) {
        let text: String? = item as String;
        if (text != null) { into.push(text!.clone()); }
    }
}

/** A library's folder, read through its .interface (and checked, with `verify`). */
function read(name: String, folder: String, verify: bool, problems: String[*]): LarimarLibrary? {
    let itf: String = Paths.join(folder, "${name}.interface");
    let config: Any = null;
    try {
        config = Toml.parse(Files.readString(itf));
    } catch (IoError e) {
        problems.push("cannot read ${itf}".clone());
        return null;
    } catch (TomlError e) {
        problems.push("${itf}: ${Toml.message(e)}".clone());
        return null;
    }
    let lib: Any = config.library;
    let hash: String = lib["interface"] as String ?? "";
    let kind: String = lib.type as String ?? "";
    let found: LarimarLibrary = { name: name.clone(), dir: folder.clone(), kind: kind.clone() };
    if (kind == "package") { found.sources.push(Paths.join(folder, libraryFile(name, kind)).clone()); }
    // [library], and of a package [library.unix] and [library.<platform>]: what the library brings for each
    let sections: Any[] = [lib, Platform.name() == "windows" ? null : lib.unix, lib[Platform.name()]];
    for (section in sections) {
        strings(section, "links", found.links);
        let relative: String[*] = [];
        strings(section, "sources", relative);
        for (x in relative) { found.sources.push(Paths.join(folder, x).clone()); }
        relative.clear();
        strings(section, "include_paths", relative);
        for (x in relative) { found.includePaths.push(Paths.join(folder, x).clone()); }
        relative.clear();
        strings(section, "objects", relative);
        for (x in relative) { found.objects.push(Paths.join(folder, x).clone()); }
    }
    strings(lib, "packages", found.needs);
    if (!verify) { return found; }
    if ((lib.name as String ?? "") != name || hash.length != 8) {
        problems.push("${itf} is not the interface of a library called '${name}' (name and interface in [library])".clone());
        return null;
    }
    if (kind != "package" && kind != "static" && kind != "dynamic") {
        problems.push("${itf}: type = \"${kind}\" is not a kind of library (package, static, dynamic)".clone());
        return null;
    }
    let binary: String = Paths.join(folder, libraryFile(name, kind));
    let module: String = Paths.join(folder, "${name}.lar");
    let header: String = Paths.join(folder, "${name}.h");
    let needed: String[*] = [binary, module, header];
    for (x in found.sources) { needed.push(x); }
    for (x in found.objects) { needed.push(x); }
    for (m in needed) {
        if (!Files.isFile(m)) {
            problems.push("${m} is missing: a package is the whole folder of one build (${libraryFile(name, kind)}, ${name}.h, ${name}.lar, ${name}.interface, and its c/)".clone());
            return null;
        }
    }
    try {
        let own: String = interfaceHash(Files.readString(module));
        if (own != hash) {
            problems.push("${module} does not match the library (its hash is ${own}, ${name}.interface says ${hash}): it was edited, or comes from another build. Copy the whole folder of one build.".clone());
            return null;
        }
        if (!fileHas(binary, interfaceMarker(hash))) {
            problems.push("${binary} is from another build than ${name}.lar and ${name}.interface (interface ${hash}): copy the whole folder of one build.".clone());
            return null;
        }
    } catch (IoError e) {
        problems.push("cannot read the library ${name} in ${folder}".clone());
        return null;
    }
    return found;
}

/**
 * Whether a file has the marker of an interface in its bytes (read in pieces: a library has zeros, which a
 * String of std cannot hold). The marker's first byte is not in the rest of it, so one pass finds it.
 */
function fileHas(path: String, marker: String): bool throws IoError {
    let f: File = Files.open(path);
    let buffer: byte[*] = [];
    for (i in 0..65536) { buffer.push(0); }
    let j: int32 = 0;
    while (true) {
        let n: int32 = f.read(buffer);
        if (n == 0) { break; }
        for (i in 0..n) {
            let b: byte = buffer[i];
            if (b == marker[j]) {
                j += 1;
                if (j == marker.length) {
                    f.close();
                    return true;
                }
            } else {
                j = b == marker[0] ? 1 : 0;
            }
        }
    }
    f.close();
    return false;
}

/** The .interface of a library that larimar build writes. */
public function interfaceText(name: String, version: String, kind: String, prefix: String, hash: String, made: String, links: String[*],
        sources: String[*], includePaths: String[*], objects: String[*], packages: String[*]): String {
    let quoted: String[*] = [];
    for (l in links) { quoted.push("\"${l}\""); }
    let files: String[*] = [];
    for (x in sources) { files.push("\"${x}\""); }
    let includes: String[*] = [];
    for (x in includePaths) { includes.push("\"${x}\""); }
    let compiled: String[*] = [];
    for (x in objects) { compiled.push("\"${x}\""); }
    let needs: String[*] = [];
    for (x in packages) { needs.push("\"${x}\""); }
    return """
        # ${name}: a library written in Larimar. Written by larimar build; read by larimar build of the
        # programs that link it. The interface hash is that of ${name}.lar, and ${libraryFile(name, kind)} has it inside:
        # a program builds only when they agree.

        [library]
        name = "${name}"
        version = "${version}"
        type = "${kind}"
        prefix = "${prefix}"
        interface = "${hash}"
        larimar = "${made}"
        files = ["${libraryFile(name, kind)}", "${name}.h", "${name}.lar"]
        links = [${quoted.join(", ")}]
        sources = [${files.join(", ")}]
        include_paths = [${includes.join(", ")}]
        objects = [${compiled.join(", ")}]
        packages = [${needs.join(", ")}]
        """;
}
