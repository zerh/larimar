// std.os.rpc: calls to another program, and a program that answers them (JSON-RPC 2.0).
//
//   import std.os.rpc { Rpc, RpcCall, RpcError, serve };
//   import std.os.process { Process };
//
//   // the program that calls
//   let calc: Rpc = Rpc.startShared(Process { program: "./calc" });   // a Larimar program that serves
//   let sum: Any = calc.call("add", { a: 2, b: 3 });                   // 5
//   calc.close();                                                      // it ends when it sees the end
//
//   // the program that answers (./calc)
//   function main(): int32 {
//       serve((call) -> {
//           if (call.method == "add") { return (call.params.a as int64 ?? 0) + (call.params.b as int64 ?? 0); }
//           call.fail(-32601, "no method ${call.method}");
//           return null;
//       });
//       return 0;
//   }
//
// The Process says what runs (program, args, env, quiet...), and Rpc starts it and talks to it. Each
// message is JSON with a Content-Length header before it, as in LSP. Rpc.start talks to any program
// through its standard input and output (the program writes nothing else there); Rpc.startShared talks to
// a Larimar program through two streams of shared memory (std.os.sharedmemory), so its own output stays its
// own and the bytes do not go through the system. serve() answers on the shared streams it was started with,
// or else on its standard input and output; it returns when the caller closes. Rpc.over and serveOver do
// the same on any pair of streams (a socket, for example).
//
// A call waits for its answer (timeout: how long, 0 for as long as it takes). If the other program ends,
// the call throws RpcError.Ended with its exit code instead of waiting.

import std.io { IoError, InputStream, OutputStream };
import std.io.console as Console;
import std.encoding.json as Json;
import std.encoding.json { JsonError };
import std.os;
import std.time as Time;
import std.os.process.internal { Child };
import std.os.sharedmemory { SharedMemoryInputStream, SharedMemoryOutputStream, uniqueName };
import std.os.internal.frames { Frames, framed, lengthOf };

/** What went wrong with a call. */
public enum RpcError {
    /** The other program answered with an error: its code and message. */
    Failed(code: int64, message: String),
    /** The other program cannot be reached any more: it ended, closed, or sent what is not a message. */
    Ended(why: String),
    /** The answer did not come in time. */
    TimedOut
}

/** A message for the error, in English. */
public function message(e: RpcError): String {
    return switch (e) {
        case Failed { code, message } -> "error ${code}: ${message}";
        case Ended { why } -> "ended: ${why}";
        case TimedOut -> "timed out";
    };
}

/** The ring of each shared stream of a call. */
const SHARED_SIZE: int32 = 1048576;

/** The environment variable that tells a program the names of its shared streams. */
const SHARED_ENV: String = "LARIMAR_RPC";

/** One call that came: what it asks for. The handler answers with what it returns, or with fail(). */
public class RpcCall {
    let method: String;
    let params: Any;
    let code: int64 = 0;
    let text: String = "";

    /** Answers with an error instead of a result (JSON-RPC: -32601 no such method, -32602 bad params...). */
    function fail(code: int64, message: String): void {
        self.code = code;
        self.text = message.clone();
    }

    function failed(): bool { return self.code != 0; }
}

// ---- messages: Content-Length, then the JSON --------------------------------------------------------

/** Where messages come from and go to. */
interface Wire {
    /** The next message, waiting up to `ms` (0: as long as it takes); null when the other side closed. */
    function receive(ms: int32): String? throws RpcError;
    function send(text: String): void throws RpcError;
    function close(): void;
}

/** Messages over two streams (a socket, a pipe...): reads wait as long as the stream does. */
class StreamWire implements Wire {
    let input: InputStream;
    let output: OutputStream;
    let frames: Frames = {};

    override function receive(ms: int32): String? throws RpcError {
        while (true) {
            let m: String? = self.frames.next();
            if (m != null) { return m; }
            try {
                if (!self.frames.fill(self.input)) { return null; }
            } catch (IoError e) {
                throw RpcError.Ended("cannot read: the other side closed".clone());
            }
        }
        return null;
    }

    override function send(text: String): void throws RpcError {
        try {
            self.output.write(framed(text).bytes());
            self.output.flush();
        } catch (IoError e) {
            throw RpcError.Ended("cannot write: the other side closed".clone());
        }
    }

    override function close(): void {}
}

/** Messages through two shared streams, to a program this one started (or from the one that started it). */
class SharedWire implements Wire {
    let input: SharedMemoryInputStream;
    let output: SharedMemoryOutputStream;
    let process: Child? = null;
    let frames: Frames = {};

    override function receive(ms: int32): String? throws RpcError {
        let until: int64 = Time.monotonic() + (ms as int64);
        while (true) {
            let m: String? = self.frames.next();
            if (m != null) { return m; }
            self.input.timeout = 200;
            try {
                if (!self.frames.fill(self.input)) { return null; }
            } catch (IoError e) {
                let timedOut: bool = switch (e) {
                    case TimedOut -> true;
                    default -> false;
                };
                if (!timedOut) { throw RpcError.Ended(ended(self.process).clone()); }
                if (self.process != null && self.process!.wait(0) != null) { throw RpcError.Ended(ended(self.process).clone()); }
                if (ms > 0 && Time.monotonic() >= until) { throw RpcError.TimedOut; }
            }
        }
        return null;
    }

    override function send(text: String): void throws RpcError {
        try {
            self.output.write(framed(text).bytes());
        } catch (IoError e) {
            throw RpcError.Ended(ended(self.process).clone());
        }
    }

    override function close(): void {
        try {
            self.output.close();
            self.input.close();
        } catch (IoError e) {}
    }
}

/** Messages through the pipes of a program this one started. */
class PipeWire implements Wire {
    let process: Child;

    override function receive(ms: int32): String? throws RpcError {
        let until: int64 = Time.monotonic() + (ms as int64);
        let length: int32 = -1;
        while (true) {
            let line: String? = self.process.readLine(200);
            if (line == null) {
                if (self.process.wait(0) != null) { throw RpcError.Ended(ended(self.process).clone()); }
                if (ms > 0 && Time.monotonic() >= until) { throw RpcError.TimedOut; }
                continue;
            }
            if (line!.trim() == "") {
                if (length < 0) { continue; }
                let body: String? = self.process.read(length, ms > 0 ? ms : 600000);
                if (body == null) { throw RpcError.Ended(ended(self.process).clone()); }
                return body;
            }
            let n: int32 = lengthOf(line!);
            if (n >= 0) { length = n; }
        }
        return null;
    }

    override function send(text: String): void throws RpcError {
        if (!self.process.send(framed(text))) { throw RpcError.Ended(ended(self.process).clone()); }
    }

    override function close(): void { self.process.closeInput(); }
}

/** Why the other program cannot be reached: it ended (and how), or it closed. */
function ended(p: Child?): String {
    if (p != null) {
        let code: int32? = p!.wait(1000);
        if (code != null) { return "the program ended (exit ${code!})"; }
    }
    return "the other program closed the connection";
}

// ---- the program that calls -------------------------------------------------------------------------

/** A connection to a program that answers calls. It closes when its memory is freed. */
public class Rpc {
    let wire: Wire;
    let process: Child? = null;
    let nextId: int64 = 1;
    /** How long a call may wait for its answer, in ms (0: as long as it takes). */
    let timeout: int32 = 0;

    /**
     * Starts the program of a Process (std.os.process), which answers JSON-RPC on its standard input and
     * output (any program): Rpc reads and writes them.
     */
    static function start(process: Child): Rpc throws RpcError {
        refuse(process);
        let why: String? = process.launch();
        if (why != null) { throw RpcError.Ended("cannot start ${process.program}: ${why!}".clone()); }
        return Rpc { wire: PipeWire { process }, process };
    }

    /**
     * Starts the program of a Process, a Larimar program that answers with serve(): the calls go through
     * shared memory (it adds LARIMAR_RPC to the Process's env), and its standard output stays this
     * console's.
     */
    static function startShared(process: Child): Rpc throws RpcError {
        refuse(process);
        let requests: String = uniqueName("rq");
        let answers: String = uniqueName("rs");
        let out: SharedMemoryOutputStream? = null;
        let input: SharedMemoryInputStream? = null;
        try {
            out = SharedMemoryOutputStream.create(requests, SHARED_SIZE);
            input = SharedMemoryInputStream.create(answers, SHARED_SIZE);
        } catch (IoError e) {
            throw RpcError.Ended("cannot make the shared streams".clone());
        }
        process.env.push("${SHARED_ENV}=${requests},${answers}");
        process.shareConsole = true;
        let why: String? = process.launch();
        if (why != null) { throw RpcError.Ended("cannot start ${process.program}: ${why!}".clone()); }
        return Rpc { wire: SharedWire { input: input!, output: out!, process }, process };
    }

    /** Calls over two streams that already exist (a socket, for example). */
    static function over(input: InputStream, output: OutputStream): Rpc {
        return Rpc { wire: StreamWire { input, output } };
    }

    /** Calls `method` and waits for its answer: the result, or RpcError. */
    function call(method: String, params: Any): Any throws RpcError {
        return self.finish(self.begin(method, params));
    }

    /** Sends a call and does not wait: its id, for finish (calls to several programs at once). */
    function begin(method: String, params: Any): int64 throws RpcError {
        let id: int64 = self.nextId;
        self.nextId += 1;
        let request: Any = { jsonrpc: "2.0", id: id, method: method, params: params };
        self.wire.send(Json.stringify(request));
        return id;
    }

    /** Waits for the answer of the call `id` (what begin gave): the result, or RpcError. */
    function finish(id: int64): Any throws RpcError {
        while (true) {
            let body: String? = self.wire.receive(self.timeout);
            if (body == null) { throw RpcError.Ended(ended(self.process).clone()); }
            let answer: Any = null;
            try {
                answer = Json.parse(body!);
            } catch (JsonError e) {
                throw RpcError.Ended("the answer is not JSON".clone());
            }
            if ((answer.id as int64 ?? -1) != id) { continue; }      // a notice, or the answer of an older call
            if (answer.error != null) {
                throw RpcError.Failed(answer.error.code as int64 ?? 0, (answer.error.message as String ?? "").clone());
            }
            return answer.result.clone();
        }
        return null;
    }

    /** Sends `method` without waiting for an answer (a notification: the other program answers nothing). */
    function notify(method: String, params: Any): void throws RpcError {
        let request: Any = { jsonrpc: "2.0", method: method, params: params };
        self.wire.send(Json.stringify(request));
    }

    /** Closes the connection: the other program sees the end (serve returns), and this one waits for it. */
    function close(): void {
        self.wire.close();
        if (self.process != null) {
            if (self.process!.wait(5000) == null) { self.process!.kill(); }
        }
    }

    /** Ends the other program now, if this one started it. */
    function stop(): void {
        self.wire.close();
        if (self.process != null) { self.process!.kill(); }
    }
}

/** What Rpc does not start: a task, nothing, or what was started already. */
function refuse(process: Child): void throws RpcError {
    if (process.hasTask()) {
        throw RpcError.Ended("the Process has a task, not a program: start it with start() and wait for it with join()".clone());
    }
    if (process.program == "") { throw RpcError.Ended("the Process has no program".clone()); }
    if (process.started()) { throw RpcError.Ended("the Process was started already: Rpc starts it".clone()); }
}

// ---- the program that answers -----------------------------------------------------------------------

/**
 * Answers the calls that come, one after another, with `handler`, until the caller closes: on the shared
 * streams this program was started with (Rpc.startShared), or else on its standard input and output.
 */
public function serve(handler: (RpcCall) -> Any): void {
    let names: String = os.env(SHARED_ENV) ?? "";
    if (names == "") {
        Console.binaryMode();
        answer(StreamWire { input: Console.input, output: Console.output }, handler);
        return;
    }
    let parts: String[*] = names.split(",");
    if (parts.length != 2) {
        Console.printError("${SHARED_ENV}=${names}: two names were expected");
        return;
    }
    try {
        let input: SharedMemoryInputStream = SharedMemoryInputStream.open(parts[0], 10000);
        let output: SharedMemoryOutputStream = SharedMemoryOutputStream.open(parts[1], 10000);
        answer(SharedWire { input, output }, handler);
    } catch (IoError e) {
        Console.printError("cannot open the shared streams ${names}");
    }
}

/** Answers the calls that come on two streams that already exist, until the input ends. */
public function serveOver(input: InputStream, output: OutputStream, handler: (RpcCall) -> Any): void {
    answer(StreamWire { input, output }, handler);
}

function answer(wire: Wire, handler: (RpcCall) -> Any): void {
    while (true) {
        let body: String? = null;
        try {
            body = wire.receive(0);
        } catch (RpcError e) {
            return;
        }
        if (body == null) { return; }
        let request: Any = null;
        let parsed: bool = true;
        try {
            request = Json.parse(body!);
        } catch (JsonError e) {
            parsed = false;
        }
        if (!parsed) {
            reply(wire, { jsonrpc: "2.0", id: null, error: { code: -32700, message: "the request is not JSON" } });
            continue;
        }
        let method: String? = request.method as String;
        if (method == null) {
            if (request.id != null) { reply(wire, { jsonrpc: "2.0", id: request.id, error: { code: -32600, message: "a request has a method" } }); }
            continue;
        }
        let call: RpcCall = { method: method!, params: request.params };
        let result: Any = handler(call);
        if (request.id == null) { continue; }          // a notification: no answer
        if (call.failed()) {
            reply(wire, { jsonrpc: "2.0", id: request.id, error: { code: call.code, message: call.text } });
        } else {
            reply(wire, { jsonrpc: "2.0", id: request.id, result: result });
        }
    }
}

function reply(wire: Wire, answer: Any): void {
    try {
        wire.send(Json.stringify(answer));
    } catch (RpcError e) {}
}
