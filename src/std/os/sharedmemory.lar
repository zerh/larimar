// std.os.sharedmemory: memory that several programs see. A stream is a queue (each message once, in
// order, from one writer to one reader); a segment is a board (bytes at offsets, the latest value written
// there, which any program that opens it reads).
//
//   import std.os.sharedmemory { SharedMemoryOutputStream, SharedMemoryInputStream, SharedMemorySegment };
//
//   // one program
//   let out: SharedMemoryOutputStream = SharedMemoryOutputStream.create("frames", 1 << 20);   // 1 MB of shared memory
//   out.write(frame);                       // waits while it is full: the other one reads at its pace
//   out.close();                            // the reader sees the end after what was written
//
//   // another program
//   let input: SharedMemoryInputStream = SharedMemoryInputStream.open("frames", 5000);        // waits up to 5 s for it
//   let n: int32 = input.read(buffer);      // 0: the writer closed it and everything was read
//
// A name is the meeting point: one program creates it (as writer or as reader), the other opens it; each
// stream has one writer and one reader. The bytes go through a ring in shared memory, with no copy through
// the system and no system call while there is something to read or room to write; a side that has to
// wait spins for a moment and then sleeps in short steps. If the other program ends without closing, the
// waiting side gets IoError.Closed instead of waiting forever. The name is freed as soon as the other side
// opens it (or when the creator closes it). A stream closes itself when its memory is freed.
//
//   // a segment: one program creates it, others open it
//   let board: SharedMemorySegment = SharedMemorySegment.create("scores", 4096);
//   board.putInt64(0, 42);
//   let seen: SharedMemorySegment = SharedMemorySegment.open("scores", 5000);    // in another program
//   let n: int64 = seen.getInt64(0);                                             // 42
//
// Every get and put is checked against the segment's size (outside it: a panic, as an index of a list).
// An int64 at an offset that is a multiple of 8 is read and written whole: whoever reads a value with
// getInt64 also sees what was written before it was put (a number of frame, a flag of "ready"). The name
// stays while its creator has it open.
//
// The streams are streams like a file or a socket: a Reader, copy(), and anything that takes an InputStream or an
// OutputStream works with them. Names: letters, digits, '.', '_' and '-', at most 26 of them;
// uniqueName("rpc") gives one that no other program uses.

import std.io { IoError, InputStream, OutputStream, Closeable };
import std.os;
import std.os.sharedmemory.common;
import std.os.sharedmemory.posix { PosixSharedMemory };
import std.os.sharedmemory.windows { WindowsSharedMemory };

native type SharedHandle = LarSharedMemory* released by lar_shared_free;
native function lar_shared_free(h: SharedHandle): void;
native function lar_shared_create(name: String, capacity: int64, reader: int32): SharedHandle?;
native function lar_shared_open(name: String, reader: int32, ms: int32): SharedHandle?;
native function lar_shared_error(h: SharedHandle): int32;
native function lar_shared_error_text(h: SharedHandle): String;
native function lar_shared_write(h: SharedHandle, bytes: byte*, count: int64, ms: int32): int32;
native function lar_shared_read(h: SharedHandle, into: byte*, size: int32, ms: int32): int32;
native function lar_shared_available(h: SharedHandle): int64;
native function lar_shared_capacity(h: SharedHandle): int64;
native function lar_shared_close(h: SharedHandle): void;
native function lar_shared_segment_create(name: String, capacity: int64): SharedHandle?;
native function lar_shared_segment_open(name: String, ms: int32): SharedHandle?;
native function lar_shared_get_int64(h: SharedHandle, at: int64): int64;
native function lar_shared_put_int64(h: SharedHandle, at: int64, v: int64): void;
native function lar_shared_get_int32(h: SharedHandle, at: int64): int32;
native function lar_shared_put_int32(h: SharedHandle, at: int64, v: int32): void;
native function lar_shared_get_float64(h: SharedHandle, at: int64): float64;
native function lar_shared_put_float64(h: SharedHandle, at: int64, v: float64): void;
native function lar_shared_get_byte(h: SharedHandle, at: int64): byte;
native function lar_shared_put_byte(h: SharedHandle, at: int64, v: byte): void;
native function lar_shared_get_bytes(h: SharedHandle, at: int64, into: byte*, count: int32): void;
native function lar_shared_put_bytes(h: SharedHandle, at: int64, bytes: byte*, count: int32): void;

/** The most bytes a name may have (the shortest limit of the systems, macOS's). */
const NAME_LIMIT: int32 = 26;

/** What a result of the C means: the error of IoError. */
function fail(code: int32, name: String, why: String): void throws IoError {
    if (code == -1 || code == -3) { throw IoError.Closed; }         // closed by the other side, or it ended
    if (code == -2) { throw IoError.TimedOut; }
    if (code == -4) { throw IoError.NotFound("shared memory ${name}".clone()); }
    throw IoError.Failed("shared memory ${name}: ${why}".clone());
}

/** Whether a name can be the name of a stream. */
function goodName(name: String): bool {
    if (name.length == 0 || name.length > NAME_LIMIT) { return false; }
    for (b in name) {
        let ok: bool = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '.' || b == '_' || b == '-';
        if (!ok) { return false; }
    }
    return true;
}

function checkName(name: String): void throws IoError {
    if (!goodName(name)) {
        throw IoError.Failed("shared memory '${name}': a name has 1 to ${NAME_LIMIT} letters, digits, '.', '_' or '-'".clone());
    }
}

/** Starts one: the handle, or the error. */
function made(h: SharedHandle?, name: String): SharedHandle throws IoError {
    if (h == null) { throw IoError.Failed("shared memory ${name}: out of memory".clone()); }
    let code: int32 = lar_shared_error(h!);
    if (code != 0) { fail(code, name, lar_shared_error_text(h!)); }
    return h!;
}

let counter: Counter = {};

synchronized class Counter {
    let n: int32 = 0;
    function next(): int32 {
        self.n += 1;
        return self.n;
    }
}

/** A name for a new stream that no other program uses: the prefix (at most 8 bytes), this program's id, a count. */
public function uniqueName(prefix: String): String {
    let p: String = prefix.length > 8 ? prefix.substring(0, 8) : prefix;
    return "${p}-${os.processId()}-${counter.next()}";
}

/** The writing side of a stream between two programs. */
public class SharedMemoryOutputStream implements OutputStream, Closeable {
    let name: String;
    let handle: SharedHandle? = null;
    /** How long a write may wait for room, in ms (0: as long as it takes). */
    let timeout: int32 = 0;

    /** Creates the stream `name` with room for `capacity` bytes (at least 4096); the other program opens it as a reader. */
    static function create(name: String, capacity: int32): SharedMemoryOutputStream throws IoError {
        checkName(name);
        let size: int64 = capacity < 4096 ? 4096 : capacity as int64;
        return SharedMemoryOutputStream { name: name.clone(), handle: made(lar_shared_create(name, size, 0), name) };
    }

    /** Opens the stream `name` that a reader created, waiting up to `ms` for it to exist (0: only now). */
    static function open(name: String, ms: int32): SharedMemoryOutputStream throws IoError {
        checkName(name);
        return SharedMemoryOutputStream { name: name.clone(), handle: made(lar_shared_open(name, 0, ms), name) };
    }

    /** Writes all the bytes, waiting while the ring is full. IoError.Closed: the reader closed it, or ended. */
    override function write(bytes: byte[]): void throws IoError {
        if (self.handle == null) { throw IoError.Closed; }
        if (bytes.length == 0) { return; }
        let r: int32 = lar_shared_write(self.handle!, bytes, bytes.length as int64, self.timeout);
        if (r < 0) { fail(r, self.name, "cannot write"); }
    }

    /** Nothing to do: what is written is already there for the reader. */
    override function flush(): void throws IoError {}

    /** The end: the reader reads what was written, then 0. */
    override function close(): void throws IoError {
        if (self.handle != null) { lar_shared_close(self.handle!); }
    }

    /** How many bytes the ring holds. */
    function capacity(): int64 { return self.handle != null ? lar_shared_capacity(self.handle!) : 0; }
}

/** The reading side of a stream between two programs. */
public class SharedMemoryInputStream implements InputStream, Closeable {
    let name: String;
    let handle: SharedHandle? = null;
    /** How long a read may wait for bytes, in ms (0: as long as it takes); then IoError.TimedOut. */
    let timeout: int32 = 0;

    /** Creates the stream `name` with room for `capacity` bytes (at least 4096); the other program opens it as a writer. */
    static function create(name: String, capacity: int32): SharedMemoryInputStream throws IoError {
        checkName(name);
        let size: int64 = capacity < 4096 ? 4096 : capacity as int64;
        return SharedMemoryInputStream { name: name.clone(), handle: made(lar_shared_create(name, size, 1), name) };
    }

    /** Opens the stream `name` that a writer created, waiting up to `ms` for it to exist (0: only now). */
    static function open(name: String, ms: int32): SharedMemoryInputStream throws IoError {
        checkName(name);
        return SharedMemoryInputStream { name: name.clone(), handle: made(lar_shared_open(name, 1, ms), name) };
    }

    /**
     * Fills buffer with what has arrived (waiting until something does): how many bytes; 0 when the writer
     * closed the stream and everything was read. IoError.Closed: the writer ended without closing it.
     */
    override function read(buffer: byte[]): int32 throws IoError {
        if (self.handle == null) { return 0; }
        if (buffer.length == 0) { return 0; }
        let r: int32 = lar_shared_read(self.handle!, buffer, buffer.length, self.timeout);
        if (r < 0) { fail(r, self.name, "cannot read"); }
        return r;
    }

    /** How many bytes can be read now, without waiting. */
    function available(): int64 { return self.handle != null ? lar_shared_available(self.handle!) : 0; }

    /** Stops reading: the writer's next write gets IoError.Closed. */
    override function close(): void throws IoError {
        if (self.handle != null) { lar_shared_close(self.handle!); }
    }
}

/**
 * Memory that several programs see, by name: bytes at offsets, read and written with get and put. One
 * program creates it; the others open it. It closes itself when its memory is freed.
 */
public class SharedMemorySegment implements Closeable {
    let name: String;
    let handle: SharedHandle? = null;
    let bytes: int64 = 0;

    /** Creates the segment `name` with `size` bytes (all 0); other programs open it by its name. */
    static function create(name: String, size: int32): SharedMemorySegment throws IoError {
        checkName(name);
        if (size < 1) { throw IoError.Failed("shared memory ${name}: a segment has 1 byte or more".clone()); }
        let h: SharedHandle = made(lar_shared_segment_create(name, size as int64), name);
        return SharedMemorySegment { name: name.clone(), handle: h, bytes: lar_shared_capacity(h) };
    }

    /** Opens the segment `name` that another program created, waiting up to `ms` for it to exist (0: only now). */
    static function open(name: String, ms: int32): SharedMemorySegment throws IoError {
        checkName(name);
        let h: SharedHandle = made(lar_shared_segment_open(name, ms), name);
        return SharedMemorySegment { name: name.clone(), handle: h, bytes: lar_shared_capacity(h) };
    }

    /** How many bytes it has. */
    function size(): int64 { return self.bytes; }

    function getInt64(offset: int64): int64 { return lar_shared_get_int64(self.at(offset, 8), offset); }
    function putInt64(offset: int64, value: int64): void { lar_shared_put_int64(self.at(offset, 8), offset, value); }
    function getInt32(offset: int64): int32 { return lar_shared_get_int32(self.at(offset, 4), offset); }
    function putInt32(offset: int64, value: int32): void { lar_shared_put_int32(self.at(offset, 4), offset, value); }
    function getFloat64(offset: int64): float64 { return lar_shared_get_float64(self.at(offset, 8), offset); }
    function putFloat64(offset: int64, value: float64): void { lar_shared_put_float64(self.at(offset, 8), offset, value); }
    function getByte(offset: int64): byte { return lar_shared_get_byte(self.at(offset, 1), offset); }
    function putByte(offset: int64, value: byte): void { lar_shared_put_byte(self.at(offset, 1), offset, value); }

    /** Copies into `into` the bytes from `offset` on (as many as `into` has). */
    function getBytes(offset: int64, into: byte[]): void {
        if (into.length > 0) { lar_shared_get_bytes(self.at(offset, into.length as int64), offset, into, into.length); }
    }

    /** Writes `bytes` from `offset` on. */
    function putBytes(offset: int64, bytes: byte[]): void {
        if (bytes.length > 0) { lar_shared_put_bytes(self.at(offset, bytes.length as int64), offset, bytes, bytes.length); }
    }

    /** Lets it go: the name is freed when its creator closes it; what other programs mapped stays theirs. */
    override function close(): void throws IoError {
        if (self.handle != null) { lar_shared_close(self.handle!); }
    }

    /** The handle, when `count` bytes from `offset` are inside the segment; a panic when they are not. */
    function at(offset: int64, count: int64): SharedHandle {
        if (self.handle == null) { panic("shared memory ${self.name}: the segment is closed"); }
        if (offset < 0 || offset + count > self.bytes) {
            panic("shared memory ${self.name}: ${count} byte(s) at offset ${offset} are outside its ${self.bytes} bytes");
        }
        return self.handle!;
    }
}
