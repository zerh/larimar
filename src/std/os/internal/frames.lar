// std.os.internal.frames: messages over a stream, each one a Content-Length header and then its text (as
// in LSP). std.os.rpc and the tasks of std.os.process send their messages this way.

import std.io { IoError, InputStream };

/** The text of a message: its header and its JSON. */
public function framed(json: String): String { return "Content-Length: ${json.length}\r\n\r\n${json}"; }

/** The length a header says (-1 when it is not Content-Length). */
public function lengthOf(line: String): int32 {
    let i: int32? = line.indexOf(":");
    if (i == null || line.substring(0, i!).trim().toLowerCase() != "content-length") { return -1; }
    return (line.substring(i! + 1).trim().toInt() ?? -1) as int32;
}

/**
 * The messages of a stream: what was read and not given yet stays here, so a read that runs out of time
 * goes on where it was.
 */
public class Frames {
    let pending: byte[*] = [];
    let taken: int32 = 0;
    let chunk: byte[*] = [];

    /** The next message if it is all here, else null. */
    function next(): String? {
        let i: int32 = self.taken;
        let length: int32 = -1;
        let lineStart: int32 = i;
        while (i < self.pending.length) {
            if (self.pending[i] == '\n') {
                let end: int32 = i > lineStart && self.pending[i - 1] == '\r' ? i - 1 : i;
                if (end == lineStart) {                    // the empty line: the JSON follows
                    if (length < 0 || self.pending.length - (i + 1) < length) { return null; }
                    let body: String = stringOfRange(self.pending, i + 1, i + 1 + length);
                    self.taken = i + 1 + length;
                    return body;
                }
                let n: int32 = lengthOf(stringOfRange(self.pending, lineStart, end));
                if (n >= 0) { length = n; }
                lineStart = i + 1;
            }
            i += 1;
        }
        return null;
    }

    /** Reads more from `input`: false at its end. */
    function fill(input: InputStream): bool throws IoError {
        if (self.chunk.length == 0) {
            for (k in 0..65536) { self.chunk.push(0); }
        }
        if (self.taken > 0 && self.taken == self.pending.length) {
            self.pending.clear();
            self.taken = 0;
        } else if (self.taken > 65536 && self.taken * 2 > self.pending.length) {
            let kept: byte[*] = [];
            for (k in self.taken..self.pending.length) { kept.push(self.pending[k]); }
            self.pending.clear();
            for (b in kept) { self.pending.push(b); }
            self.taken = 0;
        }
        let n: int32 = input.read(self.chunk);
        if (n == 0) { return false; }
        for (k in 0..n) { self.pending.push(self.chunk[k]); }
        return true;
    }
}
