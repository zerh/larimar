// std.net.tls.openssl: the TLS client on Linux, over the OpenSSL of std.net's servers.

import std.net.tls.common;
import std.net.openssl;
import std.platform { LinuxPlatform };

/** Linux: OpenSSL, loaded at run time (std.net's, shared with its TLS servers). */
public class OpenSslTls implements LinuxPlatform {
    ccode {
        /* ---------------- Linux and others: OpenSSL ----------------------------------------------------
           Over the TcpSocket's descriptor, with the OpenSSL of std.net (loaded the first time https:// is
           used, and shared with its TLS servers): the connection, its reading, writing and errors are
           std.net's; this is only what a client does differently (its context, the name it checks). */
        #include <errno.h>
        #include <arpa/inet.h>

        typedef LarOpenSslConn LarTls;

        static bool lar_tls_needs_socket(void) { return true; }

        static bool lar_tls_is_ip(const char* host) {
            unsigned char a[16];
            return inet_pton(AF_INET, host, a) == 1 || inet_pton(AF_INET6, host, a) == 1;
        }

        static void lar_tls_close(LarTls* t) { lar_openssl_close(t); }

        static LarTls* lar_tls_open_host(LarMemory* m, const char* host, int32_t port, bool verify, int32_t timeoutMs) {   /* not used here */
            (void)host; (void)port; (void)verify; (void)timeoutMs;
            LarTls* t = lar_openssl_conn(m);
            t->error = 51;
            return t;
        }

        /* over a connected socket, with its timeouts */
        static LarTls* lar_tls_open_socket(LarMemory* m, int fd, const char* host, bool verify) {
            LarTls* t = lar_openssl_conn(m);
            if (!lar_openssl_load()) { t->error = 51; memcpy(t->text, lar_openssl_missing, LAR_OPENSSL_TEXT); return t; }
            lar_ossl.ERR_clear_error();
            t->ctx = lar_ossl.SSL_CTX_new(lar_ossl.TLS_client_method());
            if (!t->ctx) { t->error = 50; lar_openssl_error(t->text, "cannot create a TLS context"); return t; }
            lar_memory_on_free(m, lar_openssl_final, t, 0);
            lar_ossl.SSL_CTX_ctrl(t->ctx, 123, 0x0303, NULL);          /* SSL_CTX_set_min_proto_version: TLS 1.2 */
            if (lar_ossl.OpenSSL_version_num() >= 0x30000000UL) {
                lar_ossl.SSL_CTX_ctrl(t->ctx, 32, 1L << 7, NULL);        /* SSL_OP_IGNORE_UNEXPECTED_EOF: an end, not an error */
            }
            if (verify) {
                lar_ossl.SSL_CTX_set_default_verify_paths(t->ctx);      /* the system's trusted certificates */
                lar_ossl.SSL_CTX_set_verify(t->ctx, 1, NULL);           /* SSL_VERIFY_PEER */
            }
            t->ssl = lar_ossl.SSL_new(t->ctx);
            if (!t->ssl) { t->error = 50; lar_openssl_error(t->text, "cannot create a TLS connection"); return t; }
            lar_ossl.SSL_set_fd(t->ssl, (int)fd);
            bool ip = lar_tls_is_ip(host);
            if (!ip) lar_ossl.SSL_ctrl(t->ssl, 55, 0, (void*)host);        /* SNI: SSL_set_tlsext_host_name */
            if (verify) {
                if (ip) lar_ossl.X509_VERIFY_PARAM_set1_ip_asc(lar_ossl.SSL_get0_param(t->ssl), host);
                else lar_ossl.SSL_set1_host(t->ssl, host);
            }
            errno = 0;
            int r = lar_ossl.SSL_connect(t->ssl);
            if (r != 1) {
                long v = lar_ossl.SSL_get_verify_result(t->ssl);
                if (verify && v != 0) {
                    t->error = 50;
                    snprintf(t->text, LAR_OPENSSL_TEXT, "certificate rejected: %s", lar_ossl.X509_verify_cert_error_string(v));
                } else if (lar_openssl_io_error(t, r, "handshake failed") == 0) {
                    t->eof = false;
                    t->error = 50;
                    snprintf(t->text, LAR_OPENSSL_TEXT, "the server closed the connection during the handshake");
                }
                return t;
            }
            t->open = true;
            return t;
        }

        static int32_t lar_tls_read(LarTls* t, uint8_t* items, int32_t len) { return lar_openssl_read(t, items, len); }
        static int32_t lar_tls_write(LarTls* t, const uint8_t* items, int32_t len) { return lar_openssl_write(t, items, len); }
    }
}
