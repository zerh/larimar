// std.net.openssl: the TLS servers on Unix, over OpenSSL loaded at run time (std.net.tls's client on
// Linux uses it too).

import std.platform { UnixPlatform, LinuxPlatform, MacOSPlatform };

ccode {
    #define LAR_NET_TLS_SERVER       /* larimar build: -ldl on Linux */
    #define LAR_OPENSSL_TEXT 300
}

/** Where OpenSSL is on Linux, and what to say when it is not there. */
public class LinuxOpenSslNames implements LinuxPlatform {
    ccode {
        static const char* lar_openssl_names[] = { "libssl.so.3", "libssl.so.1.1", "libssl.so", 0 };
        static const char* lar_openssl_hint = "OpenSSL not found (tried libssl.so.3, libssl.so.1.1, libssl.so)";
    }
}

/** Where OpenSSL is on macOS (Homebrew), and what to say when it is not there. */
public class MacOSOpenSslNames implements MacOSPlatform {
    ccode {
        static const char* lar_openssl_names[] = {
            "libssl.3.dylib", "/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib",
            "/usr/local/opt/openssl@3/lib/libssl.3.dylib", 0 };
        static const char* lar_openssl_hint = "OpenSSL not found: brew install openssl@3";
    }
}

/** The TLS servers on Unix: OpenSSL, loaded at run time (std.net.tls's client on Linux uses it too). */
public class OpenSslServers implements UnixPlatform {
    ccode {
        #include <dlfcn.h>
        #include <errno.h>
        #include <sched.h>

        /* ---- the library: loaded once, by whichever thread comes first */
        typedef struct LarOpenSslCtx LarOpenSslCtx;
        typedef struct LarOpenSslSsl LarOpenSslSsl;
        typedef struct {
            const void* (*TLS_client_method)(void);
            const void* (*TLS_server_method)(void);
            LarOpenSslCtx* (*SSL_CTX_new)(const void*);
            void (*SSL_CTX_free)(LarOpenSslCtx*);
            long (*SSL_CTX_ctrl)(LarOpenSslCtx*, int, long, void*);
            int (*SSL_CTX_set_default_verify_paths)(LarOpenSslCtx*);
            void (*SSL_CTX_set_verify)(LarOpenSslCtx*, int, void*);
            int (*SSL_CTX_use_certificate_chain_file)(LarOpenSslCtx*, const char*);
            int (*SSL_CTX_use_PrivateKey_file)(LarOpenSslCtx*, const char*, int);
            int (*SSL_CTX_check_private_key)(const LarOpenSslCtx*);
            LarOpenSslSsl* (*SSL_new)(LarOpenSslCtx*);
            void (*SSL_free)(LarOpenSslSsl*);
            int (*SSL_set_fd)(LarOpenSslSsl*, int);
            long (*SSL_ctrl)(LarOpenSslSsl*, int, long, void*);
            int (*SSL_set1_host)(LarOpenSslSsl*, const char*);
            void* (*SSL_get0_param)(LarOpenSslSsl*);
            int (*SSL_connect)(LarOpenSslSsl*);
            int (*SSL_accept)(LarOpenSslSsl*);
            int (*SSL_read)(LarOpenSslSsl*, void*, int);
            int (*SSL_write)(LarOpenSslSsl*, const void*, int);
            int (*SSL_shutdown)(LarOpenSslSsl*);
            int (*SSL_get_error)(const LarOpenSslSsl*, int);
            long (*SSL_get_verify_result)(const LarOpenSslSsl*);
            int (*X509_VERIFY_PARAM_set1_ip_asc)(void*, const char*);
            const char* (*X509_verify_cert_error_string)(long);
            unsigned long (*ERR_get_error)(void);
            void (*ERR_error_string_n)(unsigned long, char*, size_t);
            void (*ERR_clear_error)(void);
            unsigned long (*OpenSSL_version_num)(void);
        } LarOpenSslApi;
        static LarOpenSslApi lar_ossl;
        static volatile int lar_openssl_state;             /* 0 not tried, 3 loading, 1 loaded, 2 missing */
        static char lar_openssl_missing[LAR_OPENSSL_TEXT];

        static bool lar_openssl_load_now(void) {
            const char** names = lar_openssl_names;           /* the system's: OpenSslNames */
            void* h = NULL;
            for (int i = 0; names[i] && !h; i++) h = dlopen(names[i], RTLD_NOW | RTLD_LOCAL);
            if (!h) {
                snprintf(lar_openssl_missing, LAR_OPENSSL_TEXT, "%s", lar_openssl_hint);
                return false;
            }
            #define LAR_OPENSSL_SYM(name) \
                *(void**)(&lar_ossl.name) = dlsym(h, #name); \
                if (!lar_ossl.name) { \
                    snprintf(lar_openssl_missing, LAR_OPENSSL_TEXT, "OpenSSL 1.1 or newer is needed (missing " #name ")"); \
                    return false; \
                }
            LAR_OPENSSL_SYM(TLS_client_method) LAR_OPENSSL_SYM(TLS_server_method) LAR_OPENSSL_SYM(SSL_CTX_new)
            LAR_OPENSSL_SYM(SSL_CTX_free) LAR_OPENSSL_SYM(SSL_CTX_ctrl) LAR_OPENSSL_SYM(SSL_CTX_set_default_verify_paths)
            LAR_OPENSSL_SYM(SSL_CTX_set_verify) LAR_OPENSSL_SYM(SSL_CTX_use_certificate_chain_file)
            LAR_OPENSSL_SYM(SSL_CTX_use_PrivateKey_file) LAR_OPENSSL_SYM(SSL_CTX_check_private_key) LAR_OPENSSL_SYM(SSL_new)
            LAR_OPENSSL_SYM(SSL_free) LAR_OPENSSL_SYM(SSL_set_fd) LAR_OPENSSL_SYM(SSL_ctrl) LAR_OPENSSL_SYM(SSL_set1_host)
            LAR_OPENSSL_SYM(SSL_get0_param) LAR_OPENSSL_SYM(SSL_connect) LAR_OPENSSL_SYM(SSL_accept) LAR_OPENSSL_SYM(SSL_read)
            LAR_OPENSSL_SYM(SSL_write) LAR_OPENSSL_SYM(SSL_shutdown) LAR_OPENSSL_SYM(SSL_get_error)
            LAR_OPENSSL_SYM(SSL_get_verify_result) LAR_OPENSSL_SYM(X509_VERIFY_PARAM_set1_ip_asc)
            LAR_OPENSSL_SYM(X509_verify_cert_error_string) LAR_OPENSSL_SYM(ERR_get_error) LAR_OPENSSL_SYM(ERR_error_string_n)
            LAR_OPENSSL_SYM(ERR_clear_error) LAR_OPENSSL_SYM(OpenSSL_version_num)
            #undef LAR_OPENSSL_SYM
            return true;
        }

        static bool lar_openssl_load(void) {
            for (;;) {
                int state = lar_openssl_state;
                if (state == 1 || state == 2) return state == 1;
                if (state == 0 && __sync_bool_compare_and_swap(&lar_openssl_state, 0, 3)) {
                    int done = lar_openssl_load_now() ? 1 : 2;
                    __sync_synchronize();
                    lar_openssl_state = done;
                    return done == 1;
                }
                sched_yield();
            }
        }

        /* the text of OpenSSL's last error, after what */
        static void lar_openssl_error(char* text, const char* what) {
            unsigned long e = lar_ossl.ERR_get_error();
            char buf[200];
            if (e) { lar_ossl.ERR_error_string_n(e, buf, sizeof buf); snprintf(text, LAR_OPENSSL_TEXT, "%s: %s", what, buf); }
            else snprintf(text, LAR_OPENSSL_TEXT, "%s", what);
        }

        /* ---- a connection, client or server: the same reading, writing, errors and closing.
           error: 3 timeout, 4 closed, 5 reset, 50 TLS failed (text), 51 TLS unavailable (text), 100+ other */
        typedef struct {
            int32_t error; char text[LAR_OPENSSL_TEXT]; bool open, eof;
            LarOpenSslCtx* ctx;                 /* a client's own context (a server's is shared: NULL here) */
            LarOpenSslSsl* ssl;
        } LarOpenSslConn;

        static LarOpenSslConn* lar_openssl_conn(LarMemory* m) {
            LarOpenSslConn* t = (LarOpenSslConn*)lar_memory_alloc(m, sizeof(LarOpenSslConn), 0);
            memset(t, 0, sizeof *t);
            return t;
        }

        /* the error of a failed SSL_read/SSL_write/SSL_connect/SSL_accept: -1, or 0 when it is the end */
        static int32_t lar_openssl_io_error(LarOpenSslConn* t, int r, const char* what) {
            int e = lar_ossl.SSL_get_error(t->ssl, r);
            if (e == 6) { t->eof = true; t->open = false; return 0; }                 /* SSL_ERROR_ZERO_RETURN */
            if (e == 5 && errno == 0) { t->eof = true; t->open = false; return 0; }   /* closed without close_notify */
            if (e == 5 || e == 2 || e == 3) {                                         /* SYSCALL, WANT_READ/WRITE */
                t->error = errno == EAGAIN || errno == EWOULDBLOCK || errno == ETIMEDOUT || e != 5 ? 3
                         : errno == ECONNRESET || errno == EPIPE ? 5 : 100 + errno;
                snprintf(t->text, LAR_OPENSSL_TEXT, "%s", strerror(errno ? errno : EAGAIN));
                return -1;
            }
            t->error = 50;
            lar_openssl_error(t->text, what);
            return -1;
        }

        static void lar_openssl_close(LarOpenSslConn* t) {
            if (t->open && t->ssl) lar_ossl.SSL_shutdown(t->ssl);
            t->open = false;
        }

        static void lar_openssl_final(void* p) {
            LarOpenSslConn* t = (LarOpenSslConn*)p;
            lar_openssl_close(t);
            if (t->ssl) { lar_ossl.SSL_free(t->ssl); t->ssl = NULL; }
            if (t->ctx) { lar_ossl.SSL_CTX_free(t->ctx); t->ctx = NULL; }
        }

        static int32_t lar_openssl_read(LarOpenSslConn* t, uint8_t* items, int32_t len) {
            if (!t->open) { if (t->eof) return 0; t->error = 4; return -1; }
            if (len <= 0) return 0;
            for (;;) {
                errno = 0;
                lar_ossl.ERR_clear_error();
                int n = lar_ossl.SSL_read(t->ssl, items, len);
                if (n > 0) return n;
                if (errno == EINTR) continue;
                return lar_openssl_io_error(t, n, "read failed");
            }
        }

        static int32_t lar_openssl_write(LarOpenSslConn* t, const uint8_t* items, int32_t len) {
            if (!t->open) { t->error = 4; return -1; }
            int32_t done = 0;
            while (done < len) {
                errno = 0;
                lar_ossl.ERR_clear_error();
                int n = lar_ossl.SSL_write(t->ssl, items + done, len - done);
                if (n > 0) { done += n; continue; }
                if (errno == EINTR) continue;
                if (lar_openssl_io_error(t, n, "write failed") == 0) { t->error = 4; snprintf(t->text, LAR_OPENSSL_TEXT, "closed"); }
                return -1;
            }
            return 0;
        }

        /* ---- a server: the certificate and its key, one context for every connection
           (OpenSSL shares it between threads) */
        typedef struct { int32_t error; char text[LAR_OPENSSL_TEXT]; LarOpenSslCtx* ctx; } LarTlsCtx;

        static void lar_tls_server_context_final(void* p) {
            LarTlsCtx* c = (LarTlsCtx*)p;
            if (c->ctx) { lar_ossl.SSL_CTX_free(c->ctx); c->ctx = NULL; }
        }

        static LarTlsCtx* lar_tls_server_context(LarMemory* m, const char* cert, const char* key) {
            LarTlsCtx* c = (LarTlsCtx*)lar_memory_alloc(m, sizeof(LarTlsCtx), 0);
            memset(c, 0, sizeof *c);
            if (!lar_openssl_load()) { c->error = 51; memcpy(c->text, lar_openssl_missing, LAR_OPENSSL_TEXT); return c; }
            lar_ossl.ERR_clear_error();
            c->ctx = lar_ossl.SSL_CTX_new(lar_ossl.TLS_server_method());
            if (!c->ctx) { c->error = 50; lar_openssl_error(c->text, "cannot create a TLS context"); return c; }
            lar_memory_on_free(m, lar_tls_server_context_final, c, 0);
            lar_ossl.SSL_CTX_ctrl(c->ctx, 123, 0x0303, NULL);                /* SSL_CTX_set_min_proto_version: TLS 1.2 */
            if (lar_ossl.OpenSSL_version_num() >= 0x30000000UL) {
                lar_ossl.SSL_CTX_ctrl(c->ctx, 32, 1L << 7, NULL);              /* SSL_OP_IGNORE_UNEXPECTED_EOF: an end, not an error */
            }
            char what[LAR_OPENSSL_TEXT];
            if (lar_ossl.SSL_CTX_use_certificate_chain_file(c->ctx, cert) != 1) {
                c->error = 50;
                snprintf(what, sizeof what, "cannot use the certificate %s", cert);
                lar_openssl_error(c->text, what);
                return c;
            }
            if (lar_ossl.SSL_CTX_use_PrivateKey_file(c->ctx, key, 1) != 1) { /* SSL_FILETYPE_PEM */
                c->error = 50;
                snprintf(what, sizeof what, "cannot use the key %s", key);
                lar_openssl_error(c->text, what);
                return c;
            }
            if (lar_ossl.SSL_CTX_check_private_key(c->ctx) != 1) {
                c->error = 50;
                snprintf(c->text, LAR_OPENSSL_TEXT, "the key %s is not the key of the certificate %s", key, cert);
                return c;
            }
            return c;
        }

        static long long lar_tls_server_context_number(LarTlsCtx* c) { return (long long)(intptr_t)c->ctx; }

        /* a server's connection: the handshake over an accepted socket (with its timeouts) */
        static LarOpenSslConn* lar_tls_server_accept(LarMemory* m, long long ctx, int fd) {
            LarOpenSslConn* t = lar_openssl_conn(m);
            lar_ossl.ERR_clear_error();
            t->ssl = lar_ossl.SSL_new((LarOpenSslCtx*)(intptr_t)ctx);
            if (!t->ssl) { t->error = 50; lar_openssl_error(t->text, "cannot create a TLS connection"); return t; }
            lar_memory_on_free(m, lar_openssl_final, t, 0);
            lar_ossl.SSL_set_fd(t->ssl, fd);
            errno = 0;
            int r = lar_ossl.SSL_accept(t->ssl);
            if (r != 1) {
                if (lar_openssl_io_error(t, r, "handshake failed") == 0) {
                    t->eof = false;
                    t->error = 50;
                    snprintf(t->text, LAR_OPENSSL_TEXT, "the client closed the connection during the handshake");
                }
                return t;
            }
            t->open = true;
            return t;
        }
    }
}
