// codegen.gen: C99 code generation (Gen.java), part 1: the file, types, classes and interfaces,
// globals, bodies and statements. Expressions are in genexpr.lar.
//
//  - struct     -> C struct, copied by value; methods are plain functions on S*.
//  - class      -> C struct in a memory, used through pointers. The root struct starts with
//                  RtObjHead (vtable + memory); a subclass embeds its parent as `_super`.
//  - interface  -> { void* obj; const I_Table* t; }
//  - enum       -> { int32_t tag; union { ...payloads } as; }
//  - closure    -> { fn; union of every environment of that type }, copied by value.
//  - T[N]       -> { length; items[N] } by value; T[] -> { items*, length };
//                  T[*] -> pointer to { items*, length, capacity, mem }.
//  - errors     -> a function that throws takes RtError* err_out; every call checks it.
//  - memories   -> RtMem; heap memories are freed on every exit of their block.

import syntax.ast {
    ExternTypeDecl,
    Expr, Stmt, VarDecl, AssignStmt, ReturnStmt, ExprStmt, IfStmt, WhileStmt, ForStmt, BreakStmt, ContinueStmt, ThrowStmt,
    YieldStmt, TryStmt, SwitchStmt, BlockStmt, Member, Index, Call, IsExpr, SwitchExpr, Binary, allStmts, allExprs
};
import semantics.types {
    Type, TyK, NamedK, ArrK, T_STRING, T_VOID, T_ANY, T_BOOL, T_INT32, isError, isClass, isStruct, isInterface, isEnumT,
    isExternT, isOpt, isArray, optIsPointer, ascii, isCReserved, escapeName, Symbol, SymK, MemK, isMemory,
    FieldInfo, FunctionInfo, MethodInfo, StructInfo, ClassInfo, InterfaceInfo, VariantInfo, EnumInfo, LambdaInfo,
    hasCapture, cSuffix, isMemParam, PatternInfo, PatK, SwitchInfo, ForInfo, CatchInfo, CallInfo, CallK, MemberInfo, MbK,
    includes, usesAny, usesThreads, cCode, files, structs, nativeMethods, classes, interfaces, enums, externTypes, functions, globals,
    lambdaList, funcTypes, typeOrder, structOf, classOf, interfaceOf, enumOf, parentOf, syncField, chain, findMethod, allFields, classDepth, primByName,
    externInfos, externInfoOf, ExternTypeInfo, cCodeStd, includeWhens, isResource, platformCondition, nativeOwner,
    optT, buildingLibrary, libraryPrefix
};
import std.text { isIdentifierPart, isDigit };
import codegen.runtimeselect { selectRuntime };
import codegen.prune { prune, braceDelta };
import semantics.linker { filePaths, fileSources, FILE_LINES };
import semantics.expressions { hasRefs };
import codegen.expressions {
    expr, value, hoist, strip, lazyPre, lazy, zero, stringLiteral, addrOf, discard, patternTest, bindPattern,
    boxDescriptors, cloneFunctions, requireClone, mangle, cType, structName, tname, lvalue, placeMemOf,
    cloneTypeList, cloneHeader, needsDeepClone, cloneOf, classFieldPath, isPure, inOrder, forget
};

// =====================================================================================
// Function context
// =====================================================================================

public class Block {
    let cleanups: String[*] = [];
}

public class TryCtx {
    let catchLabel: String;
    let block: Block;
}

public class ArmCtx {
    let endLabel: String;
    let result: String;
    let block: Block;
    let used: bool = false;        // a yield jumped to endLabel (else the label is not written: -Wunused-label)
}

public class Fn {
    let out: StringBuilder;
    let indent: int32 = 1;
    let lambda: LambdaInfo? = null;
    let ret: Type;
    let throwsOut: bool = false;
    let blocks: Block[*] = [];        // the root first, the innermost last
    let tries: TryCtx[*] = [];
    let arms: ArmCtx[*] = [];
    let placeOverride: String = "";   // memory for allocations inside field defaults
    let temp: Temp? = null;           // the temporaries of the statement being generated (null outside statements)
    let destUsed: bool = false;       // the function created something in rt_dest (the memory of its call)
}

/** A statement's temporary memory, declared before the statement only if something used it. */
public class Temp {
    let owner: Block;
    let name: String = "";
}

public function newFn(): Fn { return Fn { out: {} in default, ret: T_VOID } in default; }

public let fn: Fn = newFn();
public let counter: int32 = 0;
public let hasErrors: bool = false;

/** Bugs of the compiler found while generating: reported instead of writing C that would crash. */
public let generatorErrors: String[*] = [] in default;

public function internalError(line: int32, msg: String): void {
    generatorErrors.push("Internal Error [Line ${line}]: ${msg} This is a bug of the compiler, not of your program: please report it." in default);
}

// helpers discovered while generating bodies
public let samInterfaces: String[*] = [] in default;
public let samSeen: Any = {} in default;
public let literalTypes: StringBuilder = {} in default;
public let literalPrototypes: StringBuilder = {} in default;
public let literalTables: StringBuilder = {} in default;
public let literalThunks: StringBuilder = {} in default;
public let lambdaDefs: String[*] = [] in default;     // by lambda id ("" until generated)
public let lambdaDone: bool[*] = [] in default;
public let resizeHelpers: String[*] = [] in default;
public let resizeSeen: Any = {} in default;
/** Trampolines: a C function that gets a Context calls the Larimar function it carries. */
public let ctxTrampolines: String[*] = [] in default;
public let ctxSeen: Any = {} in default;
public let loopBlock: Block? = null;                  // innermost loop body (per function, saved/restored)

// =====================================================================================
// Debugging (larimar build --debug): the C says which .lar line each part comes from
// =====================================================================================

/** #line before each statement, so a debugger (lldb, gdb) shows and stops on the .lar lines. */
public let debugLines: bool = false;

function lineMark(encoded: int32): String {
    let index: int32 = encoded / FILE_LINES;
    let ln: int32 = encoded % FILE_LINES;
    if (index < 0 || index >= filePaths.length || ln <= 0) { return ""; }
    return "#line ${ln} ${cPathLiteral(filePaths[index])}";
}

function cPathLiteral(path: String): String { return "\"${path.replace("\\", "/").replace("\"", "\\\"")}\""; }

/**
 * After generating with debugLines: inside a function, every line of C after a #line gets that same
 * .lar line (C would count on: N, N+1, N+2...); after the function, the lines are the C file's again,
 * so the runtime and helpers are shown as the C they are.
 */
public function spreadLines(c: String, cFile: String): String {
    let sb: StringBuilder = {};
    let written: int32 = 0;
    let depth: int32 = 0;
    let current: String = "";
    let lastWasMark: bool = false;
    let reset: String = cPathLiteral(cFile);
    let all: String[*] = c.split("\n");
    for (k, ln in all) {
        let t: String = ln.trimStart();
        if (depth == 0 && current == "" && braceDelta(ln) > 0 && ln.contains("(")) {
            // a function: its header gets the line of its first mark (its declaration), for "break name"
            let first: String = firstMark(all, k);
            if (first != "") {
                current = first;
                sb.addLine(first);
                written += 1;
                lastWasMark = true;
            }
        }
        if (depth > 0 && t.startsWith("#line ")) {
            current = t;
            sb.addLine(ln);
            written += 1;
            lastWasMark = true;
            continue;
        }
        if (current != "" && !lastWasMark && t != "") {
            sb.add(ln.substring(0, ln.length - t.length));      // with the line's indentation
            sb.addLine(current);
            written += 1;
        }
        sb.addLine(ln);
        written += 1;
        lastWasMark = false;
        depth += braceDelta(ln);
        if (depth < 0) { depth = 0; }
        if (depth == 0 && current != "") {
            current = "";
            sb.addLine("#line ${written + 2} ${reset}");
            written += 1;
        }
    }
    return sb.toString().clone();
}

/** The first #line of the function whose header is all[k] (before the function ends), or "". */
function firstMark(all: String[*], k: int32): String {
    let depth: int32 = 0;
    let i: int32 = k;
    while (i < all.length) {
        let t: String = all[i].trimStart();
        if (i > k && t.startsWith("#line ")) { return t; }
        depth += braceDelta(all[i]);
        if (depth <= 0 && i > k) { return ""; }
        i += 1;
    }
    return "";
}

public function line(s: String): void {
    let i: int32 = 0;
    while (i < fn.indent) {
        fn.out.add("    ");
        i += 1;
    }
    fn.out.addLine(s);
}

public function tmp(prefix: String): String {
    let t: String = "${prefix}_${counter}";
    counter += 1;
    return t;
}

/** Adds four spaces to every line (like String.indent(4) in Java). */
public function indent4(text: String in default): String {
    if (text.isEmpty()) { return ""; }
    let sb: StringBuilder = {} in default;
    let ls: String[*] = text.split("\n");
    for (i, l in ls) {
        if (i == ls.length - 1 && l.isEmpty()) { break; }
        sb.add("    ");
        sb.addLine(l);
    }
    return sb.toString();
}

function pushBlock(b: Block in default): void { fn.blocks.push(b); }

function popBlock(): void {
    let rest: Block[*] = [] in default;
    let i: int32 = 0;
    while (i < fn.blocks.length - 1) {
        rest.push(fn.blocks[i]);
        i += 1;
    }
    fn.blocks = rest;
}

public function topBlock(): Block { return fn.blocks[fn.blocks.length - 1]; }
public function rootBlock(): Block { return fn.blocks[0]; }

// =====================================================================================
// Output assembly
// =====================================================================================

let hasInit: bool = false;

public function generate(): String {
    for (e in enums) {
        if (e.thrown) { hasErrors = true; }
    }
    for (l in lambdaList) {
        lambdaDefs.push("");
        lambdaDone.push(false);
    }
    // Bodies first: they discover lambdas, literal objects and helpers.
    let functionsOut: StringBuilder = {} in default;
    for (f in functions) {
        if (f.isExtern || f.decl!.isNative) { continue; }     // native: every call is written in place
        functionsOut.add(functionHeader(f));
        functionsOut.addLine(" {");
        functionsOut.add(body(f.decl!.body, f.sig!.elem!, f.throwsType != null, null, f.paramSymbols, "", f.line));
        functionsOut.add("}\n\n");
    }
    for (f in functions) {                      // export: the C function C code calls
        if (f.isExtern || f.exportName == "") { continue; }
        functionsOut.add(exportBody(f));
    }
    if (buildingLibrary) {                      // the members of its classes: tk_Counter_add(handle, ...)
        for (c in handleClassNames()) {
            for (m in libraryMembers(c)) { functionsOut.add(memberBody(m)); }
        }
    }
    let methods: StringBuilder = {} in default;
    for (s in structs) {
        for (m in s.methods) {
            methods.add(methodHeader(m, true));
            methods.addLine(" {");
            if (!m.selfSymbol!.used) { methods.add("    (void)self;\n"); }
            methods.add(body(m.decl.body, m.sig!.elem!, m.throwsType != null, null, m.paramSymbols, "", m.decl.line));
            methods.add("}\n\n");
        }
    }
    for (c in classesByDepth()) {
        if (c.thread) {
            let run: MethodInfo = interfaceOf("Runnable")!.methods[0];
            methods.add("static void Thread__entry(void* p) {\n    Thread* self = (Thread*)p;\n    ");
            methods.add("${ifaceCallName(interfaceOf("Runnable")!, run)}(self->run);\n}\n\n");
        }
        for (m in c.methods) {
            methods.add(methodHeader(m, false));
            methods.addLine(" {");
            methods.add("    ${c.name}* self = (${c.name}*)self_;\n");
            methods.add("    (void)self;\n");
            if (c.thread && m.name == "start") {
                methods.add("    rt_thread_start(&self->_thread, rt_obj_mem(self), Thread__entry, self, 0);\n}\n\n");
                continue;
            }
            if (c.thread && m.name == "join") {
                methods.add("    rt_thread_join(&self->_thread);\n}\n\n");
                continue;
            }
            if (c.builder) {    // the text grows in the builder's memory; toString() is a view of it
                let p0: String = m.paramSymbols.length > 0 ? m.paramSymbols[0].cName : "";
                if (m.name == "add") {
                    methods.add("    rt_builder_add(self, ${p0});\n");
                } else if (m.name == "addLine") {
                    methods.add("    rt_builder_add(self, ${p0});\n    rt_sb_add(&self->_sb, \"\\n\", 1);\n");
                } else if (m.name == "length") {
                    methods.add("    return self->_sb.len;\n");
                } else if (m.name == "toString") {
                    methods.add("    (void)rt_dest;\n    return self->_sb.buf ? rt_str(self->_sb.buf, self->_sb.len) : rt_str(\"\", 0);\n");
                } else {
                    methods.add("    self->_sb.buf = NULL;   /* a new buffer: texts already given out stay as they were */\n    self->_sb.len = 0;\n");
                }
                methods.add("}\n\n");
                continue;
            }
            let lock: String = c.sync ? "self->${syncField(c)}" : "";
            methods.add(body(m.decl.body, m.sig!.elem!, m.throwsType != null, null, m.paramSymbols, lock, m.decl.line));
            methods.add("}\n\n");
        }
    }
    for (m in nativeMethods) {
        if (!m.decl.hasBody) { continue; }
        methods.add(nativeMethodHeader(m));
        methods.addLine(" {");
        methods.add("    (void)self;\n");
        methods.add(body(m.decl.body, m.sig!.elem!, m.throwsType != null, null, m.paramSymbols, "", m.decl.line));
        methods.add("}\n\n");
    }
    let init: String = initGlobals();
    let main: String = buildingLibrary ? "" : mainWrapper();
    for (c in classes) {
        if (!c.sync && !c.thread) {
            for (f in c.fields) { requireClone(f.type); }
        }
    }
    let boxes: String = boxDescriptors();     // may need clone functions: before generating them
    let clones: String = cloneFunctions();

    let out: StringBuilder = {} in default;     // the program; the runtime it needs goes before it
    let incSeen: Any = {} in default;
    for (ii, inc in includes) {
        let pw: String = includeWhens[ii];
        let key: String = "${inc}|${pw}";
        if (incSeen.contains(key)) { continue; }
        incSeen[key] = true;
        if (inc == "<stdint.h>" || inc == "<stdbool.h>" || inc == "<stdio.h>" || inc == "<stdlib.h>" || inc == "<string.h>") { continue; }
        let text: String = inc.startsWith("<") || inc.startsWith("\"") ? "#include ${inc}" : "#include \"${inc}\"";
        out.add(pw == "" ? "${text}\n" : "#if ${platformCondition(pw)}\n${text}\n#endif\n");
    }

    if (cCode.length > 0) {                     // export functions the c_code can already use
        let early: StringBuilder = {} in default;
        for (f in functions) {
            if (!f.isExtern && f.exportName != "" && earlyExport(f)) { early.add("${exportHeader(f, true)};\n"); }
        }
        sectionOf(out, "Export functions", early);
    }
    let named: StringBuilder = {} in default;      // what c_code names with lar"...": prototypes first
    for (code in cCode) {
        if (code.contains("lar\"")) { larPrototypes(code, named); }
    }
    sectionOf(out, "Larimar functions named in c_code", named);
    for (ci, code in cCode) {
        section(out, cCodeStd[ci] ? "c_code (std)" : "c_code");
        out.add(stripIndent(code.contains("lar\"") ? larInC(code) : code));
        out.add("\n");
    }

    let part: StringBuilder = {} in default;
    let anyResource: bool = false;
    for (e in externInfos) {
        if (e.sig != null) { continue; }
        for (d in declsOf(e)) {
            let td: String = "typedef ${d.cType != "" ? d.cType : "void*"} Ext_${e.name};";
            part.add(d.platform == "" ? "${td}\n" : "#if ${platformCondition(d.platform)}\n${td}\n#endif\n");
        }
        if (e.decl.releasedBy != "") {
            if (!anyResource) {
                part.add("typedef struct RtRes { int state; void (*release)(struct RtRes*); } RtRes;   /* 1 live, 2 releasing, 0 released */\n");
                anyResource = true;
            }
            part.add("typedef struct { RtRes h; Ext_${e.name} value; } Res_${e.name};\n");
        }
    }
    for (e in externInfos) {                    // pointers to C functions
        let sg: Type? = e.sig;
        if (sg == null) { continue; }
        let ps: String[*] = [] in default;
        for (p in sg.params) { ps.push(externCType(p)); }
        if (ps.length == 0) { ps.push("void"); }
        part.add("typedef ${externCType(sg.elem!)} (*Ext_${e.name})(${ps.join(", ")});\n");
    }
    for (t in typeOrder) { forward(part, t); }
    sectionOf(out, "Forward declarations", part);
    part = {} in default;
    for (t in typeOrder) { define(part, t); }
    sectionOf(out, "Types", part);

    if (hasErrors) {
        section(out, "Errors");
        out.add("typedef struct RtError {\n    int32_t kind;\n    union {");
        for (e in enums) {
            if (e.thrown) { out.add(" ${tname(e.name)} e_${e.name};"); }
        }
        out.add(" char _none; } as;\n} RtError;\n");
    }

    if (classes.length > 0 || interfaces.length > 0) {
        section(out, "Virtual tables and interface tables");
        for (c in classesByDepth()) { vtableStruct(out, c); }
        for (i in interfaces) { interfaceTableStruct(out, i); }
    }
    if (literalTypes.length > 0 || samInterfaces.length > 0) {
        section(out, "Objects created from literals and lambdas");
        out.add(literalTypes.toString());
        for (i in samInterfaces) {
            let m: MethodInfo = interfaceOf(i)!.methods[0];
            out.add("typedef struct ${i}__Sam { ${cType(m.sig!)} fn; } ${i}__Sam;\n");
        }
    }

    section(out, "Prototypes");
    let declared: Any = {} in default;
    for (f in functions) {
        if (f.isExtern && f.prototype && !declared.contains(f.cName) && isCName(f.cName)) {     // "(f)", a cast...: C text, no prototype
            declared[f.cName] = true;
            let pw: String = f.ext!.platform;
            out.add(pw == "" ? "${externPrototype(f)};\n" : "#if ${platformCondition(pw)}\n${externPrototype(f)};\n#endif\n");
        }
    }
    for (f in functions) {
        if (!f.isExtern && !f.decl!.isNative) { out.add("${functionHeader(f)};\n"); }
        if (!f.isExtern && f.exportName != "") { out.add("${exportHeader(f, false)};\n"); }
    }
    for (s in structs) {
        for (m in s.methods) { out.add("${methodHeader(m, true)};\n"); }
    }
    for (c in classesByDepth()) {
        for (m in c.methods) { out.add("${methodHeader(m, false)};\n"); }
        out.add("static void* ${c.name}__clone(void* self_, RtMem* mem, RtCloneMap* cm);\n");
    }
    for (m in nativeMethods) {
        if (m.decl.hasBody) { out.add("${nativeMethodHeader(m)};\n"); }
    }
    for (l in lambdaList) { out.add("${lambdaHeader(l)};\n"); }
    out.add(clonePrototypes());
    out.add(literalPrototypes.toString());
    if (anyResource) { resources(out); }

    if (enums.length > 0) {
        section(out, "Enum names");
        for (e in enums) {
            out.add("${internal()}const char* const ${e.name}__names[] = { ");
            for (i, v in e.variants) {
                if (i > 0) { out.add(", "); }
                out.add("\"${v.name}\"");
            }
            out.add(" };\n");
        }
    }

    if (classes.length > 0 || interfaces.length > 0) {
        section(out, "Class information, vtables and dispatch");
        for (c in classesByDepth()) {
            let parent: String = c.superName != "" ? "&rtclass_${c.superName}" : "NULL";
            out.add("${internal()}const RtClass rtclass_${c.name} = { \"${c.name}\", ${parent} };\n");
        }
        for (c in classesByDepth()) { out.add("${internal()}const ${c.name}_VTable vtable_${c.name} = { ${vtableInit(c, c)} };\n"); }
        for (c in classesByDepth()) {
            for (m in c.methods) {
                if (m.introducer == c.name) { dispatchHelper(out, c, m); }
            }
        }
        for (i in interfaces) {
            for (m in i.methods) { interfaceCallHelper(out, i, m); }
        }
        interfaceImplementations(out);
        out.add(literalTables.toString());
        for (i in samInterfaces) { samTable(out, interfaceOf(i)!); }
    }

    if (funcTypes.length > 0) {
        section(out, "Closure calls");
        for (ft in funcTypes) { closureCallHelper(out, ft); }
    }

    part = {} in default;
    for (t in typeOrder) { collectionHelpers(part, t); }
    part.add(boxes);
    for (r in resizeHelpers) { part.add(r); }
    for (t in ctxTrampolines) { part.add(t); }
    sectionOf(out, "Array and optional helpers", part);

    if (globals.length > 0) {
        section(out, "Globals");
        for (v in globals) {
            let s: Symbol = v.symbol!;
            if (s.memKind == MemK.FixedStatic) {
                let n: int64 = s.type.size;
                if (n < 1) { n = 1; }
                out.add("static uint8_t ${s.cName}__buf[${n}];\n");
                out.add("${internal()}RtMem ${s.cName};\n");
            } else if (isMemory(s)) {
                out.add("${internal()}RtMem ${s.cName};\n");
            } else {
                out.add("${internal()}${cType(s.type)} ${s.cName};\n");
            }
        }
    }

    if (exports().length > 0) { exportHelpers(out); }
    section(out, "Functions");
    out.add(functionsOut.toString());
    let anyBuilder: bool = false;
    for (c in classes) {
        if (c.builder) { anyBuilder = true; }
    }
    if (anyBuilder) {
        section(out, "StringBuilder");
        out.add("static inline void rt_builder_add(StringBuilder* b, RtString s) {\n");
        out.add("    if (!b->_sb.buf) b->_sb = rt_sb_mem(rt_obj_mem(b), 0);\n    rt_sb_str(&b->_sb, s);\n}\n");
    }
    if (methods.length > 0) {
        section(out, "Methods");
        out.add(methods.toString());
    }
    let anyLambda: bool = false;
    for (d in lambdaDone) {
        if (d) { anyLambda = true; }
    }
    if (anyLambda) {
        section(out, "Lambdas");
        for (i, d in lambdaDefs) {
            if (lambdaDone[i]) { out.add(d); }
        }
    }
    if (literalThunks.length > 0 || classes.length > 0) {
        section(out, "Interface thunks and cloning");
        out.add(literalThunks.toString());
        for (i in samInterfaces) { samThunk(out, interfaceOf(i)!); }
        for (c in classesByDepth()) { classClone(out, c); }
    }
    out.add(clones);
    section(out, "Entry point");
    out.add(init);
    out.add(main);
    if (buildingLibrary) { libraryGlue(out); }

    let roots: String[*] = ["main"] in default;
    for (f in functions) {
        if (!f.isExtern && f.exportName != "") { roots.push(f.exportName); }
    }
    if (buildingLibrary) {
        for (c in handleClassNames()) {
            for (m in libraryMembers(c)) { roots.push(m.cName); }
        }
    }
    let program: String = prune(out.toString(), roots);     // only what main, the exports and the c_code reach
    let head: StringBuilder = {} in default;
    head.add("/* Generated by the transpiler. Runtime first, then the program. */\n");
    let ownC: bool = cCode.length > 0 || includes.length > 0;
    for (f in functions) {
        if (f.isExtern) { ownC = true; }
    }
    let runtime: String = selectRuntime(program, usesThreads, files.length > 0, ownC);
    if (runtime.contains("RT_FILES")) {
        head.add("#define RT_FILES ");
        for (i, f in files) {
            if (i > 0) { head.add(", "); }
            head.add("\"${f.replace("\\", "/")}\"");
        }
        head.add("\n");
    }
    // POSIX functions (threads, and those C code calls) are only declared when asked for
    if (usesThreads || cCode.length > 0 || includes.length > 0) { head.add("#if !defined(_WIN32) && !defined(_XOPEN_SOURCE)\n#define _XOPEN_SOURCE 700\n#endif\n"); }
    if (usesThreads) { head.add("#define RT_THREADS\n"); }
    head.add(runtime);
    head.add(program);
    return head.toString();
}

/** In a library everything but its export functions stays inside it: two libraries (and the program) do not clash. */
function internal(): String { return buildingLibrary ? "static " : ""; }

/** What export functions use to give C its texts and the handles of a library's objects (cut when unused). */
function exportHelpers(out: StringBuilder): void {
    section(out, "Export helpers");
    if (buildingLibrary) { out.add("static void lm_library_init(void);\n"); }
    out.add("typedef struct RtHandle { void* object; RtMem mem; } RtHandle;\n\n");
    out.add("static RtHandle* rt_handle_new(void) {\n    RtHandle* h = (RtHandle*)calloc(1, sizeof(RtHandle));\n");
    out.add("    if (!h) rt_panic(\"out of memory\", 0);\n    h->mem = rt_mem_growable();\n    return h;\n}\n\n");
    out.add("static void rt_handle_release(void* p) {\n    RtHandle* h = (RtHandle*)p;\n    if (!h) return;\n");
    out.add("    rt_mem_free(&h->mem);\n    free(h);\n}\n\n");
    out.add("static void* rt_handle_object(void* p, const char* fn, const char* param) {\n");
    out.add("    if (!p) {\n        char msg[256];\n");
    out.add("        snprintf(msg, sizeof msg, \"%s: '%s' is NULL\", fn, param);\n        rt_panic(msg, 0);\n    }\n");
    out.add("    return ((RtHandle*)p)->object;\n}\n\n");
    out.add("static void* rt_handle_object_or_null(void* p) { return p ? ((RtHandle*)p)->object : NULL; }\n\n");
    out.add("static char* rt_export_text(RtString s) {\n    char* out = (char*)malloc((size_t)s.len + 1);\n");
    out.add("    if (!out) rt_panic(\"out of memory\", 0);\n    if (s.len > 0) memcpy(out, s.ptr, (size_t)s.len);\n");
    out.add("    out[s.len] = 0;\n    return out;\n}\n");
}

/**
 * What a library gives C besides its export functions: <prefix>_free for its texts, <prefix>_<Class>_release
 * for its handles, <prefix>_interface, and the start: the globals are made before the first call (when the
 * library is loaded, where the C compiler allows it).
 */
function libraryGlue(out: StringBuilder): void {
    section(out, "Library");
    let p: String = libraryPrefix != "" ? "${libraryPrefix}_" : "";
    out.add("static int lm_library_ready = 0;\n");
    out.add("static void lm_library_init(void) {\n    if (lm_library_ready) return;\n    lm_library_ready = 1;\n");
    if (hasInit) { out.add("    init_globals();\n"); }
    out.add("}\n");
    out.add("#if defined(__GNUC__) || defined(__clang__) || defined(__TINYC__)\n");
    out.add("__attribute__((constructor)) static void lm_library_load(void) { lm_library_init(); }\n#endif\n");
    out.add("void ${p}free(void* text) { free(text); }\n");
    for (c in handleClasses()) { out.add("void ${p}${c}_release(void* handle) { rt_handle_release(handle); }\n"); }
    out.add("const char ${p}larimar_interface[] = \"larimar-interface:${INTERFACE_MARK}\";\n");
    out.add("const char* ${p}interface(void) { return ${p}larimar_interface + 18; }\n");
}

/** Where the interface hash goes in a library's C: larimar build writes it once the .lar is written. */
public const INTERFACE_MARK: String = "@INTERFACE@";

/**
 * The classes C knows as handles, in order (their names in the C of the library): those that the export
 * functions take or return, and those that the members of these give C in turn.
 */
function handleClassNames(): String[*] {
    let out: String[*] = [] in default;
    for (f in functions) {
        if (f.isExtern || f.exportName == "" || f.sig == null) { continue; }
        addHandles(f.sig!.elem!, out);
        for (t in f.sig!.params) { addHandles(t, out); }
    }
    let i: int32 = 0;
    while (i < out.length && buildingLibrary) {
        for (m in libraryMembers(out[i])) {
            if (m.method == null) { continue; }
            addHandles(m.method!.sig!.elem!, out);
            for (t in m.method!.sig!.params) { addHandles(t, out); }
        }
        i += 1;
    }
    return out;
}

function addHandles(t: Type, out: String[*] in default): void {
    if (!isHandle(t)) { return; }
    let n: String = (isOpt(t) ? t.elem! : t).name;
    if (!out.contains(n)) { out.push(n.clone() in default); }
}

/** The classes C knows as handles, by the names C and Larimar see (without their module). */
function handleClasses(): String[*] {
    let out: String[*] = [] in default;
    for (n in handleClassNames()) { out.push(plainName(n)); }
    return out;
}

/** A method or a field of a class that a library gives C: <prefix>_<Class>_<name>(handle, ...). */
class LibraryMember {
    let cls: String;                 // the class, in the C of the library
    let name: String;
    let cName: String;
    let method: MethodInfo? = null;
    let field: FieldInfo? = null;
}

/** What can go to C from a member: what an export function takes (a field: not a class, which it keeps). */
function crosses(t: Type, field: bool): bool {
    if (t == optT(T_STRING) || t.kind == TyK.Prim && t != T_ANY) { return true; }
    return !field && isHandle(t);
}

/** Why a member of a class does not go to C ("" when it goes). */
function memberProblem(m: MethodInfo): String {
    if (m.isOperator) { return "an operator"; }
    if (m.throwsType != null) { return "it throws"; }
    if (m.decl.returnLives != "") { return "its result lives in ${m.decl.returnLives}"; }
    if (!crosses(m.sig!.elem!, false) && m.sig!.elem! != T_VOID) { return "it returns ${m.sig!.elem!.text}"; }
    for (i, t in m.sig!.params) {
        if (isMemParam(m.memParams, i)) { return "it takes a memory"; }
        if (!crosses(t, false)) { return "it takes ${t.text}"; }
        if (m.decl.params[i].lives != "") { return "a parameter says where it lives"; }
    }
    if (m.name == "release") { return "its C name is the one that gives the handle back"; }
    return "";
}

/** The members of a class that go to C: its fields and methods (and its parents'), the most derived ones. */
function libraryMembers(cls: String in default): LibraryMember[*] {
    let out: LibraryMember[*] = [] in default;
    let p: String = libraryPrefix != "" ? "${libraryPrefix}_" : "";
    let c: String = "${p}${plainName(cls)}_";
    for (f in allFields(cls)) {
        if (crosses(f.type, true)) { out.push(LibraryMember { cls, name: f.name, cName: "${c}${f.name}", field: f } in default); }
    }
    for (m in methodsOf(cls)) {
        if (memberProblem(m) == "") { out.push(LibraryMember { cls, name: m.name, cName: "${c}${m.name}", method: m } in default); }
    }
    return out;
}

/** The members of a class that do not go to C, with why: the .lar says it. */
function memberSkips(cls: String in default): String[*] {
    let out: String[*] = [] in default;
    for (f in allFields(cls)) {
        if (!crosses(f.type, true)) { out.push("${f.name} (${f.type.text})"); }
    }
    for (m in methodsOf(cls)) {
        let why: String = memberProblem(m);
        if (why != "" && !m.isOperator) { out.push("${m.name}() (${why})"); }
    }
    return out;
}

/** The instance methods of a class and its parents, each one by its most derived definition. */
function methodsOf(cls: String in default): MethodInfo[*] {
    let out: MethodInfo[*] = [] in default;
    let names: String[*] = [] in default;
    for (c in chain(cls)) {
        for (m in c.methods) {
            if (m.isOperator || names.contains(m.name)) { continue; }
            names.push(m.name);
            let best: MethodInfo? = findMethod(cls, m.name, false, 0);
            out.push(best ?? m);
        }
    }
    return out;
}

/** An extern type's declarations: the one for every platform, or one per platform. */
function declsOf(e: ExternTypeInfo in default): ExternTypeDecl[*] {
    let all: ExternTypeDecl[*] = [e.decl] in default;
    for (a in e.alts) { all.push(a); }
    return all;
}

/**
 * Resources (extern type X released by f): a value lives in a cell of the memory it was made in, with its
 * state; the memory releases it when it is freed, unless release(x) already did.
 */
function resources(out: StringBuilder): void {
    section(out, "Resources");
    out.add("static void rt_res_final(void* p) {\n    RtRes* r = (RtRes*)p;\n");
    out.add("    if (r->state == 1) { r->state = 2; r->release(r); r->state = 0; }\n}\n");
    out.add("static inline void rt_res_release(void* p) { if (p) rt_res_final(p); }\n");
    for (e in externInfos) {
        if (e.decl.releasedBy == "" || e.sig != null) { continue; }
        let n: String = e.name;
        let only: String = "";                      // a resource of one platform: its releaser's
        for (k, d in declsOf(e)) {
            let f: FunctionInfo? = k < e.releasers.length ? e.releasers[k] : null;
            if (f == null) { continue; }
            let pw: String = d.platform;
            if (pw == "" && f.isExtern && f.ext!.platform != "") {
                pw = f.ext!.platform;
                only = pw;
            }
            if (pw != "") { out.add("#if ${platformCondition(pw)}\n"); }
            let call: String = f.isExtern ? "${f.cName}(((Res_${n}*)r)->value)" : "${f.cName}((Res_${n}*)r)";
            out.add("static void ${n}__release(RtRes* r) { ${call}; }\n");
            let pointer: bool = d.cType == "" || d.cType.trim().endsWith("*") || d.cType.trim() == "HANDLE";
            let valid: String = pointer ? "v != NULL && (intptr_t)v != -1" : "(intmax_t)(v) >= 0";   // -1: INVALID_HANDLE_VALUE, MAP_FAILED
            out.add("static Res_${n}* ${n}__new(RtMem* m, Ext_${n} v, int line) {\n");
            out.add("    if (!(${valid})) return NULL;          /* C failed: no resource */\n");
            out.add("    Res_${n}* c = (Res_${n}*)rt_mem_alloc(m, sizeof(Res_${n}), line);\n");
            out.add("    c->h.state = 1;\n    c->h.release = ${n}__release;\n    c->value = v;\n");
            out.add("    rt_mem_on_free(m, rt_res_final, c, line);\n    return c;\n}\n");
            if (pw != "") { out.add("#endif\n"); }
        }
        if (only != "") { out.add("#if ${platformCondition(only)}\n"); }
        out.add("static inline Ext_${n} ${n}__get(Res_${n}* c, int line) {\n");
        out.add("    if (!c || c->h.state == 0) rt_panic(\"a released ${shortName(n)} was used\", line);\n");
        out.add("    return c->value;\n}\n");
        if (only != "") { out.add("#endif\n"); }
    }
}

/** A name without its module prefix: std__net__Socket -> Socket. */
function shortName(n: String): String {
    let i: int32? = n.lastIndexOf("__");
    return i != null ? n.substring(i! + 2) : n;
}

function sectionOf(out: StringBuilder, title: String, content: StringBuilder): void {
    if (content.length == 0) { return; }
    section(out, title);
    out.add(content.toString());
}

public function section(out: StringBuilder, title: String): void {
    let n: int32 = 70 - title.length;
    if (n < 3) { n = 3; }
    out.add("\n/* ---- ${title} ${"-".repeat(n)} */\n");
}

/** Like Java's stripIndent().strip(): removes the common indentation and the blank lines around. */
function stripIndent(code: String in default): String {
    let ls: String[*] = code.split("\n");
    let minIndent: int32 = 1000000;
    for (i, l in ls) {
        let trimmedRight: String = l.trimEnd();
        let last: bool = i == ls.length - 1;
        if (trimmedRight.isEmpty() && !last) { continue; }
        let n: int32 = 0;
        while (n < l.length && (l[n] == 32 || l[n] == 9)) { n += 1; }
        if (trimmedRight.isEmpty()) { n = l.length; }
        if (n < minIndent) { minIndent = n; }
    }
    if (minIndent == 1000000) { minIndent = 0; }
    let sb: StringBuilder = {} in default;
    for (i, l in ls) {
        let s: String = l.trimEnd();
        s = s.length >= minIndent ? s.substring(minIndent) : "";
        if (i > 0) { sb.add("\n"); }
        sb.add(s);
    }
    return sb.toString().trim();
}

public function classesByDepth(): ClassInfo[*] {
    let list: ClassInfo[*] = [] in default;
    for (c in classes) {
        let d: int32 = classDepth(c.name);
        let i: int32 = list.length;
        list.push(c);
        while (i > 0 && classDepth(list[i - 1].name) > d) {
            list[i] = list[i - 1];
            i -= 1;
        }
        list[i] = c;
    }
    return list;
}

// =====================================================================================
// Types
// =====================================================================================

/** C functions receive String as a NUL-terminated const char*. */
function externPrototype(f: FunctionInfo in default): String {
    let ps: String[*] = [] in default;
    for (i, p in f.sig!.params) {
        if (isMemParam(f.memParams, i)) {
            ps.push("RtMem*");
        } else if (p.kind == TyK.Array && p.ak == ArrK.Slice) {
            ps.push("${cType(p.elem!)}*");             // T[]: the elements and their count
            ps.push("int32_t");
        } else {
            ps.push(f.releases == "String" ? "void*" : externCType(p));     // it releases texts: free(void*), sqlite3_free(void*)
        }
    }
    if (f.varargs) { ps.push("..."); }
    if (ps.length == 0) { ps.push("void"); }
    // char*, not const char*: it also matches the standard headers the runtime already includes (getenv, strerror).
    let ret: String = externCType(f.sig!.elem!);
    if (f.sig!.elem! == T_STRING) { ret = "char*"; }
    return "${ret} ${f.cName}(${ps.join(", ")})";
}

/** c_code with lar"name" (the linker gave the linked name): the C name of that function, type or global. */
function larInC(code: String): String {
    let out: StringBuilder = {};
    let i: int32 = 0;
    while (i < code.length) {
        let at: int32? = code.indexOf("lar\"", i);
        let close: int32? = at != null ? code.indexOf("\"", at! + 4) : null;
        if (at == null || close == null) {
            out.add(code.substring(i));
            break;
        }
        out.add(code.substring(i, at!));
        out.add(cNameOf(code.substring(at! + 4, close!)));
        i = close! + 1;
    }
    return out.toString();
}

/** The prototypes of the Larimar functions a c_code names (those with C types the runtime already has). */
function larPrototypes(code: String, out: StringBuilder): void {
    let i: int32 = 0;
    while (i < code.length) {
        let at: int32? = code.indexOf("lar\"", i);
        let close: int32? = at != null ? code.indexOf("\"", at! + 4) : null;
        if (at == null || close == null) { return; }
        let name: String = code.substring(at! + 4, close!);
        for (f in functions) {
            if (f.name == name && !f.isExtern && f.exportName == "" && f.sig != null && plainSig(f.sig!)) { out.add("${functionHeader(f)};\n"); }
        }
        i = close! + 1;
    }
}

/** Only numbers, bool, String and void: C types the runtime declares before any c_code. */
function plainSig(sig: Type): bool {
    let all: Type[*] = [sig.elem!];
    for (p in sig.params) { all.push(p); }
    for (t in all) {
        if (!(t.kind == TyK.Prim && t != T_ANY)) { return false; }
    }
    return true;
}

function cNameOf(name: String): String {
    for (f in functions) {
        if (f.name == name) { return f.exportName != "" ? f.exportName : f.cName; }
    }
    if (structOf(name) != null || classOf(name) != null || enumOf(name) != null) { return tname(name); }
    if (externInfoOf(name) != null) { return "Ext_${name}"; }
    for (g in globals) {
        if (g.name == name && g.symbol != null) { return g.symbol!.cName; }
    }
    return name;
}

/** A plain C name (a function a prototype can declare), not C text. */
function isCName(n: String): bool {
    if (n.isEmpty() || isDigit(n[0])) { return false; }
    for (b in n.bytes()) {
        if (!isIdentifierPart(b)) { return false; }
    }
    return true;
}

public function externCType(t: Type): String {
    if (t == T_STRING || (isOpt(t) && t.elem! == T_STRING)) { return "const char*"; }
    if (isResource(t)) { return "Ext_${t.name}"; }                              // the C value itself
    if (isOpt(t) && isResource(t.elem!)) { return "Ext_${t.elem!.name}"; }
    return t == T_VOID ? "void" : cType(t);
}

/** export function: the C function C code calls (C types), which calls the Larimar one. */
function exportHeader(f: FunctionInfo, early: bool): String {
    let ps: String[*] = [] in default;
    for (i, p in f.sig!.params) { ps.push("${abiType(p, early)} ${exportParam(f, i)}"); }
    if (ps.length == 0) { ps.push("void"); }
    let r: Type = f.sig!.elem!;
    let ret: String = r == T_STRING || r == optT(T_STRING) ? "char*" : abiType(r, early);
    return "${ret} ${f.exportName}(${ps.join(", ")})";
}

/** A class of a library, as C sees it: a handle (its object, and the memory a result of C's lives in). */
function isHandle(t: Type): bool { return isClass(t) || (isOpt(t) && isClass(t.elem!)); }

/**
 * The body of an export function: C's values become Larimar's, the Larimar function runs, and its
 * result goes to C: a text as a copy that C frees (malloc), an object of a library as a new handle.
 */
function exportBody(f: FunctionInfo): String {
    let xs: String[*] = [];
    for (i, p in f.sig!.params) { xs.push(fromC(p, exportParam(f, i), f.exportName, f.params[i].name)); }
    return "${exportHeader(f, false)} {\n${callToC(f.cName, "", xs, f.sig!.elem!)}}\n\n";
}

/** A value of C as Larimar's: a text, a text or null, the object of a handle. */
function fromC(t: Type, x: String, fn: String, param: String): String {
    if (t == T_STRING) { return "rt_str_c(${x})"; }
    if (t == optT(T_STRING)) {
        let o: String = cType(t);
        return "(${x} ? ((${o}){ .has = true, .value = rt_str_c(${x}) }) : ((${o}){ .has = false }))";
    }
    if (isHandle(t)) {
        let c: String = cType(isOpt(t) ? t.elem! : t);
        return isOpt(t) ? "(${c})rt_handle_object_or_null(${x})" : "(${c})rt_handle_object(${x}, \"${fn}\", \"${param}\")";
    }
    return x;
}

/**
 * The statements that call `callee` (with `recv` first, when it is a method) and give C its result: a
 * result with data is made in a memory of the call (a text, copied for C) or of a new handle (an object).
 */
function callToC(callee: String, recv: String, xs: String[*], r: Type): String {
    let sb: StringBuilder = {} in default;
    if (buildingLibrary) { sb.add("    lm_library_init();\n"); }
    let before: String = recv != "" ? "${recv}, " : "";
    let after: String = xs.length > 0 ? ", ${xs.join(", ")}" : "";
    if (returnsData(r)) {
        if (isHandle(r)) {                      // a new handle: the result lives in its memory
            sb.add("    RtHandle* h = rt_handle_new();\n");
            sb.add("    h->object = ${callee}(${before}&h->mem${after});\n");
            if (isOpt(r)) { sb.add("    if (!h->object) { rt_handle_release(h); return NULL; }\n"); }
            sb.add("    return h;\n");
            return sb.toString();
        }
        sb.add("    RtMem mem = rt_mem_growable();\n");
        sb.add("    ${cType(r)} r = ${callee}(${before}&mem${after});\n");
        sb.add("    ${r == T_STRING || r == optT(T_STRING) ? "char*" : abiType(r, false)} out = ${toC(r, "r")};\n");
        sb.add("    rt_mem_free(&mem);\n    return out;\n");
        return sb.toString();
    }
    let all: String = recv != "" ? (xs.length > 0 ? "${recv}, ${xs.join(", ")}" : recv) : xs.join(", ");
    sb.add(r == T_VOID ? "    ${callee}(${all});\n" : "    return ${callee}(${all});\n");
    return sb.toString();
}

/** A Larimar value as C receives it: a text as a copy it frees (NULL for null). */
function toC(t: Type, x: String): String {
    if (t == T_STRING) { return "rt_export_text(${x})"; }
    if (t == optT(T_STRING)) { return "${x}.has ? rt_export_text(${x}.value) : NULL"; }
    return x;
}

/** A member of a class, for C: a method through its vtable (a subclass's runs), or a field read. */
function memberBody(m: LibraryMember): String {
    let obj: String = "rt_handle_object(self_h, \"${m.cName}\", \"self\")";
    if (m.field != null) {
        let f: FieldInfo = m.field!;
        let t: Type = f.type;
        let ret: String = t == T_STRING || t == optT(T_STRING) ? "char*" : abiType(t, false);
        let read: String = "((${m.cls}*)${obj})->${classFieldPath(m.cls, f)}";
        return "${ret} ${m.cName}(void* self_h) {\n    ${buildingLibrary ? "lm_library_init();\n    " : ""}return ${toC(t, read)};\n}\n\n";
    }
    let mi: MethodInfo = m.method!;
    let ps: String[*] = ["void* self_h"];
    let xs: String[*] = [];
    for (i, t in mi.sig!.params) {
        ps.push("${abiType(t, false)} a${i}");
        xs.push(fromC(t, "a${i}", m.cName, mi.decl.params[i].name));
    }
    let r: Type = mi.sig!.elem!;
    let ret: String = r == T_STRING || r == optT(T_STRING) ? "char*" : abiType(r, false);
    let recv: String = "(${mi.introducer}*)${obj}";
    return "${ret} ${m.cName}(${ps.join(", ")}) {\n${callToC(dispatchName(mi.introducer, mi), recv, xs, r)}}\n\n";
}

function exportParam(f: FunctionInfo, i: int32): String { return "${escapeName(f.params[i].name)}_c"; }

/** A type as C code sees it. Early (before the c_code): an opaque extern type is still void*. */
function abiType(t: Type, early: bool): String {
    if (early && isExternT(t)) { return "void*"; }
    if (isHandle(t)) { return "void*"; }                 // a handle of a library (its C type is in the .h)
    return externCType(t);
}

/** Its prototype can go before the c_code: numbers, bool, const char* and opaque extern types only. */
function earlyExport(f: FunctionInfo): bool {
    for (p in f.sig!.params) {
        if (!plainC(p) && p != optT(T_STRING) && !isHandle(p)) { return false; }
    }
    let r: Type = f.sig!.elem!;
    return plainC(r) || r == optT(T_STRING) || isHandle(r);
}

function plainC(t: Type): bool {
    if (t.kind == TyK.Prim) { return true; }
    if (!isExternT(t)) { return false; }
    let e: ExternTypeInfo? = externInfoOf(t.name);
    return e != null && e.decl.cType == "" && e.sig == null;
}

/** A C struct (extern type X = struct { ... }): C defines it, Larimar does not. */
function cStruct(t: Type): bool {
    if (t.kind != TyK.Named || t.nk != NamedK.Struct) { return false; }
    let so: StructInfo? = structOf(t.name);
    return so != null && so.decl.cName != "";
}

function forward(out: StringBuilder, t: Type): void {
    if (t.kind == TyK.Opt && optIsPointer(t)) { return; }
    if (t.kind == TyK.Named) {
        if (t.nk == NamedK.Extern || cStruct(t)) { return; }
        let name: String = tname(t.name);
        out.add("typedef struct ${name} ${name};\n");
        if (t.nk == NamedK.Class) { out.add("typedef struct ${name}_VTable ${name}_VTable;\n"); }
        if (t.nk == NamedK.Interface) { out.add("typedef struct ${name}_Table ${name}_Table;\n"); }
        return;
    }
    let name: String = structName(t);
    out.add("typedef struct ${name} ${name};");
    if (t.kind == TyK.Func) { out.add("  /* ${t.text} */"); }
    out.add("\n");
}

function define(out: StringBuilder, t: Type): void {
    if (cStruct(t)) { return; }
    if (t.kind == TyK.Named) {
        if (t.nk == NamedK.Struct) {
            let s: StructInfo = structOf(t.name)!;
            out.add("struct ${tname(s.name)} {\n");
            for (f in s.fields) { out.add("    ${cType(f.type)} ${escapeName(f.name)};\n"); }
            if (s.fields.length == 0) { out.add("    char _none;\n"); }
            out.add("};\n\n");
        } else if (t.nk == NamedK.Enum) {
            let e: EnumInfo = enumOf(t.name)!;
            out.add("enum ${e.name}_Tag { ");            // named, so a debugger shows the variant's name
            for (i, v in e.variants) {
                if (i > 0) { out.add(", "); }
                out.add("${e.name}_${v.name} = ${v.index}");
            }
            out.add(" };\n");
            out.add("struct ${tname(e.name)} {\n    enum ${e.name}_Tag tag;\n    union {");
            for (v in e.variants) {
                if (!v.hasPayload || v.fields.length == 0) { continue; }
                out.add(" struct {");
                for (f in v.fields) { out.add(" ${cType(f.type)} ${escapeName(f.name)};"); }
                out.add(" } ${v.name};");
            }
            out.add(" char _none; } as;\n};\n\n");
        } else if (t.nk == NamedK.Class) {
            let c: ClassInfo = classOf(t.name)!;
            out.add("struct ${tname(c.name)} {\n");
            if (c.superName == "") {
                out.add("    RtObjHead _h;\n");
            } else {
                out.add("    ${tname(c.superName)} _super;\n");
            }
            if (c.sync && syncField(c) == "_sync") { out.add("    RtSync* _sync;\n"); }     // a child uses its parent's
            for (f in c.fields) { out.add("    ${cType(f.type)} ${escapeName(f.name)};\n"); }
            if (c.thread) { out.add("    RtThread _thread;\n"); }
            if (c.builder) { out.add("    RtSb _sb;\n"); }
            out.add("};\n\n");
        } else if (t.nk == NamedK.Interface) {
            let i: String = tname(t.name);
            out.add("struct ${i} { void* obj; const ${i}_Table* t; };\n\n");
        }
        return;
    }
    if (t.kind == TyK.Func) {
        let id: int32 = t.funcId;
        let withEnv: LambdaInfo[*] = [] in default;
        for (l in lambdaList) {
            if (l.type == t && l.captures.length > 0) { withEnv.push(l); }
        }
        for (l in withEnv) {
            out.add("typedef struct Env_${l.id} {");
            for (s in l.captures) { out.add(" ${cType(s.type)} ${envField(s)};"); }
            out.add(" } Env_${l.id};\n");
        }
        out.add("struct Closure_${id} {  /* ${t.text} */\n");
        out.add("    ${cType(t.elem!)} (*fn)(void* env");
        if (returnsData(t.elem!)) { out.add(", RtMem*"); }
        for (p in t.params) { out.add(", ${cType(p)}"); }
        out.add(");\n    union {");
        for (l in withEnv) { out.add(" Env_${l.id} l_${l.id};"); }
        out.add(" char _none; } env;\n};\n\n");
        return;
    }
    if (t.kind == TyK.Array) {
        let name: String = structName(t);
        let e: String = cType(t.elem!);
        if (t.ak == ArrK.Fixed) {
            let n: int64 = t.size;
            if (n < 1) { n = 1; }
            out.add("struct ${name} { int32_t length; ${e} items[${n}]; };\n");
        } else if (t.ak == ArrK.Slice) {
            out.add("struct ${name} { ${e}* items; int32_t length; };\n");
        } else {
            out.add("struct ${name} { ${e}* items; int32_t length; int32_t capacity; RtMem* mem; };\n");
        }
        return;
    }
    if (t.kind == TyK.Opt && !optIsPointer(t)) {
        out.add("struct ${structName(t)} { bool has; ${cType(t.elem!)} value; };\n");
    }
}

public function envField(s: Symbol): String { return "${s.name}_${s.id}"; }

// =====================================================================================
// Classes, interfaces, closures: declarations and helpers
// =====================================================================================

function errParam(throwsOut: bool): String {
    return throwsOut ? ", RtError* err_out" : "";
}

/** Returning something that points to memory: the function creates it in the memory of the call. */
public function returnsData(ret: Type): bool { return hasRefs(ret); }

function params(ps: Symbol[*], memParams: bool[*]): String {
    let out: String[*] = [] in default;
    for (i, s in ps) {
        if (isMemParam(memParams, i)) { out.push("RtMem* ${s.cName}"); } else { out.push("${cType(s.type)} ${s.cName}"); }
    }
    return out.join(", ");
}

public function functionHeader(f: FunctionInfo): String {
    let ps: String = params(f.paramSymbols, f.memParams);
    if (returnsData(f.sig!.elem!)) { ps = ps.isEmpty() ? "RtMem* rt_dest" : "RtMem* rt_dest, ${ps}"; }
    let err: String = "";
    if (f.throwsType != null) { err = ps.isEmpty() ? "RtError* err_out" : ", RtError* err_out"; }
    let all: String = "${ps}${err}";
    if (all.isEmpty()) { all = "void"; }
    let st: String = f.cName == "user_main" ? "static " : internal();
    return "${st}${cType(f.sig!.elem!)} ${f.cName}(${all})";
}

public function methodName(m: MethodInfo): String {
    // a native type may have two methods with the same name and a different number of parameters
    for (o in nativeMethods) {
        if (o != m && o.owner == m.owner && o.name == m.name && o.decl.hasBody && m.decl.hasBody && !m.isOperator
            && o.sig != null && m.sig != null && o.sig!.params.length != m.sig!.params.length) {
            return "${m.owner}_${cSuffix(m)}_${m.sig!.params.length}";
        }
    }
    return "${m.owner}_${cSuffix(m)}";
}

function methodHeader(m: MethodInfo, isStructMethod: bool): String {
    let ps: String = params(m.paramSymbols, m.memParams);
    if (returnsData(m.sig!.elem!)) { ps = ps.isEmpty() ? "RtMem* rt_dest" : "RtMem* rt_dest, ${ps}"; }
    let recv: String = "${tname(m.introducer)}* self_";
    if (isStructMethod) {
        let so: StructInfo? = structOf(m.owner);
        recv = so != null && so!.decl.cName != "" ? "${so!.decl.cName}* self" : "${tname(m.owner)}* self";   // a native struct: C's own
    }
    let st: String = isStructMethod ? internal() : "static ";
    let rest: String = !ps.isEmpty() ? ", ${ps}" : "";
    return "${st}${cType(m.sig!.elem!)} ${methodName(m)}(${recv}${rest}${errParam(m.throwsType != null)})";
}

function nativeMethodHeader(m: MethodInfo): String {
    let ps: String = params(m.paramSymbols, m.memParams);
    if (returnsData(m.sig!.elem!)) { ps = ps.isEmpty() ? "RtMem* rt_dest" : "RtMem* rt_dest, ${ps}"; }
    let rest: String = !ps.isEmpty() ? ", ${ps}" : "";
    return "${internal()}${cType(m.sig!.elem!)} ${methodName(m)}(${cType(nativeOwner(m.owner))} self${rest}${errParam(m.throwsType != null)})";
}

public function lambdaHeader(l: LambdaInfo): String {
    let ps: String[*] = [];
    if (returnsData(l.type.elem!)) { ps.push("RtMem* rt_dest"); }
    for (s in l.params) { ps.push("${cType(s.type)} ${s.cName}"); }
    let rest: String = ps.length > 0 ? ", ${ps.join(", ")}" : "";
    return "static ${cType(l.type.elem!)} lambda_${l.id}(void* env_${rest})";
}

/** The C parameters after self: the memory of the call first when it returns data. */
public function paramCTypes(m: MethodInfo in default): String[*] {
    let out: String[*] = [];
    if (returnsData(m.sig!.elem!)) { out.push("RtMem*"); }
    for (i, p in m.sig!.params) {
        if (isMemParam(m.memParams, i)) { out.push("RtMem*"); } else { out.push(cType(p)); }
    }
    return out;
}

function vtableStruct(out: StringBuilder, c: ClassInfo in default): void {
    out.add("struct ${c.name}_VTable {\n");
    if (c.superName == "") {
        out.add("    RtVTableHead _h;\n");
    } else {
        out.add("    ${c.superName}_VTable _super;\n");
    }
    for (m in c.methods) {
        if (m.introducer != c.name) { continue; }
        out.add("    ${cType(m.sig!.elem!)} (*${cSuffix(m)})(${c.name}*");
        for (p in paramCTypes(m)) { out.add(", ${p}"); }
        if (m.throwsType != null) { out.add(", RtError*"); }
        out.add(");\n");
    }
    out.add("};\n\n");
}

function vtableInit(concrete: ClassInfo in default, level: ClassInfo): String {
    let parts: String[*] = [] in default;
    if (level.superName == "") {
        parts.push("._h = { &rtclass_${concrete.name}, ${concrete.name}__clone }");
    } else {
        parts.push("._super = { ${vtableInit(concrete, parentOf(level)!)} }");
    }
    for (m in level.methods) {
        if (m.introducer != level.name) { continue; }
        let impl: MethodInfo = findMethod(concrete.name, m.name, m.isOperator, m.sig!.params.length)!;
        parts.push(".${cSuffix(m)} = ${methodName(impl)}");
    }
    return parts.join(", ");
}

public function dispatchName(intro: String, m: MethodInfo): String { return "${intro}_${cSuffix(m)}__dispatch"; }

function argsDecl(pt: String[*], throwsOut: bool): String {
    let sb: StringBuilder = {} in default;
    for (i, p in pt) { sb.add(", ${p} a${i}"); }
    if (throwsOut) { sb.add(", RtError* err_out"); }
    return sb.toString();
}

function argsPass(n: int32, throwsOut: bool): String {
    let sb: StringBuilder = {} in default;
    let i: int32 = 0;
    while (i < n) {
        sb.add(", a${i}");
        i += 1;
    }
    if (throwsOut) { sb.add(", err_out"); }
    return sb.toString();
}

function retWord(t: Type): String {
    return t == T_VOID ? "" : "return ";
}

function dispatchHelper(out: StringBuilder, c: ClassInfo, m: MethodInfo in default): void {
    let pt: String[*] = paramCTypes(m);
    let th: bool = m.throwsType != null;
    out.add("static inline ${cType(m.sig!.elem!)} ${dispatchName(c.name, m)}(${c.name}* self${argsDecl(pt, th)}) {\n    ");
    out.add("${retWord(m.sig!.elem!)}((const ${c.name}_VTable*)rt_obj_vt(self))->${cSuffix(m)}(self${argsPass(pt.length, th)});\n}\n");
}

function interfaceTableStruct(out: StringBuilder, i: InterfaceInfo in default): void {
    out.add("struct ${i.name}_Table {\n    const RtClass* cls;\n");
    for (m in i.methods) {
        out.add("    ${cType(m.sig!.elem!)} (*${m.name})(void*");
        for (p in paramCTypes(m)) { out.add(", ${p}"); }
        if (m.throwsType != null) { out.add(", RtError*"); }
        out.add(");\n");
    }
    if (i.methods.length == 0) { out.add("    char _none;\n"); }
    out.add("};\n\n");
}

public function ifaceCallName(i: InterfaceInfo, m: MethodInfo): String { return "${i.name}_${m.name}__call"; }

function interfaceCallHelper(out: StringBuilder, i: InterfaceInfo, m: MethodInfo in default): void {
    let pt: String[*] = paramCTypes(m);
    let th: bool = m.throwsType != null;
    out.add("static inline ${cType(m.sig!.elem!)} ${ifaceCallName(i, m)}(${i.name} v${argsDecl(pt, th)}) { ");
    out.add("${retWord(m.sig!.elem!)}v.t->${m.name}(v.obj${argsPass(pt.length, th)}); }\n");
}

/** For each class that declares `implements I`: thunks plus a table. */
function interfaceImplementations(out: StringBuilder): void {
    for (c in classesByDepth()) {
        for (iname in c.interfaces) {
            let i: InterfaceInfo = interfaceOf(iname)!;
            for (im in i.methods) {
                let m: MethodInfo = findMethod(c.name, im.name, false, 0)!;
                let pt: String[*] = paramCTypes(im);
                let th: bool = im.throwsType != null;
                out.add("static ${cType(im.sig!.elem!)} ${c.name}__${iname}__${im.name}(void* self${argsDecl(pt, th)}) { ");
                out.add("${retWord(im.sig!.elem!)}${dispatchName(m.introducer, m)}((${m.introducer}*)self${argsPass(pt.length, th)}); }\n");
            }
            out.add("const ${iname}_Table ${c.name}__${iname}_table = { &rtclass_${c.name}");
            for (im in i.methods) { out.add(", ${c.name}__${iname}__${im.name}"); }
            out.add(" };\n");
        }
    }
}

function samTable(out: StringBuilder, i: InterfaceInfo in default): void {
    let m: MethodInfo = i.methods[0];
    out.add("static ${cType(m.sig!.elem!)} ${i.name}__sam_${m.name}(void* self");
    for (k, p in paramCTypes(m)) { out.add(", ${p} a${k}"); }
    out.add(");\n");
    out.add("const ${i.name}_Table ${i.name}__sam_table = { NULL, ${i.name}__sam_${m.name} };\n");
}

function samThunk(out: StringBuilder, i: InterfaceInfo in default): void {
    let m: MethodInfo = i.methods[0];
    let pt: String[*] = paramCTypes(m);
    out.add("static ${cType(m.sig!.elem!)} ${i.name}__sam_${m.name}(void* self${argsDecl(pt, false)}) { ");
    out.add("${retWord(m.sig!.elem!)}call_Closure_${m.sig!.funcId}(((${i.name}__Sam*)self)->fn${argsPass(pt.length, false)}); }\n");
}

function closureCallHelper(out: StringBuilder, ft: Type): void {
    let id: int32 = ft.funcId;
    let ps: StringBuilder = {};
    let args: StringBuilder = {};
    if (returnsData(ft.elem!)) {
        ps.add(", RtMem* rt_dest");
        args.add(", rt_dest");
    }
    for (i, p in ft.params) {
        ps.add(", ${cType(p)} a${i}");
        args.add(", a${i}");
    }
    out.add("static inline ${cType(ft.elem!)} call_Closure_${id}(Closure_${id} c${ps.toString()}) { ");
    out.add("${retWord(ft.elem!)}c.fn(&c.env${args.toString()}); }\n");
}

function collectionHelpers(out: StringBuilder, t: Type): void {
    if (isArray(t, ArrK.Growable)) {
        let n: String = structName(t);
        let e: String = cType(t.elem!);
        out.add("static inline ${n}* ${n}_new(RtMem* mem, int line) { ${n}* l = (${n}*)rt_mem_alloc(mem, sizeof(${n}), line); l->mem = mem; return l; }\n");
        out.add("static inline bool ${n}_push(${n}* l, ${e} v) {\n");
        out.add("    if (l->length == l->capacity) {\n");
        out.add("        int32_t nc = l->capacity ? (l->capacity < 0x3fffffff ? l->capacity * 2 : 0x7fffffff) : 8;\n");
        out.add("        if (nc == l->capacity) return false;\n");
        out.add("        ${e}* ni = (${e}*)rt_mem_try_realloc(l->mem, l->items, sizeof(${e}) * (size_t)l->capacity, sizeof(${e}) * (size_t)nc);\n");
        out.add("        if (!ni) return false;\n        l->items = ni;\n        l->capacity = nc;\n    }\n");
        out.add("    l->items[l->length++] = v;\n    return true;\n}\n");
        out.add("static inline void ${n}_add(${n}* l, ${e} v, int line) { if (!${n}_push(l, v)) rt_panic(\"memory is full\", line); }\n");
    } else if (isArray(t, ArrK.Fixed)) {
        let n: String = structName(t);
        let e: String = cType(t.elem!);
        out.add("static inline bool ${n}_push(${n}* a, ${e} v) { if (a->length >= ${t.size}) return false; a->items[a->length++] = v; return true; }\n");
    } else if (t.kind == TyK.Opt && !optIsPointer(t)) {
        let n: String = structName(t);
        out.add("static inline ${cType(t.elem!)} ${n}_unwrap(${n} o, int line) { if (!o.has) rt_panic(\"'!' used on a null value\", line); return o.value; }\n");
    }
}

// =====================================================================================
// Globals and entry point
// =====================================================================================

function initGlobals(): String {
    fn = newFn();
    pushBlock(Block {} in default);
    for (v in globals) {
        let s: Symbol = v.symbol!;
        if (s.memKind == MemK.FixedStatic) {
            line("${s.cName} = rt_mem_fixed(${s.cName}__buf, sizeof ${s.cName}__buf);");
        } else if (s.memKind == MemK.HeapGrowable) {
            line("${s.cName} = rt_mem_growable();");
        } else if (s.memKind == MemK.HeapFixed) {
            let size: String = expr(v.type.size!);
            line("${s.cName} = rt_mem_heap((int64_t)(${size}), ${v.line});");
        } else {
            let val: String = value(v.init!);
            line("${s.cName} = ${val};");
        }
    }
    let body: String = fn.out.toString();
    hasInit = !body.isEmpty();
    return !hasInit ? "" : "static void init_globals(void) {\n${body}}\n\n";
}

function mainWrapper(): String {
    let mo: FunctionInfo? = null;
    for (f in functions) {
        if (f.name == "main") { mo = f; }
    }
    if (mo == null || mo.isExtern) { return ""; }
    let main: FunctionInfo = mo;
    let withArgs: bool = main.sig!.params.length > 0;
    let sb: StringBuilder = {} in default;
    if (withArgs) { sb.add("int main(int argc, char** argv) {\n"); } else { sb.add("int main(void) {\n"); }
    if (hasInit) { sb.add("    init_globals();\n"); }
    if (withArgs) {     // the program's arguments, without its own name, as a String[]
        sb.add("    RtString* args = (RtString*)rt_mem_alloc(&rt_default_mem, sizeof(RtString) * (size_t)(argc > 1 ? argc - 1 : 1), 0);\n");
        sb.add("    for (int i = 1; i < argc; i++) args[i - 1] = rt_str_c(argv[i]);\n");
        sb.add("    Slice_s arg_slice = { args, argc > 1 ? (int32_t)(argc - 1) : 0 };\n");
    }
    let throwsOut: bool = main.throwsType != null;
    if (throwsOut) { sb.add("    RtError err;\n    err.kind = 0;\n"); }
    let a: String = withArgs ? "arg_slice" : "";
    if (withArgs && throwsOut) { a = "${a}, "; }
    if (throwsOut) { a = "${a}&err"; }
    let call: String = "user_main(${a})";
    if (main.sig!.elem! == T_VOID) { sb.add("    ${call};\n"); } else { sb.add("    int32_t result = ${call};\n"); }
    if (usesThreads) {
        sb.add("    rt_mem_finalize(&rt_default_mem);\n");
        for (v in globals) {
            let g: Symbol = v.symbol!;
            if (isMemory(g)) { sb.add("    rt_mem_finalize(&${g.cName});\n"); }
        }
    }
    if (throwsOut) {
        let en: String = main.throwsType!.name;
        sb.add("    if (err.kind != 0) {\n        fflush(stdout);\n        fprintf(stderr, \"uncaught error: ${en}.%s\\n\", ${en}__names[err.as.e_${en}.tag]);\n        return 1;\n    }\n");
    }
    if (main.sig!.elem! == T_VOID) { sb.add("    return 0;\n"); } else { sb.add("    return (int)result;\n"); }
    sb.add("}\n");
    return sb.toString();
}

// =====================================================================================
// Bodies and statements
// =====================================================================================

function usesErrors(body: Stmt[*] in default): bool {
    if (!hasErrors) { return false; }
    let ss: Stmt[*] = [] in default;
    allStmts(body, ss);
    for (s in ss) {
        if (s is ThrowStmt || s is TryStmt) { return true; }
    }
    let es: Expr[*] = [] in default;
    allExprs(body, false, es);
    for (e in es) {
        if (e is Call && e.throwing) { return true; }
        if (e is SwitchExpr sw) {
            for (c in sw.cases) {
                if (c.throwStmt != null) { return true; }
            }
        }
    }
    return false;
}

/** lock != "": a method of a synchronized class, locked for its whole run (unlocked on every exit). */
public function body(stmts: Stmt[*] in default, ret: Type in default, throwsOut: bool, lambda: LambdaInfo? in default,
                     ps: Symbol[*], lock: String, declLine: int32): String {
    let saved: Fn = fn;
    fn = newFn();
    fn.ret = ret;
    fn.throwsOut = throwsOut;
    fn.lambda = lambda;
    let root: Block = Block {} in default;
    pushBlock(root);
    if (debugLines) {                               // the start of the function is its declaration's line
        let mark: String = lineMark(declLine);
        if (mark != "") { line(mark); }
    }
    if (lock != "") {
        line("rt_sync_lock(${lock});");
        root.cleanups.push("rt_sync_unlock(${lock});");
    }
    for (p in ps) {
        if (!p.used) { line("(void)${p.cName};"); }
    }
    let all: Expr[*] = [] in default;           // the names bound by `is` live for the whole function
    allExprs(stmts, false, all);
    for (e in all) {
        let b: Symbol? = e is IsExpr ? e.symbol : null;
        if (b != null) {
            line("${cType(b.type)} ${b.cName} = NULL;");
            if (!b.used) { line("(void)${b.cName};"); }
        }
    }
    if (usesErrors(stmts)) {
        line("RtError err;");
        line("err.kind = 0;");
    } else if (throwsOut) {
        line("(void)err_out;");
    }
    openMemory(stmts);
    for (s in stmts) { stmt(s); }
    if (!endsWithJump(stmts)) {
        emitCleanups(root);
        // The language proved every path returns (loops forever, try/catch, switch);
        // C cannot see it, so close the function explicitly.
        if (ret != T_VOID) { line("return ${zero(ret)};"); }
    }
    let out: String = fn.out.toString();
    if (returnsData(ret) && !fn.destUsed) { out = "    (void)rt_dest;\n${out}" in default; }
    fn = saved;
    return out;
}

public function endsWithJump(stmts: Stmt[*]): bool {
    if (stmts.length == 0) { return false; }
    let last: Stmt = stmts[stmts.length - 1];
    return last is ReturnStmt || last is ThrowStmt;
}

function emitCleanups(b: Block): void {
    let i: int32 = b.cleanups.length - 1;
    while (i >= 0) {
        line(b.cleanups[i]);
        i -= 1;
    }
}

public function block(stmts: Stmt[*] in default): void {
    let b: Block = Block {} in default;
    pushBlock(b);
    openMemory(stmts);
    for (s in stmts) { stmt(s); }
    popBlock();
    if (!endsWithJump(stmts)) { emitCleanups(b); }
}

/** A block between braces, one level in. */
function bracedBlock(stmts: Stmt[*] in default): void {
    fn.indent += 1;
    block(stmts);
    fn.indent -= 1;
}

/** Emits the cleanups of every block from the innermost up to `stop` (inclusive). */
public function cleanupsUntil(stop: Block): void {
    let i: int32 = fn.blocks.length - 1;
    while (i >= 0) {
        let b: Block = fn.blocks[i];
        emitCleanups(b);
        if (b == stop) { return; }
        i -= 1;
    }
}

function anyCleanups(stop: Block): bool {
    let i: int32 = fn.blocks.length - 1;
    while (i >= 0) {
        let b: Block = fn.blocks[i];
        if (b.cleanups.length > 0) { return true; }
        if (b == stop) { return false; }
        i -= 1;
    }
    return false;
}

/** A statement; what it creates without a place lives in its temporary memory, freed when it ends. */
public function stmt(s: Stmt in default): void {
    if (debugLines) {
        let mark: String = lineMark(s.line);
        if (mark != "") { line(mark); }
    }
    let saved: Temp? = fn.temp;
    let t: Temp = Temp { owner: topBlock() } in default;
    fn.temp = t;
    let outer: StringBuilder = fn.out;
    fn.out = {} in default;                  // the statement, to put its memory before it if it used one
    stmtInner(s);
    let text: String = fn.out.toString();
    fn.out = outer;
    fn.temp = saved;
    if (t.name == "") {
        fn.out.add(text);
        return;
    }
    line("RtMem ${t.name} = rt_mem_growable();");
    fn.out.add(text);
    let free: String = "rt_mem_free(&${t.name});";
    let kept: String[*] = [] in default;
    let removed: bool = false;
    for (c in t.owner.cleanups) {
        if (!removed && c == free) { removed = true; } else { kept.push(c); }
    }
    t.owner.cleanups = kept;
    let one: Stmt[*] = [s];
    if (!endsWithJump(one)) { line(free); }
}

/** A block whose variables hold data gets its memory, freed when the block ends. */
public function openMemory(stmts: Stmt[*] in default): void {
    if (stmts.length == 0 || stmts[0].blockMemory == "") { return; }
    let m: String = stmts[0].blockMemory;
    line("RtMem ${m} = rt_mem_growable();");
    topBlock().cleanups.push("rt_mem_free(&${m});");
}

/** The current statement's temporary memory (declared before it the first time it is used). */
public function tempMem(): String {
    let t: Temp? = fn.temp;
    if (t == null) { return "&rt_default_mem"; }      // outside statements: initializing globals
    if (t.name == "") {
        t.name = tmp("tmp");
        t.owner.cleanups.push("rt_mem_free(&${t.name});");   // also on return, break or an error
    }
    return "&${t.name}";
}

function stmtInner(s: Stmt in default): void {
    switch (s) {
        case VarDecl v -> varDecl(v);
        case AssignStmt a -> assign(a);
        case BlockStmt b -> {
            line("{");
            bracedBlock(b.body);
            line("}");
        }
        case ReturnStmt r -> ret(r);
        case ExprStmt e -> discard(expr(e.expr));
        case IfStmt i -> ifStmt(i);
        case WhileStmt w -> whileStmt(w);
        case ForStmt f -> forStmt(f);
        case BreakStmt, ContinueStmt -> {
            if (loopBlock != null) { cleanupsUntil(loopBlock!); }
            line(s is BreakStmt ? "break;" : "continue;");
        }
        case ThrowStmt t -> throwStmt(t);
        case YieldStmt y -> {
            let arm: ArmCtx = fn.arms[fn.arms.length - 1];
            line("${arm.result} = ${value(y.value)};");
            cleanupsUntil(arm.block);
            line("goto ${arm.endLabel};");
            arm.used = true;
        }
        case TryStmt t -> tryStmt(t);
        case SwitchStmt sw -> switchCode(sw.switchExpr, false);
        default -> {}
    }
}

function assign(s: AssignStmt in default): void {
    let target: Expr = s.target;
    let parts: Expr[*] = [] in default;
    placeParts(target, parts);
    let held: Expr[*] = [] in default;
    if (s.value is Binary b && b.left == target) {      // a[i()] += v reads and writes the same place: i() runs once
        for (p in parts) {
            if (!isPure(p)) {
                p.computed = hoist(cType(p.ty!), expr(p));
                held.push(p);
            }
        }
    } else {                                            // the place, then the value (left to right)
        parts.push(s.value);
        held = inOrder(parts) in default;
    }
    assignTo(s, target);
    forget(held);
}

/**
 * The parts of a place that are computed, in order: the object and the index of a[i], the object of a.f.
 * An object that is a value (a struct, a T[N]) is not copied: its own place is looked into.
 */
function placeParts(target: Expr in default, parts: Expr[*] in default): void {
    switch (target) {
        case Index x -> {
            placeObject(x.object, parts);
            parts.push(x.index);
        }
        case Member m -> { placeObject(m.object, parts); }
        default -> { }
    }
}

function placeObject(o: Expr in default, parts: Expr[*] in default): void {
    let t: Type? = o.ty;
    if (t != null && (isStruct(t) || t.kind == TyK.Array && t.ak == ArrK.Fixed)) {
        placeParts(o, parts);
    } else {
        parts.push(o);
    }
}

function assignTo(s: AssignStmt in default, target: Expr in default): void {
    let mi: MemberInfo? = target.member;
    if (target is Member m && mi != null && mi.kind == MbK.AnyKey) {
        let obj: String = hoist("RtAny", expr(m.object));
        line("rt_any_set(${obj}, ${stringLiteral(mi.key)}, ${value(s.value)}, ${s.line});");
        return;
    }
    if (target is Index x && x.object.ty == T_ANY) {
        let obj: String = hoist("RtAny", expr(x.object));
        let key: String = expr(x.index);
        let v: String = value(s.value);
        if (x.index.ty == T_STRING) {
            line("rt_any_set(${obj}, ${key}, ${v}, ${s.line});");
        } else {
            line("rt_any_set_at(${obj}, (int64_t)(${key}), ${v}, ${s.line});");
        }
        return;
    }
    let t: String = lvalue(target);
    line("${t} = ${value(s.value)};");
}

function varDecl(v: VarDecl in default): void {
    let s: Symbol = v.symbol!;
    switch (s.memKind) {
        case HeapGrowable -> {
            line("RtMem ${s.cName} = rt_mem_growable();");
            topBlock().cleanups.push("rt_mem_free(&${s.cName});");
        }
        case HeapFixed -> {
            let size: String = expr(v.type.size!);
            line("RtMem ${s.cName} = rt_mem_heap((int64_t)(${size}), ${v.line});");
            topBlock().cleanups.push("rt_mem_free(&${s.cName});");
        }
        case FixedLocal -> {
            line("uint8_t ${s.cName}__buf[${s.type.size < 1 ? 1 : s.type.size}];");
            line("RtMem ${s.cName} = rt_mem_fixed(${s.cName}__buf, sizeof ${s.cName}__buf);");
            topBlock().cleanups.push("rt_mem_finalize(&${s.cName});");   // a File, a socket, a thread living here
        }
        default -> {
            let init: String = value(v.init!);
            line("${cType(s.type)} ${s.cName} = ${init};");
            if (!s.used) { line("(void)${s.cName};"); }
        }
    }
}

function ret(r: ReturnStmt in default): void {
    let a: Expr? = r.value;
    if (a == null) {
        cleanupsUntil(rootBlock());
        line("return;");
        return;
    }
    let v: String = value(a);
    if (anyCleanups(rootBlock())) {
        let t: String = tmp("ret");
        line("${cType(fn.ret)} ${t} = ${v};");
        cleanupsUntil(rootBlock());
        line("return ${t};");
    } else {
        line("return ${v};");
    }
}

function ifStmt(i: IfStmt in default): void {
    if (i.platform != "") {
        whenStmt(i);
        return;
    }
    let c: String = expr(i.cond);
    line("if (${strip(c)}) {");
    bracedBlock(i.thenBody);
    if (i.hasElse) {
        line("} else {");
        bracedBlock(i.elseBody);
    }
    line("}");
}

/**
 * #when windows ... #when macos ... #else ... #end: C's #if / #elif / #else / #endif, with no braces,
 * so what a branch declares stays for the code after it. Every branch is written (the C compiler keeps
 * one); what a branch leaves to free at the end of the block is freed only where that branch is kept.
 */
function whenStmt(i: IfStmt in default): void {
    let above: String[*] = [] in default;            // the conditions of the branches above
    let cur: IfStmt = i;
    while (true) {
        let c: String = platformCondition(cur.platform);
        line("${above.length == 0 ? "#if" : "#elif"} ${c}");
        whenBranch(cur.thenBody, keptWhen(c, above));
        above.push(c);
        if (!cur.hasElse) { break; }
        if (cur.elseBody.length == 1 && cur.elseBody[0] is IfStmt n && n.chained) {
            cur = n;
            continue;
        }
        line("#else");
        whenBranch(cur.elseBody, keptWhen("1", above));
        break;
    }
    line("#endif");
}

/** When the C compiler keeps a branch: its condition, and none of the ones above. */
function keptWhen(c: String, above: String[*]): String {
    if (above.length == 0) { return c; }
    return "(${c}) && !(${above.join(" || ")})";
}

function whenBranch(stmts: Stmt[*] in default, kept: String): void {
    let top: Block = topBlock();
    let before: int32 = top.cleanups.length;
    for (s in stmts) { stmt(s); }
    for (k in before..top.cleanups.length) {
        top.cleanups[k] = "#if ${kept}\n${top.cleanups[k]}\n#endif" in default;
    }
}

/** Opens the block of a loop body. */
function loopBlockOpen(): Block {
    let b: Block = Block {} in default;
    pushBlock(b);
    loopBlock = b;
    return b;
}

function loopBody(body: Stmt[*] in default, b: Block in default): void {
    openMemory(body);
    for (s in body) { stmt(s); }
    popBlock();
    if (!endsWithJump(body)) { emitCleanups(b); }
}

function whileStmt(w: WhileStmt in default): void {
    let saved: Block? = loopBlock;
    let cond: String = lazy(w.cond);
    let pre: String = lazyPre;
    line(pre.isEmpty() ? "while (${strip(cond)}) {" : "while (1) {");
    fn.indent += 1;
    let b: Block = loopBlockOpen();
    if (!pre.isEmpty()) {
        fn.out.add(indent4(pre));      // pre-lines were generated one level out
        line("if (!(${strip(cond)})) break;");
    }
    loopBody(w.body, b);
    fn.indent -= 1;
    line("}");
    loopBlock = saved;
}

/** `int32_t i = idx;` for the index variable of a for, if it has one. */
function indexVar(ix: Symbol? in default, value: String): void {
    if (ix == null) { return; }
    line("${ix.type == T_STRING ? "RtString" : "int32_t"} ${ix.cName} = ${value};");
    if (!ix.used) { line("(void)${ix.cName};"); }
}

function forStmt(f: ForStmt in default): void {
    let info: ForInfo = f.forInfo!;
    let saved: Block? = loopBlock;
    line("{");
    fn.indent += 1;
    let outer: Block = Block {} in default;
    pushBlock(outer);
    let v: Symbol = info.value!;
    if (info.range) {
        let ct: String = cType(info.elemType!);
        let start: String = tmp("from");
        let end: String = tmp("to");
        line("${ct} ${start} = ${expr(f.iterable)};");
        line("${ct} ${end} = ${expr(f.rangeEnd!)};");
        line("for (${ct} ${v.cName} = ${start}; ${v.cName} < ${end}; ${v.cName}++) {");
        if (!v.used) { line("    (void)${v.cName};"); }
    } else if (info.any != 0) {
        let named: bool = info.any == 2;
        let src: Expr = named && f.iterable is Member m ? m.object : f.iterable;
        let tb: String = tmp("table");
        let n: String = tmp("n");
        let idx: String = tmp("i");
        let count: String = named ? "count" : "length";
        line("RtAny ${tb}_v = ${expr(src)};");
        line("RtTable* ${tb} = ${tb}_v.kind == RT_ANY_TABLE ? ${tb}_v.as.t : NULL;");
        line("int32_t ${n} = ${tb} ? ${tb}->${count} : 0;");
        line("for (int32_t ${idx} = 0; ${idx} < ${n}; ${idx}++) {");
        fn.indent += 1;
        line("if (${tb}->${count} != ${n}) rt_panic(\"an Any table cannot gain or lose entries while it is being iterated\", ${f.line});");
        indexVar(info.index, named ? "${tb}->keys[${idx}]" : idx);
        line("RtAny ${v.cName} = ${tb}->${named ? "values" : "items"}[${idx}];");
        if (!v.used) { line("(void)${v.cName};"); }
        fn.indent -= 1;
    } else if (f.iterable.ty != null && f.iterable.ty! == T_STRING) {
        let text: String = tmp("text");
        let idx: String = tmp("i");
        line("RtString ${text} = ${expr(f.iterable)};");
        line("for (int32_t ${idx} = 0; ${idx} < ${text}.len; ${idx}++) {");
        fn.indent += 1;
        indexVar(info.index, idx);
        line("uint8_t ${v.cName} = (uint8_t)${text}.ptr[${idx}];");
        if (!v.used) { line("(void)${v.cName};"); }
        fn.indent -= 1;
    } else {
        let at: Type = f.iterable.ty!;
        let idx: String = tmp("i");
        let p: String = tmp(switch (at.ak) {
            case Fixed -> "arr";
            case Slice -> "view";
            default -> "list";
        });
        if (at.ak == ArrK.Fixed) {
            line("${cType(at)}* ${p} = ${addrOf(f.iterable)};");
        } else {
            line("${cType(at)} ${p} = ${expr(f.iterable)};");
        }
        let arrow: String = at.ak == ArrK.Slice ? "." : "->";
        line("for (int32_t ${idx} = 0; ${idx} < ${p}${arrow}length; ${idx}++) {");
        fn.indent += 1;
        let ix: Symbol? = info.index;
        if (ix != null) { line("int32_t ${ix.cName} = ${idx};"); }
        line("${cType(info.elemType!)} ${v.cName} = ${p}${arrow}items[${idx}];");
        if (ix != null && !ix.used) { line("(void)${ix.cName};"); }
        if (!v.used) { line("(void)${v.cName};"); }
        fn.indent -= 1;
    }
    fn.indent += 1;
    let b: Block = loopBlockOpen();
    loopBody(f.body, b);
    fn.indent -= 1;
    line("}");
    popBlock();
    fn.indent -= 1;
    line("}");
    loopBlock = saved;
}

public function throwStmt(t: ThrowStmt in default): void {
    let e: Type = t.value.ty!;
    let v: String = value(t.value);
    line("err.kind = ${enumOf(e.name)!.errorId};");
    line("err.as.e_${e.name} = ${v};");
    propagate();
}

/** Sends the current error to the innermost try, or to the caller. */
public function propagate(): void {
    if (fn.tries.length > 0) {
        let t: TryCtx = fn.tries[fn.tries.length - 1];
        cleanupsUntil(t.block);
        line("goto ${t.catchLabel};");
        return;
    }
    cleanupsUntil(rootBlock());
    if (fn.throwsOut) {
        line("*err_out = err;");
        line(fn.ret == T_VOID ? "return;" : "return ${zero(fn.ret)};");
    } else {
        line("rt_panic(\"uncaught error\", 0);");
    }
}

function tryStmt(t: TryStmt in default): void {
    let catchL: String = tmp("try_catch") in default;      // (kept in fn.tries while its body is generated)
    let endL: String = tmp("try_end");
    line("{");
    fn.indent += 1;
    let b: Block = Block {} in default;
    pushBlock(b);
    fn.tries.push(TryCtx { catchLabel: catchL, block: b } in default);
    openMemory(t.body);
    for (s in t.body) { stmt(s); }
    fn.tries.pop();
    popBlock();
    if (!endsWithJump(t.body)) { emitCleanups(b); }
    fn.indent -= 1;
    line("}");
    line("goto ${endL};");
    line("${catchL}:");
    for (i, c in t.catches) {
        let ci: CatchInfo = c.catchInfo!;
        let e: EnumInfo = ci.error!;
        line("${i == 0 ? "" : "} else "}if (err.kind == ${e.errorId}) {");
        fn.indent += 1;
        line("${tname(e.name)} ${ci.variable!.cName} = err.as.e_${e.name};");
        line("(void)${ci.variable!.cName};");
        line("err.kind = 0;");
        block(c.body);
        fn.indent -= 1;
    }
    line("} else {");
    fn.indent += 1;
    propagate();
    fn.indent -= 1;
    line("}");
    line("${endL}: ;");
}

// =====================================================================================
// Switch
// =====================================================================================

public function switchCode(sw: SwitchExpr in default, isExpr: bool): String {
    let si: SwitchInfo = sw.sw!;
    let st: Type = si.subjectType;
    let subj: String = tmp("subject");
    line("${cType(st)} ${subj} = ${expr(sw.subject)};");
    let res: String = "";
    if (isExpr) {
        res = tmp("value") in default;     // (kept in fn.arms while the arms are generated)
        line("${cType(si.resultType!)} ${res};");
        line("memset(&${res}, 0, sizeof ${res});");
    }
    let end: String = tmp("switch_end") in default;
    let jumped: bool = false;              // some goto to end was written
    let inner: Type = isOpt(st) ? st.elem! : st;
    let innerVal: String = isOpt(st) && !optIsPointer(st) ? "${subj}.value" : subj;
    for (c in sw.cases) {
        let pis: PatternInfo[*] = c.patternInfos;
        let tests: String[*] = [];
        for (pi in pis) { tests.push(patternTest(pi, st, inner, subj, innerVal)); }
        line("{");
        fn.indent += 1;
        line("if (${tests.join(" || ")}) {");
        fn.indent += 1;
        if (pis.length == 1) { bindPattern(pis[0], inner, subj, innerVal); }
        let guard: Expr? = c.guard;
        if (guard != null) {
            let g: String = expr(guard);
            line("if (${strip(g)}) {");
            fn.indent += 1;
        }
        let ae: Expr? = c.expr;
        if (c.throwStmt != null) {
            throwStmt(c.throwStmt!);
        } else if (ae != null) {
            if (isExpr) {
                let v: String = value(ae);
                line("${res} = ${v};");
            } else {
                discard(expr(ae));
            }
            line("goto ${end};");
            jumped = true;
        } else {
            line("{");
            fn.indent += 1;
            let b: Block = Block {} in default;
            pushBlock(b);
            if (isExpr) { fn.arms.push(ArmCtx { endLabel: end, result: res, block: b } in default); }
            openMemory(c.block);
            for (s in c.block) { stmt(s); }
            if (isExpr) {
                if (fn.arms[fn.arms.length - 1].used) { jumped = true; }
                fn.arms.pop();
            }
            popBlock();
            let jumps: bool = endsWithJump(c.block) || (isExpr && c.block.length > 0 && c.block[c.block.length - 1] is YieldStmt);
            if (!jumps) { emitCleanups(b); }
            fn.indent -= 1;
            line("}");
            if (!isExpr) {
                line("goto ${end};");
                jumped = true;
            }
        }
        if (guard != null) {
            fn.indent -= 1;
            line("}");
        }
        fn.indent -= 1;
        line("}");
        fn.indent -= 1;
        line("}");
    }
    if (isExpr) { line("rt_panic(\"no case of the switch matched\", ${sw.line});"); }
    if (jumped) { line("${end}: ;"); }
    return res;
}

// =====================================================================================
// Clone functions and class cloning (the type-level part)
// =====================================================================================

function clonePrototypes(): String {
    let sb: StringBuilder = {} in default;
    for (t in cloneTypeList()) { sb.add("${cloneHeader(t)};\n"); }
    return sb.toString();
}

function classClone(out: StringBuilder, c: ClassInfo in default): void {
    out.add("static void* ${c.name}__clone(void* self_, RtMem* mem, RtCloneMap* cm) {\n");
    if (c.sync || c.thread) {      // shared by reference: a copy would not share the lock or the thread
        out.add("    (void)mem;\n    (void)cm;\n    return self_;\n}\n\n");
        return;
    }
    out.add("    ${c.name}* o = (${c.name}*)self_;\n");
    out.add("    void* done = rt_clone_get(cm, o);\n    if (done) return done;\n");
    out.add("    ${c.name}* n = (${c.name}*)rt_mem_alloc(mem, sizeof(${c.name}), 0);\n");
    out.add("    *n = *o;\n    ((RtObjHead*)n)->mem = mem;\n    rt_clone_put(cm, o, n);\n");
    for (f in allFields(c.name)) {
        if (!needsDeepClone(f.type)) { continue; }
        let path: String = "n->${classFieldPath(c.name, f)}";
        out.add("    ${path} = ${cloneOf(f.type, path)};\n");
    }
    out.add("    return n;\n}\n\n");
}

// =====================================================================================
// A library's interface: its .h (C) and its .lar (Larimar), from its export functions
// =====================================================================================

/** The name a class or function has in Larimar's own code, without its module (the linker's a__b). */
function plainName(n: String): String {
    let at: int32? = n.lastIndexOf("__");
    return at != null ? n.substring(at + 2) : n;
}

/** The export functions of the library, in the order they are declared. */
function exports(): FunctionInfo[*] {
    let out: FunctionInfo[*] = [] in default;
    for (f in functions) {
        if (!f.isExtern && f.exportName != "" && f.sig != null) { out.push(f); }
    }
    return out;
}

/** What is wrong with the library's interface (two exports or classes with the same name): one message each. */
public function libraryProblems(): String[*] {
    let out: String[*] = [] in default;
    let seen: Any = {} in default;
    for (f in exports()) {
        let n: String = plainName(f.name);
        if (seen.contains(n)) { out.push("two export functions are called '${n}': the library's .lar would have both (give one another name)"); }
        seen[n] = true;
    }
    for (c in handleClasses()) {
        if (seen.contains(c)) { out.push("'${c}' is the name of a class and of an export function of the library: rename one"); }
        seen[c] = true;
    }
    if (exports().length == 0) { out.push("the library has no export functions: mark the functions C calls with 'export function'"); }
    let names: Any = {} in default;
    for (f in exports()) { names[f.exportName] = true; }
    for (cls in handleClassNames()) {
        for (m in libraryMembers(cls)) {
            if (names.contains(m.cName)) { out.push("'${m.cName}' is an export function and a member of ${plainName(cls)} in C: rename one (export function ... = c_name)"); }
            names[m.cName] = true;
        }
    }
    return out;
}

/** The doc comment (a doc block or // lines) right above a declaration, one line each. */
function docAbove(encoded: int32): String[*] {
    let out: String[*] = [];
    let index: int32 = encoded / FILE_LINES;
    if (index < 0 || index >= fileSources.length) { return out; }
    let lines: String[*] = fileSources[index].split("\n");
    let l: int32 = encoded % FILE_LINES - 2;
    let found: String[*] = [];
    while (l >= 0) {
        let t: String = lines[l].trim();
        if (!(t.startsWith("//") || t.startsWith("*") || t.startsWith("/*"))) { break; }
        let clean: String = t;
        if (clean.startsWith("/**")) { clean = clean.substring(3); }
        else if (clean.startsWith("/*")) { clean = clean.substring(2); }
        else if (clean.startsWith("//")) { clean = clean.substring(2); }
        else if (clean.startsWith("*") && !clean.startsWith("*/")) { clean = clean.substring(1); }
        if (clean.endsWith("*/")) { clean = clean.substring(0, clean.length - 2); }
        if (clean.startsWith("*/")) { clean = ""; }
        found.push(clean.trim().clone());
        l -= 1;
    }
    let i: int32 = found.length - 1;
    while (i >= 0) {
        if (found[i] != "" || out.length > 0) { out.push(found[i].clone()); }
        i -= 1;
    }
    while (out.length > 0 && out[out.length - 1] == "") { out.pop(); }
    return out;
}

/** A doc comment for the .h or the .lar ("" when there is none). */
function docBlock(lines: String[*], indent: String): String {
    if (lines.length == 0) { return ""; }
    if (lines.length == 1) { return "${indent}/** ${lines[0]} */\n"; }
    let sb: StringBuilder = {} in default;
    sb.add("${indent}/**\n");
    for (l in lines) { sb.add(l == "" ? "${indent} *\n" : "${indent} * ${l}\n"); }
    sb.add("${indent} */\n");
    return sb.toString();
}

/** A type of an export function in the library's .h. */
function headerType(t: Type, result: bool): String {
    if (t == T_STRING || t == optT(T_STRING)) { return result ? "char*" : "const char*"; }
    if (isHandle(t)) { return "${libraryPrefix != "" ? "${libraryPrefix}_" : ""}${plainName((isOpt(t) ? t.elem! : t).name)}*"; }
    return t == T_VOID ? "void" : cType(t);
}

/** The C prototype of an export function in the .h. */
function headerPrototype(f: FunctionInfo): String {
    let ps: String[*] = [] in default;
    for (i, p in f.sig!.params) { ps.push("${headerType(p, false)} ${escapeName(f.params[i].name)}"); }
    if (ps.length == 0) { ps.push("void"); }
    return "${headerType(f.sig!.elem!, true)} ${f.exportName}(${ps.join(", ")})";
}

/** What the .h says a result is, after its doc comment. */
function resultNote(f: FunctionInfo): String { return typeNote(f.sig!.elem!); }

function typeNote(r: Type): String {
    let p: String = libraryPrefix != "" ? "${libraryPrefix}_" : "";
    if (r == T_STRING) { return "The text is yours: free it with ${p}free."; }
    if (r == optT(T_STRING)) { return "NULL, or a text that is yours: free it with ${p}free."; }
    if (isHandle(r)) {
        let c: String = plainName((isOpt(r) ? r.elem! : r).name);
        return isOpt(r) ? "NULL, or a new ${c} that is yours: give it back with ${p}${c}_release." : "A new ${c} that is yours: give it back with ${p}${c}_release.";
    }
    return "";
}

/** The library's header for C: its handles, its export functions, how to free what they give. */
public function libraryHeader(name: String, version: String, kind: String, hash: String, made: String): String {
    let p: String = libraryPrefix != "" ? "${libraryPrefix}_" : "";
    let guard: String = "${name.toUpperCase()}_H";
    let sb: StringBuilder = {} in default;
    sb.add("/*\n * ${name}.h: ${name} ${version}, a ${kind} library written in Larimar (${made}).\n");
    sb.add(" * Written by larimar build from the export functions: do not edit it.\n *\n");
    sb.add(" * - A text it returns (char*) is yours: free it with ${p}free.\n");
    let hs: String[*] = handleClasses();
    if (hs.length > 0) { sb.add(" * - A handle (${p}${hs[0]}*...) is an object of the library: give it back with its _release.\n"); }
    sb.add(" * - The texts it receives are copied when it keeps them; NULL is an error, except for a String? (may be NULL).\n");
    sb.add(" * - A panic inside the library (a bug: an index out of range, a NULL handle) prints it and ends the program.\n */\n");
    sb.add("#ifndef ${guard}\n#define ${guard}\n\n#include <stdint.h>\n#include <stdbool.h>\n\n");
    sb.add("/* The interface it was built with: ${p}interface() gives the one of the library linked. */\n");
    sb.add("#define ${name.toUpperCase()}_INTERFACE \"${hash}\"\n\n");
    sb.add("#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n");
    for (c in hs) { sb.add("typedef struct ${p}${c} ${p}${c};\n"); }
    if (hs.length > 0) { sb.add("\n"); }
    for (cls in handleClassNames()) {                // the members of each class: its fields (read) and methods
        let c: String = plainName(cls);
        sb.add("/* ${c}: its fields (to read) and its methods; self is the handle. */\n\n");
        for (m in libraryMembers(cls)) {
            let doc: String[*] = docAbove(m.field != null ? m.field!.line : m.method!.decl.line);
            let r: Type = m.field != null ? m.field!.type : m.method!.sig!.elem!;
            let note: String = typeNote(r);
            if (note != "") {
                if (doc.length > 0) { doc.push(""); }
                doc.push(note);
            }
            sb.add(docBlock(doc, ""));
            let ps: String[*] = ["${p}${c}* self"];
            if (m.method != null) {
                for (i, t in m.method!.sig!.params) { ps.push("${headerType(t, false)} ${escapeName(m.method!.decl.params[i].name)}"); }
            }
            sb.add("${headerType(r, true)} ${m.cName}(${ps.join(", ")});\n\n");
        }
    }
    for (f in exports()) {
        let doc: String[*] = docAbove(f.line);
        let note: String = resultNote(f);
        if (note != "") {
            if (doc.length > 0) { doc.push(""); }
            doc.push(note);
        }
        sb.add(docBlock(doc, ""));
        sb.add("${headerPrototype(f)};\n\n");
    }
    for (c in hs) { sb.add("/** Gives back a ${c} (NULL does nothing). */\nvoid ${p}${c}_release(${p}${c}* handle);\n\n"); }
    sb.add("/** Frees a text the library returned (NULL does nothing). */\nvoid ${p}free(void* text);\n\n");
    sb.add("/** The interface hash of the library (as in ${name}.interface): compare it with ${name.toUpperCase()}_INTERFACE. */\n");
    sb.add("const char* ${p}interface(void);\n\n");
    sb.add("#ifdef __cplusplus\n}\n#endif\n\n#endif\n");
    return sb.toString();
}

/**
 * A class of the library in its .lar: a resource (the handle) with its fields as `native let` and its
 * methods as `native function`, so a program uses it as in the library: c.add("x"), c.words.
 */
function bindingClass(cls: String in default, p: String): String {
    let c: String = plainName(cls);
    let sb: StringBuilder = {} in default;
    sb.add(docBlock(docAbove(classOf(cls)!.line), ""));
    let members: LibraryMember[*] = libraryMembers(cls);
    let skips: String[*] = memberSkips(cls);
    if (members.length == 0 && skips.length == 0) {
        sb.add("public native type ${c} = ${p}${c}* released by ${p}${c}_release;\n\n");
        return sb.toString();
    }
    sb.add("public native type ${c} = ${p}${c}* released by ${p}${c}_release {\n");
    if (skips.length > 0) { sb.add("    // not given to C (they do not cross): ${skips.join(", ")}\n"); }
    for (m in members) {
        if (m.field != null) {
            let f: FieldInfo = m.field!;
            sb.add(docBlock(docAbove(f.line), "    "));
            let released: String = f.type == T_STRING || f.type == optT(T_STRING) ? " released by ${p}free" : "";
            sb.add("    native let ${f.name}: ${bindingType(f.type)} = ${m.cName}${released};\n");
            continue;
        }
        let mi: MethodInfo = m.method!;
        let ps: String[*] = [];
        let names: String[*] = [];
        for (i, t in mi.sig!.params) {
            ps.push("${mi.decl.params[i].name}: ${bindingType(t)}");
            names.push(mi.decl.params[i].name);
        }
        let r: Type = mi.sig!.elem!;
        sb.add(docBlock(docAbove(mi.decl.line), "    "));
        if (isHandle(r) && !isOpt(r)) {        // C gives a handle that is never NULL: the same type as in the library
            sb.add("    function ${m.name}(${ps.join(", ")}): ${bindingType(r)} { return self.${m.name}_c(${names.join(", ")})!; }\n");
            sb.add("    native function ${m.name}_c(${ps.join(", ")}): ${bindingType(r)}? = ${m.cName};\n");
            continue;
        }
        let released: String = r == T_STRING || r == optT(T_STRING) ? " released by ${p}free" : "";
        sb.add("    native function ${m.name}(${ps.join(", ")}): ${r == T_VOID ? "void" : bindingType(r)} = ${m.cName}${released};\n");
    }
    sb.add("}\n\n");
    return sb.toString();
}

/** A type of an export function in the library's .lar. */
function bindingType(t: Type): String {
    if (isHandle(t)) { return isOpt(t) ? "${plainName(t.elem!.name)}?" : plainName(t.name); }
    return t.text;
}

/**
 * The library's module for Larimar: native declarations of its export functions, with the C names of
 * the .h. A text is copied into the caller's memory and freed; a class is a resource that gives the handle back.
 */
public function libraryModule(name: String, version: String, kind: String, made: String): String {
    let p: String = libraryPrefix != "" ? "${libraryPrefix}_" : "";
    let sb: StringBuilder = {} in default;
    sb.add("// ${name} ${version}: a ${kind} library written in Larimar (${made}).\n");
    sb.add("// Written by larimar build from the export functions: do not edit it. ${name}.interface has the hash\n");
    sb.add("// of this file, and so does the library inside: a program builds only when they agree.\n\n");
    sb.add("c_include \"${name}.h\";\n\n");
    for (cls in handleClassNames()) { sb.add(bindingClass(cls, p)); }
    for (f in exports()) {
        let ps: String[*] = [] in default;
        let names: String[*] = [] in default;
        for (i, t in f.sig!.params) {
            ps.push("${f.params[i].name}: ${bindingType(t)}");
            names.push(f.params[i].name);
        }
        let n: String = plainName(f.name);
        let r: Type = f.sig!.elem!;
        let ret: String = ": ${r == T_VOID ? "void" : bindingType(r)}";
        let released: String = r == T_STRING || r == optT(T_STRING) ? " released by ${p}free" : "";
        sb.add(docBlock(docAbove(f.line), ""));
        if (isHandle(r) && !isOpt(r)) {         // C gives a handle that is never NULL: the same type as in the library
            sb.add("public function ${n}(${ps.join(", ")}): ${bindingType(r)} { return ${n}_c(${names.join(", ")})!; }\n");
            sb.add("native function ${n}_c(${ps.join(", ")}): ${bindingType(r)}? = ${f.exportName};\n\n");
        } else if (isHandle(r)) {
            sb.add("public native function ${n}(${ps.join(", ")})${ret} = ${f.exportName};\n\n");
        } else {
            sb.add("public native function ${n}(${ps.join(", ")})${ret} = ${f.exportName}${released};\n\n");
        }
    }
    sb.add("// what gives back the texts and objects of the library (only the compiler calls them)\n");
    sb.add("native function ${p}free(text: String): void = ${p}free;\n");
    for (c in handleClasses()) { sb.add("native function ${p}${c}_release(handle: ${c}): void = ${p}${c}_release;\n"); }
    return sb.toString();
}
