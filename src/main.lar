// larimar: the Larimar tool and compiler, written in Larimar (Larimar.java + Transpiler.java).
//
//   larimar new <name>              creates a project
//   larimar build [folder]          larimar.toml -> build/<name>.c -> executable
//   larimar run [folder] [-- args]  builds, then runs the program
//   larimar build --debug           -g -O0 and #line to the .lar files (debuggers; also run, and file.lar -o)
//   larimar check [file|folder]     the errors, without generating C (--json for tools)
//   larimar test [file|folder]...   runs the tests (testing.lar)
//   larimar lsp                     the language server for editors (LSP on stdin/stdout)
//   larimar dap                     the debugger for editors (DAP on stdin/stdout, over lldb-dap)
//   larimar c <file.lar>            prints the C of a file (imports are looked up next to it)
//   larimar <file.lar> [-o out.c]   the same, written to a file (how the compiler is used by scripts)

import std.os;
import std.text { isIdentifierPart, isDigit };
import std.io.path as Paths;
import std.io.files as Files;
import std.io { IoError };
import std.io.console as Console;
import syntax.ast { Program };
import semantics.linker { linkErrors, decode, readSource, testsKept };
import semantics.analyzer { analysisErrors };
import editor.session { analyzeFile, readErrors, stdDir, checkCommand, sourceRoot };
import editor.docstore { setDocument };
import project.testing { TestSettings, TestFunction, runTests, testFunctions, hasMain, withMain };
import editor.lsp { serve, worker };
import editor.dap { serveDebugger };
import codegen.gen { generate, generatorErrors, debugLines, spreadLines };
import codegen.debugmap { debugMap };
import project.cc { windows, quote, commandLine, systemLibraries, selfPath, CCompiler, chooseCompiler, installHint };
import std.encoding.toml as Toml;
import std.encoding.toml { TomlError };
import std.os.process { Process, ProcessError };

const VERSION: String = "1.1.0";

/** The version of the language this compiler implements (SPEC.md). */
const LANGUAGE: String = "1.0";

/** Set when a command fails; main prints it as "larimar: ...". */
let toolError: String = "";

/** Compile errors (already in their final form), printed one per line. */
let compileErrors: String[*] = [] in default;

function main(args: String[]): int32 {
    if (args.length == 0) {
        usage();
        return 2;
    }
    let code: int32 = command(args);
    if (compileErrors.length > 0) {
        for (e in compileErrors) { Console.printError(e); }
        return 1;
    }
    if (toolError != "") {
        Console.printError("larimar: ${toolError}");
        return 1;
    }
    return code;
}

/** build/demo.c -> build/demo.debug.json: what larimar dap needs to show the program as Larimar. */
function debugMapPath(cFile: String): String {
    let base: String = cFile.endsWith(".c") ? cFile.substring(0, cFile.length - 2) : cFile;
    return "${base}.debug.json";
}

/** --debug: #line for the debugger, -g -O0 */
let debugBuild: bool = false;

/** --cc <program>: the C compiler for this build, instead of the project's */
let compilerOverride: String = "";

function fail(msg: String in default): int32 {
    toolError = msg;
    return 1;
}

function command(args: String[]): int32 {
    let rest: String[*] = [];
    let programArgs: String[*] = [];
    let dashed: bool = false;
    let i: int32 = 1;
    while (i < args.length) {
        if (dashed) {
            programArgs.push(args[i]);
        } else if (args[i] == "--") {
            dashed = true;
        } else if (args[i] == "--debug") {
            debugBuild = true;
        } else if (args[i] == "--cc" && i + 1 < args.length) {
            compilerOverride = args[i + 1].clone() in default;
            i += 1;
        } else {
            rest.push(args[i]);
        }
        i += 1;
    }
    let cmd: String = args[0];
    if (cmd == "new") { return rest.length != 1 ? fail("usage: larimar new <name>") : create(rest[0]); }
    if (cmd == "build" || cmd == "run") {
        if (rest.length > 1) { return fail("expected at most one folder, got [${rest.join(", ")}]"); }
        let dir: String = rest.length == 1 ? rest[0] : ".";
        let p: Project? = load(Paths.absolute(dir));
        if (p == null) { return 1; }
        let exe: String = build(p, debugBuild);
        if (exe == "") { return 1; }
        return cmd == "build" ? 0 : execute(exe, programArgs);
    }
    if (cmd == "check" || cmd == "lsp" || cmd == "lsp-worker") { testsKept = "all"; }     // test functions are checked too
    if (cmd == "check") { return checkCommand(rest); }
    if (cmd == "test") {
        let s: TestSettings? = testSettings();
        return s != null ? runTests(rest, s!.clone() in default) : 1;
    }
    if (cmd == "test-main") { return testMain(rest); }
    if (cmd == "lsp") { return serve(); }
    if (cmd == "dap") { return serveDebugger(rest); }
    if (cmd == "lsp-worker") { return rest.length == 2 ? worker(rest[0], rest[1]) : fail("usage: larimar lsp-worker <request.json> <response.json>"); }
    if (cmd == "c") {
        if (rest.length != 1) { return fail("usage: larimar c <file.lar>"); }
        let c: String = compileFile(rest[0], ".");
        if (compileErrors.length > 0) { return 1; }
        print(c);
        return 0;
    }
    if (cmd == "version" || cmd == "--version") {
        println("larimar ${VERSION} (language ${LANGUAGE})");
        return 0;
    }
    if (cmd == "help" || cmd == "--help" || cmd == "-h") {
        usage();
        return 0;
    }
    if (cmd.endsWith(".lar")) {
        // larimar file.lar -o out.c: its C; larimar file.lar [args]: build it and run it
        if (args.contains("-o")) { return compileTo(args); }
        let scriptArgs: String[*] = [];
        for (a in rest) { scriptArgs.push(a); }
        for (a in programArgs) { scriptArgs.push(a); }
        return runScript(cmd, scriptArgs);
    }
    let problems: String[*] = [];
    let found: Plugin[*] = plugins(problems);
    for (m in problems) { Console.printError("larimar: ${m}"); }
    for (pl in found) {
        if (pl.command == cmd) { return runPlugin(pl, args); }
    }
    return fail("unknown command '${cmd}'. Run 'larimar help'.");
}

function usage(): void {
    println("larimar ${VERSION} (language ${LANGUAGE})");
    println("");
    println("  larimar new <name>            create a project in a new folder");
    println("  larimar build [folder]        compile the project (larimar.toml) to an executable");
    println("  larimar run [folder] [-- args] build, then run it with the arguments");
    println("  larimar build --debug         with -g -O0 and the .lar lines, for a debugger (lldb, gdb, VS Code)");
    println("  larimar check [file|folder]   find the errors without generating C (--json for tools)");
    println("  larimar test [file|folder]... run the tests (tests/ by default; --only <text>, --test <name>,");
    println("                                --list, --json, --no-sanitize)");
    println("  larimar lsp                   language server for editors (speaks LSP on stdin/stdout)");
    println("  larimar dap [--backend <lldb-dap>]  debugger for editors (DAP on stdin/stdout, over lldb-dap)");
    println("  larimar <file.lar> [args]     build one file and run it (with the bundled tcc when there is one:");
    println("                                it starts fast); its own arguments after '--' when they look like ours");
    println("  larimar c <file.lar>          print the generated C of a file");
    println("  larimar <file.lar> -o <out.c> write the generated C of a file");
    println("  larimar build --cc <program>  build with that C compiler instead of the project's ('tcc': the bundled one)");
    let problems: String[*] = [];
    let found: Plugin[*] = plugins(problems);
    if (found.length > 0) {
        println("");
        println("  from plugins ($LARIMAR_HOME/plugins):");
        for (pl in found) {
            println("  larimar ${pl.command.padEnd(22, " ")} ${pl.program} ${pl.args.join(" ")}  (${pl.file})");
        }
    }
    for (m in problems) { println("  problem: ${m}"); }
    println("");
}

// =========================================================================
// Plugins: other programs of $LARIMAR_HOME/bin that answer commands of larimar
// =========================================================================

/** The commands of larimar itself: a plugin cannot take them. */
const OWN_COMMANDS: String = " new build run check test test-main lsp lsp-worker dap c version help --version --help -h ";

/** A command of a plugin: `larimar <command> x` runs `bin/<program> <args> x`. */
class Plugin {
    let file: String;          // plugins/<name>.toml
    let program: String;
    let command: String;
    let args: String[*] = [];
}

/** $LARIMAR_HOME: the folder of bin/, std/ and plugins/. */
function larimarHome(): String { return Paths.parent(stdDir()); }

/**
 * The commands that plugins declare, one file each in $LARIMAR_HOME/plugins:
 *
 *   [plugin]
 *   name = "minero"
 *   program = "minero"             # a program of $LARIMAR_HOME/bin, nowhere else
 *   version = "1.0.0"
 *
 *   [commands]
 *   add = ["add"]                  # larimar add x  ->  bin/minero add x
 *
 * A plugin cannot take a command of larimar itself, and two plugins cannot take the same one: both are
 * problems (and that command is not taken).
 */
function plugins(problems: String[*]): Plugin[*] {
    let out: Plugin[*] = [];
    let dir: String = Paths.join(larimarHome(), "plugins");
    if (!Files.isDirectory(dir)) { return out; }
    let names: String[*] = [];
    try { names = Files.list(dir); } catch (IoError e) { return out; }
    names.sort();
    for (name in names) {
        if (!name.endsWith(".toml")) { continue; }
        let shown: String = "plugins/${name}";
        let config: Any = null;
        try {
            config = Toml.parse(Files.readString(Paths.join(dir, name)));
        } catch (IoError e) {
            problems.push("cannot read ${shown}".clone());
            continue;
        } catch (TomlError e) {
            problems.push("${shown}: ${Toml.message(e)}".clone());
            continue;
        }
        let program: String = config.plugin.program as String ?? "";
        if (program == "" || program.contains("/") || program.contains("\\")) {
            problems.push("${shown} needs [plugin] program = \"<a program of bin/>\"".clone());
            continue;
        }
        for (command, value in config.commands.fields) {
            if (OWN_COMMANDS.contains(" ${command} ")) {
                problems.push("${shown} cannot take 'larimar ${command}': it is a command of larimar".clone());
                continue;
            }
            let taken: String = "";
            for (other in out) {
                if (other.command == command) { taken = other.file; }
            }
            if (taken != "") {
                problems.push("'larimar ${command}' is taken by ${taken} and by ${shown}".clone());
                continue;
            }
            let args: String[*] = [];
            for (i, a in value) { args.push((a as String ?? "").clone()); }
            out.push(Plugin { file: shown.clone(), program: program.clone(), command: command.clone(), args });
        }
    }
    return out;
}

/** Runs the program of a plugin with its arguments and the user's, on this console; its exit code is larimar's. */
function runPlugin(pl: Plugin, args: String[]): int32 {
    let home: String = larimarHome();
    let exe: String = Paths.join(Paths.join(home, "bin"), windows() ? "${pl.program}.exe" : pl.program);
    if (!Files.isFile(exe)) {
        return fail("'larimar ${pl.command}' is answered by ${pl.program} (${pl.file}), but ${Paths.join("bin", Paths.fileName(exe))} does not exist in ${home}".clone() in default);
    }
    let all: String[*] = [];
    for (a in pl.args) { all.push(a); }
    for (i in 1..args.length) { all.push(args[i]); }
    let p: Process = { program: exe, args: all, env: ["LARIMAR_HOME=${home}"], shareConsole: true };
    try {
        p.start();
    } catch (ProcessError e) {
        return fail("cannot start ${exe}".clone() in default);
    }
    while (true) {
        let code: int32? = p.wait(60000);
        if (code != null) { return code!; }
    }
    return 0;
}

/** larimar main.lar [-o out.c] */
function compileTo(args: String[]): int32 {
    let input: String = args[0];
    let output: String = "";
    let i: int32 = 1;
    while (i < args.length) {
        if (args[i] == "-o" && i + 1 < args.length) {
            output = args[i + 1];
            i += 2;
        } else if (args[i] == "--debug") {
            debugLines = true;
            i += 1;
        } else {
            return fail("unexpected '${args[i]}' (usage: larimar <file.lar> [-o <out.c>])");
        }
    }
    let generated: String = compileFile(input, ".");
    if (compileErrors.length > 0) { return 1; }
    let c: String = debugLines ? spreadLines(generated, Paths.normalize(Paths.absolute(output != "" ? output : "out.c"))) : generated;
    if (output == "") {
        print(c);
        return 0;
    }
    try {
        Files.writeString(output, c);
        if (debugLines) { Files.writeString(debugMapPath(output), debugMap()); }
    } catch (IoError e) {
        return fail("cannot write ${output}");
    }
    return 0;
}

// =========================================================================
// compiling (Transpiler.java)
// =========================================================================

/** The C of a main file; `import a.b` reads a/b.lar next to it. Messages name files relative to `shownFrom`. */
function compileFile(main: String, shownFrom: String): String {
    let ok: bool = analyzeFile(main, shownFrom);
    for (e in readErrors) { compileErrors.push(e); }
    for (e in linkErrors) { compileErrors.push(decode(e)); }
    for (e in analysisErrors) { compileErrors.push(decode(e)); }
    if (!ok) { return ""; }
    let c: String = generate();
    if (generatorErrors.length > 0) {
        for (e in generatorErrors) { compileErrors.push(decode(e)); }
        return "";
    }
    return c;
}

// =========================================================================
// larimar test (testing.lar runs them; test-main is what it calls for each file of test functions)
// =========================================================================

/** The C compiler for the tests (a test file that uses TLS needs the system's: compileC says so). */
function testCompiler(wanted: String): CCompiler? {
    let problem: String[*] = [];
    let cc: CCompiler? = chooseCompiler(larimarHome(), wanted, false, false, problem);
    if (cc == null) { toolError = problem[0].clone() in default; }
    return cc;
}

/** The project's [c] settings for the tests, or the defaults when there is no larimar.toml here. */
function testSettings(): TestSettings? {
    let here: String = Paths.absolute(".");
    if (!Files.isFile("larimar.toml")) {
        let cc: CCompiler? = testCompiler((os.env("CC") ?? "").trim());
        if (cc == null) { return null; }
        return TestSettings {
            compiler: cc.program, first: cc.first, bundled: cc.bundled, libraries: [], libraryPaths: [], includePaths: [],
            sources: [], root: "", outDir: Paths.join(here, "build/test")
        };
    }
    let p: Project? = load(here);
    if (p == null) { return null; }
    let sources: String[*] = [];
    for (x in p.sources) { sources.push(resolve(here, x).clone()); }
    let includes: String[*] = [];
    for (x in p.includePaths) { includes.push(resolve(here, x).clone()); }
    let libPaths: String[*] = [];
    for (x in p.libraryPaths) { libPaths.push(resolve(here, x).clone()); }
    let cc: CCompiler? = testCompiler(compilerOverride != "" ? compilerOverride : p.compiler);
    if (cc == null) { return null; }
    return TestSettings {
        compiler: cc.program, first: cc.first, bundled: cc.bundled, libraries: p.libraries, libraryPaths: libPaths, includePaths: includes, sources,
        root: Paths.parent(resolve(here, p.main)), outDir: Paths.join(resolve(here, p.buildDir), "test")
    };
}

/**
 * larimarc test-main <file.lar> -o <out.c> [--root <folder>]: the C of a file of test functions with a
 * main added (testing.lar). Next to out.c it writes the file with its main (.lar) and the tests' names
 * (.tests, one per line).
 */
function testMain(rest: String[*]): int32 {
    let file: String = "";
    let output: String = "";
    let root: String = "";
    let i: int32 = 0;
    while (i < rest.length) {
        if (rest[i] == "-o" && i + 1 < rest.length) {
            output = rest[i + 1];
            i += 2;
        } else if (rest[i] == "--root" && i + 1 < rest.length) {
            root = rest[i + 1];
            i += 2;
        } else if (file == "") {
            file = rest[i];
            i += 1;
        } else {
            return fail("usage: larimarc test-main <file.lar> -o <out.c> [--root <folder>]");
        }
    }
    if (file == "" || output == "") { return fail("usage: larimarc test-main <file.lar> -o <out.c> [--root <folder>]"); }
    let source: String? = readSource(file);
    if (source == null) { return fail("cannot read ${file}"); }
    if (hasMain(source!)) { return fail("${file} has test functions and a main: larimar test writes the main, so remove it"); }
    let tests: TestFunction[*] = testFunctions(source!);
    let full: String = withMain(source!, tests);
    setDocument(Paths.normalize(Paths.absolute(file)), full);
    testsKept = "main";
    if (root != "") { sourceRoot = Paths.normalize(Paths.absolute(root)).clone() in default; }
    let base: String = output.endsWith(".c") ? output.substring(0, output.length - 2) : output;
    let names: String[*] = [];
    for (t in tests) { names.push(t.name); }
    try {
        Files.writeString("${base}.lar", full);
        Files.writeString("${base}.tests", names.join("\n"));
    } catch (IoError e) {
        return fail("cannot write ${base}.lar");
    }
    let c: String = compileFile(file, ".");
    if (compileErrors.length > 0) { return 1; }
    try {
        Files.writeString(output, c);
    } catch (IoError e) {
        return fail("cannot write ${output}");
    }
    return 0;
}

// =========================================================================
// larimar.toml
// =========================================================================

class Project {
    let dir: String;
    let name: String;
    let main: String;
    let output: String;
    let buildDir: String;
    let compiler: String;
    let flags: String[*];
    let libraries: String[*];
    let libraryPaths: String[*];
    let includePaths: String[*];
    let sources: String[*];
}


function load(dir: String): Project? {
    let source: String? = readSource(Paths.join(dir, "larimar.toml"));
    if (source == null) {
        toolError = "no larimar.toml in ${dir}. Create a project with 'larimar new <name>'." in default;
        return null;
    }
    let config: Any = null;
    try {
        config = Toml.parse(source!);
    } catch (TomlError e) {
        switch (e) { case Invalid { line, why } -> compileErrors.push("Project Error [larimar.toml:${line}]: ${why}"); }
        return null;
    }
    return project(dir, config);
}

let problems: String[*] = [] in default;

const PROJECT_KEYS: String = "[build_dir, main, name, output, version]";
const C_KEYS: String = "[compiler, flags, include_paths, libraries, library_paths, sources]";

function allowedKey(section: String, key: String): bool {
    return section == "project" ? key == "name" || key == "version" || key == "main" || key == "output" || key == "build_dir" : key == "compiler" || key == "flags" || key == "libraries" || key == "library_paths" || key == "include_paths" || key == "sources";
}

function project(dir: String, config: Any): Project? {
    let topKeys: String[*] = [];
    for (sectionName, section in config.fields) {
        if (!isSection(section)) {
            topKeys.push(sectionName.clone());
            continue;
        }
        if (sectionName == "dependencies") { continue; }      // the versions are for Minero; the compiler only looks for deps/<name>
        if (sectionName != "project" && sectionName != "c") {
            problems.push("unknown section [${sectionName}] (sections: [project], [c], [dependencies])");
            continue;
        }
        let allowed: String = sectionName == "project" ? PROJECT_KEYS : C_KEYS;
        for (key, value in section.fields) {
            // [c.linux], [c.macos], [c.windows], [c.unix]: a table with names (an empty [] is a list, as in libraries = [])
            if (sectionName == "c" && isSection(value) && (isPlatform(key) || hasNames(value))) {
                if (!isPlatform(key)) {
                    problems.push("unknown section [c.${key}] (platforms: [c.linux], [c.macos], [c.windows], [c.unix])");
                    continue;
                }
                for (platformKey, platformValue in value.fields) {
                    if (!allowedKey("c", platformKey)) { problems.push("unknown key '${platformKey}' in [c.${key}] (keys: ${C_KEYS})"); }
                }
            } else if (!allowedKey(sectionName, key)) {
                problems.push("unknown key '${key}' in [${sectionName}] (keys: ${allowed})");
            }
        }
    }
    if (topKeys.length > 0) { problems.push("keys must go inside [project] or [c]: [${topKeys.join(", ")}]"); }
    let p: Any = config.project;
    let c: Any = config.c;
    let name: String = text(p, "name", "");
    if (name == "") {
        problems.push("[project] needs a name: name = \"my-program\"");
    } else if (!validName(name)) {
        problems.push("the project name can only use letters, digits, '_', '-' and '.'");
    }
    let main: String = text(p, "main", "src/main.lar");
    let buildDir: String = text(p, "build_dir", "build");
    let exeSuffix: String = windows() ? ".exe" : "";
    let output: String = text(p, "output", "${buildDir}/${name}${exeSuffix}");
    let cc: String = (os.env("CC") ?? "").trim();     // what was asked for; "" chooses (chooseCompiler)
    // [c] for every platform, then [c.unix] (Linux and macOS) and [c.<this platform>]: their lists are added
    // to [c]'s, and a compiler there replaces [c]'s
    let unix: Any = windows() ? null : c.unix;
    let here: Any = c[os.platform()];
    let compiler: String = text(here, "compiler", text(unix, "compiler", text(c, "compiler", cc)));
    let flags: String[*] = list(c, "flags", ["-O2"]);
    let libraries: String[*] = list(c, "libraries", []);
    let libraryPaths: String[*] = list(c, "library_paths", []);
    let includePaths: String[*] = list(c, "include_paths", []);
    let sources: String[*] = list(c, "sources", []);
    let platformSections: Any[] = [unix, here];
    for (platform in platformSections) {
        for (x in list(platform, "flags", [])) { flags.push(x.clone()); }
        for (x in list(platform, "libraries", [])) { libraries.push(x.clone()); }
        for (x in list(platform, "library_paths", [])) { libraryPaths.push(x.clone()); }
        for (x in list(platform, "include_paths", [])) { includePaths.push(x.clone()); }
        for (x in list(platform, "sources", [])) { sources.push(x.clone()); }
    }
    // [dependencies]: Minero puts each one in deps/<name>; its modules are imported from deps/<name>/src,
    // and the C of its [c] (libraries, paths, sources) is added to the project's
    for (depName, _ in config.dependencies.fields) {
        let depDir: String = Paths.join(Paths.join(dir, "deps"), depName);
        if (!Files.isDirectory(depDir)) {
            problems.push("'${depName}' is in [dependencies] but not in deps/: get it with 'larimar fetch' (Minero)".clone());
            continue;
        }
        let depToml: String = Paths.join(depDir, "larimar.toml");
        if (!Files.isFile(depToml)) { continue; }
        try {
            let depConfig: Any = Toml.parse(Files.readString(depToml));
            let dc: Any = depConfig.c;
            let depUnix: Any = windows() ? null : dc.unix;
            let depHere: Any = dc[os.platform()];
            let depSections: Any[] = [dc, depUnix, depHere];
            for (section in depSections) {
                for (x in list(section, "libraries", [])) { libraries.push(x.clone()); }
                for (x in list(section, "library_paths", [])) { libraryPaths.push(Paths.join(depDir, x).clone()); }
                for (x in list(section, "include_paths", [])) { includePaths.push(Paths.join(depDir, x).clone()); }
                for (x in list(section, "sources", [])) { sources.push(Paths.join(depDir, x).clone()); }
            }
        } catch (IoError e) {
            problems.push("cannot read deps/${depName}/larimar.toml".clone());
        } catch (TomlError e) {
            problems.push("deps/${depName}/larimar.toml: ${Toml.message(e)}".clone());
        }
    }
    if (problems.length > 0) {
        for (m in problems) { compileErrors.push("Project Error [larimar.toml]: ${m}"); }
        return null;
    }
    return Project { dir, name, main, output, buildDir, compiler, flags, libraries, libraryPaths, includePaths, sources };
}

/** The platforms of [c.<platform>]: the same names as #when. */
function isPlatform(name: String): bool {
    return name == "linux" || name == "macos" || name == "windows" || name == "unix";
}

/** A [section] of larimar.toml: a table with named entries (a list has positions). */
/** Whether a table has entries with a name (a section does; a list does not). */
function hasNames(value: Any): bool {
    for (k, v in value.fields) { return true; }
    return false;
}

function isSection(value: Any): bool {
    return switch (value) {
        case Any table -> table.length == 0;
        default -> false;
    };
}

function text(section: Any, key: String, def: String): String {
    let value: Any = section[key];
    if (value == null) { return def; }
    let found: String? = value as String;
    if (found != null) { return found!.clone(); }
    problems.push("'${key}' must be a \"string\"");
    return def;
}

function list(section: Any, key: String, def: String[*]): String[*] {
    let value: Any = section[key];
    if (value == null) { return def; }
    let items: String[*] = [];
    let isList: bool = switch (value) {
        case Any table -> true;
        default -> false;
    };
    if (isList) {
        for (i, item in value) {
            let text: String? = item as String;
            if (text == null) {
                problems.push("'${key}' must be a list of strings: ${key} = [\"...\"]");
                return def;
            }
            items.push(text!.clone());
        }
        return items;
    }
    problems.push("'${key}' must be a list: ${key} = [\"...\"]");
    return def;
}

function validName(name: String): bool {
    if (name.isEmpty()) { return false; }
    for (b in name) {
        if (!isIdentifierPart(b) && b != '-' && b != '.') { return false; }
    }
    return true;
}

// =========================================================================
// build
// =========================================================================

/** A path of the project: relative to its folder, or absolute. */
function resolve(dir: String, p: String): String { return Paths.normalize(Paths.join(dir, p)); }

/** Builds the project; returns the executable, or "" on failure. */
function build(p: Project, debug: bool): String {
    let dir: String = p.dir;
    let main: String = resolve(dir, p.main);
    if (!Files.isFile(main)) {
        toolError = "the main file ${p.main} does not exist (set it with main = \"...\" in [project])" in default;
        return "";
    }
    debugLines = debug;
    let generated: String = compileFile(main, dir);
    if (compileErrors.length > 0) { return ""; }
    let cFile: String = resolve(Paths.join(dir, p.buildDir), "${p.name}.c");
    let c: String = debug ? spreadLines(generated, Paths.normalize(Paths.absolute(cFile))) : generated;
    let exe: String = resolve(dir, p.output);
    try {
        Files.createDirectories(Paths.parent(cFile));
        Files.createDirectories(Paths.parent(exe));
        Files.writeString(cFile, c);
        if (debug) { Files.writeString(debugMapPath(cFile), debugMap()); }
    } catch (IoError e) {
        toolError = "cannot write ${cFile}" in default;
        return "";
    }
    let problem: String[*] = [];
    let chosen: CCompiler? = chooseCompiler(larimarHome(), compilerOverride != "" ? compilerOverride : p.compiler, false, generated.contains("#define LM_NET_TLS"), problem);
    if (chosen == null) {
        toolError = problem[0].clone() in default;
        return "";
    }
    let cc: CCompiler = chosen;
    let cmd: String[*] = [cc.program];
    for (a in cc.first) { cmd.push(a); }
    cmd.push("-std=c99");
    for (f in p.flags) {
        if (!debug || !(f.startsWith("-O") || f == "-s")) { cmd.push(f); }     // --debug: no optimizing
    }
    if (debug) {
        cmd.push("-g");
        cmd.push("-O0");
    }
    cmd.push("-o");
    cmd.push(exe);
    cmd.push(cFile);
    for (s in p.sources) { cmd.push(resolve(dir, s)); }
    for (ip in p.includePaths) { cmd.push("-I${resolve(dir, ip)}"); }
    for (lp in p.libraryPaths) { cmd.push("-L${resolve(dir, lp)}"); }
    for (l in p.libraries) { cmd.push("-l${l}"); }
    // Dynamic libraries stay where they are (nothing is copied): the executable is told to look for them
    // there when it runs (Linux and macOS; on Windows a DLL is found next to the .exe or in the PATH).
    if (!windows()) {
        for (lp in p.libraryPaths) { cmd.push("-Wl,-rpath,${resolve(dir, lp)}"); }
    }
    for (l in systemLibraries(c)) { cmd.push(l.clone()); }
    let code: int32 = os.run(commandLine(cmd));
    if (code == 127) {
        toolError = "cannot run the C compiler '${cc.program}'. Install one (${installHint()}), or set compiler = \"...\" in [c]." in default;
        return "";
    }
    if (code != 0) {
        toolError = "the C compiler failed (exit ${code}). Command: ${cmd.join(" ")}\nThe generated C is in ${Paths.relative(dir, cFile)}" in default;
        return "";
    }
    if (cc.fallback) {
        Console.printError("note: no C compiler found, so the bundled tcc built it (fast to build, not optimized). For faster programs: ${installHint()}");
    }
    Console.printError(debug ? "built ${Paths.relative(dir, exe)} (debug)" : "built ${Paths.relative(dir, exe)}");
    return exe;
}

/**
 * larimar file.lar [args]: the file is built in a folder of the system's temporary files (the bundled tcc
 * first: it starts fast) and run with the arguments; its exit code is larimar's. Nothing is printed but
 * what the program prints, so scripts can be piped.
 */
function runScript(file: String, args: String[*]): int32 {
    let generated: String = compileFile(file, ".");
    if (compileErrors.length > 0) { return 1; }
    let problem: String[*] = [];
    let wanted: String = compilerOverride != "" ? compilerOverride : (os.env("CC") ?? "").trim();
    let chosen: CCompiler? = chooseCompiler(larimarHome(), wanted, true, generated.contains("#define LM_NET_TLS"), problem);
    if (chosen == null) { return fail(problem[0].clone() in default); }
    let cc: CCompiler = chosen;
    let temp: String = os.env(windows() ? "TEMP" : "TMPDIR") ?? "";
    if (temp.isBlank()) { temp = windows() ? "." : "/tmp"; }
    let dir: String = Paths.join(temp, "larimar");
    let name: String = Paths.fileName(file);
    let base: String = Paths.join(dir, "${name.substring(0, name.length - 4)}-${os.processId()}");
    let cFile: String = "${base}.c";
    let exe: String = windows() ? "${base}.exe" : base;
    try {
        Files.createDirectories(dir);
        Files.writeString(cFile, generated);
    } catch (IoError e) {
        return fail("cannot write ${cFile}".clone() in default);
    }
    let cmd: String[*] = [cc.program];
    for (a in cc.first) { cmd.push(a); }
    let rest: String[] = ["-std=c99", "-O1", "-o", exe, cFile];
    for (a in rest) { cmd.push(a); }
    if (!windows()) { cmd.push("-lm"); }
    for (l in systemLibraries(generated)) { cmd.push(l.clone()); }
    let log: String = "${base}.txt";
    let code: int32 = os.run("${commandLine(cmd)} > ${quote(log)} 2>&1");
    if (code != 0) {
        let said: String = "";
        try { said = Files.readString(log); } catch (IoError e) {}
        return fail("the C compiler failed (exit ${code}): ${said.trim()}\nThe generated C is in ${cFile}".clone() in default);
    }
    let result: int32 = execute(exe, args);
    let made: String[] = [cFile, exe, log];
    for (f in made) {
        try { Files.delete(f); } catch (IoError e) {}
    }
    return result;
}

function execute(exe: String, args: String[*]): int32 {
    let parts: String[*] = [quote(exe)];
    for (a in args) { parts.push(quote(a)); }
    return os.run(parts.join(" "));
}

// =========================================================================
// new
// =========================================================================

function create(path: String): int32 {
    let name: String = Paths.fileName(Paths.normalize(path));
    if (!validName(name)) { return fail("the project name can only use letters, digits, '_', '-' and '.'"); }
    if (Files.exists(path)) { return fail("${path} already exists"); }
    try {
        Files.createDirectories(Paths.join(path, "src"));
        Files.writeString(Paths.join(path, "larimar.toml"), """
            [project]
            name = "${name}"
            version = "0.1.0"
            main = "src/main.lar"

            [c]
            flags = ["-O2"]
            libraries = []
            """);
        Files.writeString(Paths.join(path, "src/main.lar"), """
            function main(): int32 {
                println("Hello from ${name}!");
                return 0;
            }
            """);
        Files.writeString(Paths.join(path, ".gitignore"), "build/\n");
    } catch (IoError e) {
        return fail("cannot create ${path}");
    }
    println("created ${path}\n  cd ${path}\n  larimar run");
    return 0;
}
