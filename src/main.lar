// larimar: the Larimar tool and compiler, written in Larimar (Larimar.java + Transpiler.java).
//
//   larimar new <name>              creates a project
//   larimar build [folder]          larimar.toml -> build/<name>.c -> executable (a library: build/<name>/)
//   larimar run [folder] [-- args]  builds, then runs the program
//   larimar build --debug           -g -O0 and #line to the .lar files (debuggers; also run, and file.lar -o)
//   larimar check [file|folder]     the errors, without generating C (--json for tools)
//   larimar test [file|folder]...   runs the tests (testing.lar)
//   larimar lsp                     the language server for editors (LSP on stdin/stdout)
//   larimar dap                     the debugger for editors (DAP on stdin/stdout, over lldb-dap)
//   larimar c <file.lar>            prints the C of a file (imports are looked up next to it)
//   larimar <file.lar> [-o out.c]   the same, written to a file (how the compiler is used by scripts)

import std.os;
import std.os { Platform };
import std.text { isIdentifierPart, isDigit };
import std.io.path as Paths;
import std.io.files as Files;
import std.io { IoError };
import std.io.console as Console;
import syntax.ast { Program };
import semantics.linker { linkErrors, decode, readSource, testsKept, target };
import semantics.analyzer { analysisErrors };
import editor.session { analyzeFile, readErrors, stdDir, checkCommand, sourceRoot };
import editor.docstore { setDocument };
import project.testing { TestSettings, TestFunction, runTests, testFunctions, hasMain, withMain };
import editor.lsp { serve, worker };
import editor.dap { serveDebugger };
import codegen.gen { debugLines, generate, generatorErrors, INTERFACE_MARK, spreadLines };
import codegen.gen.library { libraryHeader, libraryModule, libraryProblems };
import semantics.types { buildingLibrary, libraryRules, libraryPrefix };
import project.libraries { LarimarLibrary, larimarLibraries, interfaceHash, libraryFile, interfaceText };
import project.lpk { pack };
import codegen.debugmap { debugMap };
import project.cc { windows, mac, quote, commandLine, systemLibraries, selfPath, CCompiler, chooseCompiler, installHint };
import std.encoding.toml as Toml;
import std.encoding.toml { TomlError };
import std.os.process { Process, ProcessError };

const VERSION: String = "1.7.0";

/** The version of the language this compiler implements (docs/spec.md). */
const LANGUAGE: String = "1.0";

/** Set when a command fails; main prints it as "larimar: ...". */
let toolError: String = "";

/** Compile errors (already in their final form), printed one per line. */
let compileErrors: String[*] = [] in default;

function main(args: String[]): int32 {
    if (args.length == 0) {
        usage();
        return 2;
    }
    let code: int32 = command(args);
    if (compileErrors.length > 0) {
        for (e in compileErrors) { Console.printError(e); }
        return 1;
    }
    if (toolError != "") {
        Console.printError("larimar: ${toolError}");
        return 1;
    }
    return code;
}

/** build/demo.c -> build/demo.debug.json: what larimar dap needs to show the program as Larimar. */
function debugMapPath(cFile: String): String {
    let base: String = cFile.endsWith(".c") ? cFile.substring(0, cFile.length - 2) : cFile;
    return "${base}.debug.json";
}

/** --debug: #line for the debugger, -g -O0 */
let debugBuild: bool = false;

/** --cc <program>: the C compiler for this build, instead of the project's */
let compilerOverride: String = "";

/** --static / --dynamic: the kind of library to build, instead of the project's ([library] type) */
let libraryOverride: String = "";

function fail(msg: String in default): int32 {
    toolError = msg;
    return 1;
}

/** The options of larimar itself, taken out of the arguments; what follows `--` is the program's. */
function command(args: String[]): int32 {
    let rest: String[*] = [];
    let programArgs: String[*] = [];
    let dashed: bool = false;
    let i: int32 = 1;
    while (i < args.length) {
        let a: String = args[i];
        let next: String? = i + 1 < args.length ? args[i + 1] : null;
        i += 1;
        if (dashed) {
            programArgs.push(a);
            continue;
        }
        switch (a) {
            case "--" -> { dashed = true; }
            case "--debug" -> { debugBuild = true; }
            case "--static", "--dynamic" -> { libraryOverride = a.substring(2).clone() in default; }
            case "--cc" when next != null -> {
                compilerOverride = next!.clone() in default;
                i += 1;
            }
            case "--target" when next != null -> {
                if (!isPlatform(next!)) { return fail("--target ${next!}: the platforms are linux, macos, windows and unix"); }
                target = next!.clone() in default;
                i += 1;
            }
            default -> rest.push(a);
        }
    }
    let cmd: String = args[0];
    if (cmd == "check" || cmd == "lsp" || cmd == "lsp-worker") { testsKept = "all"; }     // test functions are checked too
    return switch (cmd) {
        case "new" -> newProject(rest);
        case "build", "run" -> buildProject(cmd == "run", rest, programArgs);
        case "check" -> checkCommand(rest);
        case "test" -> test(rest);
        case "test-main" -> testMain(rest);
        case "lsp" -> serve();
        case "lsp-worker" -> rest.length == 2 ? worker(rest[0], rest[1]) : fail("usage: larimar lsp-worker <request.json> <response.json>");
        case "dap" -> serveDebugger(rest);
        case "c" -> rest.length == 1 ? writeC(rest[0], "") : fail("usage: larimar c <file.lar>");
        case "version", "--version" -> version();
        case "help", "--help", "-h" -> usage();
        default -> cmd.endsWith(".lar") ? file(cmd, rest, programArgs) : plugin(cmd, args);
    };
}

/** larimar new <name> [--library] */
function newProject(rest: String[*]): int32 {
    let names: String[*] = [];
    for (r in rest) {
        if (r != "--library") { names.push(r); }
    }
    return names.length == 1 ? create(names[0], rest.contains("--library")) : fail("usage: larimar new <name> [--library]");
}

/** larimar build [folder], larimar run [folder] [-- args] */
function buildProject(run: bool, rest: String[*], programArgs: String[*]): int32 {
    if (rest.length > 1) { return fail("expected at most one folder, got [${rest.join(", ")}]"); }
    let p: Project? = load(Paths.absolute(rest.length == 1 ? rest[0] : "."));
    if (p == null) { return 1; }
    if (p.kind == "library") {
        if (run) { return fail("${p.name} is a library: it has no main to run. Build it (larimar build), and run a program that uses it."); }
        return buildLibrary(p, debugBuild) ? 0 : 1;
    }
    if (libraryOverride != "") { return fail("--${libraryOverride} is for libraries ([project] kind = \"library\"), and ${p.name} is a program"); }
    let exe: String = build(p, debugBuild);
    if (exe == "") { return 1; }
    return run ? execute(exe, programArgs) : 0;
}

/** larimar test [file|folder]... */
function test(rest: String[*]): int32 {
    let s: TestSettings? = testSettings();
    return s != null ? runTests(rest, s!.clone() in default) : 1;
}

/** larimar file.lar -o out.c: its C; larimar file.lar [args]: build it and run it */
function file(main: String, rest: String[*], programArgs: String[*]): int32 {
    if (rest.contains("-o")) {
        if (rest.length != 2 || rest[0] != "-o") { return fail("usage: larimar <file.lar> -o <out.c> [--debug] [--target <platform>]"); }
        debugLines = debugBuild;
        return writeC(main, rest[1]);
    }
    let scriptArgs: String[*] = [];
    for (a in rest) { scriptArgs.push(a); }
    for (a in programArgs) { scriptArgs.push(a); }
    return runScript(main, scriptArgs);
}

/** The C of a file, into `output` ("": printed). */
function writeC(main: String, output: String): int32 {
    let generated: String = compileFile(main, ".");
    if (compileErrors.length > 0) { return 1; }
    let c: String = debugLines ? spreadLines(generated, Paths.normalize(Paths.absolute(output != "" ? output : "out.c"))) : generated;
    if (output == "") {
        print(c);
        return 0;
    }
    try {
        Files.writeString(output, c);
        if (debugLines) { Files.writeString(debugMapPath(output), debugMap()); }
    } catch (IoError e) {
        return fail("cannot write ${output}");
    }
    return 0;
}

/** A command that is not larimar's: a plugin's, or an error. */
function plugin(cmd: String, args: String[]): int32 {
    let problems: String[*] = [];
    let found: Plugin[*] = plugins(problems);
    for (m in problems) { Console.printError("larimar: ${m}"); }
    for (pl in found) {
        if (pl.command == cmd) { return runPlugin(pl, args); }
    }
    return fail("unknown command '${cmd}'. Run 'larimar help'.");
}

function version(): int32 {
    println("larimar ${VERSION} (language ${LANGUAGE})");
    return 0;
}

function usage(): int32 {
    println("""
        larimar ${VERSION} (language ${LANGUAGE})

          larimar new <name> [--library] create a project in a new folder (a program, or a library)
          larimar build [folder]        compile the project (larimar.toml) to an executable, or a library:
                                        build/<name>.lpk, a package (a program names it in [packages]),
                                        and build/<name>/ with what it has: <name>.c, .h, .lar, .interface
          larimar build --static | --dynamic  a library compiled for C (lib<name>.a, .so), instead of a package
          larimar run [folder] [-- args] build, then run it with the arguments
          larimar build --debug         with -g -O0 and the .lar lines, for a debugger (lldb, gdb, VS Code)
          larimar check [file|folder]   find the errors without generating C (--json for tools)
          larimar test [file|folder]... run the tests (tests/ by default; --only <text>, --test <name>,
                                        --list, --json, --no-sanitize)
          larimar lsp                   language server for editors (speaks LSP on stdin/stdout)
          larimar dap [--backend <lldb-dap>]  debugger for editors (DAP on stdin/stdout, over lldb-dap)
          larimar <file.lar> [args]     build one file and run it (with the bundled tcc when there is one:
                                        it starts fast); its own arguments after '--' when they look like ours
          larimar c <file.lar>          print the generated C of a file
          larimar <file.lar> -o <out.c> write the generated C of a file
          larimar build --cc <program>  build with that C compiler instead of the project's ('tcc': the bundled one)
          larimar ... --target <platform>  generate the C of one platform only (linux, macos, windows, unix),
                                        with no #if: by default the same C builds on every one
        """);
    let problems: String[*] = [];
    let found: Plugin[*] = plugins(problems);
    if (found.length > 0) {
        println("  from plugins ($LARIMAR_HOME/plugins):");
        for (pl in found) {
            println("  larimar ${pl.command.padEnd(22, " ")} ${pl.program} ${pl.args.join(" ")}  (${pl.file})");
        }
        println("");
    }
    for (m in problems) { println("  problem: ${m}"); }
    return 0;
}

// =========================================================================
// Plugins: other programs of $LARIMAR_HOME/bin that answer commands of larimar
// =========================================================================

/** The commands of larimar itself: a plugin cannot take them. */
const OWN_COMMANDS: String = " new build run check test test-main lsp lsp-worker dap c version help --version --help -h ";

/** A command of a plugin: `larimar <command> x` runs `bin/<program> <args> x`. */
class Plugin {
    let file: String;          // plugins/<name>.toml
    let program: String;
    let command: String;
    let args: String[*] = [];
}

/** $LARIMAR_HOME: the folder of bin/, std/ and plugins/. */
function larimarHome(): String { return Paths.parent(stdDir()); }

/**
 * The commands that plugins declare, one file each in $LARIMAR_HOME/plugins:
 *
 *   [plugin]
 *   name = "mytool"
 *   program = "mytool"             # a program of $LARIMAR_HOME/bin, nowhere else
 *   version = "1.0.0"
 *
 *   [commands]
 *   hello = ["hello"]              # larimar hello x  ->  bin/mytool hello x
 *
 * A plugin cannot take a command of larimar itself, and two plugins cannot take the same one: both are
 * problems (and that command is not taken).
 */
function plugins(problems: String[*]): Plugin[*] {
    let out: Plugin[*] = [];
    let dir: String = Paths.join(larimarHome(), "plugins");
    if (!Files.isDirectory(dir)) { return out; }
    let names: String[*] = [];
    try { names = Files.list(dir); } catch (IoError e) { return out; }
    names.sort();
    for (name in names) {
        if (!name.endsWith(".toml")) { continue; }
        let shown: String = "plugins/${name}";
        let config: Any = null;
        try {
            config = Toml.parse(Files.readString(Paths.join(dir, name)));
        } catch (IoError e) {
            problems.push("cannot read ${shown}".clone());
            continue;
        } catch (TomlError e) {
            problems.push("${shown}: ${Toml.message(e)}".clone());
            continue;
        }
        let program: String = config.plugin.program as String ?? "";
        if (program == "" || program.contains("/") || program.contains("\\")) {
            problems.push("${shown} needs [plugin] program = \"<a program of bin/>\"".clone());
            continue;
        }
        for (command, value in config.commands.fields) {
            if (OWN_COMMANDS.contains(" ${command} ")) {
                problems.push("${shown} cannot take 'larimar ${command}': it is a command of larimar".clone());
                continue;
            }
            let taken: String = "";
            for (other in out) {
                if (other.command == command) { taken = other.file; }
            }
            if (taken != "") {
                problems.push("'larimar ${command}' is taken by ${taken} and by ${shown}".clone());
                continue;
            }
            let args: String[*] = [];
            for (i, a in value) { args.push((a as String ?? "").clone()); }
            out.push(Plugin { file: shown.clone(), program: program.clone(), command: command.clone(), args });
        }
    }
    return out;
}

/** Runs the program of a plugin with its arguments and the user's, on this console; its exit code is larimar's. */
function runPlugin(pl: Plugin, args: String[]): int32 {
    let home: String = larimarHome();
    let exe: String = Paths.join(Paths.join(home, "bin"), windows() ? "${pl.program}.exe" : pl.program);
    if (!Files.isFile(exe)) {
        return fail("'larimar ${pl.command}' is answered by ${pl.program} (${pl.file}), but ${Paths.join("bin", Paths.fileName(exe))} does not exist in ${home}".clone() in default);
    }
    let all: String[*] = [];
    for (a in pl.args) { all.push(a); }
    for (i in 1..args.length) { all.push(args[i]); }
    let p: Process = { program: exe, args: all, env: ["LARIMAR_HOME=${home}"], shareConsole: true };
    try {
        p.start();
    } catch (ProcessError e) {
        return fail("cannot start ${exe}".clone() in default);
    }
    while (true) {
        let code: int32? = p.wait(60000);
        if (code != null) { return code!; }
    }
    return 0;
}

// =========================================================================
// compiling (Transpiler.java)
// =========================================================================

/** The C of a main file; `import a.b` reads a/b.lar next to it. Messages name files relative to `shownFrom`. */
function compileFile(main: String, shownFrom: String): String {
    let ok: bool = analyzeFile(main, shownFrom);
    for (e in readErrors) { compileErrors.push(e); }
    for (e in linkErrors) { compileErrors.push(decode(e)); }
    for (e in analysisErrors) { compileErrors.push(decode(e)); }
    if (!ok) { return ""; }
    let c: String = generate();
    if (generatorErrors.length > 0) {
        for (e in generatorErrors) { compileErrors.push(decode(e)); }
        return "";
    }
    return c;
}

// =========================================================================
// larimar test (testing.lar runs them; test-main is what it calls for each file of test functions)
// =========================================================================

/** The C compiler for the tests (a test file that uses TLS needs the system's: compileC says so). */
function testCompiler(wanted: String): CCompiler? {
    let problem: String[*] = [];
    let cc: CCompiler? = chooseCompiler(larimarHome(), wanted, false, false, problem);
    if (cc == null) { toolError = problem[0].clone() in default; }
    return cc;
}

/** The project's [c] settings for the tests, or the defaults when there is no larimar.toml here. */
function testSettings(): TestSettings? {
    let here: String = Paths.absolute(".");
    if (!Files.isFile("larimar.toml")) {
        let cc: CCompiler? = testCompiler((os.env("CC") ?? "").trim());
        if (cc == null) { return null; }
        return TestSettings {
            compiler: cc.program, first: cc.first, bundled: cc.bundled, links: [], includePaths: [],
            sources: [], root: "", outDir: Paths.join(here, "build/test")
        };
    }
    let p: Project? = load(here);
    if (p == null) { return null; }
    let sources: String[*] = [];
    for (x in p.sources) { sources.push(resolve(here, x).clone()); }
    let includes: String[*] = [];
    for (x in p.includePaths) { includes.push(resolve(here, x).clone()); }
    for (l in p.larimarLibraries) {
        includes.push(l.dir);
        for (x in l.includePaths) { includes.push(x); }
        for (x in l.sources) { sources.push(x.clone()); }
    }
    let cc: CCompiler? = testCompiler(compilerOverride != "" ? compilerOverride : p.compiler);
    if (cc == null) { return null; }
    let links: String[*] = linkArgs(p, cc.bundled);
    if (toolError != "") { return null; }
    return TestSettings {
        compiler: cc.program, first: cc.first, bundled: cc.bundled, links, includePaths: includes, sources,
        root: Paths.parent(resolve(here, p.main)), outDir: Paths.join(resolve(here, p.buildDir), "test")
    };
}

/**
 * larimarc test-main <file.lar> -o <out.c> [--root <folder>]: the C of a file of test functions with a
 * main added (testing.lar). Next to out.c it writes the file with its main (.lar) and the tests' names
 * (.tests, one per line).
 */
function testMain(rest: String[*]): int32 {
    let file: String = "";
    let output: String = "";
    let root: String = "";
    let i: int32 = 0;
    while (i < rest.length) {
        if (rest[i] == "-o" && i + 1 < rest.length) {
            output = rest[i + 1];
            i += 2;
        } else if (rest[i] == "--root" && i + 1 < rest.length) {
            root = rest[i + 1];
            i += 2;
        } else if (file == "") {
            file = rest[i];
            i += 1;
        } else {
            return fail("usage: larimarc test-main <file.lar> -o <out.c> [--root <folder>]");
        }
    }
    if (file == "" || output == "") { return fail("usage: larimarc test-main <file.lar> -o <out.c> [--root <folder>]"); }
    let source: String? = readSource(file);
    if (source == null) { return fail("cannot read ${file}"); }
    if (hasMain(source!)) { return fail("${file} has test functions and a main: larimar test writes the main, so remove it"); }
    let tests: TestFunction[*] = testFunctions(source!);
    let full: String = withMain(source!, tests);
    setDocument(Paths.normalize(Paths.absolute(file)), full);
    testsKept = "main";
    if (root != "") { sourceRoot = Paths.normalize(Paths.absolute(root)).clone() in default; }
    let base: String = output.endsWith(".c") ? output.substring(0, output.length - 2) : output;
    let names: String[*] = [];
    for (t in tests) { names.push(t.name); }
    try {
        Files.writeString("${base}.lar", full);
        Files.writeString("${base}.tests", names.join("\n"));
    } catch (IoError e) {
        return fail("cannot write ${base}.lar");
    }
    let c: String = compileFile(file, ".");
    if (compileErrors.length > 0) { return 1; }
    try {
        Files.writeString(output, c);
    } catch (IoError e) {
        return fail("cannot write ${output}");
    }
    return 0;
}

// =========================================================================
// larimar.toml
// =========================================================================

class Project {
    let dir: String;
    let name: String;
    let version: String;
    let kind: String;                   // "program" or "library"
    let libraryType: String;            // a library: "package", "static" or "dynamic"
    let prefix: String;                 // a library: what its C names start with (<prefix>_<name>)
    let main: String;
    let output: String;
    let buildDir: String;
    let compiler: String;
    let flags: String[*];
    let staticLibraries: String[*];
    let staticLibraryPaths: String[*];
    let dynamicLibraries: String[*];
    let dynamicLibraryPaths: String[*];
    let includePaths: String[*];
    let sources: String[*];
    let larimarLibraries: LarimarLibrary[*];     // the libraries written in Larimar that it uses: those of [packages]
}

function load(dir: String): Project? {
    let source: String? = readSource(Paths.join(dir, "larimar.toml"));
    if (source == null) {
        toolError = "no larimar.toml in ${dir}. Create a project with 'larimar new <name>'." in default;
        return null;
    }
    let config: Any = null;
    try {
        config = Toml.parse(source!);
    } catch (TomlError e) {
        switch (e) { case Invalid { line, why } -> compileErrors.push("Project Error [larimar.toml:${line}]: ${why}"); }
        return null;
    }
    return project(dir, config);
}

let problems: String[*] = [] in default;

const PROJECT_KEYS: String = "[build_dir, kind, main, name, output, version]";
const LIBRARY_KEYS: String = "[prefix, type]";
const C_KEYS: String = "[compiler, dynamic_libraries, dynamic_library_paths, flags, include_paths, sources, static_libraries, static_library_paths]";

function keysOf(section: String): String {
    return section == "project" ? PROJECT_KEYS : section == "library" ? LIBRARY_KEYS : C_KEYS;
}

function allowedKey(section: String, key: String): bool {
    return keysOf(section).contains("[${key},") || keysOf(section).contains(" ${key},") || keysOf(section).contains(" ${key}]");
}

/** libraries and library_paths of before 1.3: a library is now static or dynamic by the key that names it. */
function oldKey(key: String, where: String): String {
    if (key == "libraries") {
        return "'libraries' in ${where} is now static_libraries (lib<name>.a, inside the executable) or dynamic_libraries (lib<name>.so/.dylib, <name>.dll: loaded when it starts; also the system's, like m or user32)";
    }
    return "'library_paths' in ${where} is now static_library_paths or dynamic_library_paths (the folders of each kind; the executable looks for its dynamic libraries in the second)";
}

function project(dir: String, config: Any): Project? {
    let topKeys: String[*] = [];
    for (sectionName, section in config.fields) {
        if (!isSection(section)) {
            topKeys.push(sectionName.clone());
            continue;
        }
        if (sectionName == "packages") { continue; }          // name = "folder": project.libraries reads them
        if (sectionName != "project" && sectionName != "c" && sectionName != "library") {
            problems.push("unknown section [${sectionName}] (sections: [project], [library], [c], [packages])");
            continue;
        }
        let allowed: String = keysOf(sectionName);
        for (key, value in section.fields) {
            // [c.linux], [c.macos], [c.windows], [c.unix]: a table with names (an empty [] is a list, as in libraries = [])
            if (sectionName == "c" && isSection(value) && (isPlatform(key) || hasNames(value))) {
                if (!isPlatform(key)) {
                    problems.push("unknown section [c.${key}] (platforms: [c.linux], [c.macos], [c.windows], [c.unix])");
                    continue;
                }
                for (platformKey, platformValue in value.fields) {
                    if (platformKey == "libraries" || platformKey == "library_paths") {
                        problems.push(oldKey(platformKey, "[c.${key}]"));
                    } else if (!allowedKey("c", platformKey)) {
                        problems.push("unknown key '${platformKey}' in [c.${key}] (keys: ${C_KEYS})");
                    }
                }
            } else if (sectionName == "c" && (key == "libraries" || key == "library_paths")) {
                problems.push(oldKey(key, "[c]"));
            } else if (!allowedKey(sectionName, key)) {
                problems.push("unknown key '${key}' in [${sectionName}] (keys: ${allowed})");
            }
        }
    }
    if (topKeys.length > 0) { problems.push("keys must go inside [project], [library], [c] or [packages]: [${topKeys.join(", ")}]"); }
    let p: Any = config.project;
    let c: Any = config.c;
    let lib: Any = config.library;
    let name: String = text(p, "name", "");
    let kind: String = text(p, "kind", "program");
    if (kind != "program" && kind != "library") { problems.push("kind = \"${kind}\" in [project]: it is \"program\" (the default) or \"library\""); }
    if (name == "") {
        problems.push("[project] needs a name: name = \"my-program\"");
    } else if (!validName(name)) {
        problems.push("the project name can only use letters, digits, '_', '-' and '.'");
    } else if (kind == "library" && !cIdentifier(name)) {
        problems.push("a library's name is also its module (import ${name.replace("-", "_").replace(".", "_")}) and its files: use only letters, digits and '_'");
    }
    if (kind != "library" && lib != null) { problems.push("[library] is for libraries: add kind = \"library\" to [project]"); }
    let libraryType: String = libraryOverride != "" ? libraryOverride : text(lib, "type", "package");
    if (libraryType != "package" && libraryType != "static" && libraryType != "dynamic") {
        problems.push("type = \"${libraryType}\" in [library]: it is \"package\" (the default), \"static\" or \"dynamic\"");
    }
    let prefix: String = text(lib, "prefix", name);
    if (prefix != "" && !cIdentifier(prefix)) { problems.push("prefix = \"${prefix}\" in [library]: the C names start with it, so only letters, digits and '_'"); }
    let version: String = text(p, "version", "0.1.0");
    let main: String = text(p, "main", "src/main.lar");
    let buildDir: String = text(p, "build_dir", "build");
    let exeSuffix: String = windows() ? ".exe" : "";
    let output: String = text(p, "output", kind == "library" ? "${buildDir}/${name}" : "${buildDir}/${name}${exeSuffix}");
    let cc: String = (os.env("CC") ?? "").trim();     // what was asked for; "" chooses (chooseCompiler)
    // [c] for every platform, then [c.unix] (Linux and macOS) and [c.<this platform>]: their lists are added
    // to [c]'s, and a compiler there replaces [c]'s
    let unix: Any = windows() ? null : c.unix;
    let here: Any = c[Platform.name()];
    let compiler: String = text(here, "compiler", text(unix, "compiler", text(c, "compiler", cc)));
    let flags: String[*] = list(c, "flags", ["-O2"]);
    let staticLibraries: String[*] = list(c, "static_libraries", []);
    let staticLibraryPaths: String[*] = list(c, "static_library_paths", []);
    let dynamicLibraries: String[*] = list(c, "dynamic_libraries", []);
    let dynamicLibraryPaths: String[*] = list(c, "dynamic_library_paths", []);
    let includePaths: String[*] = list(c, "include_paths", []);
    let sources: String[*] = list(c, "sources", []);
    let platformSections: Any[] = [unix, here];
    for (platform in platformSections) {
        for (x in list(platform, "flags", [])) { flags.push(x.clone()); }
        for (x in list(platform, "static_libraries", [])) { staticLibraries.push(x.clone()); }
        for (x in list(platform, "static_library_paths", [])) { staticLibraryPaths.push(x.clone()); }
        for (x in list(platform, "dynamic_libraries", [])) { dynamicLibraries.push(x.clone()); }
        for (x in list(platform, "dynamic_library_paths", [])) { dynamicLibraryPaths.push(x.clone()); }
        for (x in list(platform, "include_paths", [])) { includePaths.push(x.clone()); }
        for (x in list(platform, "sources", [])) { sources.push(x.clone()); }
    }
    for (x in staticLibraries) {
        if (dynamicLibraries.contains(x)) { problems.push("'${x}' is in static_libraries and in dynamic_libraries: it is linked one way"); }
    }
    let larimarLibs: LarimarLibrary[*] = larimarLibraries(dir, config, true, problems);
    if (problems.length > 0) {
        for (m in problems) { compileErrors.push("Project Error [larimar.toml]: ${m}"); }
        return null;
    }
    return Project {
        dir, name, version, kind, libraryType, prefix, main, output, buildDir, compiler, flags, staticLibraries, staticLibraryPaths,
        dynamicLibraries, dynamicLibraryPaths, includePaths, sources, larimarLibraries: larimarLibs
    };
}

/** A name of C (and of a module): letters, digits and '_', not starting with a digit. */
function cIdentifier(name: String): bool {
    if (name.isEmpty() || isDigit(name[0])) { return false; }
    for (b in name) {
        if (!isIdentifierPart(b)) { return false; }
    }
    return true;
}

/** The platforms: of [c.<platform>] and of --target. */
function isPlatform(name: String): bool {
    return name == "linux" || name == "macos" || name == "windows" || name == "unix";
}

/** A [section] of larimar.toml: a table with named entries (a list has positions). */
/** Whether a table has entries with a name (a section does; a list does not). */
function hasNames(value: Any): bool {
    for (k, v in value.fields) { return true; }
    return false;
}

function isSection(value: Any): bool {
    return switch (value) {
        case Any table -> table.length == 0;
        default -> false;
    };
}

function text(section: Any, key: String, def: String): String {
    let value: Any = section[key];
    if (value == null) { return def; }
    let found: String? = value as String;
    if (found != null) { return found!.clone(); }
    problems.push("'${key}' must be a \"string\"");
    return def;
}

function list(section: Any, key: String, def: String[*]): String[*] {
    let value: Any = section[key];
    if (value == null) { return def; }
    let items: String[*] = [];
    let isList: bool = switch (value) {
        case Any table -> true;
        default -> false;
    };
    if (isList) {
        for (i, item in value) {
            let text: String? = item as String;
            if (text == null) {
                problems.push("'${key}' must be a list of strings: ${key} = [\"...\"]");
                return def;
            }
            items.push(text!.clone());
        }
        return items;
    }
    problems.push("'${key}' must be a list: ${key} = [\"...\"]");
    return def;
}

function validName(name: String): bool {
    if (name.isEmpty()) { return false; }
    for (b in name) {
        if (!isIdentifierPart(b) && b != '-' && b != '.') { return false; }
    }
    return true;
}

// =========================================================================
// build
// =========================================================================

/** A path of the project: relative to its folder, or absolute. */
function resolve(dir: String, p: String): String { return Paths.normalize(Paths.join(dir, p)); }

/** Builds the project; returns the executable, or "" on failure. */
function build(p: Project, debug: bool): String {
    let dir: String = p.dir;
    let main: String = resolve(dir, p.main);
    if (!Files.isFile(main)) {
        toolError = "the main file ${p.main} does not exist (set it with main = \"...\" in [project])" in default;
        return "";
    }
    debugLines = debug;
    let generated: String = compileFile(main, dir);
    if (compileErrors.length > 0) { return ""; }
    let cFile: String = resolve(Paths.join(dir, p.buildDir), "${p.name}.c");
    let c: String = debug ? spreadLines(generated, Paths.normalize(Paths.absolute(cFile))) : generated;
    let exe: String = resolve(dir, p.output);
    try {
        Files.createDirectories(Paths.parent(cFile));
        Files.createDirectories(Paths.parent(exe));
        Files.writeString(cFile, c);
        if (debug) { Files.writeString(debugMapPath(cFile), debugMap()); }
    } catch (IoError e) {
        toolError = "cannot write ${cFile}" in default;
        return "";
    }
    let problem: String[*] = [];
    let chosen: CCompiler? = chooseCompiler(larimarHome(), compilerOverride != "" ? compilerOverride : p.compiler, false, generated.contains("#define LM_NET_TLS"), problem);
    if (chosen == null) {
        toolError = problem[0].clone() in default;
        return "";
    }
    let cc: CCompiler = chosen;
    let cmd: String[*] = [cc.program];
    for (a in cc.first) { cmd.push(a); }
    cmd.push("-std=c99");
    for (f in p.flags) {
        if (!debug || !(f.startsWith("-O") || f == "-s")) { cmd.push(f); }     // --debug: no optimizing
    }
    if (debug) {
        cmd.push("-g");
        cmd.push("-O0");
    }
    cmd.push("-o");
    cmd.push(exe);
    cmd.push(cFile);
    for (s in p.sources) { cmd.push(resolve(dir, s)); }
    for (ip in p.includePaths) { cmd.push("-I${resolve(dir, ip)}"); }
    for (x in packageArgs(p)) { cmd.push(x.clone()); }
    let links: String[*] = linkArgs(p, cc.bundled);
    if (toolError != "") { return ""; }
    for (l in links) { cmd.push(l); }
    for (l in systemLibraries(c)) { cmd.push(l.clone()); }
    let code: int32 = os.run(commandLine(cmd));
    if (code == 127) {
        toolError = "cannot run the C compiler '${cc.program}'. Install one (${installHint()}), or set compiler = \"...\" in [c]." in default;
        return "";
    }
    if (code != 0) {
        toolError = "the C compiler failed (exit ${code}). Command: ${cmd.join(" ")}\nThe generated C is in ${Paths.relative(dir, cFile)}" in default;
        return "";
    }
    if (cc.fallback) {
        Console.printError("note: no C compiler found, so the bundled tcc built it (fast to build, not optimized). For faster programs: ${installHint()}");
    }
    Console.printError(debug ? "built ${Paths.relative(dir, exe)} (debug)" : "built ${Paths.relative(dir, exe)}");
    return exe;
}

/**
 * How a program links its libraries. A static one (static_libraries) is the file lib<name>.a of
 * static_library_paths, given to the linker by its path, so it goes inside the executable even when a
 * dynamic one is next to it (on Linux, one of the system's: -Wl,-Bstatic). A dynamic one
 * (dynamic_libraries) is -l<name> with -L for each of dynamic_library_paths, and the executable looks for
 * it in those folders when it runs (Linux and macOS: rpath; on Windows, next to the .exe or in the PATH).
 * A package of [packages] adds what its C needs.
 */
function linkArgs(p: Project, bundled: bool): String[*] {
    let dir: String = p.dir;
    let out: String[*] = [];
    for (l in p.staticLibraries) {
        let found: String = "";
        for (lp in p.staticLibraryPaths) {
            let candidate: String = Paths.join(resolve(dir, lp), "lib${l}.a");
            if (found == "" && Files.isFile(candidate)) { found = candidate; }
        }
        if (found != "") {
            out.push(found.clone());
        } else if (Platform.name() == "linux" && !bundled) {
            out.push("-Wl,-Bstatic");
            out.push("-l${l}");
            out.push("-Wl,-Bdynamic");
        } else {
            let where: String = p.staticLibraryPaths.length == 0 ? "there is no static_library_paths" : "not in static_library_paths [${p.staticLibraryPaths.join(", ")}]";
            toolError = "lib${l}.a (static_libraries) is ${where}: add the folder that has it" in default;
            return out;
        }
    }
    for (lp in p.dynamicLibraryPaths) { out.push("-L${resolve(dir, lp)}"); }
    for (l in p.dynamicLibraries) { out.push("-l${l}"); }
    if (!windows()) {
        for (lp in p.dynamicLibraryPaths) { out.push("-Wl,-rpath,${resolve(dir, lp)}"); }
    }
    for (l in p.larimarLibraries) {             // a package: the compiled C it brings, and what its C needs of the system
        for (x in l.objects) { out.push(x.clone()); }
        try {
            for (x in systemLibraries(Files.readString(Paths.join(l.dir, libraryFile(l.name, "package"))))) { out.push(x.clone()); }
        } catch (IoError e) { }
        if (!windows()) { out.push("-lm"); }
        for (x in l.links) { out.push(x.clone()); }
    }
    return out;
}

/** What the libraries of [packages] add to a C command: their folder (the .h their .lar includes), and of a package its C. */
function packageArgs(p: Project): String[*] {
    let out: String[*] = [];
    for (l in p.larimarLibraries) {
        out.push("-I${l.dir}");
        for (ip in l.includePaths) { out.push("-I${ip}"); }
        for (x in l.sources) { out.push(x.clone()); }
    }
    return out;
}

/**
 * larimar build of a library: build/<name>/ gets lib<name>.a (or the dynamic one), <name>.h for C,
 * <name>.lar for Larimar and <name>.interface with the hash of the .lar, which the library also has inside.
 * Everything of the C but the export functions (and what the library gives with them) is static, so two
 * libraries and the program that links them do not clash; each one has its own runtime.
 */
function buildLibrary(p: Project, debug: bool): bool {
    let dir: String = p.dir;
    let main: String = resolve(dir, p.main);
    if (!Files.isFile(main)) {
        toolError = "the main file ${p.main} does not exist (set it with main = \"...\" in [project])" in default;
        return false;
    }
    debugLines = debug;
    buildingLibrary = true;
    let generated: String = compileFile(main, dir);
    if (compileErrors.length > 0) { return false; }
    let problems: String[*] = libraryProblems();
    if (problems.length > 0) {
        for (m in problems) { compileErrors.push("Library Error [${p.name}]: ${m}"); }
        return false;
    }
    let kind: String = p.libraryType;
    let module: String = libraryModule(p.name, p.version, kind, "larimar ${VERSION}");
    let hash: String = interfaceHash(module);
    let header: String = libraryHeader(p.name, p.version, kind, hash, "larimar ${VERSION}");
    let cFile: String = resolve(Paths.join(dir, p.buildDir), "${p.name}.c");
    let withHash: String = generated.replace(INTERFACE_MARK, hash);
    let c: String = debug ? spreadLines(withHash, Paths.normalize(Paths.absolute(cFile))) : withHash;
    let outDir: String = resolve(dir, p.output);
    let binary: String = Paths.join(outDir, libraryFile(p.name, kind));
    let problem: String[*] = [];
    let chosen: CCompiler? = chooseCompiler(larimarHome(), compilerOverride != "" ? compilerOverride : p.compiler, false, generated.contains("#define LM_NET_TLS"), problem);
    if (chosen == null) {
        toolError = problem[0].clone() in default;
        return false;
    }
    let cc: CCompiler = chosen;
    // what a program that links it statically must link too: what its C needs, and the libraries it links
    let links: String[*] = [];
    if (kind == "static") {
        for (l in systemLibraries(c)) { links.push(l.clone()); }
        for (l in p.dynamicLibraries) { links.push("-l${l}"); }
        for (l in p.staticLibraries) { links.push("-l${l}"); }
        if (!windows()) { links.push("-lm"); }
    }
    if (kind == "package") { return buildPackage(p, withHash, header, module, hash, cc); }
    try {
        Files.createDirectories(Paths.parent(cFile));
        Files.createDirectories(outDir);
        Files.writeString(cFile, c);
        if (debug) { Files.writeString(debugMapPath(cFile), debugMap()); }
        let kinds: String[] = ["package", "static", "dynamic"];     // no file of another build stays next to this one
        for (k in kinds) {
            let old: String = Paths.join(outDir, libraryFile(p.name, k));
            if (Files.isFile(old)) { Files.delete(old); }
        }
    } catch (IoError e) {
        toolError = "cannot write ${cFile}" in default;
        return false;
    }
    let base: String[*] = [cc.program];
    for (a in cc.first) { base.push(a); }
    base.push("-std=c99");
    for (f in p.flags) {
        if (!debug || !(f.startsWith("-O") || f == "-s")) { base.push(f); }
    }
    if (debug) {
        base.push("-g");
        base.push("-O0");
    }
    if (!windows()) { base.push("-fPIC"); }                 // it goes into executables and dynamic libraries of any kind
    for (ip in p.includePaths) { base.push("-I${resolve(dir, ip)}"); }
    for (x in packageArgs(p)) { base.push(x.clone()); }
    let sources: String[*] = [cFile];
    for (x in p.sources) { sources.push(resolve(dir, x)); }
    if (kind == "static") {
        let objects: String[*] = [];
        let objDir: String = Paths.join(Paths.parent(cFile), "${p.name}-objects");
        try { Files.createDirectories(objDir); } catch (IoError e) {}
        for (i, src in sources) {
            let name: String = Paths.fileName(src);
            let dot: int32? = name.lastIndexOf(".");
            let obj: String = Paths.join(objDir, "${i}-${dot != null ? name.substring(0, dot!) : name}.o");
            let cmd: String[*] = [];
            for (a in base) { cmd.push(a); }
            cmd.push("-c");
            cmd.push("-o");
            cmd.push(obj);
            cmd.push(src);
            if (!runC(cmd, cc.program, dir, cFile)) { return false; }
            objects.push(obj.clone());
        }
        let ar: String[*] = cc.bundled ? [cc.program, "-ar", "rcs", binary] : ["ar", "rcs", binary];
        for (o in objects) { ar.push(o); }
        let code: int32 = os.run(commandLine(ar));
        if (code != 0) {
            toolError = "the archiver failed (exit ${code}). Command: ${ar.join(" ")}" in default;
            return false;
        }
    } else {
        let cmd: String[*] = [];
        for (a in base) { cmd.push(a); }
        cmd.push(mac() ? "-dynamiclib" : "-shared");
        if (mac()) {
            cmd.push("-install_name");
            cmd.push("@rpath/${libraryFile(p.name, kind)}");      // the program finds it by its rpath
        }
        cmd.push("-o");
        cmd.push(binary);
        if (windows()) { cmd.push("-Wl,--out-implib,${Paths.join(outDir, "lib${p.name}.dll.a")}"); }
        for (x in sources) { cmd.push(x); }
        let ls: String[*] = linkArgs(p, cc.bundled);
        if (toolError != "") { return false; }
        for (l in ls) { cmd.push(l); }
        for (l in systemLibraries(c)) { cmd.push(l.clone()); }
        if (!windows()) { cmd.push("-lm"); }
        if (!runC(cmd, cc.program, dir, cFile)) { return false; }
    }
    try {
        Files.writeString(Paths.join(outDir, "${p.name}.h"), header);
        Files.writeString(Paths.join(outDir, "${p.name}.lar"), module);
        Files.writeString(Paths.join(outDir, "${p.name}.interface"), interfaceText(p.name, p.version, kind, p.prefix, hash, VERSION, links, [], [], [], []));
    } catch (IoError e) {
        toolError = "cannot write the library's files in ${outDir}" in default;
        return false;
    }
    let shown: String = Paths.relative(dir, outDir);
    Console.printError("built ${shown}/: ${libraryFile(p.name, kind)}, ${p.name}.h, ${p.name}.lar, ${p.name}.interface (${kind}${debug ? ", debug" : ""}; interface ${hash})");
    return true;
}

/**
 * larimar build of a library as a package (the default): build/<name>/ gets <name>.c, the library in C, with
 * its .h, .lar and .interface, and in c/ the C the library brings (the sources and include_paths of its [c],
 * those of every platform). Nothing is compiled into it: the program that names the folder in [packages]
 * compiles it with its own C, so one folder serves every platform. Its C is compiled once here, to find
 * its errors now.
 */
function buildPackage(p: Project, c: String, header: String, module: String, hash: String, cc: CCompiler): bool {
    let dir: String = p.dir;
    let outDir: String = resolve(dir, p.output);
    let config: Any = null;
    try {
        config = Toml.parse(readSource(Paths.join(dir, "larimar.toml")) ?? "");
    } catch (TomlError e) { }
    let sections: String[] = ["", "unix", "linux", "macos", "windows"];
    let manifest: StringBuilder = {};
    let here: String[*] = [Paths.join(outDir, "${p.name}.c")];      // what this platform compiles, to check it
    let hereIncludes: String[*] = [outDir];
    try {
        Files.createDirectories(outDir);
        let kinds: String[] = ["static", "dynamic"];
        for (k in kinds) {
            let old: String = Paths.join(outDir, libraryFile(p.name, k));
            if (Files.isFile(old)) { Files.delete(old); }
        }
        Files.writeString(here[0], c);
        Files.writeString(Paths.join(outDir, "${p.name}.h"), header);
        Files.writeString(Paths.join(outDir, "${p.name}.lar"), module);
        for (name in sections) {
            let section: Any = name == "" ? config.c : config.c[name];
            let sources: String[*] = [];
            let includes: String[*] = [];
            let links: String[*] = [];
            for (x in list(section, "sources", [])) {
                if (!packaged(dir, x, outDir, false)) { return false; }
                sources.push("c/${x}");
            }
            for (x in list(section, "include_paths", [])) {
                if (!packaged(dir, x, outDir, true)) { return false; }
                includes.push("c/${x}");
            }
            for (x in list(section, "dynamic_libraries", [])) { links.push("-l${x}"); }
            // a C library already compiled (lib<name>.a in the static_library_paths of its section, or of [c]) goes
            // in the package, for the platform of its section; one that is not there is the system's
            let objects: String[*] = [];
            for (x in list(section, "static_libraries", [])) {
                let found: String = "";
                let places: Any[] = [section, config.c];
                for (place in places) {
                    for (lp in list(place, "static_library_paths", [])) {
                        if (found == "" && Files.isFile(resolve(dir, "${lp}/lib${x}.a"))) { found = "${lp}/lib${x}.a"; }
                    }
                }
                if (found == "") {
                    links.push("-l${x}");
                    continue;
                }
                if (!packaged(dir, found, outDir, false)) { return false; }
                objects.push("c/${found}");
            }
            let mine: bool = name == "" || name == Platform.name() || (name == "unix" && !windows());
            if (mine) {
                for (x in sources) { here.push(Paths.join(outDir, x).clone()); }
                for (x in includes) { hereIncludes.push(Paths.join(outDir, x).clone()); }
            }
            if (name == "") {
                let needs: String[*] = [];
                for (n, _ in config.packages.fields) { needs.push(n.clone()); }
                manifest.add(interfaceText(p.name, p.version, "package", p.prefix, hash, VERSION, links, sources, includes, objects, needs));
            } else if (sources.length + includes.length + links.length + objects.length > 0) {
                manifest.add("\n[library.${name}]\nlinks = ${quotedList(links)}\nsources = ${quotedList(sources)}\ninclude_paths = ${quotedList(includes)}\nobjects = ${quotedList(objects)}\n");
            }
        }
        Files.writeString(Paths.join(outDir, "${p.name}.interface"), manifest.toString());
    } catch (IoError e) {
        toolError = "cannot write the package in ${outDir}: ${Files.message(e)}" in default;
        return false;
    }
    let objDir: String = Paths.join(resolve(dir, p.buildDir), "${p.name}-objects");
    try { Files.createDirectories(objDir); } catch (IoError e) {}
    for (i, src in here) {
        let cmd: String[*] = [cc.program];
        for (a in cc.first) { cmd.push(a); }
        cmd.push("-std=c99");
        for (f in p.flags) { cmd.push(f); }
        for (ip in hereIncludes) { cmd.push("-I${ip}"); }
        for (x in packageArgs(p)) {
            if (x.startsWith("-I")) { cmd.push(x.clone()); }
        }
        cmd.push("-c");
        cmd.push("-o");
        cmd.push(Paths.join(objDir, "${i}.o"));
        cmd.push(src);
        if (!runC(cmd, cc.program, dir, here[0])) { return false; }
    }
    let lpk: String = "${outDir}.lpk";
    try {
        pack(outDir, lpk);
    } catch (IoError e) {
        toolError = "cannot write ${lpk}: ${Files.message(e)}" in default;
        return false;
    }
    Console.printError("built ${Paths.relative(dir, lpk)}, the package in one file, and ${Paths.relative(dir, outDir)}/: ${p.name}.c, ${p.name}.h, ${p.name}.lar, ${p.name}.interface (interface ${hash})");
    return true;
}

function quotedList(items: String[*]): String {
    let quoted: String[*] = [];
    for (x in items) { quoted.push("\"${x}\""); }
    return "[${quoted.join(", ")}]";
}

/** Copies a file (or a folder, whole) of the library's project into c/ of its package, at the same path. */
function packaged(dir: String, path: String, outDir: String, folder: bool): bool {
    if (Paths.isAbsolute(path) || path.startsWith("..") || path.contains("/../")) {
        toolError = "'${path}' in [c] is outside the library's folder: what goes in its package is inside it" in default;
        return false;
    }
    let from: String = resolve(dir, path);
    let to: String = Paths.join(Paths.join(outDir, "c"), path);
    try {
        if (folder) {
            copyFolder(from, to);
        } else {
            Files.createDirectories(Paths.parent(to));
            Files.copy(from, to);
        }
    } catch (IoError e) {
        toolError = "cannot copy ${path} into the package: ${Files.message(e)}" in default;
        return false;
    }
    return true;
}

function copyFolder(from: String, to: String): void throws IoError {
    Files.createDirectories(to);
    for (name in Files.list(from)) {
        let source: String = Paths.join(from, name);
        if (Files.isDirectory(source)) {
            copyFolder(source, Paths.join(to, name));
        } else {
            Files.copy(source, Paths.join(to, name));
        }
    }
}

/** Runs the C compiler; false (and toolError) when it fails. */
function runC(cmd: String[*], program: String, dir: String, cFile: String): bool {
    let code: int32 = os.run(commandLine(cmd));
    if (code == 127) {
        toolError = "cannot run the C compiler '${program}'. Install one (${installHint()}), or set compiler = \"...\" in [c]." in default;
        return false;
    }
    if (code != 0) {
        toolError = "the C compiler failed (exit ${code}). Command: ${cmd.join(" ")}\nThe generated C is in ${Paths.relative(dir, cFile)}" in default;
        return false;
    }
    return true;
}

/**
 * larimar file.lar [args]: the file is built in a folder of the system's temporary files (the bundled tcc
 * first: it starts fast) and run with the arguments; its exit code is larimar's. Nothing is printed but
 * what the program prints, so scripts can be piped.
 */
function runScript(file: String, args: String[*]): int32 {
    let generated: String = compileFile(file, ".");
    if (compileErrors.length > 0) { return 1; }
    let problem: String[*] = [];
    let wanted: String = compilerOverride != "" ? compilerOverride : (os.env("CC") ?? "").trim();
    let chosen: CCompiler? = chooseCompiler(larimarHome(), wanted, true, generated.contains("#define LM_NET_TLS"), problem);
    if (chosen == null) { return fail(problem[0].clone() in default); }
    let cc: CCompiler = chosen;
    let temp: String = os.env(windows() ? "TEMP" : "TMPDIR") ?? "";
    if (temp.isBlank()) { temp = windows() ? "." : "/tmp"; }
    let dir: String = Paths.join(temp, "larimar");
    let name: String = Paths.fileName(file);
    let base: String = Paths.join(dir, "${name.substring(0, name.length - 4)}-${os.processId()}");
    let cFile: String = "${base}.c";
    let exe: String = windows() ? "${base}.exe" : base;
    try {
        Files.createDirectories(dir);
        Files.writeString(cFile, generated);
    } catch (IoError e) {
        return fail("cannot write ${cFile}".clone() in default);
    }
    let cmd: String[*] = [cc.program];
    for (a in cc.first) { cmd.push(a); }
    let rest: String[] = ["-std=c99", "-O1", "-o", exe, cFile];
    for (a in rest) { cmd.push(a); }
    if (!windows()) { cmd.push("-lm"); }
    for (l in systemLibraries(generated)) { cmd.push(l.clone()); }
    let log: String = "${base}.txt";
    let code: int32 = os.run("${commandLine(cmd)} > ${quote(log)} 2>&1");
    if (code != 0) {
        let said: String = "";
        try { said = Files.readString(log); } catch (IoError e) {}
        return fail("the C compiler failed (exit ${code}): ${said.trim()}\nThe generated C is in ${cFile}".clone() in default);
    }
    let result: int32 = execute(exe, args);
    let made: String[] = [cFile, exe, log];
    for (f in made) {
        try { Files.delete(f); } catch (IoError e) {}
    }
    return result;
}

function execute(exe: String, args: String[*]): int32 {
    let parts: String[*] = [quote(exe)];
    for (a in args) { parts.push(quote(a)); }
    return os.run(parts.join(" "));
}

// =========================================================================
// new
// =========================================================================

function create(path: String, library: bool): int32 {
    let name: String = Paths.fileName(Paths.normalize(path));
    if (!validName(name)) { return fail("the project name can only use letters, digits, '_', '-' and '.'"); }
    if (library && !cIdentifier(name)) { return fail("a library's name is also its module and its C prefix: use only letters, digits and '_'"); }
    if (Files.exists(path)) { return fail("${path} already exists"); }
    if (library) { return createLibrary(path, name); }
    try {
        Files.createDirectories(Paths.join(path, "src"));
        Files.writeString(Paths.join(path, "larimar.toml"), """
            [project]
            name = "${name}"
            version = "0.1.0"
            main = "src/main.lar"

            [c]
            flags = ["-O2"]
            dynamic_libraries = []
            """);
        Files.writeString(Paths.join(path, "src/main.lar"), """
            function main(): int32 {
                println("Hello from ${name}!");
                return 0;
            }
            """);
        Files.writeString(Paths.join(path, ".gitignore"), "build/\n");
    } catch (IoError e) {
        return fail("cannot create ${path}");
    }
    println("created ${path}\n  cd ${path}\n  larimar run");
    return 0;
}

/** larimar new <name> --library: a library with one export function and a test of it. */
function createLibrary(path: String, name: String): int32 {
    try {
        Files.createDirectories(Paths.join(path, "src"));
        Files.createDirectories(Paths.join(path, "tests"));
        Files.writeString(Paths.join(path, "larimar.toml"), """
            [project]
            name = "${name}"
            version = "0.1.0"
            kind = "library"
            main = "src/${name}.lar"

            [library]
            type = "package"         # for C: "static" or "dynamic" (also: larimar build --static)
            prefix = "${name}"       # its C names: ${name}_greeting

            [c]
            flags = ["-O2"]
            """);
        Files.writeString(Paths.join(path, "src/${name}.lar"), """
            /** A greeting for someone. */
            public export function greeting(who: String): String {
                return "Hello, \${who}, from ${name}!";
            }
            """);
        Files.writeString(Paths.join(path, "tests/${name}_test.lar"), """
            import ${name};
            import std.test { checkText };

            test function greets(): void {
                checkText("Hello, Ana, from ${name}!", ${name}.greeting("Ana"));
            }
            """);
        Files.writeString(Paths.join(path, ".gitignore"), "build/\n");
    } catch (IoError e) {
        return fail("cannot create ${path}");
    }
    println("created ${path}\n  cd ${path}\n  larimar build     (build/${name}/: ${name}.c, ${name}.h, ${name}.lar, ${name}.interface)\n  larimar test");
    return 0;
}
