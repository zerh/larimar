// semantics.linker: modules (Linker.java). Each file is a module; `import a.b` loads a/b.lar.
//
// Every module is parsed, its top-level declarations are renamed with its path
// (geo.shapes.Circle becomes geo__shapes__Circle; the main file keeps its names), every
// reference is resolved through the module's imports, and everything is joined into one
// program. The analyzer and the generator then see a single program with distinct names.
//
// Lines are file index * 1000000 + line; decode() turns them back into "file:line".

import std.io.path as Paths;
import std.io.files as Files;
import std.io { IoError };
import std.text { isIdentifierPart, isDigit };
import syntax.ast {
    Node, Expr, Stmt, TypeRefKind, TypeRef, Program, ImportDecl, NativeInterfaceDecl, CIncludeDecl, CCodeDecl, ExternTypeDecl, ExternFunctionDecl, ExternValueDecl, ConstDecl,
    Param, FunctionDecl, FieldDecl, StructDecl, ClassDecl, InterfaceDecl, NativeTypeDecl, EnumDecl, declName, isTypeDecl, VarDecl,
    AssignStmt, ReturnStmt, ExprStmt, IfStmt, WhileStmt, ForStmt, ThrowStmt, YieldStmt, TryStmt, SwitchStmt,
    BlockStmt, StringLit, Ident, Member, Index, Call, Unary, Binary, Ternary, IsExpr, Cast, Unwrap, Lambda, ObjectLit,
    ArrayLit, Placed, Pattern, SwitchExpr, PT_NAME, PT_CONSTANT, PT_NULL
};
import syntax.parser { parseProgram };
import syntax.parser.natives { OPENED_BINDING };
import editor.opendocuments { openDocument };

public const FILE_LINES: int32 = 1000000;

public class Module {
    let path: String;              // "geo.shapes"; "" for the main file
    let prefix: String;            // "geo__shapes__"; "" for the main file
    let index: int32;
    let program: Program? = null;
    let ownValues: Any;
    let ownTypes: Any;
    let publics: Any;
    let values: Any;
    let types: Any;
    let aliases: Any;           // alias -> index in mods
    let natives: Any;           // native interface (as seen here) -> { member: its mangled name }
}

function newModule(path: String in default, index: int32): Module {
    let prefix: String = path != "" ? ("${path.replace(".", "__")}__" in default) : "";
    return Module {
        path, prefix, index, ownValues: {} in default, ownTypes: {} in default, publics: {} in default,
        values: {} in default, types: {} in default, aliases: {} in default, natives: {} in default
    } in default;
}

/** The state of linking: the settings it was given (target, std, libraries, unsafe C), every module read and its order, the files of the program, and the errors. */
public class Linking {
    let mods: Module[*] = [];           // every module, by load order
    let modIndex: Any = {};               // path -> index in mods (loaded or failed)
    let order: Module[*] = [];          // a module comes after the ones it imports
    let errors: String[*] = [];
    let root: Module = newModule("", 0);
    let lang: Module? = null;
    /** The words of the program's sources: what it can use from std.lang. */
    let words: Any = {};
    let rootDir: String = "";
    let target: String = "";
    /** The folder of the standard library (codegen reads the runtime beside it, in runtime/). */
    let stdDir: String = "std";
    /** The files of the program, by index (for messages and LAR_FILES). */
    let fileNames: String[*] = [];
    /** Per file (same order as fileNames): its absolute path, and the text that was read (for larimar lsp). */
    let filePaths: String[*] = [];
    let fileSources: String[*] = [];
    /** Links the program whose main file is `mainFile` (shown as `mainShown`). Errors go to linkErrors. */
    let linkErrors: String[*] = [];
    /** The main file's path, for what is asked after linking (trusted). */
    let linkedMain: String = "";
    /** The program has classes that implement Task: its copies run them (the C's main says so). */
    let taskClasses: bool = false;
    let testsKept: String = "none";
    let unsafeC: bool = false;
    /** [project] unsafe_c = true of the main file's project: its modules may have native interfaces. */
    let projectUnsafe: bool = false;
    /** Per library of [dependencies] (the order of libraryNames): its [project] unsafe_c. */
    let libraryUnsafe: bool[*] = [];
    let unsafeSources: String[*] = [];
    let unsafeNotes: String[*] = [];
    /** The libraries of the project's [dependencies]: their names, and the folders of their modules (same order). */
    let libraryNames: String[*] = [];
    let libraryRoots: String[*] = [];
    /** When set, module files are shown relative to this folder (or absolute when outside it). */
    let showFrom: String = "";
}

/** The Linking of the compilation being done (pipeline: Compilation). */
public let linking: Linking = Linking {} in default;

/** Makes `state` the one the compiler works on. */
public function useLinking(state: Linking in default): void { linking = state; }

/**
 * --target: the one platform the C is generated for (linux, macos, windows, unix); "" for every one,
 * chosen when the C is compiled. With a target, switch (Platform.current()) is its arm.
 */

/** Whether what is for `platform` ("": every one) is for the target. */
public function inTarget(platform: String): bool {
    return platform == "" || platform == linking.target || platform == "unix" && linking.target != "windows";
}



/**
 * The standard library a file belongs to, when it is one of its files (std/crypto.lar open in the
 * editor, of a copy that is not the installed one): its modules are then the ones of that copy, so
 * that `import std.crypto` in its parts is the file being read, not another.
 */
function ownStd(mainPath: String in default): String? {
    let dir: String = Paths.parent(Paths.normalize(Paths.absolute(mainPath)));
    while (dir != "") {
        if (Paths.fileName(dir) == "std" && readSource(Paths.join(dir, "lang.lar")) != null) { return dir.clone() in default; }
        let up: String = Paths.parent(dir);
        if (up == dir) { break; }
        dir = up;
    }
    return null;
}



/**
 * Link: reads the main file and every module it imports (parsing each), in an order where a module comes
 * after the ones it uses, and gives each the names it sees. The rules (semantics.rules) look at the
 * modules next; assemble puts them together.
 */
public function link(mainShown: String in default, mainSource: String in default, sourceDir: String in default, std: String in default, mainPath: String in default): void {
    linking.linkedMain = mainPath;
    linking.rootDir = sourceDir;
    linking.stdDir = ownStd(mainPath) ?? std;
    linking.fileNames.push(mainShown);
    linking.filePaths.push(mainPath);
    linking.fileSources.push(mainSource);
    linking.mods.push(linking.root);
    linking.modIndex[""] = 0;
    parse(linking.root, mainSource);
    if (linking.root.program != null) { visit(linking.root); }
    // the main file is std/lang.lar itself (open in the editor): it is the language, not loaded again
    let langItself: bool = Paths.normalize(Paths.absolute(mainPath)) == Paths.normalize(Paths.absolute(moduleFile("std.lang")));
    if (linking.root.program != null) { writeTasks(mainPath); }
    if (linking.root.program != null && !langItself) { loadLang(); }
    for (m in linking.order) { tables(m); }
    linking.unsafeSources.clear();
    linking.unsafeNotes.clear();
    flushRuleErrors();
}

/** The errors said so far, into linkErrors (each once). */
public function flushRuleErrors(): void {
    for (e in linking.errors) { linking.linkErrors.push(e); }
    linking.errors.clear();
}

/** The modules linked, each after the ones it imports. */
public function linkedModules(): Module[*] { return linking.order; }

/** The declarations of a module, as written (before assemble gives them their C names). */
public function declarationsOf(module: Module in default): Node[*] { return module.program!.decls; }

/** The main file linked. */
public function linkedMainFile(): String { return linking.linkedMain; }

/** The imports of a module. */
public function importsOf(module: Module in default): ImportDecl[*] { return module.program!.imports; }

/** A broken rule of the language: its message, with the rule's id (semantics.rules). */
public function ruleError(line: int32, rule: String, msg: String): void {
    linking.errors.push("Module Error [Line ${line}]: error[${rule}] ${msg}");
}

/** Assemble: every module's declarations, with their C names, in one Program; the errors go to linkErrors. */
public function assemble(): Program {
    let mainPath: String = linking.linkedMain;
    let langItself: bool = Paths.normalize(Paths.absolute(mainPath)) == Paths.normalize(Paths.absolute(moduleFile("std.lang")));
    let prog: Program = Program { line: 1 } in default;
    if (linking.lang != null) {
        for (d in linking.lang!.program!.decls) {
            rewriteDecl(linking.lang!, d);
            d.builtin = true;
            prog.decls.push(d);
        }
    }
    let seen: Any = {} in default;
    for (m in linking.order) {
        for (d in m.program!.decls) {
            if (langItself && m == linking.root) { d.builtin = true; }       // its declarations are the language's
            if (d is CIncludeDecl c) {
                let key: String = "${c.header}|${c.platform}|${c.owner != "" ? "${m.path}.${c.owner}" : ""}|${c.gives}" in default;   // a class's: its system is known later
                if (seen[key] != null) { continue; }
                seen[key] = 1;
            }
            rewriteDecl(m, d);
            prog.decls.push(d);
        }
    }
    flushRuleErrors();
    return prog;
}

function dictFromSet(into: Any, names: Any in default, prefix: String): void {
    for (k, v in names.fields) { into[k] = "${prefix}${k}"; }
}

function error(line: int32, msg: String): void {
    linking.errors.push("Module Error [Line ${line}]: ${msg}");
}

/**
 * std.lang, cut down to the declarations the program mentions, and the ones those mention
 * (comments after // do not count). A name the main file declares itself is its own.
 */
function loadLang(): void {
    let source: String? = readSource(moduleFile("std.lang"));
    if (source == null) {
        error(1, "The language's own module was not found (looked for ${shownName("std.lang")}); set LARIMAR_HOME to the folder that has std/.");
        return;
    }
    let module: Module = newModule("", linking.fileNames.length);
    let p: Program = parseProgram(source, module.index * FILE_LINES + 1);
    if (p.error != "") {
        linking.errors.push(p.error);
        return;
    }
    let lines: String[*] = source.split("\n") in default;
    // String and Any have methods written here: every program may call them without naming the type
    // (\"ab\".repeat(2)). What it does not call leaves the C later (prune).
    linking.words["String"] = true;
    linking.words["Any"] = true;
    let all: Node[*] = p.decls;
    let kept: bool[*] = [] in default;
    for (d in all) { kept.push(false); }
    let changed: bool = true;
    while (changed) {
        changed = false;
        for (i, d in all) {
            let name: String = declName(d);
            if (d is FunctionDecl sf && sf.typeName != "") {          // a static function: when its type and its name are used
                name = linking.words.contains(sf.typeName) ? sf.name : "";
            }
            let shadowed: bool = (linking.root.ownTypes.contains(name) || linking.root.ownValues.contains(name)) && p.publics.contains(name);
            if (kept[i] || name == "" || !linking.words.contains(name) || shadowed) { continue; }
            kept[i] = true;
            changed = true;
            for (k in d.line % FILE_LINES - 1..(i + 1 < all.length ? all[i + 1].line % FILE_LINES - 1 : lines.length)) { addWords(lines[k]); }
        }
    }
    let cSymbols: Any = {} in default;
    for (i, d in all) {                         // what the kept C names: its ccode stays
        if (!kept[i]) { continue; }
        switch (d) {
            case ExternFunctionDecl f -> {
                cSymbols[f.name] = true;
                cWords(f.cBody, cSymbols);
            }
            case ExternTypeDecl t -> cWords(t.cType, cSymbols);
            default -> {}
        }
    }
    for (i, d in all) {
        if (d is CCodeDecl c && cCodeUses(c.code, cSymbols)) { kept[i] = true; }
    }
    let decls: Node[*] = [] in default;
    for (i, d in all) {
        if (!kept[i]) { continue; }
        decls.push(d);
        if (isTypeDecl(d)) { module.ownTypes[declName(d)] = 1; } else { module.ownValues[declName(d)] = 1; }
    }
    if (decls.length == 0) { return; }
    linking.fileNames.push(shownName("std.lang"));
    linking.filePaths.push(Paths.absolute(moduleFile("std.lang")).clone() in default);
    linking.fileSources.push(source!);
    p.decls = decls;
    module.program = p;
    for (n in p.publics) { module.publics[n] = 1; }
    // public names keep their name (every program sees them); private helpers get a prefix, so a program
    // can declare an isSpace of its own
    for (k, v in module.ownValues.fields) { module.values[k] = module.publics.contains(k) ? k : "std__lang__${k}"; }
    for (k, v in module.ownTypes.fields) { module.types[k] = module.publics.contains(k) ? k : "std__lang__${k}"; }
    linking.lang = module;
}

// ---- the tasks of other processes (std.os.process.tasks) --------------------------------------------


const TASKS_MODULE: String = "std.os.process.tasks";
const PROCESS_MODULE: String = "std.os.process";


/** The types a field of a Task can have: they go to the other process as they are. */
const TASK_SCALARS: String = " int8 int16 int32 int64 uint8 uint16 uint32 uint64 byte float32 float64 bool String ";

/**
 * The name of `implements` that is std.os.process.Task, as the class wrote it ("" when it does not
 * implement it): Task imported by name, or through the alias of std.os.process.
 */
function taskInterface(c: ClassDecl in default, p: Program in default): String {
    let kinds: String[] = ["Task", "UnsafeTask"];            // UnsafeTask: a Task with C of its own
    for (i in c.interfaces) {
        for (im in p.imports) {
            if (im.path != "std.os.process") { continue; }
            for (kind in kinds) {
                if (im.hasNames && i == kind) {
                    for (n in im.names) {
                        if (n == kind) { return i; }
                    }
                }
                if (im.alias != "" && i == "${im.alias}.${kind}") { return i; }
            }
        }
    }
    return "";
}

function taskScalar(typeRef: TypeRef in default): bool { return typeRef.kind == TypeRefKind.Named && TASK_SCALARS.contains(" ${typeRef.name} "); }

/** What a value of a scalar type is when it comes back from a table (`x`: the Any). */
function fromTable(typeRef: TypeRef in default, x: String): String {
    if (typeRef.name == "String") { return "(${x} as String ?? \"\").clone()"; }
    if (typeRef.name == "bool") { return "${x} as bool ?? false"; }
    if (typeRef.name == "float32" || typeRef.name == "float64") { return "${x} as ${typeRef.name} ?? 0.0"; }
    return "${x} as ${typeRef.name} ?? 0";
}

/**
 * The module path a file is imported by: from the project's folder (tests, and the editor, also from the
 * folder above it, as moduleFile does). "" when it is under neither.
 */
function modulePathOf(file: String): String {
    let own: String = pathUnder(Paths.normalize(Paths.absolute(linking.rootDir)), file);
    if (own != "" || linking.testsKept == "none") { return own; }
    let dir: String = Paths.parent(Paths.normalize(Paths.absolute(linking.rootDir)));     // the folders above, up to the project's (moduleFile)
    while (dir != "") {
        let found: String = pathUnder(dir, file);
        if (found != "") { return found; }
        if (Files.isFile(Paths.join(dir, "larimar.toml"))) { break; }
        let up: String = Paths.parent(dir);
        if (up == dir) { break; }
        dir = up;
    }
    return "";
}

function pathUnder(dir: String, file: String): String {
    let base: String = "${dir}/";
    let full: String = Paths.normalize(Paths.absolute(file));
    if (!full.startsWith(base) || !full.endsWith(".lar")) { return ""; }
    let path: String = full.substring(base.length, full.length - 4).replace("/", ".");
    for (b in path) {
        if (!isIdentifierPart(b) && b != '.') { return ""; }
    }
    return path.clone();
}

/**
 * For each module with classes that implement Task, two functions of its own: one gives the
 * class and fields of a task as a table, the other makes it again from them. std.os.process.tasks is
 * then written to ask each of those modules.
 */
function writeTasks(mainPath: String): void {
    let processAt: int32 = linking.modIndex[PROCESS_MODULE] as int32 ?? -1;
    if (processAt < 0) { return; }
    let owners: String[*] = [] in default;
    for (m in linking.mods) {
        if (m.program == null || isStd(m.path) || m.path == TASKS_MODULE) { continue; }
        let encode: StringBuilder = {} in default;
        let start: StringBuilder = {} in default;
        let setup: StringBuilder = {} in default;
        let iface: String = "";
        let line: int32 = 0;
        for (d in m.program!.decls) {
            if (!(d is ClassDecl c)) { continue; }
            let spelled: String = taskInterface(c, m.program!);
            if (spelled == "") { continue; }
            if (iface == "") {
                iface = spelled;
                line = c.line;
            }
            if (c.superName != "") {
                error(c.line, "Task '${c.name}' extends '${c.superName}': a task goes to another process with its own fields, so it extends no class.");
                continue;
            }
            let key: String = m.path != "" ? "${m.path}.${c.name}" : c.name;
            if (spelled.endsWith("UnsafeTask")) { setup.add("    if (task is ${c.name} t) {\n        t.setup(loader);\n        return;\n    }\n"); }
            encode.add("    if (task is ${c.name} t) {\n        let f: Any = {};\n");
            let fill: StringBuilder = {} in default;
            let literal: String[*] = [] in default;
            for (fd in c.fields) {
                let n: String = fd.name;
                let typeRef: TypeRef = fd.type;
                if (taskScalar(typeRef)) {
                    encode.add("        f[\"${n}\"] = t.${n};\n");
                    literal.push("${n}: ${fromTable(typeRef, "fields[\"${n}\"]")}" in default);
                } else if (typeRef.kind == TypeRefKind.Opt && typeRef.inner != null && taskScalar(typeRef.inner!)) {
                    encode.add("        if (t.${n} != null) { f[\"${n}\"] = t.${n}!; }\n");
                    if (typeRef.inner!.name == "String") {
                        literal.push("${n}: null" in default);
                        fill.add("        if (fields[\"${n}\"] != null) { t.${n} = (fields[\"${n}\"] as String ?? \"\").clone(); }\n");
                    } else {
                        literal.push("${n}: fields[\"${n}\"] as ${typeRef.inner!.name}" in default);
                    }
                } else if (typeRef.kind == TypeRefKind.Growable && typeRef.inner != null && taskScalar(typeRef.inner!)) {
                    encode.add("        let l_${n}: Any = {};\n        for (v in t.${n}) { l_${n}.push(v); }\n        f[\"${n}\"] = l_${n};\n");
                    literal.push("${n}: []" in default);
                    fill.add("        for (i, v in fields[\"${n}\"]) { t.${n}.push(${fromTable(typeRef.inner!, "v")}); }\n");
                } else {
                    error(fd.line, "Field '${n}' of Task '${c.name}' goes to another process: it is a number, a bool, a String, an optional of one of them, or a list of them.");
                }
            }
            encode.add("        let out: Any = { name: \"${key}\" };\n        out[\"fields\"] = f;\n        return out;\n    }\n");
            start.add("    if (name == \"${key}\") {\n        let t: ${c.name} = { ${literal.join(", ")} };\n");
            start.add(fill.toString());
            start.add("        return t;\n    }\n");
        }
        if (iface == "") { continue; }
        iface = "LarimarProcess.Task";         // Task as std.os.process says it, whatever the module imported (Task, UnsafeTask)
        m.program!.imports.push(ImportDecl { line: 1, path: PROCESS_MODULE, alias: "LarimarProcess" } in default);
        m.program!.imports.push(ImportDecl { line: 1, path: "std.os.library", alias: "LarimarLibraries" } in default);
        let source: String = """
            public function larimarTaskEncode(task: ${iface}): Any {
            ${encode.toString()}    return null;
            }

            public function larimarTaskStart(name: String, fields: Any): ${iface}? {
            ${start.toString()}    return null;
            }

            public function larimarTaskSetup(task: ${iface}, loader: LarimarLibraries.LibraryLoader): void throws LarimarLibraries.LoadError {
            ${setup.toString()}}
            """ in default;
        let p: Program = parseProgram(source, m.index * FILE_LINES + line);
        if (p.error != "") {
            linking.errors.push(p.error);
            continue;
        }
        addWords(source);
        for (d in p.decls) {
            m.program!.decls.push(d);
            m.ownValues[declName(d)] = 1;
            m.publics[declName(d)] = 1;
        }
        let path: String = m == linking.root ? modulePathOf(mainPath) : m.path;
        if (path == "") {
            error(line, "The Task classes of this file are found by its module, and the file is not in the project's folder: move them to a module of the project.");
            continue;
        }
        owners.push(path.clone() in default);
    }
    if (owners.length == 0) { return; }
    let imports: StringBuilder = {} in default;
    let encodes: StringBuilder = {} in default;
    let starts: StringBuilder = {} in default;
    let setups: StringBuilder = {} in default;
    for (i, o in owners) {
        imports.add("import ${o} as Tasks${i};\n");
        encodes.add("    let e${i}: Any = Tasks${i}.larimarTaskEncode(task);\n    if (e${i} != null) { return e${i}; }\n");
        starts.add("    let t${i}: Task? = Tasks${i}.larimarTaskStart(name, fields);\n    if (t${i} != null) { return t${i}; }\n");
        setups.add("    Tasks${i}.larimarTaskSetup(task, loader);\n");
    }
    let registry: String = """
        import std.os.process { Task };
        import std.os.library { LibraryLoader, LoadError };
        ${imports.toString()}
        public function encode(task: Task): Any {
        ${encodes.toString()}    return null;
        }

        public function start(name: String, fields: Any): Task? {
        ${starts.toString()}    return null;
        }

        public function setup(task: Task, loader: LibraryLoader): void throws LoadError {
        ${setups.toString()}}
        """ in default;
    // std.os.process.tasks, written here; std.os.process's encodeTask and startTask then ask it (std itself
    // has no import of it: no cycle in its sources)
    let tasks: Module = newModule(TASKS_MODULE, linking.fileNames.length);
    linking.fileNames.push(shownName(TASKS_MODULE));
    linking.filePaths.push(Paths.absolute(moduleFile(TASKS_MODULE)).clone() in default);
    linking.fileSources.push(registry);
    linking.mods.push(tasks);
    linking.modIndex[TASKS_MODULE] = linking.mods.length - 1;
    parse(tasks, registry);
    if (tasks.program == null) { return; }
    let process: Module = linking.mods[processAt];
    if (process.program == null) { return; }
    process.program!.imports.push(ImportDecl { line: 1, path: TASKS_MODULE, alias: "TaskRegistry" } in default);
    let calls: Program = parseProgram("""
        function encodeTask(task: Task): Any { return TaskRegistry.encode(task); }
        function startTask(name: String, fields: Any): Task? { return TaskRegistry.start(name, fields); }
        function setupTask(task: Task, loader: LibraryLoader): void throws LoadError { TaskRegistry.setup(task, loader); }
        """, process.index * FILE_LINES + 1);
    for (i, d in process.program!.decls) {
        if (!(d is FunctionDecl f)) { continue; }
        for (c in calls.decls) {
            if (c is FunctionDecl g && g.name == f.name) {
                g.line = f.line;
                process.program!.decls[i] = g;
            }
        }
    }
    let kept: Module[*] = [] in default;
    for (m in linking.order) {
        if (m != tasks) { kept.push(m); }
    }
    linking.order.clear();
    for (m in kept) { linking.order.push(m); }
    visit(tasks);                                 // its imports (the modules of the tasks), then itself, last
    linking.taskClasses = true;
}

/** Adds the words of a text (not those of its comments) to `words`. */
function addWords(text: String in default): void {
    let i: int32 = 0;
    while (i < text.length) {
        let start: int32 = i;
        if (text[i] == '/' && i + 1 < text.length && text[i + 1] == '/') {
            while (i < text.length && text[i] != '\n') { i += 1; }
        } else if (isIdentifierPart(text[i]) && !isDigit(text[i])) {
            while (i < text.length && isIdentifierPart(text[i])) { i += 1; }
            linking.words[text.substring(start, i)] = true;
        } else {
            i += 1;
        }
    }
}

/** Every name in a piece of C, into names. */
function cWords(code: String in default, names: Any in default): void {
    let i: int32 = 0;
    while (i < code.length) {
        if (isIdentifierPart(code[i]) && !isDigit(code[i])) {
            let start: int32 = i;
            while (i < code.length && isIdentifierPart(code[i])) { i += 1; }
            names[code.substring(start, i).clone() in default] = true;
        } else {
            i += 1;
        }
    }
}

function cCodeUses(code: String in default, cSymbols: Any in default): bool {
    let i: int32 = 0;
    while (i < code.length) {
        if (isIdentifierPart(code[i]) && !isDigit(code[i])) {
            let start: int32 = i;
            while (i < code.length && isIdentifierPart(code[i])) { i += 1; }
            if (cSymbols.contains(code.substring(start, i))) { return true; }
        } else {
            i += 1;
        }
    }
    return false;
}

/**
 * Which test functions stay in the program: "none" (larimar build: they are not compiled), "all" (larimar
 * check and the editor: they are checked like the rest) or "main" (larimar test: the main file's).
 */

function parse(module: Module in default, source: String in default): void {
    addWords(source);
    let p: Program = parseProgram(source, module.index * FILE_LINES + 1);
    if (p.error != "") {
        linking.errors.push(p.error);
        return;
    }
    if (linking.testsKept != "all" && !(linking.testsKept == "main" && module == linking.root)) {
        let kept: Node[*] = [] in default;
        for (d in p.decls) {
            if (!(d is FunctionDecl f && f.isTest)) { kept.push(d); }
        }
        p.decls = kept;
    }
    for (i, d in p.decls) {                   // std.memory: limit and compact are written by the compiler, not C
        if (d is ExternFunctionDecl e && nativeKnown(module, e.name)) {
            p.decls[i] = FunctionDecl { line: e.line, name: e.name, params: e.params, ret: e.ret, isNative: true } in default;
        } else if (d is FunctionDecl f && !f.hasBody && !f.isTest && nativeKnown(module, f.name)) {
            f.isNative = true;                // the others without a body: the rule body-needed
        }
    }
    module.program = p;
    for (d in p.decls) {
        let name: String = declName(d);
        if (name == "") { continue; }
        if (isTypeDecl(d)) { module.ownTypes[name] = 1; } else { module.ownValues[name] = 1; }
    }
    for (n in p.publics) { module.publics[n] = 1; }
}

/** The files read: sources live as long as the compiler. */
let texts: byte[*] = [] in heap;

/** The text of a file, or null if it cannot be read. */
public function readSource(path: String): String? {
    let open: String? = openDocument(Paths.normalize(Paths.absolute(path)));     // the editor's text, if it is open there
    if (open != null) { return open!.clone() in texts; }
    try {
        return Files.readString(path) in texts;
    } catch (IoError e) {
        return null;
    }
}

public function isStd(path: String): bool { return path.startsWith("std."); }

/**
 * Whether a program may have C of its own (larimarc --unsafe-c). Only for the compiler's own sources and
 * tests, which try what std's C does: a program built with it has none of the language's guarantees.
 */

/**
 * Where the program's C comes from, outside std: the project ("this project") and the libraries whose
 * native interfaces it has, and what was noticed about them (a type that nothing releases). Built after
 * linking; larimar build says it every time.
 */

/** Whether the module may have native interfaces of its own (unsafe_c of its project or library). */
public function unsafeModule(module: Module in default): bool {
    if (isStd(module.path)) { return false; }
    let library: int32 = libraryOf(module.path);
    if (library >= 0) { return library < linking.libraryUnsafe.length && linking.libraryUnsafe[library]; }
    return linking.projectUnsafe;
}

/** Who a module's C is from: its library, or the project. */
public function sourceOf(module: Module in default): String {
    let library: int32 = libraryOf(module.path);
    return library >= 0 ? linking.libraryNames[library] : "this project";
}

/** Whether a module may have C: the standard library's (the installed one, or the copy being edited), and the language's. */
public function trusted(module: Module in default, mainPath: String): bool {
    if (linking.unsafeC || isStd(module.path) || (linking.lang != null && module == linking.lang!)) { return true; }
    let file: String = module == linking.root ? mainPath : linking.filePaths[module.index];
    return Paths.normalize(Paths.absolute(file)).startsWith("${Paths.normalize(Paths.absolute(linking.stdDir))}/");
}

/**
 * Where a module's file is: std/, else a library of [dependencies] (its name, or <name>.<part>), else the
 * project's folder (the main file's).
 */
function moduleFile(path: String): String {
    if (isStd(path)) { return Paths.join(linking.stdDir, "${path.substring(4).replace(".", "/")}.lar"); }
    let relative: String = "${path.replace(".", "/")}.lar";
    let library: int32 = libraryOf(path);
    if (library >= 0) { return Paths.join(linking.libraryRoots[library], relative); }
    let own: String = Paths.join(linking.rootDir, relative);
    if (Files.isFile(own)) { return own; }
    if (linking.testsKept != "none") {                        // tests (and the editor): also from a folder above (the project's: tests.support...)
        let dir: String = Paths.parent(linking.rootDir);
        while (dir != "") {
            let fromProject: String = Paths.join(dir, relative);
            if (Files.isFile(fromProject)) { return fromProject; }
            if (Files.isFile(Paths.join(dir, "larimar.toml"))) { break; }    // not past the project
            let up: String = Paths.parent(dir);
            if (up == dir) { break; }
            dir = up;
        }
    }
    return own;
}


/** The library a module belongs to (its name, or <name>.<part>): its index, or -1. */
public function libraryOf(path: String): int32 {
    for (i, n in linking.libraryNames) {
        if (path == n || path.startsWith("${n}.")) { return i; }
    }
    return -1;
}

/** How a module's file is shown in messages. */
function shownName(path: String): String {
    if (isStd(path)) { return "${path.replace(".", "/")}.lar"; }
    return linking.showFrom != "" ? Paths.relative(linking.showFrom, moduleFile(path)) : moduleFile(path);
}


/** Loads the imports first, so each module comes after the ones it uses (and globals start in that order). */
function visit(module: Module in default): void {
    for (imp in module.program!.imports) {
        if (linking.modIndex[imp.path] != null) { continue; }       // already loaded, or a cycle: fine for declarations
        if (linking.root.index < linking.filePaths.length && Paths.normalize(Paths.absolute(moduleFile(imp.path))) == Paths.normalize(linking.filePaths[linking.root.index])) {
            linking.modIndex[imp.path] = 0;                         // the file opened alone (root), imported back by its parts
            continue;
        }
        let source: String? = readSource(moduleFile(imp.path));
        if (source == null) {
            error(imp.line, "Module '${imp.path}' not found (looked for ${shownName(imp.path)}).");
            continue;
        }
        let text: String = source!;
        let dep: Module = newModule(imp.path, linking.fileNames.length);
        linking.fileNames.push(shownName(imp.path));
        linking.filePaths.push(Paths.absolute(moduleFile(imp.path)).clone() in default);
        linking.fileSources.push(text);
        linking.mods.push(dep);
        linking.modIndex[dep.path] = linking.mods.length - 1;
        parse(dep, text);
        let library: int32 = libraryOf(imp.path);
        if (library >= 0 && Files.isFile(Paths.join(linking.rootDir, "${imp.path.replace(".", "/")}.lar"))) {
            error(imp.line, "Module '${imp.path}' is of the library '${linking.libraryNames[library]}' of [dependencies], and the project has a file with its name too: rename the project's.");
        }
        if (dep.program != null) { visit(dep); }
    }
    linking.order.push(module);
}

// ---- what each module can see ----------------------------------------------------------

function tables(module: Module in default): void {
    if (linking.lang != null && module != linking.lang!) {     // the language's public names: visible everywhere, below the module's own
        for (k, v in linking.lang!.types.fields) {
            if (linking.lang!.publics.contains(k)) { module.types[k] = v; }
        }
        for (k, v in linking.lang!.values.fields) {
            if (linking.lang!.publics.contains(k)) { module.values[k] = v; }
        }
    }
    dictFromSet(module.values, module.ownValues, module.prefix);
    dictFromSet(module.types, module.ownTypes, module.prefix);
    for (d in module.program!.decls) {              // its native interfaces: Name.f is the C function f
        if (!(d is NativeInterfaceDecl nativeInterface)) { continue; }
        let members: Any = {} in default;
        for (n in nativeInterface.members) { members[n] = "${module.prefix}${nativeInterface.name}__${n}" in default; }
        module.natives[nativeInterface.name] = members;
    }
    for (imp in module.program!.imports) {
        let ti: int32 = (linking.modIndex[imp.path] as int32 ?? -1);
        if (ti < 0) { continue; }
        let target: Module = linking.mods[ti];
        if (target.program == null) { continue; }
        if (target == module) {
            error(imp.line, "A module cannot import itself.");
            continue;
        }
        if (!imp.hasNames) {
            let a: String = imp.alias;
            if (module.values[a] != null || module.types[a] != null || module.aliases[a] != null) {
                error(imp.line, "'${a}' is already used in this file; import the module with another name: import ${imp.path} as other;");
            } else {
                module.aliases[a] = ti;
            }
            continue;
        }
        for (n in imp.names) {
            let found: bool = false;
            if (target.ownValues[n] != null) {
                found = true;
                bring(module, module.values, n, target, "${target.prefix}${n}" in default, imp.line);
            }
            if (target.ownTypes[n] != null) {
                found = true;
                bring(module, module.types, n, target, "${target.prefix}${n}" in default, imp.line);
            }
            if (!found) { error(imp.line, "Module '${target.path}' has no '${n}'."); }
            if (found && target.natives[n] != null) { module.natives[n] = target.natives[n].clone() in default; }
        }
    }
    for (d in module.program!.decls) {              // and what the native interfaces they extend give
        if (!(d is NativeInterfaceDecl nativeInterface)) { continue; }
        for (parent in nativeInterface.parents) {
            if (module.natives[parent] == null) {
                error(nativeInterface.line, "Native interface '${nativeInterface.name}' extends '${parent}', which is not a native interface known here (import it by name).");
                continue;
            }
            for (k, v in module.natives[parent].fields) {
                if (module.natives[nativeInterface.name][k] == null) { module.natives[nativeInterface.name][k] = v.clone() in default; }
            }
        }
    }
}

function bring(module: Module, into: Any, n: String in into, from: Module, mangled: String in into, line: int32): void {
    if (from.publics[n] == null) {
        error(line, "'${n}' is private to module '${from.path}'; mark it 'public' there to use it here.");
    } else if (into[n] != null && (into[n] as String ?? "") != mangled) {
        let last: String = from.path.substring((from.path.lastIndexOf(".") ?? -1) + 1);
        error(line, "'${n}' is already defined in this file; import the module instead and write ${last}.${n}.");
    } else {
        into[n] = mangled;
    }
}

// ---- renaming ---------------------------------------------------------------------------------
// Declarations are renamed in place; an expression may be replaced (alias.name becomes the name).

let rm: Module = linking.root;                          // the module being rewritten
let scopes: Any[*] = [] in default;
let scopeDepth: int32 = 0;

function push(): void {
    if (scopeDepth < scopes.length) { scopes[scopeDepth] = {} in default; } else { scopes.push({} in default); }
    scopeDepth += 1;
}

function pop(): void { scopeDepth -= 1; }

function declare(n: String in default): void {
    if (n != "" && scopeDepth > 0) { scopes[scopeDepth - 1][n] = 1; }
}

function local(n: String): bool {
    let i: int32 = 0;
    while (i < scopeDepth) {
        if (scopes[i][n] != null) { return true; }
        i += 1;
    }
    return false;
}

/** The native functions of modules: Memory.limit and Memory.compact, in std/memory.lar (imported, or opened alone). */
/** A file of std opened alone (the editor, larimar check std/x.lar): it is std, whatever its module path. */
public function stdFileOpened(module: Module in default): bool {
    if (module.index >= linking.filePaths.length) { return false; }
    let f: String = Paths.normalize(Paths.absolute(linking.filePaths[module.index]));
    return f.startsWith("${Paths.normalize(Paths.absolute(linking.stdDir))}/");
}

/** std.lang (or std/lang.lar opened alone): what has no body there the compiler writes. */
public function isLanguage(module: Module in default): bool {
    if (module.path == "std.lang") { return true; }
    return module.path == "" && module.index < linking.filePaths.length && linking.filePaths[module.index].replace("\\", "/").endsWith("std/lang.lar");
}

function nativeKnown(module: Module in default, name: String): bool {
    let alone: bool = module.path == "" && module.index < linking.filePaths.length && linking.filePaths[module.index].replace("\\", "/").endsWith("std/memory.lar");
    return (module.path == "std.memory" || alone) && (name == "limit" || name == "compact");
}

/**
 * lar"name" in ccode: a function, type or global of Larimar, by its Larimar name (module.name for another
 * module); it becomes lar"its linked name", and the generator writes its C name there.
 */
function larNames(module: Module in default, code: String, line: int32): String {
    let out: StringBuilder = {};
    let i: int32 = 0;
    while (i < code.length) {
        let at: int32? = code.indexOf("lar\"", i);
        if (at == null) {
            out.add(code.substring(i));
            break;
        }
        let close: int32? = code.indexOf("\"", at! + 4);
        if (close == null) {
            error(line, "lar\" without its closing quote in ccode: lar\"name\"");
            return code.clone();
        }
        out.add(code.substring(i, at!));
        let name: String = code.substring(at! + 4, close!);
        let linked: String = larName(module, name);
        if (linked == "") { error(line, "lar\"${name}\" in ccode: '${name}' is not a function, type or global of Larimar seen here."); }
        out.add("lar\"${linked}\"");
        i = close! + 1;
    }
    return out.toString();
}

/** The linked name of a Larimar name seen from module m ("a.b.name": the module a.b), or "". */
function larName(module: Module in default, name: String): String {
    let dot: int32? = name.lastIndexOf(".");
    if (dot == null) { return (module.values[name] as String ?? module.types[name] as String ?? "").clone(); }
    let path: String = name.substring(0, dot!);
    let n: String = name.substring(dot! + 1);
    for (other in linking.mods) {
        let alias: bool = module.aliases[path] != null && (module.aliases[path] as int32 ?? -1) == other.index;
        if (other.path == path || alias) {
            if (other.ownValues[n] != null || other.ownTypes[n] != null) { return "${other.prefix}${n}"; }
        }
    }
    return "";
}

function rewriteDecl(module: Module in default, d: Node in default): void {
    rm = module;
    scopeDepth = 0;
    let dn: String = declName(d);
    let mapped: String = (isTypeDecl(d) ? module.types[dn] : module.values[dn]) as String ?? "";
    let own: String = (linking.lang != null && module == linking.lang! && mapped != "" ? mapped : "${module.prefix}${dn}") in default;
    switch (d) {
        case FunctionDecl f -> {
            if (f.typeName == "") {
                function_(f, own);
            } else {                                                 // static: Type.name, in the module of Type
                if (module.ownTypes[f.typeName] == null) {
                    error(f.line, "Static function '${f.typeName}.${f.name}' must be declared in the module that declares '${f.typeName}'.");
                }
                f.typeName = typeName(f.typeName, f.line);
                function_(f, f.name);
            }
        }
        case ConstDecl c -> {
            c.name = own;
            typeRef(c.type);
            c.value = expr(c.value);
        }
        case VarDecl v -> {
            v.name = own;
            typeRef(v.type);
            v.init = exprOpt(v.init);
        }
        case StructDecl s -> {
            s.name = own;
            fields(s.fields);
            for (f in s.methods) { function_(f, f.name); }
        }
        case ClassDecl c -> {
            c.name = own;
            if (c.superName != "") { c.superName = typeName(c.superName, c.line); }
            let ifs: String[*] = [] in default;
            for (i in c.interfaces) { ifs.push(typeName(i, c.line)); }
            c.interfaces = ifs;
            fields(c.fields);
            for (f in c.methods) { function_(f, f.name); }
        }
        case InterfaceDecl i -> {
            i.name = own;
            let parents: String[*] = [] in default;
            for (p in i.parents) { parents.push(typeName(p, i.line)); }
            i.parents = parents;
            for (f in i.methods) { function_(f, f.name); }
        }
        case NativeTypeDecl t -> {
            t.name = own;
            for (f in t.methods) { function_(f, f.name); }
        }
        case EnumDecl e -> {
            e.name = own;
            for (v in e.variants) { params(v.fields); }
        }
        case CCodeDecl c -> {
            c.fromStd = (linking.lang != null && module == linking.lang!) || isStd(module.path);
            if (c.code.contains("lar\"")) { c.code = larNames(module, c.code, c.line); }
            if (c.owner != "") { c.owner = typeName(c.owner, c.line); }
        }
        case CIncludeDecl c -> {
            if (c.owner != "") { c.owner = typeName(c.owner, c.line); }
        }
        case ExternTypeDecl t -> {
            t.name = own;
            if (t.fieldsStruct != "") { t.fieldsStruct = (rm.types[t.fieldsStruct] as String ?? t.fieldsStruct).clone() in default; }
            if (t.releasedBy != "") {            // the function that releases it: a name of this module (or one it sees)
                let v: String = rm.values[t.releasedBy] as String ?? "";
                if (v != "") { t.releasedBy = v; }
            }
        }
        case ExternValueDecl v -> {
            v.name = own;
            typeRef(v.type);
        }
        case ExternFunctionDecl f -> {
            let headers: bool = hasHeaders(module);
            f.name = own;
            params(f.params);
            typeRef(f.ret);
            f.prototype = !headers;
            if (f.cBody.contains("lar\"")) { f.cBody = larNames(module, f.cBody, f.line); }
            if (f.owner != "") { f.owner = typeName(f.owner, f.line); }
            if (f.releasedBy != "") {            // what releases its text: a name of this module (or one it sees)
                let v: String = rm.values[f.releasedBy] as String ?? "";
                if (v != "") { f.releasedBy = v; }
            }
        }
        default -> {}
    }
}

/**
 * Whether a module brings its own C headers (cinclude or ccode), itself or in its parts (the modules
 * of its folder, net/posix.lar for net.lar): then its natives are declared by them, not by us.
 */
function hasHeaders(module: Module in default): bool {
    let parts: String = "${module.path}.";
    for (x in linking.mods) {
        if (x != module && (module.path == "" || !x.path.startsWith(parts))) { continue; }
        if (x.program == null) { continue; }
        for (d in x.program!.decls) {
            if (d is CIncludeDecl || d is CCodeDecl) { return true; }
        }
    }
    return false;
}

function function_(f: FunctionDecl in default, name: String in default): void {
    push();
    params(f.params);
    for (p in f.params) { declare(p.name); }
    block(f.body, false);
    pop();
    f.name = name;
    typeRef(f.ret);
    typeRef(f.throwsType);
}

function fields(fs: FieldDecl[*] in default): void {
    for (f in fs) {
        typeRef(f.type);
        f.defaultValue = exprOpt(f.defaultValue);
    }
}

function params(ps: Param[*] in default): void {
    for (p in ps) { typeRef(p.type); }
}

function typeRef(t: TypeRef? in default): void {
    if (t == null || t.rewritten) { return; }
    t.rewritten = true;
    if (t.kind == TypeRefKind.Named) {
        t.name = typeName(t.name, t.line);
        return;
    }
    for (p in t.params) { typeRef(p); }
    typeRef(t.inner);
    t.size = exprOpt(t.size);
}

/** Shape, geo.Shape, Shape.Circle (enum variant), geo.Shape.Circle. */
function typeName(name: String in default, line: int32): String {
    let dot: int32? = name.indexOf(".");
    let head: String = dot != null ? name.substring(0, dot) : name;
    let rest: String = dot != null ? name.substring(dot) : "";
    if (rm.types[head] != null) { return "${(rm.types[head] as String ?? "")}${rest}" in default; }
    if (dot != null && rm.aliases[head] != null) {
        let r: String = rest.substring(1);
        let dot2: int32? = r.indexOf(".");
        let member: String = dot2 != null ? r.substring(0, dot2) : r;
        let mangled: String = exported(linking.mods[(rm.aliases[head] as int32 ?? -1)], member, false, line);
        return mangled == "" ? name : ("${mangled}${dot2 != null ? r.substring(dot2) : ""}" in default);
    }
    hidden(head, line);
    return name;
}

/** A public name of another module: values first, then types ("" after an error). */
function exported(from: Module, n: String, values: bool, line: int32): String {
    let found: bool = (values && from.ownValues[n] != null) || from.ownTypes[n] != null;
    if (!found) {
        error(line, "Module '${from.path}' has no '${n}'.");
        return "";
    }
    if (from.publics[n] == null) {
        error(line, "'${n}' is private to module '${from.path}'; mark it 'public' there to use it here.");
        return "";
    }
    return "${from.prefix}${n}" in default;
}

/** Modules do not see the main file's declarations (nobody imports the main file). */
function hidden(n: String, line: int32): void {
    if (rm != linking.root && (linking.root.ownValues[n] != null || linking.root.ownTypes[n] != null)) {
        error(line, "'${n}' is declared in the main file, which modules cannot see; move it to a module and import it.");
    }
}

// ---- statements

function block(body: Stmt[*] in default, newScope: bool): void {
    if (newScope) { push(); }
    for (s in body) { stmt(s); }
    if (newScope) { pop(); }
}

function stmt(s: Stmt in default): void {
    switch (s) {
        case VarDecl v -> {
            typeRef(v.type);
            v.init = exprOpt(v.init);
            declare(v.name);
        }
        case AssignStmt a -> {
            a.target = expr(a.target);
            a.value = expr(a.value);
        }
        case ReturnStmt r -> { r.value = exprOpt(r.value); }
        case ExprStmt e -> { e.expr = expr(e.expr); }
        case ThrowStmt t -> { t.value = expr(t.value); }
        case YieldStmt y -> { y.value = expr(y.value); }
        case SwitchStmt sw -> switchExpr(sw.switchExpr);
        case IfStmt i -> {
            i.cond = expr(i.cond);
            block(i.thenBody, true);
            block(i.elseBody, true);
        }
        case WhileStmt w -> {
            w.cond = expr(w.cond);
            block(w.body, true);
        }
        case ForStmt f -> {
            f.iterable = expr(f.iterable);
            f.rangeEnd = exprOpt(f.rangeEnd);
            push();
            declare(f.indexName);
            declare(f.varName);
            block(f.body, false);
            pop();
        }
        case TryStmt t -> {
            block(t.body, true);
            for (c in t.catches) {
                push();
                declare(c.varName);
                c.typeName = typeName(c.typeName, c.line);
                block(c.body, false);
                pop();
            }
        }
        case BlockStmt b -> block(b.body, true);
        default -> {}
    }
}

// ---- expressions

function exprOpt(e: Expr? in default): Expr? { return e == null ? null : expr(e); }

/** The expression renamed; module.name comes back as the name itself. */
function expr(e: Expr in default): Expr {
    if (e.rewritten) { return e is Member m && m.replaced != null ? m.replaced! : e; }
    e.rewritten = true;
    switch (e) {
        case Ident id -> identName(id);
        case Member m -> {
            if (m.object is Ident io && !local(io.name) && rm.natives[io.name] != null) {    // Native.f is the C function f
                let found: String = rm.natives[io.name][m.name] as String ?? "";
                if (found == "") { error(m.line, "Native interface '${io.name}' has no '${m.name}'."); }
                let id: Ident = Ident { line: m.line, name: found == "" ? m.name : found, rewritten: true } in default;
                m.replaced = id;
                return id;
            }
            if (m.object is Ident obj && isAlias(obj.name)) {          // alias.name is the name itself
                let name: String = exported(linking.mods[(rm.aliases[obj.name] as int32 ?? -1)], m.name, true, m.line);
                let id: Ident = Ident { line: m.line, name: name == "" ? m.name : name, rewritten: true } in default;
                m.replaced = id;
                return id;
            }
            m.object = expr(m.object);
        }
        case Index x -> {
            x.object = expr(x.object);
            x.index = expr(x.index);
        }
        case Binary b -> {
            b.left = expr(b.left);
            b.right = expr(b.right);
        }
        case Ternary t -> {
            t.cond = expr(t.cond);
            t.then = expr(t.then);
            t.otherwise = expr(t.otherwise);
        }
        case IsExpr x -> {
            x.expr = expr(x.expr);
            x.typeName = x.typeName.contains(".") ? typeName(x.typeName, x.line) : rm.types[x.typeName] as String ?? x.typeName;
            declare(x.binding);
        }
        case Call c -> {
            c.callee = expr(c.callee);
            let args: Expr[*] = [] in default;
            for (a in c.args) { args.push(expr(a)); }
            c.args = args;
        }
        case Unary u -> { u.operand = expr(u.operand); }
        case Unwrap u -> { u.expr = expr(u.expr); }
        case Cast c -> {
            c.expr = expr(c.expr);
            typeRef(c.type);
        }
        case Lambda l -> {
            params(l.params);
            push();
            for (p in l.params) { declare(p.name); }
            block(l.body, false);
            pop();
        }
        case ObjectLit o -> {
            if (o.typeName != "") { o.typeName = typeName(o.typeName, o.line); }
            for (f in o.fields) { f.value = expr(f.value); }
        }
        case ArrayLit a -> {
            let elems: Expr[*] = [] in default;
            for (x in a.elems) { elems.push(expr(x)); }
            a.elems = elems;
        }
        case StringLit s -> {
            let exprs: Expr[*] = [] in default;
            for (x in s.exprs) { exprs.push(expr(x)); }
            s.exprs = exprs;
        }
        case Placed p -> {
            p.expr = expr(p.expr);
            p.memory = exprOpt(p.memory);
            typeRef(p.buffer);
        }
        case SwitchExpr sw -> {
            switchExpr(sw);
            if (chosen(sw) && sw.cases[0].expr != null) { return sw.cases[0].expr!; }
        }
        default -> {}
    }
    return e;
}

/** Platform.current(), as the linker leaves it. */
function asksPlatform(e: Expr in default): bool {
    return e is Call c && c.args.length == 0 && c.callee is Member m && m.name == "current"
        && m.object is Ident t && (t.name == "std__platform__Platform" || t.name == "std__os__Platform");
}

/** A switch on the platform that --target reduced to its arm. */
function chosen(switchExpr: SwitchExpr in default): bool {
    return linking.target != "" && switchExpr.cases.length == 1 && switchExpr.cases[0].isDefault && asksPlatform(switchExpr.subject);
}

/** With --target, a switch on Platform.current() keeps only the arm of that platform, as its default. */
function choosePlatform(switchExpr: SwitchExpr in default): void {
    if (linking.target == "" || !asksPlatform(switchExpr.subject)) { return; }
    let variant: String = switch (linking.target) {
        case "linux" -> "Linux";
        case "macos" -> "MacOS";
        case "windows" -> "Windows";
        default -> "Unix";
    };
    for (c in switchExpr.cases) {
        let named: bool = false;
        for (p in c.patterns) { named = named || p.name == variant || p.name.endsWith(".${variant}"); }
        if (c.guard != null || !(c.isDefault || named)) { continue; }
        c.isDefault = true;
        c.patterns = [] in default;
        switchExpr.cases = [c] in default;
        return;
    }
}

function switchExpr(sw: SwitchExpr in default): void {
    sw.subject = expr(sw.subject);
    for (c in sw.cases) {
        push();
        for (p in c.patterns) { pattern(p); }
        c.guard = exprOpt(c.guard);
        c.expr = exprOpt(c.expr);
        if (c.hasBlock) { block(c.block, true); }
        if (c.throwStmt != null) { c.throwStmt!.value = expr(c.throwStmt!.value); }
        pop();
    }
    choosePlatform(sw);
}

function isAlias(n: String): bool {
    return !local(n) && rm.values[n] == null && rm.types[n] == null && rm.aliases[n] != null;
}

function identName(id: Ident in default): void {
    let n: String = id.name;
    if (local(n)) { return; }
    if (rm.natives[n] != null && rm.natives[n][OPENED_BINDING] != null) {     // an UnsafeTask's interface, as a value: what binds it
        id.name = (rm.natives[n][OPENED_BINDING] as String ?? n).clone() in default;
        return;
    }
    let v: String = rm.values[n] as String ?? rm.types[n] as String ?? "";
    if (v != "") {
        id.name = v;
        return;
    }
    if (rm.aliases[n] != null) {
        error(id.line, "'${n}' is a module; use one of its names: ${n}.name");
        return;
    }
    hidden(n, id.line);
}

/** A variant keeps its name; a type or a constant is renamed (variant lookup ignores a module prefix). */
function pattern(p: Pattern in default): void {
    if (p.kind == PT_NULL) { return; }
    if (p.kind == PT_CONSTANT) {
        p.constant = exprOpt(p.constant);
        return;
    }
    let name: String = p.name;
    if (name.contains(".")) {
        name = typeName(name, p.line);
    } else if (rm.types[name] != null) {
        name = rm.types[name] as String ?? "";
    } else if (p.kind == PT_NAME && !local(name) && rm.values[name] != null) {
        name = rm.values[name] as String ?? "";
    }
    p.name = name;
    declare(p.binding);
    for (b in p.bindings) { declare(b); }
}

// ---- messages -------------------------------------------------------------------------------------

/** "[Line 2000005]" -> "[src/geo.lar:5]", "line 7" -> "main.lar:7", and geo__Shape -> geo.Shape. */
public function decode(msg: String): String {
    let a: String = replaceLines(msg, "[Line ", true);
    let b: String = replaceLines(a, "line ", false);
    return b.replace("__", ".");
}

function replaceLines(msg: String, key: String, bracket: bool): String {
    let builder: StringBuilder = {} in default;
    let i: int32 = 0;
    let done: int32 = 0;
    while (true) {
        let at: int32? = msg.indexOf(key, i);
        if (at == null) { break; }
        let j: int32 = at + key.length;
        let k: int32 = j;
        while (k < msg.length && isDigit(msg[k])) { k += 1; }
        let ok: bool = k > j;
        if (bracket) {
            ok = ok && k < msg.length && msg[k] == ']';
        } else {
            ok = ok && (at == 0 || !isIdentifierPart(msg[at - 1])) && (k >= msg.length || !isIdentifierPart(msg[k]));
        }
        if (!ok) {
            i = at + 1;
            continue;
        }
        let n: int64 = msg.substring(j, k).toInt() ?? 0;
        let file: int32 = (n / 1000000) as int32;
        let name: String = "?";
        if (file < linking.fileNames.length) { name = linking.fileNames[file]; }
        builder.add(msg.substring(done, at));
        if (bracket) {
            builder.add("[${name}:${n % 1000000}]");
            done = k + 1;
        } else {
            builder.add("${name}:${n % 1000000}");
            done = k;
        }
        i = done;
    }
    builder.add(msg.substring(done));
    return builder.toString();
}

// ---- for the editor (ide.lar) ----------------------------------------------------------------

function moduleOfFile(index: int32): Module? {
    for (m in linking.mods) {
        if (m.index == index) { return m; }
    }
    if (linking.lang != null && linking.lang!.index == index) { return linking.lang; }
    return null;
}

/** What a file can name: name -> its name after linking (its own, imported and the language's). */
public function namesOfFile(index: int32): Any {
    let out: Any = {} in default;
    let module: Module? = moduleOfFile(index);
    if (module == null) { return out; }
    for (k, v in module!.values.fields) { out[k] = (v as String ?? k).clone() in default; }
    for (k, v in module!.types.fields) { out[k] = (v as String ?? k).clone() in default; }
    return out;
}

/** A name std.lang keeps to itself (its helpers): every file sees it, but the editor does not offer it. */
public function isLangHelper(name: String): bool {
    if (linking.lang == null) { return false; }
    let own: bool = linking.lang!.ownValues[name] != null || linking.lang!.ownTypes[name] != null;
    return own && linking.lang!.publics[name] == null;
}

/** The modules a file imports with a name: alias -> module path ("geo.shapes"). */
public function aliasesOfFile(index: int32): Any {
    let out: Any = {} in default;
    let module: Module? = moduleOfFile(index);
    if (module == null) { return out; }
    for (k, v in module!.aliases.fields) {
        let i: int32 = v as int32 ?? -1;
        if (i >= 0 && i < linking.mods.length) { out[k] = linking.mods[i].path.clone() in default; }
    }
    return out;
}

/** The public names of a module, each with its name after linking. */
public function publicsOfModule(path: String): Any {
    let out: Any = {} in default;
    let i: int32 = linking.modIndex[path] as int32 ?? -1;
    if (i < 0 || i >= linking.mods.length) { return out; }
    let module: Module = linking.mods[i];
    for (k, v in module.publics.fields) { out[k] = "${module.prefix}${k}" in default; }
    return out;
}

/** The file of a module, from its path ("geo.shapes"), or "". */
public function fileOfModule(path: String): String {
    let i: int32 = linking.modIndex[path] as int32 ?? -1;
    if (i < 0 || i >= linking.mods.length) { return ""; }
    let idx: int32 = linking.mods[i].index;
    return idx >= 0 && idx < linking.filePaths.length ? linking.filePaths[idx] : "";
}
