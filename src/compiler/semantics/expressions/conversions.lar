// semantics.expressions.conversions: when a value of one type can be used as another: coercion and conversions.

import syntax.ast { Expr, Lambda, Node, NullLit, Placed, SwitchExpr };
import semantics.types {
    ArrayKind, Conversion, ConversionKind, cTypeOf, EnumInfo, enumOf, Frame, FrameKind, hasThreadSafe, implementor, InterfaceInfo,
    interfaceOf, isClass, isEnumT, isError, isInterface, isNumeric, isOpt, isPtr, isStruct, isSubclass, meet,
    MethodInfo, NamedKind, P_TEMP, Place, PlaceKind, R_STATIC, Region, rLocal, rResult, Scope, StructInfo, structOf,
    Symbol, SymbolKind, T_ANY, T_BOOL, T_ERROR, T_STRING, T_VOID, TypeKind, Type
};
import semantics.analyzer { block, error, frame, scope, wrong };
import semantics.analyzer.flow { blockRegion, lifetime };
import semantics.analyzer.threads { checkThreadSafeLambda };
import semantics.expressions { check, note, resolvePlacement };
import semantics.expressions.operators { lt, optional, withoutThreadSafe };

public function typeOf(e: Node): Type { return e.ty ?? T_ERROR; }
public function regionOf(e: Node): Region { return e.region ?? R_STATIC; }
public function setRegion(e: Node in default, r: Region in default): void { e.region = r; }

let blockMemories: int32 = 0;

public function placeRegion(p: Place in default): Region {
    switch (p.kind) {
        case Memory -> { return p.memory!.memRegion!; }
        case Stack -> { return frame().kind == FrameKind.Global ? R_STATIC : rLocal(block(), "a temporary buffer of this block"); }
        case OfObject, OfList, OfAny -> { return regionOf(p.expr!); }
        case Temp -> { return tempRegion("a temporary of this statement"); }
        case Block -> {
            let b: Scope = p.scope!;
            if (b.memory == "") {               // the block gets a memory: its first statement says so
                b.memory = "mem_${blockMemories}" in default;
                blockMemories += 1;
                b.body![0].blockMemory = b.memory;
            }
            return blockRegion(b);
        }
        case Result -> {
            let frameOf: Frame = frame();
            if (frameOf.result == null) {
                frameOf.result = Symbol { name: "result", kind: SymbolKind.Local, type: T_VOID, line: 0, frame: frameOf, scope: frameOf.root!, id: -1,
                    cName: "result", region: R_STATIC, argsOutlive: frameOf.returnsArgs } in default;
            }
            return rResult(frameOf.result!);
        }
        default -> { return R_STATIC; }
    }
}

/** The current statement's temporaries (none at the top level: there it is the whole program). */
function tempRegion(label: String in default): Region {
    let c: Scope? = scope;
    while (c != null && c.frame == frame()) {
        if (c.statement) { return rLocal(c, label); }
        c = c.parent;
    }
    return R_STATIC;
}

public function hasRefs(type: Type): bool {
    let visiting: Any = {};
    return hasRefsIn(type, visiting);
}

/** Has a struct or an enum (by name) references to memory? */
public function namedHasRefs(name: String, namedKind: NamedKind): bool {
    let visiting: Any = {};
    return namedRefsIn(name, namedKind, visiting);
}

function hasRefsIn(type: Type, visiting: Any): bool {
    if (type == T_STRING || type == T_ANY) { return true; }
    return switch (type.kind) {
        case Prim, Null, Ptr, Err -> false;                  // a C pointer: C owns what it points to
        case Func -> true;
        case Opt -> hasRefsIn(type.elem!, visiting);
        case Array -> type.arrayKind != ArrayKind.Fixed || hasRefsIn(type.elem!, visiting);
        case Named -> switch (type.namedKind) {
            case Class, Interface -> true;
            case Extern -> true;                             // a C value may point to memory (a handle made in a memory)
            case Struct, Enum -> namedRefsIn(type.name, type.namedKind, visiting);
        };
    };
}

function namedRefsIn(name: String, namedKind: NamedKind, visiting: Any): bool {
    if (visiting.contains(name)) { return false; }
    visiting[name] = true;
    if (namedKind == NamedKind.Struct) {
        let structInfo: StructInfo? = structOf(name);
        if (structInfo == null) { return false; }
        for (f in structInfo.fields) {
            if (hasRefsIn(f.type, visiting)) { return true; }
        }
        return false;
    }
    if (namedKind == NamedKind.Enum) {
        let enumInfo: EnumInfo? = enumOf(name);
        if (enumInfo == null) { return false; }
        for (v in enumInfo.variants) {
            for (f in v.fields) {
                if (hasRefsIn(f.type, visiting)) { return true; }
            }
        }
    }
    return false;
}

public function conversionOf(kind: ConversionKind, from: Type in default, to: Type in default): Conversion {
    return Conversion { kind, from, to } in default;
}

// =====================================================================================
// Coercion and conversions
// =====================================================================================

/** Checks `e` where a value of type `target` is needed, applying implicit conversions. Returns the target type, or ERROR. */
public function coerce(e: Expr in default, target: Type in default, place: Place in default, ctx: String in default): Type {
    if (isError(target)) {
        check(e, null, place);
        return T_ERROR;
    }
    // A lambda where a single-method interface is expected (optionally `in` a memory).
    if (e is Placed p && p.expr is Lambda && isInterface(target)) {
        let type: Type = coerce(p.expr, target, resolvePlacement(p) ?? P_TEMP, ctx);
        e.ty = type;
        setRegion(e, regionOf(p.expr));
        return type;
    }
    if (e is Lambda && isInterface(target)) {
        let interfaceInfo: InterfaceInfo = interfaceOf(target.name)!;
        if (interfaceInfo.methods.length != 1) { return wrong(e.line, "A lambda can only be used as '${interfaceInfo.name}' if the interface has exactly one method."); }
        let method: MethodInfo = interfaceInfo.methods[0];
        if (method.throwsType != null) { return wrong(e.line, "'${interfaceInfo.name}.${method.name}' can throw, and lambdas cannot."); }
        let leftType: Type = check(e, method.sig, place);
        if (isError(leftType)) { return T_ERROR; }
        let c: Conversion = conversionOf(ConversionKind.SamLambda, leftType, target);
        c.iface = interfaceInfo;
        e.conversionOf = c;
        e.place = place;
        let placed: Region = placeRegion(place);
        lifetime(regionOf(e), placed, e.line, "This lambda uses data from {v}, but it is stored in {st}, which lives longer.");
        e.region = placed;
        note(method.sig!);
        return target;
    }
    // A lambda where a `thread safe` function is expected: checked like the run of a Thread.
    let bare: Type = withoutThreadSafe(target);
    if (bare != target) {
        let inner: Expr = e is Placed pl ? pl.expr : e;
        if (inner is Lambda l) {
            let leftType: Type = coerce(e, bare, place, ctx);
            if (isError(leftType)) { return T_ERROR; }
            if (l.lambda != null) { checkThreadSafeLambda(l.lambda!, e.line); }
            note(target);
            return target;
        }
    }
    // A switch gets the optional type itself: its arms can be null or a value.
    let hint: Type = isOpt(target) && !(e is NullLit) && !(e is SwitchExpr) ? target.elem! : target;
    let type: Type = check(e, hint, place);
    if (isError(type)) { return T_ERROR; }
    let c: Conversion? = conversion(type, target);
    if (c == null) {
        let extra: String = "";
        if (isClass(type) && isClass(target) && isSubclass(target.name, type.name)) {
            extra = " A superclass value is not always a subclass; use a switch with a type pattern (case ${target.text} x -> ...).";
        } else if (isOpt(type) && !isOpt(target)) {
            extra = " The value may be null: use ?? to give a default, ! to assert it is not null, or check it with != null first.";
        } else if (type.kind == TypeKind.Null) {
            extra = " Only optional types (T?) can be null.";
        }
        return wrong(e.line, "${ctx}: expected ${target.text} but got ${type.text}.${extra}");
    }
    if (c.kind != ConversionKind.None) { e.conversionOf = c; }
    if (c.kind == ConversionKind.ToAny && (isStruct(type) || isEnumT(type))) { box(e, type, place); }
    note(target);
    return target;
}

/** A struct or enum put in an Any is copied into a memory: the one written with `in`, or the table's. */
function box(e: Expr in default, type: Type, place: Place in default): void {
    let bp: Place = e is Placed p && p.expr.place != null ? p.expr.place! : place;
    if (bp.kind == PlaceKind.Stack) {
        error(e.line, "A value put in an Any is copied into a memory, not into a temporary buffer.");
        return;
    }
    e.boxPlace = bp;
    setRegion(e, meet(regionOf(e), placeRegion(bp)));
}

public function conversion(from: Type in default, to: Type in default): Conversion? {
    if (from == to) { return conversionOf(ConversionKind.None, from, to); }
    if (hasThreadSafe(from) && cTypeOf(from) == to) { return conversionOf(ConversionKind.None, from, to); }    // drops `thread safe`
    if (to == T_ANY) {
        let inner: Type = isOpt(from) ? from.elem! : from;
        let ok: bool = from.kind == TypeKind.Null || isNumeric(inner) || inner == T_BOOL || inner == T_STRING
            || isClass(inner) || (!isOpt(from) && (isStruct(inner) || isEnumT(inner)));
        return ok ? conversionOf(ConversionKind.ToAny, from, to) : null;
    }
    if (from.kind == TypeKind.Null && isOpt(to)) { return conversionOf(ConversionKind.NullToOptional, from, to); }
    if (from.kind == TypeKind.Null && isPtr(to)) { return conversionOf(ConversionKind.None, from, to); }        // NULL
    if (isOpt(to) && !isOpt(from)) {
        let inner: Conversion? = conversion(from, to.elem!);
        if (inner == null) { return null; }
        let c: Conversion = conversionOf(ConversionKind.WrapOptional, from, to);
        c.implClass = inner.implClass;
        c.iface = inner.iface;
        return c;
    }
    if (isOpt(from) && isOpt(to) && isClass(from.elem!) && isClass(to.elem!) && isSubclass(from.elem!.name, to.elem!.name)) {
        return conversionOf(ConversionKind.Upcast, from, to);
    }
    if (isClass(from) && isClass(to) && isSubclass(from.name, to.name)) { return conversionOf(ConversionKind.Upcast, from, to); }
    if (isClass(from) && isInterface(to)) {
        let impl: String = implementor(from.name, to.name);
        if (impl == "") { return null; }
        let c: Conversion = conversionOf(ConversionKind.ClassToInterface, from, to);
        c.implClass = impl;
        c.iface = interfaceOf(to.name);
        return c;
    }
    if (from.kind == TypeKind.Array && to.kind == TypeKind.Array && from.elem! == to.elem!) {
        if (from.arrayKind == ArrayKind.Fixed && to.arrayKind == ArrayKind.Fixed && from.size <= to.size) { return conversionOf(ConversionKind.ResizeFixed, from, to); }
        if (to.arrayKind == ArrayKind.Slice && from.arrayKind != ArrayKind.Slice) { return conversionOf(ConversionKind.ToSlice, from, to); }
    }
    return null;
}
