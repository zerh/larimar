// semantics.analyzer: semantic analysis (Analyzer.java), part 1: declarations, statements, regions
// and the final passes. Expressions are in checkexpr.lar.
//
//  - Types: declarations, expressions with expected types, implicit conversions.
//  - Regions: every value that references memory carries the region of that memory;
//    storing it somewhere that outlives the region is an error (fix: .clone()).
//  - Captures: a lambda captures by value; captured variables cannot change.
//  - Errors: throws/try/catch are checked; every throwing call is handled.
//  - Switch: patterns resolved, enums covered completely.

import syntax.ast { Expr, Param, Program, VarDecl };
import semantics.types {
    classOf, declared, EnumInfo, enumOf, escapeName, Frame, FrameKind, interfaceOf, isExternTypeName,
    isMemory, isStruct, LambdaInfo, named, NamedKind, nativeOwner, newOwner, newScope, Owner, R_STATIC,
    Region, Scope, structOf, SwitchInfo, Symbol, SymbolKind, T_ERROR, Type
};
import semantics.linker { linking };
import semantics.analyzer.classes { checkFieldDefaults, checkMain, validateClasses, validateInterfaces };
import semantics.analyzer.compact { resolveRegions };
import semantics.analyzer.declarations { collect, constants, signatures };
import semantics.analyzer.flow { flowSummaries };
import semantics.analyzer.narrowing { hasSymbol };
import semantics.analyzer.order { checkGlobalOrder, computeTypeOrder };
import semantics.analyzer.statements { analyzeFunction, analyzeMethod, analyzeVarDecl };
import semantics.analyzer.threads { checkSynchronizedClasses, checkThreads };

// =====================================================================================
// State
// =====================================================================================

public class Diag {
    let line: int32;
    let msg: String;
}

/** The state of the analysis: its scopes and frames, every symbol, what it checks once the bodies are read (lifetimes, mutations, threads), and its errors. */
public class Analysis {
    let diags: Diag[*] = [];
    let globalFrame: Frame;
    let frames: Frame[*] = [];
    let frameTop: int32 = 0;                  // frames in use
    /** The scope being read, and the program's (newAnalysis makes both). */
    let scope: Scope;
    let globalScope: Scope;
    let states: FrameState[*] = [];
    let stateTop: int32 = 0;
    let symbolIds: int32 = 0;
    let allSymbols: Symbol[*] = [];
    let mutations: Mutation[*] = [];
    let varSyms: Symbol[*] = [];     // reassigned locals with a Var region
    let deferred: Deferred[*] = [];
    /** for (k, v in table.fields): the member being iterated. */
    let anyFieldsLoop: Expr? = null;
    let threadRuns: ThreadRun[*] = [];
    /** The errors, sorted by line, without repeats. */
    let analysisErrors: String[*] = [];
}

/** An analysis that has read nothing: its global frame and scope. */
public function newAnalysis(): Analysis {
    let frame: Frame = Frame { kind: FrameKind.Global } in default;
    let top: Scope = newScope(null, frame);
    return Analysis { globalFrame: frame, scope: top, globalScope: top } in default;
}

/** The Analysis of the compilation being done (pipeline: Compilation). */
public let analysis: Analysis = newAnalysis();

/** Makes `state` the one the compiler works on. */
public function useAnalysis(state: Analysis in default): void { analysis = state; }


public function error(line: int32, msg: String): void {
    analysis.diags.push(Diag { line, msg: "Semantic Error [Line ${line}]: ${msg}" } in default);
}

/** Reports an error where a type is expected: the result is the error type. */
public function wrong(line: int32, msg: String): Type {
    error(line, msg);
    return T_ERROR;
}

/** A symbol for the name after `is`, declared later where the test is true (see narrow). */
public function bindingSymbol(name: String in default, type: Type in default, line: int32, region: Region in default): Symbol {
    let symbol: Symbol = Symbol { name, kind: SymbolKind.Local, type, line, frame: frame(), scope: analysis.scope, id: analysis.symbolIds, cName: "${escapeName(name)}_${analysis.symbolIds}", region } in default;
    analysis.symbolIds += 1;
    analysis.allSymbols.push(symbol);
    symbol.immutable = true;
    symbol.binding = true;
    return symbol;
}

public class HandledSet { let enums: EnumInfo[*] = []; }

public class FrameState {
    let loopDepth: int32 = 0;
    let handled: HandledSet[*] = [];
    let yields: SwitchInfo[*] = [];
    let exprSwitchDepth: int32 = 0;
    let reassigned: Any;
    /** Locals whose value is returned: they are created where the caller says (PlaceK.Result). */
    let returned: Any;
}


public enum MutK { Reassign, Field, Push }

public class Mutation {
    let line: int32;
    let root: Symbol;
    let frame: int32;
    let kind: MutK;
}


public enum DefK { Outlives, ReturnLocal }

public class Deferred {
    let line: int32;
    let kind: DefK;
    let value: Region;
    let storage: Region;
    let msg: String;
    let frame: Frame? = null;
    /** The message when the storage lives forever and the value in a block or a statement. */
    let forever: String = "";
    /** The value checked, to name what lives too little in the message ("" role: stored in `target`). */
    let expr: Expr? = null;
    let target: String = "";
    let role: String = "";              // "", "field <name>", "throw", "return"
}



public class ThreadRun {
    let lambda: LambdaInfo;
    let line: int32;
    let safe: bool = false;          // a lambda given as a `thread safe` function, not the run of a Thread
}


public function frame(): Frame { return analysis.frames[analysis.frameTop - 1]; }
public function state(): FrameState { return analysis.states[analysis.stateTop - 1]; }

// =====================================================================================
// Entry point
// =====================================================================================


public function analyze(program: Program in default): void {
    analysis.frames.push(analysis.globalFrame);
    analysis.frameTop = 1;
    analysis.globalFrame.root = analysis.scope;
    analysis.states.push(FrameState { reassigned: {} in default, returned: {} in default } in default);
    analysis.stateTop = 1;

    collect(program);
    constants(program);
    signatures(program);
    validateClasses();
    validateInterfaces();
    checkSynchronizedClasses();
    flowSummaries();          // before the field defaults: a call there must know if it creates its result
    checkFieldDefaults();

    let initializers: Owner[*] = [] in default;       // what the initial value of each global calls and reads
    for (d in program.decls) {
        if (d is VarDecl v) {
            declared.globals.push(v);
            let o: Owner = newOwner();
            analysis.globalFrame.owner = o;
            analyzeVarDecl(v);
            analysis.globalFrame.owner = null;
            initializers.push(o);
        }
    }
    for (f in declared.functions) {
        if (!f.isExtern && f.sig != null) { analyzeFunction(f); }
    }
    for (s in declared.structs) {
        for (m in s.methods) {
            if (m.sig != null) { analyzeMethod(m, named(s.name, NamedKind.Struct)); }
        }
    }
    for (c in declared.classes) {
        for (m in c.methods) {
            if (m.sig != null && m.decl.hasBody) { analyzeMethod(m, named(c.name, NamedKind.Class)); }
        }
    }
    for (m in declared.nativeMethods) {
        if (m.sig != null && m.decl.hasBody) { analyzeMethod(m, nativeOwner(m.owner)); }
    }

    resolveRegions();
    checkThreads();
    checkGlobalOrder(initializers);
    checkMutations();
    checkMemoryUses();
    checkMain();
    computeTypeOrder();

    // sorted by line (stable), each message once
    let sorted: Diag[*] = [] in default;
    for (d in analysis.diags) {
        let i: int32 = sorted.length;
        sorted.push(d);
        while (i > 0 && sorted[i - 1].line > d.line) {
            sorted[i] = sorted[i - 1];
            i -= 1;
        }
        sorted[i] = d;
    }
    let seen: Any = {} in default;
    for (d in sorted) {
        if (!seen.contains(d.msg)) {
            seen[d.msg] = true;
            analysis.analysisErrors.push(d.msg);
        }
    }
}

// =====================================================================================
// Scopes, frames and symbols
// =====================================================================================

public function pushFrame(kind: FrameKind, ret: Type? in default, throwsType: Type? in default, lambda: LambdaInfo? in default,
                          selfType: Type? in default, parent: Scope in default, owner: Owner? in default): Frame {
    let frameOf: Frame = Frame { kind, owner, returnType: ret, throwsType, lambda, selfType, index: analysis.frameTop } in default;
    if (analysis.frameTop < analysis.frames.length) { analysis.frames[analysis.frameTop] = frameOf; } else { analysis.frames.push(frameOf); }
    analysis.frameTop += 1;
    analysis.scope = newScope(parent, frameOf);
    frameOf.root = analysis.scope;
    let state: FrameState = FrameState { reassigned: {} in default, returned: {} in default } in default;
    if (analysis.stateTop < analysis.states.length) { analysis.states[analysis.stateTop] = state; } else { analysis.states.push(state); }
    analysis.stateTop += 1;
    if (lambda != null) { lambda.frame = frameOf; }
    return frameOf;
}

public function popFrame(restore: Scope in default): void {
    analysis.frameTop -= 1;
    analysis.stateTop -= 1;
    analysis.scope = restore;
}

public function pushScope(): void { analysis.scope = newScope(analysis.scope, frame()); }

public function popScope(): void { analysis.scope = analysis.scope.parent!; }

/** The block the current statement is in (names are declared there, not in the statement). */
public function block(): Scope { return analysis.scope.statement ? analysis.scope.parent! : analysis.scope; }

public function declare(name: String in default, kind: SymbolKind, type: Type in default, line: int32): Symbol {
    let target: Scope = block();
    let symbol: Symbol = Symbol { name, kind, type, line, frame: frame(), scope: target, id: analysis.symbolIds, cName: escapeName(name), region: R_STATIC } in default;
    analysis.symbolIds += 1;
    analysis.allSymbols.push(symbol);
    let ei: int32 = target.names[name] as int32 ?? -1;
    if (ei >= 0) {
        let existing: Symbol = analysis.allSymbols[ei];
        let what: String = existing.kind == SymbolKind.Function ? "as a function" : "in this scope";
        error(line, "'${name}' is already declared ${what} (line ${existing.line}).");
        return symbol;
    }
    if (kind != SymbolKind.Function && lookup(name) != null) { symbol.cName = "${escapeName(name)}_${symbol.id}"; }
    if ((structOf(name) != null || classOf(name) != null || enumOf(name) != null || interfaceOf(name) != null || isExternTypeName(name))
        && kind != SymbolKind.Function) {
        symbol.cName = "${escapeName(name)}_v${symbol.id}";
    }
    target.names[name] = analysis.allSymbols.length - 1;
    return symbol;
}

public function lookup(name: String): Symbol? {
    let c: Scope? = analysis.scope;
    while (c != null) {
        let i: int32 = c.names[name] as int32 ?? -1;
        if (i >= 0) { return analysis.allSymbols[i]; }
        c = c.parent;
    }
    return null;
}

public function narrowedType(symbol: Symbol): Type? {
    let c: Scope? = analysis.scope;
    while (c != null) {
        for (i, ns in c.narrowSyms) {
            if (ns == symbol) { return c.narrowTypes[i]; }
        }
        if (c == symbol.scope) { break; }
        c = c.parent;
    }
    return null;
}

/** Records that the current lambda (and every lambda in between) captures `s`. */
public function noteCapture(symbol: Symbol in default, line: int32): void {
    let cur: int32 = analysis.frameTop - 1;
    let capturable: bool = symbol.kind == SymbolKind.Local || symbol.kind == SymbolKind.Param || symbol.kind == SymbolKind.Self;
    if (!capturable || symbol.frame.index >= cur) { return; }
    if (isMemory(symbol)) {
        error(line, "Lambdas can only use global memories or memories created inside them ('${symbol.name}' belongs to the enclosing function).");
        return;
    }
    if (symbol.kind == SymbolKind.Self && isStruct(symbol.type)) {
        error(line, "'self' cannot be used inside a lambda in a struct method: the struct may be copied or disappear. Copy the fields you need into local variables first.");
        return;
    }
    let i: int32 = symbol.frame.index + 1;
    while (i <= cur) {
        let lambdaInfo: LambdaInfo? = analysis.frames[i].lambda;
        if (lambdaInfo != null && !hasSymbol(lambdaInfo.captures, symbol)) { lambdaInfo.captures.push(symbol); }
        i += 1;
    }
    if (symbol.capturedAt < 0) {
        let first: LambdaInfo? = analysis.frames[symbol.frame.index + 1].lambda;
        symbol.capturedAt = first != null ? first.node.line : line;
    }
}

// =====================================================================================
// Final passes
// =====================================================================================

function checkMutations(): void {
    for (m in analysis.mutations) {
        let symbol: Symbol = m.root;
        if (m.frame > symbol.frame.index) {
            let verb: String = m.kind == MutK.Reassign ? "reassign" : "modify";
            error(m.line, "Cannot ${verb} outer variable '${symbol.name}' (declared at line ${symbol.line}) inside a lambda body. Captured variables are immutable.");
        } else if (symbol.capturedAt >= 0) {
            let what: String = m.kind == MutK.Reassign ? "reassigned" : "modified";
            error(m.line, "Variable '${symbol.name}' (declared at line ${symbol.line}) is captured by the lambda at line ${symbol.capturedAt} and cannot be ${what}.");
        }
    }
}

function checkMemoryUses(): void {
    for (s in analysis.allSymbols) {
        if (isMemory(s) && s.dataUseLine >= 0) { error(s.dataUseLine, "'${s.name}' is used as a memory, so it cannot also be used as plain bytes."); }
    }
}
