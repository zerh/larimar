// semantics.analyzer.order: orders that must exist: globals get their values in order, C structs are defined before they are embedded.

import semantics.types {
    ArrayKind, ClassInfo, classOf, cTypeOf, declared, enumOf, hasThreadSafe, isArray, isError, named,
    NamedKind, optIsPointer, Owner, structOf, Symbol, Type, TypeKind
};
import semantics.analyzer { error };
import semantics.analyzer.threads { markRound };

/**
 * The initial value of a global, and every function it calls however deep, cannot use a global that is
 * initialized after it (or itself): it would find it without its value.
 */
public function checkGlobalOrder(initializers: Owner[*] in default): void {
    for (k, v in declared.globals) {
        markRound += 1;
        let todo: Owner[*] = [initializers[k]] in default;
        let found: bool = false;
        let i: int32 = 0;
        while (i < todo.length && !found) {
            let o: Owner = todo[i];
            i += 1;
            if (o.mark == markRound) { continue; }
            o.mark = markRound;
            for (u, g in o.uses) {
                if (found || !initializedFrom(g, k)) { continue; }
                found = true;
                let same: bool = v.symbol != null && v.symbol! == g;
                error(v.line, same
                    ? "The initial value of '${v.name}' calls code that uses '${v.name}' itself (line ${o.useLines[u]}), before it has a value."
                    : "The initial value of '${v.name}' calls code that uses global '${g.name}' (line ${o.useLines[u]}), which gets its value later. Declare '${g.name}' before '${v.name}', or give '${v.name}' its value in main.");
            }
            for (e in o.edges) { todo.push(e); }
        }
    }
}

/** Whether global `g` is the k-th one or one initialized after it. */
function initializedFrom(g: Symbol in default, k: int32): bool {
    let j: int32 = k;
    while (j < declared.globals.length) {
        let s: Symbol? = declared.globals[j].symbol;
        if (s != null && s! == g) { return true; }
        j += 1;
    }
    return false;
}

// =====================================================================================
// C structs must be defined before they are embedded by value; that order must exist.
// =====================================================================================

public function computeTypeOrder(): void {
    let nodes: Type[*] = [] in default;
    for (s in declared.structs) { nodes.push(named(s.name, NamedKind.Struct)); }
    for (e in declared.enums) { nodes.push(named(e.name, NamedKind.Enum)); }
    for (c in declared.classes) { nodes.push(named(c.name, NamedKind.Class)); }
    for (i in declared.interfaces) { nodes.push(named(i.name, NamedKind.Interface)); }
    let snapshot: Type[*] = [] in default;
    for (t in declared.usedTypes) { snapshot.push(t); }
    for (t in snapshot) {
        if (t.kind == TypeKind.Func || t.kind == TypeKind.Array || t.kind == TypeKind.Opt) { nodes.push(t); }
    }
    let path: Type[*] = [] in default;
    for (t in nodes) { visitType(t, path); }
}

function visitType(type: Type in default, path: Type[*] in default): void {
    if (hasThreadSafe(type)) {                     // C uses the type without `thread safe`
        visitType(cTypeOf(type), path);
        return;
    }
    if (type.order == 2) { return; }
    if (type.order == 1) {
        let cycle: StringBuilder = {} in default;
        let on: bool = false;
        for (n in path) {
            if (n == type) { on = true; }
            if (on) { cycle.add("${display(n)} -> "); }
        }
        cycle.add(display(type));
        error(typeLine(type), "Type cycle detected: ${cycle.toString()}. A value cannot contain itself; use a class (a reference) or an optional class field.");
        return;
    }
    type.order = 1;
    path.push(type);
    for (d in valueDeps(type)) { visitType(d, path); }
    path.pop();
    type.order = 2;
    declared.typeOrder.push(type);
}

function display(type: Type): String { return type.kind == TypeKind.Func ? "closure ${type.text}" : type.text; }

function typeLine(t: Type): int32 {
    if (t.kind == TypeKind.Named) {
        if (t.namedKind == NamedKind.Struct) { return structOf(t.name)!.line; }
        if (t.namedKind == NamedKind.Class) { return classOf(t.name)!.line; }
        return t.namedKind == NamedKind.Enum ? enumOf(t.name)!.line : 0;
    }
    if (t.kind == TypeKind.Func) {
        for (l in declared.lambdaList) {
            if (l.type == t && l.captures.length > 0) { return l.node.line; }
        }
    }
    return 0;
}

/** Types that t's C definition embeds by value. */
function valueDeps(t: Type in default): Type[*] {
    let out: Type[*] = [] in default;
    if (t.kind == TypeKind.Named) {
        if (t.namedKind == NamedKind.Struct) {
            for (f in structOf(t.name)!.fields) { addValueDep(out, f.type); }
        } else if (t.namedKind == NamedKind.Enum) {
            for (v in enumOf(t.name)!.variants) {
                for (f in v.fields) { addValueDep(out, f.type); }
            }
        } else if (t.namedKind == NamedKind.Class) {
            let classInfo: ClassInfo = classOf(t.name)!;
            if (classInfo.valid && classInfo.superName != "") { out.push(named(classInfo.superName, NamedKind.Class)); }
            for (f in classInfo.fields) { addValueDep(out, f.type); }
        }
    } else if (t.kind == TypeKind.Array) {
        if (t.arrayKind == ArrayKind.Fixed) { addValueDep(out, t.elem!); }
    } else if (t.kind == TypeKind.Opt) {
        if (!optIsPointer(t)) { addValueDep(out, t.elem!); }
    } else if (t.kind == TypeKind.Func) {
        for (l in declared.lambdaList) {
            if (l.type == t) {
                for (s in l.captures) { addValueDep(out, s.type); }
            }
        }
    }
    return out;
}

function addValueDep(out: Type[*] in default, type: Type in default): void {
    if (isError(type) || type.kind == TypeKind.Prim || type.kind == TypeKind.Ptr) { return; }                   // T*: a C pointer
    if (type.kind == TypeKind.Named && (type.namedKind == NamedKind.Class || type.namedKind == NamedKind.Extern)) { return; }    // pointers
    if (isArray(type, ArrayKind.Growable)) { return; }                                                // pointer
    if (type.kind == TypeKind.Opt && optIsPointer(type)) { return; }
    out.push(type);
}
