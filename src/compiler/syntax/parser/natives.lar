// syntax.parser.natives: what comes from C (native functions, types, structs and values; cinclude and ccode).
// Each function reads one construction; the comment above it shows its form (the notation is in syntax.parser).

import syntax.ast {
    BlockStmt, Call, CIncludeDecl, Expr, ExprStmt, ExternFunctionDecl, ExternTypeDecl, ExternValueDecl, FieldDecl, FunctionDecl,
    Ident, NativeInterfaceDecl, NativeTypeDecl, Node, Param, ReturnStmt, SelfExpr, StructDecl, TypeRefKind, typeNamed
};
import syntax.lexer { Token, TokenType };
import syntax.parser { endedBySemicolon, lives, Parser, qualifiedName };
import syntax.parser.declarations { cBodied, functionDeclaration, parameter, parameters, staticFunction };
import syntax.parser.expressions { expression };
import syntax.parser.types { type };

/**
 * (after `native`)
 *   function NAME ( [ parameter ( , parameter )* [ , ... ] ] ) [ : Type ] [ = C ] [ released by NAME ] ;  a C function
 *   const NAME : Type [ = C ] ;      let NAME : Type [ = NAME ] ;                        a C constant, macro or global
 *   struct NAME [ = C ] { ( let NAME : Type [ = NAME ] ; | function ... | static ... )* }  a C struct, by value
 *   type NAME [ = CTYPE | = ( Type, ... ) -> Type ] [ released by NAME ] ( ; | { member* } )   a C type
 *   type NAME { ... }                                                                   (std) a type the compiler knows
 */
public function nativeDeclaration(parser: Parser in default, line: int32): Node {
    if (parser.optional(TokenType.Interface)) { return nativeInterface(parser, ""); }
    if (parser.optional(TokenType.Function)) { return nativeFunctionOfC(parser); }
    if (parser.at(TokenType.Const) || parser.at(TokenType.Let)) { return nativeValue(parser); }
    if (parser.optional(TokenType.Struct)) { return nativeStruct(parser); }
    if (!parser.atWord("type")) {
        parser.error(parser.current().line, "Expected 'function', 'type', 'struct', 'const' or 'let' after 'native' (got '${parser.current().text}')");
        return BlockStmt { line } in default;
    }
    parser.advance();
    let name: Token = parser.expect(TokenType.Ident, "Expected the type's name after 'native type'");
    if (parser.at(TokenType.LBrace)) { return nativeType(parser, line, name); }
    return nativeCType(parser, name);
}

/**
 * (after `native interface`) NAME STRING ( , STRING )* [ extends NAME ( , NAME )* ]
 *     { ( function ... ; | type NAME ... ; | const ... ; | let ... ; | struct ... )* }
 * What C headers give, under one name: Name.f(...) calls the C function f. In a class (`owner`) it is its
 * own, static: only on the class's system.
 */
public function nativeInterface(parser: Parser in default, owner: String in default): NativeInterfaceDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected the name of the native interface");
    let declaration: NativeInterfaceDecl = NativeInterfaceDecl { line: name.line, name: name.text, owner } in default;
    if (parser.at(TokenType.Str)) {
        declaration.headers.push(parser.advance().text);
        while (parser.optional(TokenType.Comma)) { declaration.headers.push(parser.expect(TokenType.Str, "Expected another header after ','").text); }
    }
    if (parser.optional(TokenType.Extends)) {
        while (true) {
            declaration.parents.push(qualifiedName(parser, "Expected the name of the native interface it extends"));
            if (!parser.optional(TokenType.Comma)) { break; }
        }
    }
    if (declaration.headers.length == 0 && declaration.parents.length == 0) {
        parser.error(name.line, "A native interface says its header: native interface ${name.text} \"<header.h>\" { ... }");
    }
    let gives: String[*] = [] in default;
    let types: ExternTypeDecl[*] = [] in default;
    let functions: ExternFunctionDecl[*] = [] in default;
    parser.expect(TokenType.LBrace, "Expected '{' with what the header gives");
    while (!parser.at(TokenType.RBrace) && !parser.atEnd() && !parser.hasFailed()) {
        if (parser.optional(TokenType.Function)) {
            let f: ExternFunctionDecl = nativeFunctionOfC(parser);
            if (f.cBody == "") { gives.push(f.cName); }
            declaration.members.push(f.name);
            f.name = "${name.text}__${f.name}" in default;
            f.owner = owner;
            functions.push(f);
            parser.nativeParts.push(f);
        } else if (parser.at(TokenType.Const) || parser.at(TokenType.Let)) {
            let n: Node = nativeValue(parser);
            if (n is ExternValueDecl v) {
                if (v.cExpr == "") { gives.push(v.cName); } else { cNames(v.cExpr, gives); }
                declaration.members.push(v.name);
                v.name = "${name.text}__${v.name}" in default;
                parser.nativeParts.push(v);
            }
        } else if (parser.optional(TokenType.Struct)) {
            let st: StructDecl = nativeStruct(parser);
            cNames(st.cName, gives);
            declaration.types.push(st.name);
            parser.nativeParts.push(st);
        } else if (parser.atWord("type")) {
            parser.advance();
            let typeName: Token = parser.expect(TokenType.Ident, "Expected the type's name after 'type'");
            let n: Node = nativeCType(parser, typeName);
            if (n is ExternTypeDecl t) {
                if (t.cType == "") { t.cType = "${typeName.text}*" in default; }       // type FILE: a FILE* of C
                cNames(t.cType, gives);
                types.push(t);
                declaration.types.push(t.name);
            }
            parser.nativeParts.push(n);
        } else {
            parser.error(parser.current().line, "A native interface has what its header gives: function, type, const, let or struct (got '${parser.current().text}')");
            parser.advance();
        }
    }
    parser.expect(TokenType.RBrace, "Expected '}' to close the native interface");
    parser.optional(TokenType.Semi);
    for (t in types) {                          // released by fclose: its own fclose
        if (declaration.members.contains(t.releasedBy)) { t.releasedBy = "${name.text}__${t.releasedBy}" in default; }
    }
    for (f in functions) {
        if (declaration.members.contains(f.releasedBy)) { f.releasedBy = "${name.text}__${f.releasedBy}" in default; }
    }
    for (h in declaration.headers) {
        parser.nativeParts.push(CIncludeDecl { line: name.line, header: h, owner, gives: gives.join(" ") in default } in default);
    }
    return declaration;
}

/** The C names in C text (struct tm*: struct, tm), added to `into`. */
function cNames(text: String, into: String[*] in default): void {
    let word: byte[*] = [];
    for (b in "${text} ") {
        if (b == '_' || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') && word.length > 0) {
            word.push(b);
        } else if (word.length > 0) {
            let w: String = stringOfRange(word, 0, word.length);
            if (w != "struct" && w != "const" && w != "unsigned") { into.push(w.clone() in default); }
            word.clear();
        }
    }
}

/** At C text: c"...". */
function atCText(parser: Parser in default): bool { return parser.at(TokenType.CText); }

/** [ = NAME | = struct NAME | = c"C" ]: what a native declaration is in C; "" without '='. */
function cTarget(parser: Parser in default, what: String): String {
    if (!parser.optional(TokenType.Assign)) { return ""; }
    if (atCText(parser)) {
        let text: Token = parser.advance();
        if (text.text.trim() == "") { parser.error(text.line, "The C of ${what} is empty"); }
        return text.text;
    }
    if (parser.optional(TokenType.Struct)) {                  // = struct addrinfo: a C struct known by its tag
        return "struct ${parser.expect(TokenType.Ident, "Expected the name of the C struct after 'struct' in ${what}").text}" in default;
    }
    return parser.expect(TokenType.Ident, "Expected the C name, 'struct' and its name, or c\"C text\", after '=' in ${what}").text;
}

/** (after `native function`) NAME ( [ parameter ( , parameter )* [ , ... ] ] ) [ : Type ] [ = C ] [ released by NAME ] ; */
function nativeFunctionOfC(parser: Parser in default): ExternFunctionDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected function name");
    let declaration: ExternFunctionDecl = ExternFunctionDecl { line: name.line, name: name.text, cName: name.text, ret: typeNamed("void", name.line) } in default;
    parser.expect(TokenType.LParen, "Expected '(' after function name");
    if (!parser.at(TokenType.RParen)) {
        while (true) {
            if (parser.optional(TokenType.Ellipsis)) {
                declaration.varargs = true;
                break;
            }
            declaration.params.push(parameter(parser, true));
            if (!parser.optional(TokenType.Comma)) { break; }
        }
    }
    parser.expect(TokenType.RParen, declaration.varargs ? "'...' must be the last parameter" : "Expected ')' after parameters");
    if (parser.optional(TokenType.Colon)) { declaration.ret = type(parser); }
    if (parser.at(TokenType.Assign) && !(parser.next().kind == TokenType.Ident || parser.next().kind == TokenType.Str || parser.next().kind == TokenType.CText)) {
        parser.error(parser.current().line, "A native function of a module names its C function (= c_name;); to write it in Larimar, write a plain function");
    }
    let target: String = cTarget(parser, "native function '${name.text}'");
    if (target != "") { declaration.cName = target; }
    if (parser.atWord("released")) {                // a text C makes: copied into the memory of the call, then released
        parser.advance();
        let by: Token = parser.expect(TokenType.Ident, "Expected 'by' and the function that releases the text: released by free");
        if (by.text != "by") { parser.error(by.line, "Expected 'by' after 'released': released by free"); }
        declaration.releasedBy = parser.expect(TokenType.Ident, "Expected the function that releases the result of '${name.text}' after 'released by'").text;
    }
    if (parser.at(TokenType.CCode)) {                         // native function f(...): T { C }: the compiler writes it
        if (target != "") { parser.error(name.line, "A native function names its C function (= c_name;) or has a body of C, not both"); }
        declaration.cBody = parser.advance().text;
        declaration.cName = "lar_${name.text}";
        return declaration;
    }
    parser.expect(TokenType.Semi, "Expected ';' after native function (or its body of C: native function f(): T { ... })");
    return declaration;
}

/** (after `native`) ( const NAME : Type [ = C ] | let NAME : Type [ = NAME ] ) ; */
function nativeValue(parser: Parser in default): Node {
    let isConst: bool = parser.advance().kind == TokenType.Const;
    let what: String = isConst ? "native const" : "native let";
    let name: Token = parser.expect(TokenType.Ident, "Expected a name after '${what}'");
    parser.expect(TokenType.Colon, "Expected ':' and a type after '${name.text}'");
    let declaration: ExternValueDecl = ExternValueDecl { line: name.line, name: name.text, type: type(parser), isConst, cName: name.text } in default;
    if (parser.optional(TokenType.Assign)) {
        if (atCText(parser)) {                   // what C writes for it: sizeof, a cast, a macro with arguments
            if (!isConst) { parser.error(parser.current().line, "A native let is a C variable: give its C name (= c_name), not C text"); }
            declaration.cExpr = parser.advance().text;
            if (declaration.cExpr.trim() == "") { parser.error(name.line, "The C of '${name.text}' is empty"); }
        } else {
            declaration.cName = parser.expect(TokenType.Ident, "Expected the C name, or c\"C text\", after '='").text;
        }
    }
    return endedBySemicolon(parser, declaration, what);
}

/** (after `native struct`) NAME [ = C ] { ( let NAME : Type [ = NAME ] ; | function ... | static ... )* } */
function nativeStruct(parser: Parser in default): StructDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected the struct's name after 'native struct'");
    let declaration: StructDecl = StructDecl { line: name.line, name: name.text, cName: name.text } in default;
    let target: String = cTarget(parser, "native struct '${name.text}'");
    if (target != "") { declaration.cName = target; }
    parser.expect(TokenType.LBrace, "Expected '{' with the fields of the C struct");
    while (!parser.at(TokenType.RBrace) && !parser.atEnd() && !parser.hasFailed()) {
        if (parser.at(TokenType.Let)) {
            declaration.fields.push(cField(parser));
        } else if (parser.at(TokenType.Function)) {
            declaration.methods.push(functionDeclaration(parser, false, true));
        } else if (parser.optional(TokenType.Static)) {
            staticFunction(parser, declaration.name);
        } else {
            parser.error(parser.current().line, "A native struct has its C fields (let name: Type;) and Larimar functions (got '${parser.current().text}')");
        }
    }
    parser.expect(TokenType.RBrace, "Expected '}' to close the native struct");
    parser.optional(TokenType.Semi);
    return declaration;
}

/** let NAME : Type [ = NAME ] ;      a field of a C struct (after '=': its name in C) */
function cField(parser: Parser in default): FieldDecl {
    parser.expect(TokenType.Let, "Expected 'let'");
    let name: Token = parser.expect(TokenType.Ident, "Expected field name");
    parser.expect(TokenType.Colon, "Expected ':' and a type after field '${name.text}'");
    let declaration: FieldDecl = FieldDecl { line: name.line, name: name.text, type: type(parser) } in default;
    if (parser.optional(TokenType.Assign)) {
        declaration.cName = parser.expect(TokenType.Ident, "A field of C has no default value: after '=' goes its name in C (let size: int64 = st_size;)").text;
    }
    parser.expect(TokenType.Semi, "Expected ';' after field declaration");
    return declaration;
}

/**
 * (after `native type NAME`) [ = CTYPE ] [ released by NAME ] ( ; | { member* } )
 *     CTYPE: [ struct ] NAME *...  or c"C TYPE";  without '=' it is opaque (void*)
 */
function nativeCType(parser: Parser in default, name: Token in default): Node {
    let declaration: ExternTypeDecl = ExternTypeDecl { line: name.line, name: name.text } in default;
    if (parser.optional(TokenType.Assign)) {
        if (atCText(parser)) {
            declaration.cType = parser.advance().text;
            if (declaration.cType.trim() == "") { parser.error(name.line, "The C type of '${name.text}' is empty"); }
        } else {
            let tagged: String = parser.optional(TokenType.Struct) ? "struct " : "";             // = struct tm*
            let cType: String = "${tagged}${parser.expect(TokenType.Ident, "Expected the C type after 'native type ${name.text} =': a name (FILE*, struct tm*) or c\"C text\"").text}";
            while (parser.optional(TokenType.Star)) { cType = "${cType}*"; }
            declaration.cType = cType.clone() in default;
        }
    }
    if (parser.atWord("released")) {
        parser.advance();
        let by: Token = parser.expect(TokenType.Ident, "Expected 'by' and the function that releases it: released by close");
        if (by.text != "by") { parser.error(by.line, "Expected 'by' after 'released': released by close"); }
        declaration.releasedBy = parser.expect(TokenType.Ident, "Expected the function that releases '${declaration.name}' after 'released by'").text;
    } else if (parser.atWord("released_by")) {
        parser.error(parser.current().line, "Write 'released by' (two words): released by close");
    }
    if (parser.at(TokenType.LBrace)) {
        nativeMembers(parser, declaration);
        parser.optional(TokenType.Semi);
        return declaration;
    }
    return endedBySemicolon(parser, declaration, "native type");
}

/**
 * { ( let NAME : Type [ = NAME ] ; | native function ... | native let ... | function ... | static ... )* }
 * The members of a C type: its fields (when it is a pointer to a C struct), functions of C that take it
 * first (self), and functions written in Larimar.
 */
function nativeMembers(parser: Parser in default, declaration: ExternTypeDecl in default): void {
    parser.expect(TokenType.LBrace, "Expected '{'");
    let methods: NativeTypeDecl = NativeTypeDecl { line: declaration.line, name: declaration.name } in default;
    let fields: StructDecl = StructDecl { line: declaration.line, name: "${declaration.name}__fields" in default } in default;
    while (!parser.at(TokenType.RBrace) && !parser.atEnd() && !parser.hasFailed()) {
        if (parser.at(TokenType.Let)) {
            fields.fields.push(cField(parser));
        } else if (parser.optional(TokenType.Native)) {
            let start: int32 = parser.previous().line;
            if (parser.optional(TokenType.Function)) {
                methods.methods.push(nativeMember(parser, declaration.name, start, false, false));
            } else if (parser.optional(TokenType.Let)) {
                methods.methods.push(nativeMember(parser, declaration.name, start, true, false));
            } else {
                parser.error(parser.current().line, "Expected 'function' or 'let' after 'native'");
            }
        } else if (parser.optional(TokenType.Static)) {
            if (parser.optional(TokenType.Native)) {
                let start: int32 = parser.previous().line;
                parser.expect(TokenType.Function, "Expected 'function' after 'static native'");
                parser.staticFunctions.push(nativeMember(parser, declaration.name, start, false, true));
            } else {
                let f: FunctionDecl = functionDeclaration(parser, false, true);
                f.typeName = declaration.name;
                f.isStatic = true;
                parser.staticFunctions.push(f);
            }
        } else if (parser.at(TokenType.Function)) {
            methods.methods.push(functionDeclaration(parser, false, true));
        } else {
            parser.error(parser.current().line, "Inside a native type go its C fields (let), native functions and functions (got '${parser.current().text}')");
        }
    }
    parser.expect(TokenType.RBrace, "Expected '}' to close the native type");
    if (fields.fields.length > 0) {
        let c: String = declaration.cType.trim();
        if (!c.endsWith("*")) {
            parser.error(fields.fields[0].line, "The fields of '${declaration.name}' are reached through its pointer: its C type must be a pointer to the struct (native type ${declaration.name} = c_struct*)");
        }
        fields.cName = c.substring(0, c.length - 1).trim().clone() in default;
        declaration.fieldsStruct = fields.name;
        parser.nativeParts.push(fields);
    }
    if (methods.methods.length > 0) { parser.nativeParts.push(methods); }
}

/**
 * (after `native function` or `native let`, in a native type)
 *   NAME parameters [ : Type ] [ in lives ] [ throws Type ] = ( C | expression ) ;      (let: NAME : Type = ...)
 * With `= C` (a name, or "C text"), the method calls that C function with self first: before it only the
 * memory of the call, when the first parameter is one (m: byte[*]). Any other expression is Larimar.
 */
function nativeMember(p: Parser in default, owner: String in default, line: int32, property: bool, isStatic: bool): FunctionDecl {
    let name: Token = p.expect(TokenType.Ident, "Expected a name");
    let declaration: FunctionDecl = FunctionDecl { line, name: name.text, ret: typeNamed("void", name.line), isProperty: property } in default;
    if (property) {
        p.expect(TokenType.Colon, "Expected ':' and the type after 'native let ${name.text}'");
        declaration.ret = type(p);
    } else {
        declaration.params = parameters(p);
        if (p.optional(TokenType.Colon)) { declaration.ret = type(p); }
        if (p.optional(TokenType.In)) { declaration.returnLives = lives(p); }
        if (p.optional(TokenType.Throws)) { declaration.throwsType = type(p); }
    }
    p.expect(TokenType.Assign, "Expected '=' and its C function (= c_name;) or a Larimar expression");
    let value: Expr? = null;
    if ((p.at(TokenType.Ident) || p.at(TokenType.CText)) && (p.next().kind == TokenType.Semi || p.next().kind == TokenType.Ident && p.next().text == "released")) {
        let c: Token = p.advance();
        let cFunction: ExternFunctionDecl = ExternFunctionDecl {
            line: c.line, name: "${owner}__${name.text}" in default, cName: c.text, ret: declaration.ret.clone() in default
        } in default;
        if (p.atWord("released")) {            // = c_f released by r: the text C makes is copied, then released
            p.advance();
            let by: Token = p.expect(TokenType.Ident, "Expected 'by' and the function that releases the text: released by free");
            if (by.text != "by") { p.error(by.line, "Expected 'by' after 'released': released by free"); }
            cFunction.releasedBy = p.expect(TokenType.Ident, "Expected the function that releases the result of '${name.text}' after 'released by'").text;
        }
        let args: Expr[*] = [] in default;
        let kept: Param[*] = [] in default;
        for (i, p in declaration.params) {
            let memory: bool = i == 0 && p.type != null && p.type!.kind == TypeRefKind.Growable && p.type!.inner!.kind == TypeRefKind.Named && p.type!.inner!.name == "byte";
            if (memory) {
                cFunction.params.push(p.clone() in default);     // the memory of the call: before self, and not written in calls
            } else {
                kept.push(p);
            }
        }
        if (!isStatic) {
            cFunction.params.push(Param { line: c.line, name: "receiver", type: typeNamed(owner, c.line) } in default);
            args.push(SelfExpr { line: c.line } in default);
        }
        for (p in kept) {
            cFunction.params.push(p.clone() in default);
            args.push(Ident { line: c.line, name: p.name } in default);
        }
        declaration.params = kept;
        p.nativeParts.push(cFunction);
        value = Call { line: c.line, callee: Ident { line: c.line, name: cFunction.name } in default, args } in default;
    } else {
        value = expression(p);
    }
    if (declaration.ret.kind == TypeRefKind.Named && declaration.ret.name == "void") {
        declaration.body.push(ExprStmt { line, expr: value! } in default);
    } else {
        declaration.body.push(ReturnStmt { line, value: value! } in default);
    }
    declaration.hasBody = true;
    if (isStatic) {
        declaration.typeName = owner;
        declaration.isStatic = true;
    }
    p.expect(TokenType.Semi, property ? "Expected ';' after native let" : "Expected ';' after native function");
    return declaration;
}

/**
 * (after `type`) NAME { ( static ... | let NAME : Type [ = expression ] ; | operator ... ; | function ... ( ; | block ) )* }
 * A type of the language (String, Any), in std.lang: what has no body the compiler writes.
 */
public function languageType(parser: Parser in default, line: int32): NativeTypeDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected the type's name after 'type'");
    let declaration: NativeTypeDecl = nativeType(parser, line, name);
    declaration.language = true;
    return declaration;
}

/**
 * (after `native type NAME`) { ( static ... | native function ... | native let ... | native operator ... | function ... )* }
 * The methods of a type the compiler knows (String, Any): only in the standard library.
 */
function nativeType(parser: Parser in default, line: int32, name: Token in default): NativeTypeDecl {
    let declaration: NativeTypeDecl = NativeTypeDecl { line, name: name.text } in default;
    parser.expect(TokenType.LBrace, "Expected '{' to open native type body");
    while (!parser.at(TokenType.RBrace) && !parser.atEnd()) {
        if (parser.at(TokenType.Let)) {
            parser.advance();
            declaration.methods.push(nativeProperty(parser, parser.previous().line));
        } else if (parser.optional(TokenType.Operator)) {
            declaration.methods.push(nativeOperator(parser, parser.previous().line));
        } else if (parser.optional(TokenType.Static)) {
            staticFunction(parser, declaration.name);
        } else if (parser.optional(TokenType.Native)) {
            if (parser.optional(TokenType.Function)) {
                declaration.methods.push(nativeFunction(parser, parser.previous().line));
            } else if (parser.optional(TokenType.Operator)) {
                declaration.methods.push(nativeOperator(parser, parser.previous().line));
            } else if (parser.optional(TokenType.Let)) {
                declaration.methods.push(nativeProperty(parser, parser.previous().line));
            } else {
                parser.error(parser.current().line, "Expected 'function', 'let' or 'operator' after 'native'");
            }
        } else if (parser.at(TokenType.Function)) {
            declaration.methods.push(functionDeclaration(parser, false, true));
        } else {
            parser.error(parser.current().line, "Expected 'native function', 'native operator' or 'function' inside native type");
        }
    }
    parser.expect(TokenType.RBrace, "Expected '}' to close native type body");
    parser.optional(TokenType.Semi);
    return declaration;
}

/** (after `native function`) NAME parameters [ : Type ] [ in lives ] [ throws Type ] [ = expression ] ; */
public function nativeFunction(parser: Parser in default, line: int32): FunctionDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected function name");
    let declaration: FunctionDecl = FunctionDecl { line, name: name.text, ret: typeNamed("void", name.line) } in default;
    declaration.params = parameters(parser);
    if (parser.optional(TokenType.Colon)) { declaration.ret = type(parser); }
    if (parser.optional(TokenType.In)) { declaration.returnLives = lives(parser); }
    if (parser.optional(TokenType.Throws)) { declaration.throwsType = type(parser); }
    if (parser.at(TokenType.CCode)) {                         // native function f(...): T { C }
        cBodied(parser, declaration);
        return declaration;
    }
    if (parser.optional(TokenType.Assign)) {
        let value: Expr = expression(parser);
        if (declaration.ret.kind == TypeRefKind.Named && declaration.ret.name == "void") {
            declaration.body.push(ExprStmt { line, expr: value } in default);
        } else {
            declaration.body.push(ReturnStmt { line, value } in default);
        }
        declaration.hasBody = true;
    }
    parser.expect(TokenType.Semi, "Expected ';' after native function");
    return declaration;
}

/**
 * (after `native let`) NAME : Type [ = expression ] ;
 *
 * A value read without parentheses and never assigned (s.length). Without `= expression` the compiler
 * gives it; with it, it is that expression.
 */
public function nativeProperty(parser: Parser in default, line: int32): FunctionDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected a name after 'native let'");
    parser.expect(TokenType.Colon, "Expected ':' and the type after 'native let ${name.text}'");
    let declaration: FunctionDecl = FunctionDecl { line, name: name.text, ret: type(parser), isProperty: true } in default;
    if (parser.optional(TokenType.Assign)) {
        declaration.body.push(ReturnStmt { line, value: expression(parser) } in default);
        declaration.hasBody = true;
    }
    parser.expect(TokenType.Semi, "Expected ';' after native let");
    return declaration;
}

/** (after `native operator`) ( [ ] | SYMBOL ) parameters : Type ; */
function nativeOperator(parser: Parser in default, line: int32): FunctionDecl {
    let name: String = "";
    if (parser.optional(TokenType.LBracket)) {
        parser.expect(TokenType.RBracket, "Expected ']' after '[' in native operator");
        name = "[]";
    } else {
        name = parser.advance().text;
    }
    let declaration: FunctionDecl = FunctionDecl { line, name, isOperator: true, params: parameters(parser), ret: typeNamed("void", line) } in default;
    parser.expect(TokenType.Colon, "Native operators must declare their return type");
    declaration.ret = type(parser);
    parser.expect(TokenType.Semi, "Expected ';' after native operator");
    return declaration;
}
