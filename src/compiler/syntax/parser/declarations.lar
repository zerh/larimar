// syntax.parser.declarations: what a file declares (functions, structs, classes, interfaces, enums, constants).
// Each function reads one construction; the comment above it shows its form (the notation is in syntax.parser).

import syntax.ast {
    BlockStmt, Call, CCodeDecl, CIncludeDecl, ClassDecl, ConstDecl, EnumDecl, EnumVariant, ExprStmt,
    ExternFunctionDecl, FieldDecl, FunctionDecl, Ident, InterfaceDecl, Node, Param, ReturnStmt, Stmt, StructDecl,
    TypeRefKind, typeNamed, TypeRef
};
import syntax.lexer { Token, TokenType };
import syntax.parser { endedBySemicolon, lives, looseList, Parser, qualifiedName, strictList };
import syntax.parser.expressions { expression, level, waitFirst };
import syntax.parser.natives { languageType, nativeDeclaration, nativeFunction, nativeInterface, nativeProperty };
import syntax.parser.statements { block, variable };
import syntax.parser.types { type };

/**
 * ccode { C } | ccode "FILE" ; | cinclude "HEADER" ; | native ... | test function ... | const ... |
 * let ... | function ... | struct ... | [synchronized] class ... | interface ... | enum ... | native type ...
 */
public function topLevelDeclaration(parser: Parser in default): Node {
    let start: Token = parser.current();
    if (parser.optional(TokenType.CCode)) { return CCodeDecl { line: start.line, code: parser.previous().text } in default; }
    if (parser.optional(TokenType.CInclude)) {
        let include: CIncludeDecl = CIncludeDecl { line: start.line, header: parser.expect(TokenType.Str, "Expected the header after 'cinclude': cinclude \"<math.h>\";").text } in default;
        return endedBySemicolon(parser, include, "'cinclude'");
    }
    if (parser.atWord("test") && parser.next().kind == TokenType.Function) {
        parser.advance();
        return testFunction(parser);
    }
    if (parser.optional(TokenType.Const)) { return constant(parser); }
    if (parser.at(TokenType.Let)) { return variable(parser); }
    if (parser.at(TokenType.Function)) { return functionDeclaration(parser, false, true); }
    if (parser.optional(TokenType.Struct)) { return structDeclaration(parser); }
    if (parser.optional(TokenType.Class)) { return classDeclaration(parser, false); }
    if (parser.optional(TokenType.Synchronized)) {
        parser.expect(TokenType.Class, "Expected 'class' after 'synchronized'");
        return classDeclaration(parser, true);
    }
    if (parser.optional(TokenType.Interface)) { return interfaceDeclaration(parser); }
    if (parser.optional(TokenType.Enum)) { return enumDeclaration(parser); }
    if (parser.optional(TokenType.Native)) { return nativeDeclaration(parser, start.line); }
    if (parser.atWord("type") && parser.next().kind == TokenType.Ident) {      // type String { ... }: a type of the language (std.lang)
        parser.advance();
        return languageType(parser, start.line);
    }
    if (parser.at(TokenType.Override)) {
        parser.error(start.line, "'override' is only valid inside a class");
        return BlockStmt { line: start.line } in default;
    }
    if (start.kind == TokenType.Ident && (parser.next().kind == TokenType.Assign || parser.next().kind == TokenType.OpAssign)) {
        let op: String = parser.next().kind == TokenType.OpAssign ? "${parser.next().text}=" : "=";
        parser.error(start.line, "'${start.text} ${op} ...' is a statement: at top level only declarations are allowed. Move it into a function (main), or give the value where '${start.text}' is declared: let ${start.text}: T = ...;");
        return BlockStmt { line: start.line } in default;
    }
    if (start.kind == TokenType.Ident && (parser.next().kind == TokenType.LParen || parser.next().kind == TokenType.Dot)) {
        parser.error(start.line, "'${start.text}${parser.next().text}...' is a statement: at top level only declarations are allowed. Move it into a function (main).");
        return BlockStmt { line: start.line } in default;
    }
    parser.error(start.line, "Only declarations (let, const, function, struct, class, interface, enum, native, cinclude, ccode) are allowed at top level (got '${start.text}')");
    return BlockStmt { line: start.line } in default;
}

/** (after `test`) function NAME ( [ NAME : Type ] ) : void block */
function testFunction(parser: Parser in default): FunctionDecl {
    let test: FunctionDecl = functionDeclaration(parser, false, true);
    if (test.typeName != "") {
        parser.error(test.line, "A test function is a plain function, not '${test.typeName}.${test.name}'");
    } else if (test.params.length > 1) {
        parser.error(test.line, "A test function takes nothing, or one setup: test function ${test.name}(s: MySetup)");
    } else if (test.ret.kind != TypeRefKind.Named || test.ret.name != "void") {
        parser.error(test.line, "A test function returns nothing: test function ${test.name}(): void");
    } else if (test.returnLives != "") {
        parser.error(test.line, "A test function returns nothing, so it has no 'in ${test.returnLives}'");
    }
    test.isTest = true;
    return test;
}

/** (after `const`) NAME : Type = expression ; */
function constant(parser: Parser in default): Node {
    let name: Token = parser.expect(TokenType.Ident, "Expected constant name");
    parser.expect(TokenType.Colon, "Expected ':' and a type after constant '${name.text}'");
    let constantType: TypeRef = type(parser);
    parser.expect(TokenType.Assign, "Constants need a value");
    return endedBySemicolon(parser, ConstDecl { line: name.line, name: name.text, type: constantType, value: expression(parser) } in default, "constant");
}

/** NAME : Type [ in lives ]      (in a lambda: NAME [ : Type ]) */
public function parameter(parser: Parser in default, typeRequired: bool): Param {
    let name: Token = parser.expect(TokenType.Ident, "Expected parameter name");
    let parameter: Param = Param { line: name.line, name: name.text } in default;
    if (!typeRequired) {
        if (parser.optional(TokenType.Colon)) { parameter.type = type(parser); }
        return parameter;
    }
    parser.expect(TokenType.Colon, "Expected ':' and a type after parameter '${name.text}'");
    parameter.type = type(parser);
    if (parser.optional(TokenType.In)) { parameter.lives = lives(parser); }
    return parameter;
}

/** ( [ parameter ( , parameter )* ] ) */
public function parameters(parser: Parser in default): Param[*] {
    parser.expect(TokenType.LParen, "Expected '('");
    let list: Param[*] = [] in default;
    strictList(parser, TokenType.RParen, () -> { list.push(parameter(parser, true)); });
    parser.expect(TokenType.RParen, "Expected ')' after parameters");
    return list;
}

public function functionDeclaration(parser: Parser in default, isOverride: bool, withBody: bool): FunctionDecl {
    parser.expect(TokenType.Function, "Expected 'function'");
    let name: Token = parser.expect(TokenType.Ident, "Expected function name");
    let typeName: String = "";
    if (parser.optional(TokenType.Dot)) {                    // function Type.method(): a static function of Type
        typeName = name.text;
        name = parser.expect(TokenType.Ident, "Expected method name after '${typeName}.'");
    }
    let parameterList: Param[*] = parameters(parser);
    let declaration: FunctionDecl = FunctionDecl { line: name.line, name: name.text, isOverride, params: parameterList, ret: typeNamed("void", name.line) } in default;
    if (typeName != "") {
        declaration.typeName = typeName;
        declaration.isStatic = true;
    }
    if (parser.optional(TokenType.Colon)) { declaration.ret = type(parser); }
    if (parser.optional(TokenType.In)) { declaration.returnLives = lives(parser); }
    if (parser.optional(TokenType.Throws)) { declaration.throwsType = type(parser); }
    let waitToken: Token = parser.current();
    if (parser.atWord("wait_until")) {
        parser.error(waitToken.line, "Write 'wait until' (two words): wait until (condition)");
    }
    if (parser.optionalWords("wait", "until")) {
        if (!parser.waitUntilAllowed) { parser.error(waitToken.line, "'wait until' goes on a method of a synchronized class (whoever calls it waits there until the condition holds)"); }
        parser.expect(TokenType.LParen, "Expected '(' and a condition after 'wait until'");
        declaration.waitUntil = expression(parser);
        parser.expect(TokenType.RParen, "Expected ')' after the condition of 'wait until'");
    }
    if (withBody && parser.at(TokenType.CCode)) {
        parser.error(parser.current().line, "A body of C belongs to a native function: native function ${name.text}(...): T { ... }");
        parser.advance();
    } else if (withBody && parser.optional(TokenType.Semi)) {
        declaration.hasBody = false;            // the compiler writes it (only in std.lang; the linker checks)
    } else if (withBody) {
        declaration.body = block(parser, "body of '${name.text}'");
        declaration.hasBody = true;
        if (declaration.waitUntil != null) { declaration.body = waitFirst(waitToken.line, declaration.waitUntil!, declaration.body); }
    } else {
        if (parser.at(TokenType.LBrace)) { parser.error(parser.current().line, "An interface has signatures: only its static functions have a body (static function ${name.text}(...) { ... })"); }
        parser.expect(TokenType.Semi, "Expected ';' after the method signature");
    }
    return declaration;
}

/** operator ( + | - | * | / | % | == | < ) parameters : Type block */
function operatorDeclaration(parser: Parser in default): FunctionDecl {
    let keyword: Token = parser.expect(TokenType.Operator, "Expected 'operator'");
    let symbol: Token = parser.advance();
    let kind: TokenType = symbol.kind;
    if (!(kind == TokenType.Plus || kind == TokenType.Minus || kind == TokenType.Star || kind == TokenType.Slash || kind == TokenType.Percent || kind == TokenType.Eq || kind == TokenType.Lt)) {
        parser.error(symbol.line, "Operator '${symbol.text}' cannot be overloaded (allowed: + - * / % == <)");
    }
    let parameterList: Param[*] = parameters(parser);
    parser.expect(TokenType.Colon, "Operators must declare their return type");
    let returnType: TypeRef = type(parser);
    return FunctionDecl { line: keyword.line, name: symbol.text, isOperator: true, params: parameterList, ret: returnType, body: block(parser, "operator body"), hasBody: true } in default;
}

/** (after `struct`) NAME { ( field | static ... | function ... | operator ... )* } */
function structDeclaration(parser: Parser in default): StructDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected struct name");
    let declaration: StructDecl = StructDecl { line: name.line, name: name.text } in default;
    parser.expect(TokenType.LBrace, "Expected '{' to open struct body");
    while (!parser.at(TokenType.RBrace) && !parser.atEnd()) {
        if (parser.at(TokenType.Let)) {
            declaration.fields.push(field(parser));
        } else if (parser.optional(TokenType.Static)) {
            staticFunction(parser, declaration.name);
        } else if (parser.at(TokenType.Function)) {
            declaration.methods.push(functionDeclaration(parser, false, true));
        } else if (parser.at(TokenType.Operator)) {
            declaration.methods.push(operatorDeclaration(parser));
        } else if (parser.at(TokenType.Override)) {
            parser.error(parser.current().line, "Structs have no inheritance, so 'override' is not allowed");
        } else {
            parser.error(parser.current().line, "Expected 'let', 'function' or 'operator' inside struct (got '${parser.current().text}')");
        }
    }
    parser.expect(TokenType.RBrace, "Expected '}' to close struct body");
    parser.optional(TokenType.Semi);
    return declaration;
}

/**
 * (after `class`) NAME [ extends NAME ] [ implements NAME ( , NAME )* ]
 *     { ( field | static ... | [override] function ... | native function ... | native let ... | operator ... )* }
 */
function classDeclaration(parser: Parser in default, isSynchronized: bool): ClassDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected class name");
    let declaration: ClassDecl = ClassDecl { line: name.line, name: name.text, isSynchronized } in default;
    if (parser.optional(TokenType.Extends)) { declaration.superName = qualifiedName(parser, "Expected superclass name"); }
    if (parser.optional(TokenType.Implements)) {
        while (true) {
            declaration.interfaces.push(qualifiedName(parser, "Expected interface name"));
            if (!parser.optional(TokenType.Comma)) { break; }
        }
    }
    parser.cOwner = declaration.name;              // its system (implements UnixPlatform...) is known after linking
    parser.expect(TokenType.LBrace, "Expected '{' to open class body");
    while (!parser.at(TokenType.RBrace) && !parser.atEnd()) {
        if (parser.at(TokenType.CInclude)) {                  // the headers of its C: only on its system
            let include: CIncludeDecl = CIncludeDecl { line: parser.advance().line, header: parser.expect(TokenType.Str, "Expected the header after 'cinclude': cinclude \"<math.h>\";").text, owner: declaration.name } in default;
            parser.expect(TokenType.Semi, "Expected ';' after the header of 'cinclude'");
            parser.nativeParts.push(include);
        } else if (parser.at(TokenType.CCode)) {              // C its methods share: only on its system
            let code: Token = parser.advance();
            parser.nativeParts.push(CCodeDecl { line: code.line, code: code.text, owner: declaration.name } in default);
        } else if (parser.at(TokenType.Let)) {
            declaration.fields.push(field(parser));
        } else if (parser.optional(TokenType.Static)) {
            staticFunction(parser, declaration.name);
        } else if (parser.optional(TokenType.Override)) {
            if (parser.optional(TokenType.Native)) {
                parser.expect(TokenType.Function, "Expected 'function' after 'override native'");
                let m: FunctionDecl = nativeFunction(parser, parser.previous().line);
                m.isOverride = true;
                declaration.methods.push(m);
            } else if (!parser.at(TokenType.Function)) {
                parser.error(parser.current().line, "Expected 'function' after 'override'");
            } else {
                declaration.methods.push(method(parser, isSynchronized, true));
            }
        } else if (parser.optional(TokenType.Native)) {
            if (parser.optional(TokenType.Interface)) {
                let opened: bool = false;           // an UnsafeTask's: its functions are found in a library when it runs
                for (i in declaration.interfaces) {
                    if (i == "UnsafeTask" || i.endsWith(".UnsafeTask")) { opened = true; }
                }
                parser.nativeParts.push(nativeInterface(parser, declaration.name, opened));
            } else if (parser.optional(TokenType.Let)) {
                let property: FunctionDecl = nativeProperty(parser, parser.previous().line);
                if (!property.hasBody) { parser.error(property.line, "A native let of a class needs its value: native let ${property.name}: T = expression;"); }
                declaration.methods.push(property);
            } else {
                parser.expect(TokenType.Function, "Expected 'function' or 'let' after 'native' in class");
                declaration.methods.push(nativeFunction(parser, parser.previous().line));
            }
        } else if (parser.at(TokenType.Function)) {
            declaration.methods.push(method(parser, isSynchronized, false));
        } else if (parser.at(TokenType.Operator)) {
            declaration.methods.push(operatorDeclaration(parser));
        } else {
            parser.error(parser.current().line, "Expected 'let', 'function' or 'operator' inside class body (got '${parser.current().text}')");
        }
    }
    parser.cOwner = "";
    parser.expect(TokenType.RBrace, "Expected '}' to close class body");
    parser.optional(TokenType.Semi);
    return declaration;
}

/**
 * native function f(params): T { C } (a method, a static function): the body is C. It becomes a C function the compiler writes (its
 * parameters with their C types and names), and f calls it. In a class for one system (it implements
 * UnixPlatform...), f calls it only there (elsewhere it panics; the C of that system reaches no other).
 */
public function cBodied(p: Parser in default, declaration: FunctionDecl in default): void {
    let code: Token = p.advance();
    let line: int32 = declaration.line;
    let owner: String = p.cOwner != "" ? "${p.cOwner}_" : "";
    let cFunction: ExternFunctionDecl = ExternFunctionDecl {
        line, name: "${owner}c_${declaration.name}", params: declaration.params, ret: declaration.ret,
        cName: "lar_${owner}${declaration.name}_${line}", cBody: code.text, owner: p.cOwner
    } in default;
    p.nativeParts.push(cFunction);
    let call: Call = Call { line, callee: Ident { line, name: cFunction.name } in default } in default;
    for (p in declaration.params) { call.args.push(Ident { line, name: p.name } in default); }
    let run: Stmt = ReturnStmt { line, value: call } in default;
    if (declaration.ret.kind == TypeRefKind.Named && declaration.ret.name == "void") { run = ExprStmt { line, expr: call } in default; }
    declaration.body.push(run);                 // in a class for one system, the analyzer keeps it for that platform only
    declaration.cBodied = p.cOwner != "";
    declaration.hasBody = true;
}

/** A method of a class: in a synchronized class it may say `wait until`. */
function method(parser: Parser in default, ofSynchronizedClass: bool, isOverride: bool): FunctionDecl {
    parser.waitUntilAllowed = ofSynchronizedClass;
    let method: FunctionDecl = functionDeclaration(parser, isOverride, true);
    parser.waitUntilAllowed = false;
    return method;
}

/** (after `interface`) NAME [ extends NAME ( , NAME )* ] { ( function NAME parameters [ : Type ] ... ; | static function ... )* } */
function interfaceDeclaration(parser: Parser in default): InterfaceDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected interface name");
    let declaration: InterfaceDecl = InterfaceDecl { line: name.line, name: name.text } in default;
    if (parser.optional(TokenType.Extends)) {                 // interface LinuxPlatform extends UnixPlatform
        while (true) {
            declaration.parents.push(qualifiedName(parser, "Expected the name of the interface it extends"));
            if (!parser.optional(TokenType.Comma)) { break; }
        }
    }
    parser.expect(TokenType.LBrace, "Expected '{' to open interface body");
    while (!parser.at(TokenType.RBrace) && !parser.atEnd()) {
        if (parser.optional(TokenType.Static)) {              // static function system(): Clock { ... }: gives an implementation
            staticFunction(parser, declaration.name);
        } else if (parser.at(TokenType.Let)) {
            parser.error(parser.current().line, "Interfaces only declare methods; fields belong in classes or structs");
        } else {
            declaration.methods.push(functionDeclaration(parser, false, false));
        }
    }
    parser.expect(TokenType.RBrace, "Expected '}' to close interface body");
    parser.optional(TokenType.Semi);
    return declaration;
}

/** (after `static`, inside the type `owner`) function ... | native function ... = C ; */
public function staticFunction(parser: Parser in default, owner: String in default): void {
    let found: FunctionDecl? = null;
    if (parser.optional(TokenType.Native)) {
        parser.expect(TokenType.Function, "Expected 'function' after 'static native'");
        found = nativeFunction(parser, parser.previous().line);
        if (!found!.hasBody) { parser.error(found!.line, "A static native function needs its C: static native function ${found!.name}(...) = c_function(...);"); }
    } else if (parser.at(TokenType.Function)) {
        found = functionDeclaration(parser, false, true);
    } else {
        parser.error(parser.current().line, "Expected 'function' after 'static'");
        return;
    }
    let staticFunction: FunctionDecl = found!;
    if (staticFunction.typeName != "") { parser.error(staticFunction.line, "Inside '${owner}' a static function is written without the type: static function ${staticFunction.name}(...)"); }
    staticFunction.typeName = owner;
    staticFunction.isStatic = true;
    parser.staticFunctions.push(staticFunction);
}

/** (after `enum`) NAME { [ variant ( , variant )* [ , ] ] }      variant: NAME [ parameters ] */
function enumDeclaration(parser: Parser in default): EnumDecl {
    let name: Token = parser.expect(TokenType.Ident, "Expected enum name");
    let declaration: EnumDecl = EnumDecl { line: name.line, name: name.text } in default;
    parser.expect(TokenType.LBrace, "Expected '{' to open enum body");
    looseList(parser, TokenType.RBrace, () -> {
        let variantName: Token = parser.expect(TokenType.Ident, "Expected variant name");
        let variant: EnumVariant = EnumVariant { line: variantName.line, name: variantName.text } in default;
        if (parser.at(TokenType.LParen)) {
            variant.hasPayload = true;
            variant.fields = parameters(parser);
        }
        declaration.variants.push(variant);
    });
    parser.expect(TokenType.RBrace, "Expected '}' to close enum body (variants are separated by commas)");
    parser.optional(TokenType.Semi);
    return declaration;
}

/** let NAME : Type [ = expression ] ; */
public function field(parser: Parser in default): FieldDecl {
    parser.expect(TokenType.Let, "Expected 'let'");
    let name: Token = parser.expect(TokenType.Ident, "Expected field name");
    parser.expect(TokenType.Colon, "Expected ':' and a type after field '${name.text}'");
    let declaration: FieldDecl = FieldDecl { line: name.line, name: name.text, type: type(parser) } in default;
    if (parser.optional(TokenType.Assign)) { declaration.defaultValue = expression(parser); }
    parser.expect(TokenType.Semi, "Expected ';' after field declaration");
    return declaration;
}
