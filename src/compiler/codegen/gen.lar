// codegen.gen: C99 code generation (Gen.java), part 1: the file, types, classes and interfaces,
// globals, bodies and statements. Expressions are in genexpr.lar.
//
//  - struct     -> C struct, copied by value; methods are plain functions on S*.
//  - class      -> C struct in a memory, used through pointers. The root struct starts with
//                  LarObjectHeader (vtable + memory); a subclass embeds its parent as `_super`.
//  - interface  -> { void* obj; const I_Table* t; }
//  - enum       -> { int32_t tag; union { ...payloads } as; }
//  - closure    -> { fn; union of every environment of that type }, copied by value.
//  - T[N]       -> { length; items[N] } by value; T[] -> { items*, length };
//                  T[*] -> pointer to { items*, length, capacity, mem }.
//  - errors     -> a function that throws takes LarError* err_out; every call checks it.
//  - memories   -> LarMemory; heap memories are freed on every exit of their block.

import semantics.types {
    classDepth, ClassInfo, declared, FunctionInfo, interfaceOf, isMemory, LambdaInfo, MemoryKind,
    MethodInfo, platformCondition, Symbol, syncField, T_VOID, Type, TypeKind
};
import codegen.localnames { localName, nameLocals };
import codegen.cprogram { CProgram };
import codegen.prune { NATIVE_HEADERS, braceDelta, prune, selectRuntime };
import semantics.linker { FILE_LINES, linking };
import codegen.expressions { boxDescriptors, cType, typeCName, value };
import codegen.expressions.clone { cloneFunctions, requireClone };
import codegen.gen.classes {
    classClone, clonePrototypes, closureCallHelper, collectionHelpers, dispatchHelper, functionHeader,
    ifaceCallName, initGlobals, interfaceCallHelper, interfaceImplementations, interfaceTableStruct, lambdaHeader,
    mainWrapper, methodHeader, nativeMethodHeader, params, samTable, samThunk, vtableInit, vtableStruct
};
import codegen.gen.statements { block, body, ret };
import codegen.gen.types {
    define, externDefinition, externPrototype, forward, isCName, larInC, larPrototypes
};

// =====================================================================================
// Function context
// =====================================================================================

public class Block {
    let cleanups: String[*] = [];
}

public class TryCtx {
    let catchLabel: String;
    let block: Block;
}

public class ArmCtx {
    let endLabel: String;
    let result: String;
    let block: Block;
    let used: bool = false;        // a yield jumped to endLabel (else the label is not written: -Wunused-label)
}

public class FunctionCode {
    let out: StringBuilder;
    let indent: int32 = 1;
    let lambda: LambdaInfo? = null;
    let ret: Type;
    let throwsOut: bool = false;
    let blocks: Block[*] = [];        // the root first, the innermost last
    let tries: TryCtx[*] = [];
    let arms: ArmCtx[*] = [];
    let placeOverride: String = "";   // memory for allocations inside field defaults
    let temp: Temp? = null;           // the temporaries of the statement being generated (null outside statements)
    let destUsed: bool = false;       // the function created something in lar_result_memory (the memory of its call)
}

/** A statement's temporary memory, declared before the statement only if something used it. */
public class Temp {
    let owner: Block;
    let name: String = "";
    let line: int32 = 0;
}

public function newFunctionCode(): FunctionCode { return FunctionCode { out: {} in default, ret: T_VOID } in default; }

/** The state of the generator: the function being written, the pieces of C made on the way (lambdas, literals, helpers) and its errors. */
public class Generation {
    let writing: FunctionCode = newFunctionCode();
    let counter: int32 = 0;
    let hasErrors: bool = false;
    /** Bugs of the compiler found while generating: reported instead of writing C that would crash. */
    let generatorErrors: String[*] = [];
    // helpers discovered while generating bodies
    let samInterfaces: String[*] = [];
    let samSeen: Any = {};
    let literalTypes: StringBuilder = {};
    let literalPrototypes: StringBuilder = {};
    let literalTables: StringBuilder = {};
    let literalThunks: StringBuilder = {};
    let lambdaDefs: String[*] = [];     // by lambda id ("" until generated)
    let lambdaDone: bool[*] = [];
    /** The trampolines of callbacks given to C (codegen.expressions.callbacks): one per pair, by name. */
    let callbackSeen: Any = {};
    let callbackNames: String[*] = [];
    let callbackTexts: String[*] = [];
    let resizeHelpers: String[*] = [];
    let resizeSeen: Any = {};
    let loopBlock: Block? = null;                  // innermost loop body (per function, saved/restored)
    /** #line before each statement, so a debugger (lldb, gdb) shows and stops on the .lar lines. */
    let debugLines: bool = false;
    let hasInit: bool = false;
}

/** The Generation of the compilation being done (pipeline: Compilation). */
public let generation: Generation = Generation {} in default;

/** Makes `state` the one the compiler works on. */
public function useGeneration(state: Generation in default): void { generation = state; }



public function internalError(line: int32, msg: String): void {
    generation.generatorErrors.push("Internal Error [Line ${line}]: ${msg} This is a bug of the compiler, not of your program: please report it." in default);
}


// =====================================================================================
// Debugging (larimar build --debug): the C says which .lar line each part comes from
// =====================================================================================


public function lineMark(encoded: int32): String {
    let index: int32 = encoded / FILE_LINES;
    let ln: int32 = encoded % FILE_LINES;
    if (index < 0 || index >= linking.filePaths.length || ln <= 0) { return ""; }
    return "#line ${ln} ${cPathLiteral(linking.filePaths[index])}";
}

function cPathLiteral(path: String): String { return "\"${path.replace("\\", "/").replace("\"", "\\\"")}\""; }

/**
 * After generating with debugLines: inside a function, every line of C after a #line gets that same
 * .lar line (C would count on: N, N+1, N+2...); after the function, the lines are the C file's again,
 * so the runtime and helpers are shown as the C they are.
 */
public function spreadLines(c: String, cFile: String): String {
    let builder: StringBuilder = {};
    let written: int32 = 0;
    let depth: int32 = 0;
    let current: String = "";
    let lastWasMark: bool = false;
    let reset: String = cPathLiteral(cFile);
    let all: String[*] = c.split("\n");
    for (k, ln in all) {
        let t: String = ln.trimStart();
        if (depth == 0 && current == "" && braceDelta(ln) > 0 && ln.contains("(")) {
            // a function: its header gets the line of its first mark (its declaration), for "break name"
            let first: String = firstMark(all, k);
            if (first != "") {
                current = first;
                builder.addLine(first);
                written += 1;
                lastWasMark = true;
            }
        }
        if (depth > 0 && t.startsWith("#line ")) {
            current = t;
            builder.addLine(ln);
            written += 1;
            lastWasMark = true;
            continue;
        }
        if (current != "" && !lastWasMark && t != "") {
            builder.add(ln.substring(0, ln.length - t.length));      // with the line's indentation
            builder.addLine(current);
            written += 1;
        }
        builder.addLine(ln);
        written += 1;
        lastWasMark = false;
        depth += braceDelta(ln);
        if (depth < 0) { depth = 0; }
        if (depth == 0 && current != "") {
            current = "";
            builder.addLine("#line ${written + 2} ${reset}");
            written += 1;
        }
    }
    return builder.toString().clone();
}

/** The first #line of the function whose header is all[k] (before the function ends), or "". */
function firstMark(all: String[*], k: int32): String {
    let depth: int32 = 0;
    let i: int32 = k;
    while (i < all.length) {
        let t: String = all[i].trimStart();
        if (i > k && t.startsWith("#line ")) { return t; }
        depth += braceDelta(all[i]);
        if (depth <= 0 && i > k) { return ""; }
        i += 1;
    }
    return "";
}

public function line(s: String): void {
    let i: int32 = 0;
    while (i < generation.writing.indent) {
        generation.writing.out.add("    ");
        i += 1;
    }
    generation.writing.out.addLine(s);
}

/** A temporary of the function being generated, by what it is: its name comes from codegen.localnames. */
public function tmp(role: String): String { return localName(role); }

/** Adds four spaces to every line (like String.indent(4) in Java). */
public function indent4(text: String in default): String {
    if (text.isEmpty()) { return ""; }
    let builder: StringBuilder = {} in default;
    let lines: String[*] = text.split("\n");
    for (i, l in lines) {
        if (i == lines.length - 1 && l.isEmpty()) { break; }
        builder.add("    ");
        builder.addLine(l);
    }
    return builder.toString();
}

public function pushBlock(blockCode: Block in default): void { generation.writing.blocks.push(blockCode); }

public function popBlock(): void {
    let rest: Block[*] = [] in default;
    let i: int32 = 0;
    while (i < generation.writing.blocks.length - 1) {
        rest.push(generation.writing.blocks[i]);
        i += 1;
    }
    generation.writing.blocks = rest;
}

public function topBlock(): Block { return generation.writing.blocks[generation.writing.blocks.length - 1]; }
public function rootBlock(): Block { return generation.writing.blocks[0]; }

// =====================================================================================
// Output assembly
// =====================================================================================


/** The C of the analyzed program: emitC, then nameC, then pruneC (the passes EmitC, NameC and Prune). */
public function generate(): String {
    let program: CProgram = emitC();
    nameC(program);
    return pruneC(program);
}

/**
 * NameC: the names of the compiler's variables (codegen.localnames). A function's are named when it is
 * written; here, those left in the text between them.
 */
public function nameC(program: CProgram): void {
    for (p in program.parts) {
        if (p.cFunction == null) { p.text = nameLocals(p.text).clone() in default; }
    }
}

/** EmitC: the whole program, every function and type, before anything is cut: text, and each function whole. */
public function emitC(): CProgram {
    for (e in declared.enums) {
        if (e.thrown) { generation.hasErrors = true; }
    }
    for (l in declared.lambdaList) {
        generation.lambdaDefs.push("");
        generation.lambdaDone.push(false);
    }
    // Bodies first: they discover lambdas, literal objects and helpers.
    let functionTexts: String[*] = [] in default;
    let functionNames: String[*] = [] in default;
    for (f in declared.functions) {
        if (f.isExtern || f.decl!.isNative) { continue; }     // native: every call is written in place
        let one: StringBuilder = {} in default;
        one.add(functionHeader(f));
        one.addLine(" {");
        one.add(body(f.decl!.body, f.sig!.elem!, f.throwsType != null, null, f.paramSymbols, "", f.line));
        one.add("}\n\n");
        functionTexts.push(one.toString());
        functionNames.push(f.cName);
    }
    let methods: StringBuilder = {} in default;
    for (s in declared.structs) {
        for (m in s.methods) {
            methods.add(methodHeader(m, true));
            methods.addLine(" {");
            if (!m.selfSymbol!.used) { methods.add("    (void)self;\n"); }
            methods.add(body(m.decl.body, m.sig!.elem!, m.throwsType != null, null, m.paramSymbols, "", m.decl.line));
            methods.add("}\n\n");
        }
    }
    for (c in classesByDepth()) {
        if (c.thread) {
            let run: MethodInfo = interfaceOf("Runnable")!.methods[0];
            methods.add("static void Thread__entry(void* p) {\n    Thread* self = (Thread*)p;\n    ");
            methods.add("${ifaceCallName(interfaceOf("Runnable")!, run)}(self->run);\n}\n\n");
        }
        for (m in c.methods) {
            methods.add(methodHeader(m, false));
            methods.addLine(" {");
            methods.add("    ${c.name}* self = (${c.name}*)self_;\n");
            methods.add("    (void)self;\n");
            if (c.thread && m.name == "start") {
                methods.add("    lar_thread_start(&self->_thread, lar_object_mem(self), Thread__entry, self, 0);\n}\n\n");
                continue;
            }
            if (c.thread && m.name == "join") {
                methods.add("    lar_thread_join(&self->_thread);\n}\n\n");
                continue;
            }
            if (c.builder) {    // the text grows in the builder's memory; toString() is a view of it
                let p0: String = m.paramSymbols.length > 0 ? m.paramSymbols[0].cName : "";
                if (m.name == "add") {
                    methods.add("    lar_builder_add(self, ${p0});\n");
                } else if (m.name == "addLine") {
                    methods.add("    lar_builder_add(self, ${p0});\n    lar_text_builder_add(&self->_sb, \"\\n\", 1);\n");
                } else if (m.name == "length") {
                    methods.add("    return self->_sb.len;\n");
                } else if (m.name == "toString") {
                    methods.add("    (void)lar_result_memory;\n    return self->_sb.buf ? lar_string(self->_sb.buf, self->_sb.len) : lar_string(\"\", 0);\n");
                } else {
                    methods.add("    self->_sb.buf = NULL;   /* a new buffer: texts already given out stay as they were */\n    self->_sb.len = 0;\n");
                }
                methods.add("}\n\n");
                continue;
            }
            let lock: String = c.sync ? "self->${syncField(c)}" : "";
            methods.add(body(m.decl.body, m.sig!.elem!, m.throwsType != null, null, m.paramSymbols, lock, m.decl.line));
            methods.add("}\n\n");
        }
    }
    for (m in declared.nativeMethods) {
        if (!m.decl.hasBody) { continue; }
        methods.add(nativeMethodHeader(m));
        methods.addLine(" {");
        methods.add("    (void)self;\n");
        methods.add(body(m.decl.body, m.sig!.elem!, m.throwsType != null, null, m.paramSymbols, "", m.decl.line));
        methods.add("}\n\n");
    }
    let init: String = initGlobals();
    let main: String = mainWrapper();
    for (c in declared.classes) {
        if (!c.sync && !c.thread) {
            for (f in c.fields) { requireClone(f.type); }
        }
    }
    let boxes: String = boxDescriptors();     // may need clone functions: before generating them
    let clones: String = cloneFunctions();

    let out: StringBuilder = {} in default;     // the text being written; it goes into `program` before each function
    let program: CProgram = {} in default;      // the program; the runtime it needs goes before it
    let incSeen: Any = {} in default;
    let headers: StringBuilder = {} in default;     // of native interfaces: each kept only when what it gives is used
    for (ii, inc in declared.includes) {
        let platformName: String = declared.includeWhens[ii];
        let gives: String = declared.includeGives[ii];
        if (gives != "") {
            let text: String = inc.startsWith("<") || inc.startsWith("\"") ? "#include ${inc}" : "#include \"${inc}\"";
            headers.add(platformName == "" ? text : "#if ${platformCondition(platformName)}\n${text}\n#endif");
            headers.add("\n/* gives: ${gives} */\n\n");
            continue;
        }
        let key: String = "${inc}|${platformName}";
        if (incSeen.contains(key)) { continue; }
        incSeen[key] = true;
        if (inc == "<stdint.h>" || inc == "<stdbool.h>" || inc == "<stdio.h>" || inc == "<stdlib.h>" || inc == "<string.h>") { continue; }
        let text: String = inc.startsWith("<") || inc.startsWith("\"") ? "#include ${inc}" : "#include \"${inc}\"";
        out.add(platformName == "" ? "${text}\n" : "#if ${platformCondition(platformName)}\n${text}\n#endif\n");
    }
    if (headers.length > 0) {
        section(out, NATIVE_HEADERS);
        out.add(headers.toString());
    }

    let named: StringBuilder = {} in default;      // what ccode names with lar"...": prototypes first
    for (code in declared.cCode) {
        if (code.contains("lar\"")) { larPrototypes(code, named); }
    }
    for (f in declared.functions) {
        if (f.isExtern && f.ext!.cBody.contains("lar\"")) { larPrototypes(f.ext!.cBody, named); }
    }
    sectionOf(out, "Larimar functions named in ccode", named);
    for (ci, code in declared.cCode) {
        section(out, declared.cCodeStd[ci] ? "ccode (std)" : "ccode");
        out.add(stripIndent(code.contains("lar\"") ? larInC(code) : code));
        out.add("\n");
    }

    let part: StringBuilder = {} in default;
    let anyResource: bool = false;
    for (e in declared.externInfos) {
        part.add("typedef ${e.decl.cType != "" ? e.decl.cType : "void*"} LarNative_${e.name};\n");
        if (e.decl.releasedBy != "") {
            if (!anyResource) {
                part.add("typedef struct LarResource { int state; void (*release)(struct LarResource*); LarMemory* mem; } LarResource;   /* 1 live, 2 releasing, 0 released; the memory it is in */\n");
                anyResource = true;
            }
            part.add("typedef struct { LarResource h; LarNative_${e.name} value; } LarResource_${e.name};\n");
        }
    }
    for (t in declared.typeOrder) { forward(part, t); }
    sectionOf(out, "Forward declarations", part);
    part = {} in default;
    for (t in declared.typeOrder) { define(part, t); }
    sectionOf(out, "Types", part);

    if (generation.hasErrors) {
        section(out, "Errors");
        out.add("typedef struct LarError {\n    int32_t kind;\n    union {");
        for (e in declared.enums) {
            if (e.thrown) { out.add(" ${typeCName(e.name)} e_${e.name};"); }
        }
        out.add(" char _none; } as;\n} LarError;\n");
    }

    if (declared.classes.length > 0 || declared.interfaces.length > 0) {
        section(out, "Virtual tables and interface tables");
        for (c in classesByDepth()) { vtableStruct(out, c); }
        for (i in declared.interfaces) { interfaceTableStruct(out, i); }
    }
    if (generation.literalTypes.length > 0 || generation.samInterfaces.length > 0) {
        section(out, "Objects created from literals and lambdas");
        out.add(generation.literalTypes.toString());
        for (i in generation.samInterfaces) {
            let m: MethodInfo = interfaceOf(i)!.methods[0];
            out.add("typedef struct ${i}__Sam { ${cType(m.sig!)} fn; } ${i}__Sam;\n");
        }
    }

    section(out, "Prototypes");
    let written: Any = {} in default;
    for (f in declared.functions) {                      // native function f(...): T { C }: its C function, here
        if (f.isExtern && f.ext!.cBody != "" && !written.contains(f.cName)) {
            written[f.cName] = true;
            let platformName: String = f.ext!.platform;
            let body: String = (f.ext!.cBody.contains("lar\"") ? larInC(f.ext!.cBody) : f.ext!.cBody).clone() in default;
            let text: String = "static ${externDefinition(f)} {\n${bodyText(body)}\n}";
            out.add(platformName == "" ? "${text}\n" : "#if ${platformCondition(platformName)}\n${text}\n#endif\n");
        }
    }
    for (f in declared.functions) {
        if (f.isExtern && f.prototype && !written.contains(f.cName) && isCName(f.cName)) {     // "(f)", a cast...: C text, no prototype
            written[f.cName] = true;
            let platformName: String = f.ext!.platform;
            out.add(platformName == "" ? "${externPrototype(f)};\n" : "#if ${platformCondition(platformName)}\n${externPrototype(f)};\n#endif\n");
        }
    }
    for (f in declared.functions) {
        if (!f.isExtern && !f.decl!.isNative) { out.add("${functionHeader(f)};\n"); }
    }
    for (s in declared.structs) {
        for (m in s.methods) { out.add("${methodHeader(m, true)};\n"); }
    }
    for (c in classesByDepth()) {
        for (m in c.methods) { out.add("${methodHeader(m, false)};\n"); }
        out.add("static void* ${c.name}__clone(void* self_, LarMemory* mem, LarCloneMap* cm);\n");
    }
    for (m in declared.nativeMethods) {
        if (m.decl.hasBody) { out.add("${nativeMethodHeader(m)};\n"); }
    }
    for (l in declared.lambdaList) { out.add("${lambdaHeader(l)};\n"); }
    out.add(clonePrototypes());
    out.add(generation.literalPrototypes.toString());
    if (anyResource) { resources(out); }

    if (declared.enums.length > 0) {
        section(out, "Enum names");
        for (e in declared.enums) {
            out.add("const char* const ${e.name}__names[] = { ");
            for (i, v in e.variants) {
                if (i > 0) { out.add(", "); }
                out.add("\"${v.name}\"");
            }
            out.add(" };\n");
        }
    }

    if (declared.classes.length > 0 || declared.interfaces.length > 0) {
        section(out, "Class information, vtables and dispatch");
        for (c in classesByDepth()) {
            let parent: String = c.superName != "" ? "&lar_class_${c.superName}" : "NULL";
            out.add("const LarClass lar_class_${c.name} = { \"${c.name}\", ${parent} };\n");
        }
        for (c in classesByDepth()) { out.add("const ${c.name}_VTable methods_${c.name} = { ${vtableInit(c, c)} };\n"); }
        for (c in classesByDepth()) {
            for (m in c.methods) {
                if (m.introducer == c.name) { dispatchHelper(out, c, m); }
            }
        }
        for (i in declared.interfaces) {
            for (m in i.methods) { interfaceCallHelper(out, i, m); }
        }
        interfaceImplementations(out);
        out.add(generation.literalTables.toString());
        for (i in generation.samInterfaces) { samTable(out, interfaceOf(i)!); }
    }

    if (declared.funcTypes.length > 0) {
        section(out, "Closure calls");
        for (ft in declared.funcTypes) { closureCallHelper(out, ft); }
    }

    part = {} in default;
    for (t in declared.typeOrder) { collectionHelpers(part, t); }
    part.add(boxes);
    for (r in generation.resizeHelpers) { part.add(r); }
    sectionOf(out, "Array and optional helpers", part);

    if (declared.globals.length > 0) {
        section(out, "Globals");
        for (v in declared.globals) {
            let s: Symbol = v.symbol!;
            if (s.memKind == MemoryKind.FixedStatic) {
                let n: int64 = s.type.size;
                if (n < 1) { n = 1; }
                out.add("static uint8_t ${s.cName}__buf[${n}];\n");
                out.add("LarMemory ${s.cName};\n");
            } else if (isMemory(s)) {
                out.add("LarMemory ${s.cName};\n");
            } else {
                out.add("${cType(s.type)} ${s.cName};\n");
            }
        }
    }

    section(out, "Functions");
    program.add(out.toString());
    out.clear();
    for (i, text in functionTexts) { program.addFunction(functionNames[i], text); }
    let anyBuilder: bool = false;
    for (c in declared.classes) {
        if (c.builder) { anyBuilder = true; }
    }
    if (anyBuilder) {
        section(out, "StringBuilder");
        out.add("static inline void lar_builder_add(StringBuilder* b, LarString s) {\n");
        out.add("    if (!b->_sb.buf) b->_sb = lar_text_builder_mem(lar_object_mem(b), 0);\n    lar_text_builder_str(&b->_sb, s);\n}\n");
    }
    if (methods.length > 0) {
        section(out, "Methods");
        out.add(methods.toString());
    }
    let anyLambda: bool = false;
    for (d in generation.lambdaDone) {
        if (d) { anyLambda = true; }
    }
    if (anyLambda) {
        section(out, "Lambdas");
        program.add(out.toString());
        out.clear();
        for (i, d in generation.lambdaDefs) {
            if (generation.lambdaDone[i]) { program.addFunction("lambda_${i}", d); }
        }
    }
    if (generation.callbackNames.length > 0) {
        section(out, "Callbacks given to C");
        program.add(out.toString());
        out.clear();
        for (i, name in generation.callbackNames) { program.addFunction(name, generation.callbackTexts[i]); }
    }
    if (generation.literalThunks.length > 0 || declared.classes.length > 0) {
        section(out, "Interface thunks and cloning");
        out.add(generation.literalThunks.toString());
        for (i in generation.samInterfaces) { samThunk(out, interfaceOf(i)!); }
        for (c in classesByDepth()) { classClone(out, c); }
    }
    out.add(clones);
    section(out, "Entry point");
    out.add(init);
    out.add(main);
    program.add(out.toString());
    return program;
}

/** Prune: only what main and the ccode reach, after the runtime it needs. */
public function pruneC(emitted: CProgram): String {
    let roots: String[*] = ["main"] in default;
    let program: String = prune(emitted, roots);
    let head: StringBuilder = {} in default;
    head.add("/* Generated by the transpiler. Runtime first, then the program. */\n");
    let ownC: bool = declared.cCode.length > 0 || declared.includes.length > 0;
    for (f in declared.functions) {
        if (f.isExtern) { ownC = true; }
    }
    let runtime: String = selectRuntime(program, declared.usesThreads, declared.files.length > 0, ownC);
    if (runtime.contains("LAR_FILES")) {
        head.add("#define LAR_FILES ");
        for (i, f in declared.files) {
            if (i > 0) { head.add(", "); }
            head.add("\"${f.replace("\\", "/")}\"");
        }
        head.add("\n");
    }
    // POSIX functions (threads, and those C code calls) are only declared when asked for
    if (declared.usesThreads || declared.cCode.length > 0 || declared.includes.length > 0) { head.add("#if !defined(_WIN32) && !defined(_XOPEN_SOURCE)\n#define _XOPEN_SOURCE 700\n#endif\n"); }
    if (declared.usesThreads) { head.add("#define LAR_THREADS\n"); }
    head.add(runtime);
    head.add(program);
    return head.toString();
}

/**
 * Resources (extern type X released by f): a value lives in a cell of the memory it was made in, with its
 * state; the memory releases it when it is freed, unless release(x) already did.
 */
function resources(out: StringBuilder): void {
    section(out, "Resources");
    out.add("""
        static void lar_resource_final(void* p) {
            LarResource* r = (LarResource*)p;
            if (r->state == 1) { r->state = 2; r->release(r); r->state = 0; }
        }
        static inline void lar_resource_release(void* p) { if (p) lar_resource_final(p); }
        """);
    for (e in declared.externInfos) {
        if (e.decl.releasedBy == "") { continue; }
        let n: String = e.name;
        let functionInfo: FunctionInfo? = e.releaser;
        if (functionInfo == null) { continue; }
        let only: String = functionInfo.isExtern ? functionInfo.ext!.platform : "";      // a resource of one platform: its releaser's
        let cType: String = e.decl.cType.trim();
        let valid: String = cType == "" || cType.endsWith("*") || cType == "HANDLE"
            ? "v != NULL && (intptr_t)v != -1"                      // -1: INVALID_HANDLE_VALUE, MAP_FAILED
            : "(intmax_t)(v) >= 0";
        if (only != "") { out.add("#if ${platformCondition(only)}\n"); }
        out.add("""
            static void ${n}__release(LarResource* r) { ${functionInfo.isExtern ? "${functionInfo.cName}(((LarResource_${n}*)r)->value)" : "${functionInfo.cName}((LarResource_${n}*)r)"}; }
            static LarResource_${n}* ${n}__new(LarMemory* m, LarNative_${n} v, int line) {
                if (!(${valid})) return NULL;          /* C failed: no resource */
                LarResource_${n}* c = (LarResource_${n}*)lar_memory_alloc(m, sizeof(LarResource_${n}), line);
                c->h.state = 1;
                c->h.release = ${n}__release;
                c->h.mem = m;
                c->value = v;
                lar_memory_on_free(m, lar_resource_final, c, line);
                return c;
            }
            """);
        if (only != "") { out.add("#endif\n#if ${platformCondition(only)}\n"); }
        out.add("""
            static inline LarNative_${n} ${n}__get(LarResource_${n}* c, int line) {
                if (!c || c->h.state == 0) lar_panic("a released ${shortName(n)} was used", line);
                return c->value;
            }
            """);
        if (only != "") { out.add("#endif\n"); }
    }
}

/** A name without its module prefix: std__net__Socket -> Socket. */
function shortName(n: String): String {
    let i: int32? = n.lastIndexOf("__");
    return i != null ? n.substring(i! + 2) : n;
}

function sectionOf(out: StringBuilder, title: String, content: StringBuilder): void {
    if (content.length == 0) { return; }
    section(out, title);
    out.add(content.toString());
}

public function section(out: StringBuilder, title: String): void {
    let n: int32 = 70 - title.length;
    if (n < 3) { n = 3; }
    out.add("\n/* ---- ${title} ${"-".repeat(n)} */\n");
}

/** A C body as it was written, indented once (its closing line's indentation does not count). */
function bodyText(body: String in default): String {
    let lines: String[*] = body.split("\n");
    if (lines.length > 1 && lines[lines.length - 1].trim().isEmpty()) { lines.pop(); }
    let text: String = stripIndent(lines.join("\n"));
    return "    ${text.replace("\n", "\n    ")}";
}

/** Like Java's stripIndent().strip(): removes the common indentation and the blank lines around. */
function stripIndent(code: String in default): String {
    let lines: String[*] = code.split("\n");
    let minIndent: int32 = 1000000;
    for (i, l in lines) {
        let trimmedRight: String = l.trimEnd();
        let last: bool = i == lines.length - 1;
        if (trimmedRight.isEmpty() && !last) { continue; }
        let n: int32 = 0;
        while (n < l.length && (l[n] == 32 || l[n] == 9)) { n += 1; }
        if (trimmedRight.isEmpty()) { n = l.length; }
        if (n < minIndent) { minIndent = n; }
    }
    if (minIndent == 1000000) { minIndent = 0; }
    let builder: StringBuilder = {} in default;
    for (i, l in lines) {
        let s: String = l.trimEnd();
        s = s.length >= minIndent ? s.substring(minIndent) : "";
        if (i > 0) { builder.add("\n"); }
        builder.add(s);
    }
    return builder.toString().trim();
}

public function classesByDepth(): ClassInfo[*] {
    let list: ClassInfo[*] = [] in default;
    for (c in declared.classes) {
        let d: int32 = classDepth(c.name);
        let i: int32 = list.length;
        list.push(c);
        while (i > 0 && classDepth(list[i - 1].name) > d) {
            list[i] = list[i - 1];
            i -= 1;
        }
        list[i] = c;
    }
    return list;
}
