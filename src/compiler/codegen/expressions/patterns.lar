// codegen.expressions.patterns: the patterns of a switch.

import semantics.types {
    escapeName, isClass, isInterface, isOpt, optIsPointer, PatK, PatternInfo, Symbol, T_ANY, T_STRING, TypeKind, Type
};
import codegen.gen { line };
import codegen.expressions { anyKind, anyPayload, boxType, cType, value };

// Joined only with || (several patterns in one case), so a comparison needs no parentheses of its own
// (clang warns about if ((a == b))).
public function patternTest(patternInfo: PatternInfo in default, st: Type, inner: Type, subj: String, val: String): String {
    let opt: bool = isOpt(st);
    let has: String = "";
    if (opt) { has = optIsPointer(st) ? "(${subj} != NULL)" : "${subj}.has"; }
    if (st == T_ANY) {
        if (patternInfo.kind == PatK.Default) { return "1"; }
        if (patternInfo.kind == PatK.Null) { return "${subj}.kind == LAR_ANY_NULL"; }
        let at: Type = patternInfo.anyType!;
        if (isClass(at)) { return "lar_any_is_obj(${subj}, &lar_class_${at.name})"; }
        return at.kind == TypeKind.Named ? "lar_any_is_val(${subj}, &${boxType(at)})" : "${subj}.kind == ${anyKind(at)}";
    }
    let test: String = "1";
    if (patternInfo.kind == PatK.AnyType) {
        test = "0";
    } else if (patternInfo.kind == PatK.Null) {
        test = optIsPointer(st) ? "${subj} == NULL" : "!${subj}.has";
    } else if (patternInfo.kind == PatK.Variant) {
        test = "${val}.tag == ${inner.name}_${patternInfo.variant!.name}";
    } else if (patternInfo.kind == PatK.Constant) {
        let c: String = value(patternInfo.constant!);
        test = inner == T_STRING ? "lar_string_eq(${val}, ${c})" : "${val} == ${c}";
    } else if (patternInfo.kind == PatK.Class) {
        if (isInterface(inner)) {
            test = "(${val}.t->cls != NULL && lar_is_a(lar_object_class(${val}.obj), &lar_class_${patternInfo.cls!.name}))";
        } else {
            test = "lar_is_a(lar_object_class(${val}), &lar_class_${patternInfo.cls!.name})";
        }
    }
    return opt && patternInfo.kind != PatK.Default && patternInfo.kind != PatK.Null ? "(${has} && ${test})" : test;
}

public function bindPattern(patternInfo: PatternInfo, inner: Type, subj: String, val: String): void {
    let w: Symbol? = patternInfo.whole;
    if (w != null) {
        line("${cType(w.type)} ${w.cName} = ${val};");
        if (!w.used) { line("(void)${w.cName};"); }
    }
    if (patternInfo.kind == PatK.Variant) {
        for (i, bo in patternInfo.bindings) {
            if (bo == null) { continue; }
            let b: Symbol = bo;
            line("${cType(b.type)} ${b.cName} = ${val}.as.${patternInfo.variant!.name}.${escapeName(patternInfo.variant!.fields[i].name)};");
            if (!b.used) { line("(void)${b.cName};"); }
        }
    } else if (patternInfo.kind == PatK.AnyType && patternInfo.bindings.length > 0) {
        let b: Symbol = patternInfo.bindings[0]!;
        line("${cType(b.type)} ${b.cName} = ${anyPayload(patternInfo.anyType!, val)};");
        if (!b.used) { line("(void)${b.cName};"); }
    } else if (patternInfo.kind == PatK.Class && patternInfo.bindings.length > 0) {
        let b: Symbol = patternInfo.bindings[0]!;
        let obj: String = isInterface(inner) ? "${val}.obj" : val;
        line("${patternInfo.cls!.name}* ${b.cName} = (${patternInfo.cls!.name}*)${obj};");
        if (!b.used) { line("(void)${b.cName};"); }
    }
}
