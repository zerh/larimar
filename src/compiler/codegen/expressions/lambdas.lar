// codegen.expressions.lambdas: lambdas and literal objects.

import syntax.ast { ArrayLit, Expr, Lambda, ObjectLit };
import semantics.types {
    ArrayKind, ClassInfo, hasBigCaptures, classOf, Conversion, FieldInfo, hasCapture, InterfaceInfo, interfaceOf, LambdaInfo, NamedKind,
    parentOf, StructInfo, structOf, Symbol, SymbolKind, syncField, T_ANY, T_VOID, Type, VariantInfo
};
import codegen.gen {
    Block, counter, writing, lambdaDefs, lambdaDone, line, literalPrototypes, literalTables, literalThunks, literalTypes,
    loopBlock, samInterfaces, samSeen, tmp
};
import codegen.gen.classes { lambdaHeader, paramCTypes };
import codegen.gen.statements { body };
import codegen.gen.types { envField };
import codegen.expressions {
    cType, fieldC, forget, hoist, hoistAs, inOrder, placeMem, structName, typeCName, value, writtenValues
};
import codegen.expressions.strings { stringLiteral };

public function lambdaValue(l: Lambda in default): String {
    let lambdaInfo: LambdaInfo = l.lambda!;
    genLambda(lambdaInfo);
    let fid: int32 = lambdaInfo.type.funcId;
    if (lambdaInfo.captures.length == 0) { return "((Closure_${fid}){ .fn = lambda_${lambdaInfo.id} })"; }
    let env: String[*] = [] in default;
    for (s in lambdaInfo.captures) { env.push(".${envField(s)} = ${captureValue(s)}"); }
    if (hasBigCaptures(lambdaInfo)) {                // in the memory where the lambda lives, not in every closure of its type
        let captures: String = tmp("captures");
        line("Env_${lambdaInfo.id}* ${captures} = (Env_${lambdaInfo.id}*)lar_memory_alloc(${placeMem(l)}, sizeof(Env_${lambdaInfo.id}), LINE(${l.line}));");
        line("*${captures} = (Env_${lambdaInfo.id}){ ${env.join(", ")} };");
        return "((Closure_${fid}){ .fn = lambda_${lambdaInfo.id}, .env = { .l_${lambdaInfo.id} = ${captures} } })";
    }
    return "((Closure_${fid}){ .fn = lambda_${lambdaInfo.id}, .env = { .l_${lambdaInfo.id} = { ${env.join(", ")} } } })";
}

function captureValue(symbol: Symbol): String {
    let lambdaInfo: LambdaInfo? = writing.lambda;
    if (lambdaInfo != null && hasCapture(lambdaInfo, symbol)) { return "env->${envField(symbol)}"; }
    return symbol.kind == SymbolKind.Self ? "self" : symbol.cName;
}

function genLambda(lambdaInfo: LambdaInfo in default): void {
    if (lambdaDone[lambdaInfo.id]) { return; }
    lambdaDone[lambdaInfo.id] = true;
    let savedLoop: Block? = loopBlock;
    loopBlock = null;
    let builder: StringBuilder = {} in default;
    builder.add(lambdaHeader(lambdaInfo));
    builder.add(" {\n");
    if (lambdaInfo.captures.length == 0) {
        builder.add("    (void)env_;\n");
    } else if (hasBigCaptures(lambdaInfo)) {
        builder.add("    Env_${lambdaInfo.id}* env = *(Env_${lambdaInfo.id}**)env_;\n");
    } else {
        builder.add("    Env_${lambdaInfo.id}* env = (Env_${lambdaInfo.id}*)env_;\n");
    }
    builder.add(body(lambdaInfo.node.body, lambdaInfo.type.elem!, false, lambdaInfo, lambdaInfo.params, "", lambdaInfo.node.line));
    builder.add("}\n\n");
    loopBlock = savedLoop;
    lambdaDefs[lambdaInfo.id] = builder.toString();
}

/** A lambda used as a single-method interface: a small object holding the closure. */
public function singleMethodObject(lambda: Lambda in default, conversion: Conversion in default): String {
    let interfaceInfo: InterfaceInfo = conversion.iface!;
    if (!samSeen.contains(interfaceInfo.name)) {
        samSeen[interfaceInfo.name] = true;
        samInterfaces.push(interfaceInfo.name);
    }
    let closure: String = lambdaValue(lambda);
    let mem: String = placeMem(lambda);
    let o: String = tmp("lambda_object");
    line("${interfaceInfo.name}__Sam* ${o} = (${interfaceInfo.name}__Sam*)lar_memory_alloc(${mem}, sizeof(${interfaceInfo.name}__Sam), LINE(${lambda.line}));");
    line("${o}->fn = ${closure};");
    return "((${interfaceInfo.name}){ (void*)${o}, &${interfaceInfo.name}__sam_table })";
}

function givenValue(literal: ObjectLit, name: String): Expr? {
    let found: Expr? = null;
    for (fi in literal.fields) {
        if (fi.name == name) { found = fi.value; }
    }
    return found;
}

public function objectLit(literal: ObjectLit in default, type: Type in default): String {
    if (type == T_ANY) {
        let table: String = tmp("table");
        line("LarTable* ${table} = lar_table_new(${placeMem(literal)}, LINE(${literal.line}));");
        for (fi in literal.fields) {
            let v: String = value(fi.value);
            if (fi.name == "" || fi.shorthand) {
                line("lar_table_push(${table}, ${v}, LINE(${fi.line}));");
            } else {
                line("lar_table_set(${table}, ${stringLiteral(fi.name)}, ${v}, LINE(${fi.line}));");
            }
        }
        return "lar_any_t(${table})";
    }
    let variant: VariantInfo? = literal.variant;
    if (variant != null) {
        let tag: String = "${type.name}_${variant.name}";
        if (variant.fields.length == 0) { return "((${typeCName(type.name)}){ .tag = ${tag} })"; }
        let held: Expr[*] = inOrder(writtenValues(literal));
        let v: String = "((${typeCName(type.name)}){ .tag = ${tag}, .as.${variant.name} = { ${fieldInits(variant.fields, literal, "")} } })";
        forget(held);
        return v;
    }
    if (type.namedKind == NamedKind.Struct) {
        let structInfo: StructInfo = structOf(type.name)!;
        let sn: String = cType(type);              // a C struct has its own name
        if (structInfo.fields.length == 0) { return structInfo.decl.cName != "" ? "((${sn}){ 0 })" : "((${sn}){ ._none = 0 })"; }
        let held: Expr[*] = inOrder(writtenValues(literal));
        let inits: String = fieldInits(structInfo.fields, literal, "");
        forget(held);
        return "((${sn}){ ${inits == "" ? "0" : inits} })";            // {0}: a C struct with nothing given
    }
    if (type.namedKind != NamedKind.Class) { return interfaceLit(literal, interfaceOf(type.name)!); }
    let classInfo: ClassInfo = classOf(type.name)!;
    let mem: String = hoistAs("LarMemory*", placeMem(literal), "place") in default;      // (field defaults are created there)
    let obj: String = tmp("new_${typeCName(classInfo.name)}");
    line("${classInfo.name}* ${obj} = (${classInfo.name}*)lar_memory_alloc(${mem}, sizeof(${classInfo.name}), LINE(${literal.line}));");
    let sync: String = "";
    if (classInfo.sync) {       // its fields live in its own memory, used only under its lock
        sync = tmp("sync");
        line("LarSync* ${sync} = lar_sync_new(${mem}, LINE(${literal.line}));");
        mem = "(&${sync}->own)" in default;
    }
    let held: Expr[*] = inOrder(writtenValues(literal));
    let init: String = classInit(classInfo, classInfo.name, literal, mem);
    forget(held);
    line("*${obj} = (${classInfo.name}){ ${init} };");
    if (sync != "") { line("${obj}->${syncField(classInfo)} = ${sync};"); }
    return obj;
}

function fieldInits(fields: FieldInfo[*] in default, literal: ObjectLit in default, mem: String in default): String {
    let out: String[*] = [] in default;
    for (f in fields) {
        let g: Expr? = givenValue(literal, f.name);
        let v: String = "";
        if (g != null) {
            v = value(g);
        } else if (f.defaultValue == null) {
            continue;                        // a field of a C struct that was not given: zero
        } else {
            let saved: String = writing.placeOverride;
            if (mem != "") { writing.placeOverride = mem; }
            v = value(f.defaultValue!);
            writing.placeOverride = saved;
        }
        out.push(".${fieldC(f)} = ${v}");
    }
    return out.join(", ");
}

function classInit(level: ClassInfo in default, concrete: String, literal: ObjectLit in default, mem: String in default): String {
    let parts: String[*] = [] in default;
    if (level.superName == "") {
        parts.push(".header = { (const void*)&methods_${concrete}, ${mem} }");
    } else {
        parts.push("._super = { ${classInit(parentOf(level)!, concrete, literal, mem)} }");
    }
    if (level.fields.length > 0) { parts.push(fieldInits(level.fields, literal, mem)); }
    return parts.join(", ");
}

function interfaceLit(literal: ObjectLit in default, interfaceInfo: InterfaceInfo in default): String {
    let id: int32 = counter;
    counter += 1;
    let sn: String = "ILit_${id}";
    literalTypes.add("typedef struct ${sn} {");
    for (m in interfaceInfo.methods) { literalTypes.add(" ${cType(m.sig!)} ${m.name};"); }
    literalTypes.add(" } ${sn};\n");
    for (m in interfaceInfo.methods) {
        let parameterText: StringBuilder = {} in default;
        let asb: StringBuilder = {} in default;
        for (k, p in paramCTypes(m)) {
            parameterText.add(", ${p} a${k}");
            asb.add(", a${k}");
        }
        let head: String = "static ${cType(m.sig!.elem!)} ${sn}__${m.name}(void* self${parameterText.toString()})";
        literalPrototypes.add("${head};\n");
        let ret: String = m.sig!.elem! == T_VOID ? "" : "return ";
        literalThunks.add("${head} { ${ret}call_Closure_${m.sig!.funcId}(((${sn}*)self)->${m.name}${asb.toString()}); }\n");
    }
    literalTables.add("const ${interfaceInfo.name}_Table ${sn}_table = { NULL");
    for (m in interfaceInfo.methods) { literalTables.add(", ${sn}__${m.name}"); }
    literalTables.add(" };\n");
    let mem: String = placeMem(literal);
    let obj: String = tmp("interface_object");
    line("${sn}* ${obj} = (${sn}*)lar_memory_alloc(${mem}, sizeof(${sn}), LINE(${literal.line}));");
    for (m in interfaceInfo.methods) { line("${obj}->${m.name} = ${value(givenValue(literal, m.name)!)};"); }
    return "((${interfaceInfo.name}){ (void*)${obj}, &${sn}_table })";
}

public function arrayLit(a: ArrayLit in default, type: Type): String {
    if (type.arrayKind == ArrayKind.Growable) {
        let mem: String = placeMem(a);
        let l: String = tmp("list");
        line("${cType(type)} ${l} = ${structName(type)}_new(${mem}, LINE(${a.line}));");
        for (x in a.elems) { line("${structName(type)}_add(${l}, ${value(x)}, LINE(${a.line}));"); }
        return l;
    }
    if (a.elems.length == 0) { return "((${cType(type)}){ .length = 0 })"; }
    let held: Expr[*] = inOrder(a.elems);
    let vs: String[*] = [] in default;
    for (x in a.elems) { vs.push(value(x)); }
    forget(held);
    return "((${cType(type)}){ .length = ${a.elems.length}, .items = { ${vs.join(", ")} } })";
}
