// std.crypto.macos: secure random bytes on macOS (arc4random).

import std.crypto { RandomSource };
import std.os { MacOSPlatform };

public class MacOSRandomSource implements RandomSource, MacOSPlatform {
    ccode {
        void arc4random_buf(void* buffer, size_t length);   /* declared here: -std=c99 hides it in stdlib.h */
    }

    override native function fill(items: byte[]): bool {
        arc4random_buf(items, (size_t)items_length);
        return true;
    }
}
