// std.net.http.tls: encrypted connections, for https:// (and whatever else needs TLS).
//
//   public interface TlsProvider {
//       function connect(host: String, port: int32, timeout: int32): Connection throws NetError;
//   }
//
// A Client (std.net.http) has one: SystemTls unless it is given another. Implement TlsProvider to use a
// TLS library of your own (mbedTLS, wolfSSL...): it gives back a Connection (read, write, flush, close)
// and std.net.http speaks HTTP over it without knowing what is underneath.
//
// SystemTls uses what the system has: Network.framework on macOS, SChannel on Windows, OpenSSL on Linux
// (libssl, loaded the first time it is needed, so a program that never uses https:// needs nothing).
// When there is none, connect throws NetError.TlsUnavailable saying what is missing.
//
// Everything blocks, like a TcpSocket: there are no threads inside. A connection closes itself when the
// memory it lives in is freed.

import std.net { Connection, TcpSocket, NetError, Socket };
import std.io.files { IoError };

/** What gives encrypted connections. */
public interface TlsProvider {
    /**
     * An encrypted connection to host:port, after the TLS handshake. It checks the server's certificate as
     * the implementation decides (SystemTls: against the system's trusted certificates, for host). timeout:
     * how long reads and writes may wait, in ms (0: no limit). A failure is a NetError: HostNotFound,
     * Refused, Timeout..., Tls(reason) when the handshake or the certificate fails, TlsUnavailable(what)
     * when there is no TLS to use.
     */
    function connect(host: String, port: int32, timeout: int32): Connection throws NetError;
}

c_code {
    #define LM_NET_TLS              /* larimar build: Network.framework, secur32 or -ldl */

    /* error codes: 1 host not found, 2 refused, 3 timeout, 4 closed, 5 reset, 50 TLS failed (text),
       51 TLS unavailable (text), 100+ other */
    #define LM_TLS_TEXT 300

#if defined(__APPLE__)
    /* ---------------- macOS: Network.framework ---------------------------------------------------
       It makes its own connection (it does not take a socket) and answers in callbacks on a dispatch
       queue; each operation here waits for its callback with a semaphore, so it blocks like a socket.
       The state shared with the callbacks is malloc'd, and freed by the callback of the cancellation:
       a late callback never touches freed memory. */
    #include <Network/Network.h>
    #include <dispatch/dispatch.h>
    #include <errno.h>

    #define LM_TLS_RBUF 65536
    typedef struct {
        nw_connection_t conn;
        dispatch_queue_t q;
        dispatch_semaphore_t sem;
        volatile int started;           /* the start was answered: ready or failed */
        volatile int ready;
        volatile int32_t error;
        char text[LM_TLS_TEXT];
        volatile int32_t rlen;          /* the last receive: bytes in rbuf, end, error */
        volatile int reof, rerr, werr;
        uint8_t rbuf[LM_TLS_RBUF];
    } LmTlsMac;

    typedef struct { int32_t error; char text[LM_TLS_TEXT]; bool open, eof; int32_t timeoutMs; LmTlsMac* mac; } LmTls;

    static bool lm_tls_needs_socket(void) { return false; }

    static void lm_tls_nw_error(LmTlsMac* p, nw_error_t err) {
        if (!err) { p->error = 50; snprintf(p->text, LM_TLS_TEXT, "the connection failed"); return; }
        nw_error_domain_t d = nw_error_get_error_domain(err);
        int c = nw_error_get_error_code(err);
        if (d == nw_error_domain_posix) {
            p->error = c == ECONNREFUSED ? 2 : c == ETIMEDOUT ? 3 : c == ECONNRESET || c == EPIPE ? 5 : 100 + c;
            snprintf(p->text, LM_TLS_TEXT, "%s", strerror(c));
        } else if (d == nw_error_domain_dns) {
            p->error = 1;
            snprintf(p->text, LM_TLS_TEXT, "host not found");
        } else {
            const char* why = c == -9807 ? "the certificate chain is not valid"
                : c == -9808 ? "bad certificate"
                : c == -9812 ? "the certificate was signed by an unknown authority"
                : c == -9813 ? "no trusted root certificate"
                : c == -9814 ? "the certificate has expired"
                : c == -9815 ? "the certificate is not yet valid"
                : c == -9843 ? "the certificate is not for this host"
                : c == -67843 ? "the certificate is not trusted" : NULL;
            p->error = 50;
            if (why) snprintf(p->text, LM_TLS_TEXT, "%s", why);
            else snprintf(p->text, LM_TLS_TEXT, "handshake failed (OSStatus %d)", c);
        }
    }

    static long lm_tls_wait(LmTlsMac* p, int32_t ms) {
        return dispatch_semaphore_wait(p->sem, ms > 0 ? dispatch_time(DISPATCH_TIME_NOW, (int64_t)ms * (int64_t)NSEC_PER_MSEC)
                                                      : DISPATCH_TIME_FOREVER);
    }

    static void lm_tls_close(LmTls* t) {
        if (t->mac) { nw_connection_cancel(t->mac->conn); t->mac = NULL; }   /* the cancelled state frees it */
        t->open = false;
    }

    static void lm_tls_final(void* p) { lm_tls_close((LmTls*)p); }

    static void lm_tls_copy_error(LmTls* t, LmTlsMac* p) {
        t->error = p->error;
        memcpy(t->text, p->text, LM_TLS_TEXT);
    }

    static LmTls* lm_tls_open_socket(RtMem* m, int fd, const char* host, bool verify) {   /* not used here */
        (void)fd; (void)host; (void)verify;
        LmTls* t = (LmTls*)rt_mem_alloc(m, sizeof(LmTls), 0);
        memset(t, 0, sizeof *t);
        t->error = 51;
        return t;
    }

    static LmTls* lm_tls_open_host(RtMem* m, const char* host, int32_t port, bool verify, int32_t timeoutMs) {
        LmTls* t = (LmTls*)rt_mem_alloc(m, sizeof(LmTls), 0);
        memset(t, 0, sizeof *t);
        t->timeoutMs = timeoutMs;
        LmTlsMac* p = (LmTlsMac*)calloc(1, sizeof(LmTlsMac));
        if (!p) { t->error = 50; snprintf(t->text, LM_TLS_TEXT, "out of memory"); return t; }
        p->q = dispatch_queue_create("larimar.tls", DISPATCH_QUEUE_SERIAL);
        p->sem = dispatch_semaphore_create(0);
        dispatch_queue_t q = p->q;
        char service[16];
        snprintf(service, sizeof service, "%d", (int)port);
        nw_endpoint_t ep = nw_endpoint_create_host(host, service);
        nw_parameters_t params = nw_parameters_create_secure_tcp(^(nw_protocol_options_t tls) {
            if (!verify) {                      /* accept any certificate: for local tests */
                sec_protocol_options_t sec = nw_tls_copy_sec_protocol_options(tls);
                sec_protocol_options_set_verify_block(sec, ^(sec_protocol_metadata_t md, sec_trust_t trust,
                                                             sec_protocol_verify_complete_t done) {
                    (void)md; (void)trust;
                    done(true);
                }, q);
                sec_release(sec);
            }
        }, NW_PARAMETERS_DEFAULT_CONFIGURATION);
        p->conn = nw_connection_create(ep, params);
        nw_release(ep);
        nw_release(params);
        nw_connection_set_queue(p->conn, p->q);
        nw_connection_set_state_changed_handler(p->conn, ^(nw_connection_state_t state, nw_error_t err) {
            if (state == nw_connection_state_ready) {
                if (!p->started) { p->ready = 1; p->started = 1; dispatch_semaphore_signal(p->sem); }
            } else if (state == nw_connection_state_waiting || state == nw_connection_state_failed) {
                if (!p->started) { lm_tls_nw_error(p, err); p->started = 1; dispatch_semaphore_signal(p->sem); }
            } else if (state == nw_connection_state_cancelled) {
                nw_connection_set_state_changed_handler(p->conn, NULL);
                nw_release(p->conn);
                dispatch_release(p->sem);
                dispatch_release(p->q);
                free(p);
            }
        });
        t->mac = p;
        nw_connection_start(p->conn);
        if (lm_tls_wait(p, timeoutMs) != 0) {
            t->error = 3;
            snprintf(t->text, LM_TLS_TEXT, "timed out");
            lm_tls_close(t);
            return t;
        }
        if (!p->ready) {
            lm_tls_copy_error(t, p);
            lm_tls_close(t);
            return t;
        }
        t->open = true;
        rt_mem_on_free(m, lm_tls_final, t, 0);
        return t;
    }

    static int32_t lm_tls_read(LmTls* t, uint8_t* items, int32_t len) {
        if (!t->open) { if (t->eof) return 0; t->error = 4; return -1; }
        if (len <= 0) return 0;
        LmTlsMac* p = t->mac;
        uint32_t want = (uint32_t)(len < LM_TLS_RBUF ? len : LM_TLS_RBUF);
      again:
        p->rlen = 0;
        p->rerr = 0;
        nw_connection_receive(p->conn, 1, want, ^(dispatch_data_t content, nw_content_context_t ctx, bool complete, nw_error_t err) {
            if (content) {
                dispatch_data_apply(content, ^bool(dispatch_data_t region, size_t offset, const void* buf, size_t size) {
                    (void)region;
                    if (offset + size <= LM_TLS_RBUF) memcpy(p->rbuf + offset, buf, size);
                    return true;
                });
                p->rlen = (int32_t)dispatch_data_get_size(content);
            }
            if (err) { lm_tls_nw_error(p, err); p->rerr = 1; }
            else if (complete && ctx && nw_content_context_get_is_final(ctx)) p->reof = 1;   /* the other side closed */
            dispatch_semaphore_signal(p->sem);
        });
        if (lm_tls_wait(p, t->timeoutMs) != 0) {
            t->error = 3;
            lm_tls_close(t);
            return -1;
        }
        int32_t n = p->rlen;
        if (n > 0) memcpy(items, p->rbuf, (size_t)n);
        if (p->reof) { t->eof = true; if (n == 0) { lm_tls_close(t); return 0; } }
        if (n > 0) return n;
        if (p->rerr) { lm_tls_copy_error(t, p); return -1; }
        goto again;                                  /* nothing yet, and not the end: wait for more */
    }

    static int32_t lm_tls_write(LmTls* t, const uint8_t* items, int32_t len) {
        if (!t->open) { t->error = 4; return -1; }
        if (len <= 0) return 0;
        LmTlsMac* p = t->mac;
        dispatch_data_t d = dispatch_data_create(items, (size_t)len, p->q, DISPATCH_DATA_DESTRUCTOR_DEFAULT);  /* a copy */
        p->werr = 0;
        nw_connection_send(p->conn, d, NW_CONNECTION_DEFAULT_MESSAGE_CONTEXT, true, ^(nw_error_t err) {
            if (err) { lm_tls_nw_error(p, err); p->werr = 1; }
            dispatch_semaphore_signal(p->sem);
        });
        dispatch_release(d);
        if (lm_tls_wait(p, t->timeoutMs) != 0) {
            t->error = 3;
            lm_tls_close(t);
            return -1;
        }
        if (p->werr) { lm_tls_copy_error(t, p); return -1; }
        return 0;
    }

#elif defined(_WIN32)
    /* ---------------- Windows: SChannel ----------------------------------------------------------
       Over the TcpSocket's SOCKET: the handshake with InitializeSecurityContext, then records with
       EncryptMessage / DecryptMessage. Certificates: the system's store (SCH_CRED_AUTO_CRED_VALIDATION). */
    #define SECURITY_WIN32
    #include <winsock2.h>
    #include <windows.h>
    #include <security.h>
    #include <schannel.h>
    #ifndef SCH_USE_STRONG_CRYPTO
    #define SCH_USE_STRONG_CRYPTO 0x00400000
    #endif
    #ifndef SEC_E_WRONG_PRINCIPAL
    #define SEC_E_WRONG_PRINCIPAL ((HRESULT)0x80090322L)
    #endif

    #define LM_TLS_IN 33000             /* encrypted bytes not yet decrypted (a record is at most ~16.7 KB) */
    #define LM_TLS_OUT 17000            /* one encrypted record to send */
    typedef struct {
        int32_t error; char text[LM_TLS_TEXT]; bool open, eof;
        SOCKET fd;
        CredHandle cred; CtxtHandle ctx; bool hasCred, hasCtx;
        SecPkgContext_StreamSizes sizes;
        int32_t inLen;
        int32_t plainLen, plainPos;
        uint8_t in[LM_TLS_IN];
        uint8_t plain[LM_TLS_IN];
        uint8_t out[LM_TLS_OUT];
    } LmTls;

    static bool lm_tls_needs_socket(void) { return true; }

    static void lm_tls_status(LmTls* t, SECURITY_STATUS s) {
        const char* why = s == SEC_E_UNTRUSTED_ROOT ? "the certificate is not trusted"
            : s == SEC_E_CERT_EXPIRED ? "the certificate has expired"
            : s == SEC_E_WRONG_PRINCIPAL || s == (SECURITY_STATUS)CERT_E_CN_NO_MATCH ? "the certificate is not for this host"
            : s == SEC_E_ILLEGAL_MESSAGE ? "the server did not answer in TLS"
            : s == SEC_E_ALGORITHM_MISMATCH ? "no cipher in common with the server" : NULL;
        t->error = 50;
        if (why) snprintf(t->text, LM_TLS_TEXT, "%s", why);
        else snprintf(t->text, LM_TLS_TEXT, "TLS failed (0x%08lx)", (unsigned long)s);
    }

    static void lm_tls_sock_error(LmTls* t) {
        int e = WSAGetLastError();
        t->error = e == WSAETIMEDOUT || e == WSAEWOULDBLOCK ? 3 : e == WSAECONNRESET || e == WSAECONNABORTED ? 5 : 100 + e;
        snprintf(t->text, LM_TLS_TEXT, "socket error %d", e);
    }

    static bool lm_tls_send_all(LmTls* t, const uint8_t* p, int32_t len) {
        while (len > 0) {
            int n = send(t->fd, (const char*)p, len, 0);
            if (n <= 0) { lm_tls_sock_error(t); return false; }
            p += n;
            len -= n;
        }
        return true;
    }

    static void lm_tls_close(LmTls* t) { t->open = false; }

    static void lm_tls_final(void* p) {
        LmTls* t = (LmTls*)p;
        t->open = false;
        if (t->hasCtx) { DeleteSecurityContext(&t->ctx); t->hasCtx = false; }
        if (t->hasCred) { FreeCredentialsHandle(&t->cred); t->hasCred = false; }
    }

    static LmTls* lm_tls_open_host(RtMem* m, const char* host, int32_t port, bool verify, int32_t timeoutMs) {   /* not used here */
        (void)host; (void)port; (void)verify; (void)timeoutMs;
        LmTls* t = (LmTls*)rt_mem_alloc(m, sizeof(LmTls), 0);
        memset(t, 0, sizeof *t);
        t->error = 51;
        return t;
    }

    /* over a connected socket, with its timeouts */
    static LmTls* lm_tls_open_socket(RtMem* m, SOCKET fd, const char* host, bool verify) {
        LmTls* t = (LmTls*)rt_mem_alloc(m, sizeof(LmTls), 0);
        memset(t, 0, sizeof *t);
        t->fd = fd;
        rt_mem_on_free(m, lm_tls_final, t, 0);
        SCHANNEL_CRED sc;
        memset(&sc, 0, sizeof sc);
        sc.dwVersion = SCHANNEL_CRED_VERSION;
        sc.dwFlags = SCH_USE_STRONG_CRYPTO | SCH_CRED_NO_DEFAULT_CREDS
            | (verify ? SCH_CRED_AUTO_CRED_VALIDATION : (SCH_CRED_MANUAL_CRED_VALIDATION | SCH_CRED_NO_SERVERNAME_CHECK));
        TimeStamp expiry;
        SECURITY_STATUS s = AcquireCredentialsHandleA(NULL, (LPSTR)UNISP_NAME_A, SECPKG_CRED_OUTBOUND, NULL, &sc,
                                                      NULL, NULL, &t->cred, &expiry);
        if (s != SEC_E_OK) { lm_tls_status(t, s); return t; }
        t->hasCred = true;
        DWORD flags = ISC_REQ_SEQUENCE_DETECT | ISC_REQ_REPLAY_DETECT | ISC_REQ_CONFIDENTIALITY
            | ISC_REQ_ALLOCATE_MEMORY | ISC_REQ_STREAM | ISC_REQ_EXTENDED_ERROR
            | (verify ? 0 : ISC_REQ_MANUAL_CRED_VALIDATION);
        bool first = true, needRead = false;
        for (;;) {
            if (needRead) {
                if (t->inLen >= LM_TLS_IN) { t->error = 50; snprintf(t->text, LM_TLS_TEXT, "handshake too big"); return t; }
                int n = recv(t->fd, (char*)t->in + t->inLen, LM_TLS_IN - t->inLen, 0);
                if (n == 0) { t->error = 50; snprintf(t->text, LM_TLS_TEXT, "the server closed the connection during the handshake"); return t; }
                if (n < 0) { lm_tls_sock_error(t); return t; }
                t->inLen += n;
            }
            needRead = true;
            SecBuffer inb[2], outb[1];
            inb[0].cbBuffer = (unsigned long)t->inLen; inb[0].BufferType = SECBUFFER_TOKEN; inb[0].pvBuffer = t->in;
            inb[1].cbBuffer = 0; inb[1].BufferType = SECBUFFER_EMPTY; inb[1].pvBuffer = NULL;
            outb[0].cbBuffer = 0; outb[0].BufferType = SECBUFFER_TOKEN; outb[0].pvBuffer = NULL;
            SecBufferDesc ind = { SECBUFFER_VERSION, 2, inb };
            SecBufferDesc outd = { SECBUFFER_VERSION, 1, outb };
            DWORD attrs = 0;
            s = InitializeSecurityContextA(&t->cred, first ? NULL : &t->ctx, (SEC_CHAR*)host, flags, 0, 0,
                                           first ? NULL : &ind, 0, first ? &t->ctx : NULL, &outd, &attrs, NULL);
            if (first && (s == SEC_I_CONTINUE_NEEDED || s == SEC_E_OK)) t->hasCtx = true;
            first = false;
            if (outb[0].cbBuffer > 0 && outb[0].pvBuffer) {
                bool sent = lm_tls_send_all(t, (const uint8_t*)outb[0].pvBuffer, (int32_t)outb[0].cbBuffer);
                FreeContextBuffer(outb[0].pvBuffer);
                if (!sent) return t;
            }
            if (s == SEC_E_INCOMPLETE_MESSAGE) continue;              /* read more of the same message */
            if (s == SEC_I_CONTINUE_NEEDED || s == SEC_E_OK) {
                if (inb[1].BufferType == SECBUFFER_EXTRA && inb[1].cbBuffer > 0) {
                    memmove(t->in, t->in + t->inLen - inb[1].cbBuffer, inb[1].cbBuffer);
                    t->inLen = (int32_t)inb[1].cbBuffer;
                    needRead = s != SEC_I_CONTINUE_NEEDED;            /* the extra bytes are the next message */
                } else {
                    t->inLen = 0;
                }
                if (s == SEC_E_OK) break;
                continue;
            }
            lm_tls_status(t, s);
            return t;
        }
        s = QueryContextAttributesA(&t->ctx, SECPKG_ATTR_STREAM_SIZES, &t->sizes);
        if (s != SEC_E_OK) { lm_tls_status(t, s); return t; }
        t->open = true;
        return t;
    }

    static int32_t lm_tls_read(LmTls* t, uint8_t* items, int32_t len) {
        if (len <= 0) return 0;
        for (;;) {
            if (t->plainPos < t->plainLen) {
                int32_t n = t->plainLen - t->plainPos;
                if (n > len) n = len;
                memcpy(items, t->plain + t->plainPos, (size_t)n);
                t->plainPos += n;
                return n;
            }
            if (!t->open) { if (t->eof) return 0; t->error = 4; return -1; }
            if (t->inLen > 0) {
                SecBuffer b[4];
                b[0].cbBuffer = (unsigned long)t->inLen; b[0].BufferType = SECBUFFER_DATA; b[0].pvBuffer = t->in;
                for (int i = 1; i < 4; i++) { b[i].cbBuffer = 0; b[i].BufferType = SECBUFFER_EMPTY; b[i].pvBuffer = NULL; }
                SecBufferDesc d = { SECBUFFER_VERSION, 4, b };
                SECURITY_STATUS s = DecryptMessage(&t->ctx, &d, 0, NULL);
                if (s == SEC_E_OK) {
                    SecBuffer* data = NULL;
                    SecBuffer* extra = NULL;
                    for (int i = 1; i < 4; i++) {
                        if (b[i].BufferType == SECBUFFER_DATA) data = &b[i];
                        if (b[i].BufferType == SECBUFFER_EXTRA) extra = &b[i];
                    }
                    t->plainLen = 0;
                    t->plainPos = 0;
                    if (data && data->cbBuffer > 0) {
                        memcpy(t->plain, data->pvBuffer, data->cbBuffer);
                        t->plainLen = (int32_t)data->cbBuffer;
                    }
                    if (extra && extra->cbBuffer > 0) {
                        memmove(t->in, extra->pvBuffer, extra->cbBuffer);
                        t->inLen = (int32_t)extra->cbBuffer;
                    } else {
                        t->inLen = 0;
                    }
                    continue;
                }
                if (s == SEC_I_CONTEXT_EXPIRED) { t->open = false; t->eof = true; return 0; }   /* close_notify */
                if (s != SEC_E_INCOMPLETE_MESSAGE) { lm_tls_status(t, s); return -1; }
            }
            if (t->inLen >= LM_TLS_IN) { t->error = 50; snprintf(t->text, LM_TLS_TEXT, "TLS record too big"); return -1; }
            int n = recv(t->fd, (char*)t->in + t->inLen, LM_TLS_IN - t->inLen, 0);
            if (n == 0) { t->open = false; t->eof = true; return 0; }     /* closed without close_notify: the end */
            if (n < 0) { lm_tls_sock_error(t); return -1; }
            t->inLen += n;
        }
    }

    static int32_t lm_tls_write(LmTls* t, const uint8_t* items, int32_t len) {
        if (!t->open) { t->error = 4; return -1; }
        unsigned long head = t->sizes.cbHeader, tail = t->sizes.cbTrailer;
        unsigned long most = t->sizes.cbMaximumMessage;
        if (head + tail >= LM_TLS_OUT) { t->error = 50; snprintf(t->text, LM_TLS_TEXT, "unexpected TLS sizes"); return -1; }
        if (most > LM_TLS_OUT - head - tail) most = LM_TLS_OUT - head - tail;
        int32_t done = 0;
        while (done < len) {
            unsigned long chunk = (unsigned long)(len - done);
            if (chunk > most) chunk = most;
            memcpy(t->out + head, items + done, chunk);
            SecBuffer b[4];
            b[0].cbBuffer = head; b[0].BufferType = SECBUFFER_STREAM_HEADER; b[0].pvBuffer = t->out;
            b[1].cbBuffer = chunk; b[1].BufferType = SECBUFFER_DATA; b[1].pvBuffer = t->out + head;
            b[2].cbBuffer = tail; b[2].BufferType = SECBUFFER_STREAM_TRAILER; b[2].pvBuffer = t->out + head + chunk;
            b[3].cbBuffer = 0; b[3].BufferType = SECBUFFER_EMPTY; b[3].pvBuffer = NULL;
            SecBufferDesc d = { SECBUFFER_VERSION, 4, b };
            SECURITY_STATUS s = EncryptMessage(&t->ctx, 0, &d, 0);
            if (s != SEC_E_OK) { lm_tls_status(t, s); return -1; }
            if (!lm_tls_send_all(t, t->out, (int32_t)(b[0].cbBuffer + b[1].cbBuffer + b[2].cbBuffer))) return -1;
            done += (int32_t)chunk;
        }
        return 0;
    }

#else
    /* ---------------- Linux and others: OpenSSL, loaded with dlopen ------------------------------
       Over the TcpSocket's descriptor. Only the functions below are used; they are the same in
       OpenSSL 1.1 and 3. No headers are needed to compile, and nothing is loaded until https:// is used. */
    #include <dlfcn.h>
    #include <errno.h>
    #include <arpa/inet.h>

    typedef struct LmSslCtx LmSslCtx;
    typedef struct LmSsl LmSsl;
    typedef struct {
        const void* (*TLS_client_method)(void);
        LmSslCtx* (*SSL_CTX_new)(const void*);
        void (*SSL_CTX_free)(LmSslCtx*);
        long (*SSL_CTX_ctrl)(LmSslCtx*, int, long, void*);
        int (*SSL_CTX_set_default_verify_paths)(LmSslCtx*);
        void (*SSL_CTX_set_verify)(LmSslCtx*, int, void*);
        LmSsl* (*SSL_new)(LmSslCtx*);
        void (*SSL_free)(LmSsl*);
        int (*SSL_set_fd)(LmSsl*, int);
        long (*SSL_ctrl)(LmSsl*, int, long, void*);
        int (*SSL_set1_host)(LmSsl*, const char*);
        void* (*SSL_get0_param)(LmSsl*);
        int (*SSL_connect)(LmSsl*);
        int (*SSL_read)(LmSsl*, void*, int);
        int (*SSL_write)(LmSsl*, const void*, int);
        int (*SSL_shutdown)(LmSsl*);
        int (*SSL_get_error)(const LmSsl*, int);
        long (*SSL_get_verify_result)(const LmSsl*);
        int (*X509_VERIFY_PARAM_set1_ip_asc)(void*, const char*);
        const char* (*X509_verify_cert_error_string)(long);
        unsigned long (*ERR_get_error)(void);
        void (*ERR_error_string_n)(unsigned long, char*, size_t);
        void (*ERR_clear_error)(void);
        unsigned long (*OpenSSL_version_num)(void);
    } LmSslApi;
    static LmSslApi lm_ssl;
    static int lm_tls_state;                /* 0 not tried, 1 loaded, 2 missing */
    static char lm_tls_missing[LM_TLS_TEXT];

    static bool lm_tls_load(void) {
        if (lm_tls_state) return lm_tls_state == 1;
        static const char* names[] = { "libssl.so.3", "libssl.so.1.1", "libssl.so", 0 };
        void* h = NULL;
        for (int i = 0; names[i] && !h; i++) h = dlopen(names[i], RTLD_NOW | RTLD_LOCAL);
        if (!h) {
            snprintf(lm_tls_missing, LM_TLS_TEXT, "OpenSSL not found (tried libssl.so.3, libssl.so.1.1, libssl.so)");
            lm_tls_state = 2;
            return false;
        }
        #define LM_SSL_SYM(name) \
            *(void**)(&lm_ssl.name) = dlsym(h, #name); \
            if (!lm_ssl.name) { \
                snprintf(lm_tls_missing, LM_TLS_TEXT, "OpenSSL 1.1 or newer is needed (missing " #name ")"); \
                lm_tls_state = 2; \
                return false; \
            }
        LM_SSL_SYM(TLS_client_method) LM_SSL_SYM(SSL_CTX_new) LM_SSL_SYM(SSL_CTX_free) LM_SSL_SYM(SSL_CTX_ctrl)
        LM_SSL_SYM(SSL_CTX_set_default_verify_paths) LM_SSL_SYM(SSL_CTX_set_verify) LM_SSL_SYM(SSL_new)
        LM_SSL_SYM(SSL_free) LM_SSL_SYM(SSL_set_fd) LM_SSL_SYM(SSL_ctrl) LM_SSL_SYM(SSL_set1_host)
        LM_SSL_SYM(SSL_get0_param) LM_SSL_SYM(SSL_connect) LM_SSL_SYM(SSL_read) LM_SSL_SYM(SSL_write)
        LM_SSL_SYM(SSL_shutdown) LM_SSL_SYM(SSL_get_error) LM_SSL_SYM(SSL_get_verify_result)
        LM_SSL_SYM(X509_VERIFY_PARAM_set1_ip_asc) LM_SSL_SYM(X509_verify_cert_error_string)
        LM_SSL_SYM(ERR_get_error) LM_SSL_SYM(ERR_error_string_n) LM_SSL_SYM(ERR_clear_error)
        LM_SSL_SYM(OpenSSL_version_num)
        #undef LM_SSL_SYM
        lm_tls_state = 1;
        return true;
    }

    typedef struct {
        int32_t error; char text[LM_TLS_TEXT]; bool open, eof;
        LmSslCtx* ctx;
        LmSsl* ssl;
    } LmTls;

    static bool lm_tls_needs_socket(void) { return true; }

    static void lm_tls_ssl_error(LmTls* t, const char* what) {
        unsigned long e = lm_ssl.ERR_get_error();
        char buf[200];
        if (e) { lm_ssl.ERR_error_string_n(e, buf, sizeof buf); snprintf(t->text, LM_TLS_TEXT, "%s: %s", what, buf); }
        else snprintf(t->text, LM_TLS_TEXT, "%s", what);
        t->error = 50;
    }

    /* the error of a failed SSL_read/SSL_write/SSL_connect: -1, or 0 when it is the end */
    static int32_t lm_tls_io_error(LmTls* t, int r, const char* what) {
        int e = lm_ssl.SSL_get_error(t->ssl, r);
        if (e == 6) { t->eof = true; t->open = false; return 0; }                 /* SSL_ERROR_ZERO_RETURN */
        if (e == 5 && errno == 0) { t->eof = true; t->open = false; return 0; }   /* closed without close_notify */
        if (e == 5 || e == 2 || e == 3) {                                         /* SYSCALL, WANT_READ/WRITE */
            t->error = errno == EAGAIN || errno == EWOULDBLOCK || errno == ETIMEDOUT || e != 5 ? 3
                     : errno == ECONNRESET || errno == EPIPE ? 5 : 100 + errno;
            snprintf(t->text, LM_TLS_TEXT, "%s", strerror(errno ? errno : EAGAIN));
            return -1;
        }
        lm_tls_ssl_error(t, what);
        return -1;
    }

    static bool lm_tls_is_ip(const char* host) {
        unsigned char a[16];
        return inet_pton(AF_INET, host, a) == 1 || inet_pton(AF_INET6, host, a) == 1;
    }

    static void lm_tls_close(LmTls* t) {
        if (t->open && t->ssl) lm_ssl.SSL_shutdown(t->ssl);
        t->open = false;
    }

    static void lm_tls_final(void* p) {
        LmTls* t = (LmTls*)p;
        lm_tls_close(t);
        if (t->ssl) { lm_ssl.SSL_free(t->ssl); t->ssl = NULL; }
        if (t->ctx) { lm_ssl.SSL_CTX_free(t->ctx); t->ctx = NULL; }
    }

    static LmTls* lm_tls_open_host(RtMem* m, const char* host, int32_t port, bool verify, int32_t timeoutMs) {   /* not used here */
        (void)host; (void)port; (void)verify; (void)timeoutMs;
        LmTls* t = (LmTls*)rt_mem_alloc(m, sizeof(LmTls), 0);
        memset(t, 0, sizeof *t);
        t->error = 51;
        return t;
    }

    /* over a connected socket, with its timeouts */
    static LmTls* lm_tls_open_socket(RtMem* m, int fd, const char* host, bool verify) {
        LmTls* t = (LmTls*)rt_mem_alloc(m, sizeof(LmTls), 0);
        memset(t, 0, sizeof *t);
        if (!lm_tls_load()) { t->error = 51; memcpy(t->text, lm_tls_missing, LM_TLS_TEXT); return t; }
        lm_ssl.ERR_clear_error();
        t->ctx = lm_ssl.SSL_CTX_new(lm_ssl.TLS_client_method());
        if (!t->ctx) { lm_tls_ssl_error(t, "cannot create a TLS context"); return t; }
        rt_mem_on_free(m, lm_tls_final, t, 0);
        lm_ssl.SSL_CTX_ctrl(t->ctx, 123, 0x0303, NULL);          /* SSL_CTX_set_min_proto_version: TLS 1.2 */
        if (lm_ssl.OpenSSL_version_num() >= 0x30000000UL) {
            lm_ssl.SSL_CTX_ctrl(t->ctx, 32, 1L << 7, NULL);        /* SSL_OP_IGNORE_UNEXPECTED_EOF: an end, not an error */
        }
        if (verify) {
            lm_ssl.SSL_CTX_set_default_verify_paths(t->ctx);      /* the system's trusted certificates */
            lm_ssl.SSL_CTX_set_verify(t->ctx, 1, NULL);           /* SSL_VERIFY_PEER */
        }
        t->ssl = lm_ssl.SSL_new(t->ctx);
        if (!t->ssl) { lm_tls_ssl_error(t, "cannot create a TLS connection"); return t; }
        lm_ssl.SSL_set_fd(t->ssl, (int)fd);
        bool ip = lm_tls_is_ip(host);
        if (!ip) lm_ssl.SSL_ctrl(t->ssl, 55, 0, (void*)host);        /* SNI: SSL_set_tlsext_host_name */
        if (verify) {
            if (ip) lm_ssl.X509_VERIFY_PARAM_set1_ip_asc(lm_ssl.SSL_get0_param(t->ssl), host);
            else lm_ssl.SSL_set1_host(t->ssl, host);
        }
        errno = 0;
        int r = lm_ssl.SSL_connect(t->ssl);
        if (r != 1) {
            long v = lm_ssl.SSL_get_verify_result(t->ssl);
            if (verify && v != 0) {
                t->error = 50;
                snprintf(t->text, LM_TLS_TEXT, "certificate rejected: %s", lm_ssl.X509_verify_cert_error_string(v));
            } else if (lm_tls_io_error(t, r, "handshake failed") == 0) {
                t->eof = false;
                t->error = 50;
                snprintf(t->text, LM_TLS_TEXT, "the server closed the connection during the handshake");
            }
            return t;
        }
        t->open = true;
        return t;
    }

    static int32_t lm_tls_read(LmTls* t, uint8_t* items, int32_t len) {
        if (!t->open) { if (t->eof) return 0; t->error = 4; return -1; }
        if (len <= 0) return 0;
        for (;;) {
            errno = 0;
            lm_ssl.ERR_clear_error();
            int n = lm_ssl.SSL_read(t->ssl, items, len);
            if (n > 0) return n;
            if (errno == EINTR) continue;
            return lm_tls_io_error(t, n, "read failed");
        }
    }

    static int32_t lm_tls_write(LmTls* t, const uint8_t* items, int32_t len) {
        if (!t->open) { t->error = 4; return -1; }
        int32_t done = 0;
        while (done < len) {
            errno = 0;
            lm_ssl.ERR_clear_error();
            int n = lm_ssl.SSL_write(t->ssl, items + done, len - done);
            if (n > 0) { done += n; continue; }
            if (errno == EINTR) continue;
            if (lm_tls_io_error(t, n, "write failed") == 0) { t->error = 4; snprintf(t->text, LM_TLS_TEXT, "closed"); }
            return -1;
        }
        return 0;
    }
#endif

    static int32_t lm_tls_error(LmTls* t) { return t->error; }
    static const char* lm_tls_error_text(LmTls* t) { return t->text; }
}

extern type TlsHandle;
extern function lm_tls_needs_socket(): bool;
extern function lm_tls_open_socket(m: byte[*], s: Socket, host: String, verify: bool): TlsHandle;
extern function lm_tls_open_host(m: byte[*], host: String, port: int32, verify: bool, timeoutMs: int32): TlsHandle;
extern function lm_tls_error(t: TlsHandle): int32;
extern function lm_tls_error_text(t: TlsHandle): String;
extern function lm_tls_read(t: TlsHandle, buffer: byte[]): int32;
extern function lm_tls_write(t: TlsHandle, bytes: byte[]): int32;
extern function lm_tls_close(t: TlsHandle): void;

/**
 * The TLS of the system: Network.framework (macOS), SChannel (Windows), OpenSSL (Linux and others).
 * verify: false accepts any certificate, for tests against a local server with one of its own.
 */
public class SystemTls implements TlsProvider {
    let verify: bool = true;

    function connect(host: String, port: int32, timeout: int32): Connection throws NetError {
        let c: SystemTlsConnection = {};
        if (lm_tls_needs_socket()) {             // Linux, Windows: TLS over a TcpSocket
            c.tcp = TcpSocket.connect(host, port);
            c.tcp!.setTimeout(timeout);
            c.tls = lm_tls_open_socket(c.tcp!.handle()!, host, self.verify);
        } else {                                 // macOS: Network.framework makes the connection itself
            c.tls = lm_tls_open_host(host, port, self.verify, timeout);
        }
        let code: int32 = lm_tls_error(c.tls!);
        if (code != 0) {
            let why: String = lm_tls_error_text(c.tls!);
            switch (code) {
                case 1 -> throw NetError.HostNotFound(host.clone());
                case 2 -> throw NetError.Refused;
                case 3 -> throw NetError.Timeout;
                case 5 -> throw NetError.Reset;
                case 51 -> throw NetError.TlsUnavailable(why.clone());
                default -> throw NetError.Tls(why.clone());
            }
        }
        return c;
    }
}

/** A connection of SystemTls: the TLS session, over its TcpSocket (none on macOS: the system connects). */
class SystemTlsConnection implements Connection {
    let tcp: TcpSocket? = null;
    let tls: TlsHandle? = null;

    function read(buffer: byte[]): int32 throws IoError {
        let n: int32 = lm_tls_read(self.tls!, buffer);
        if (n < 0) { fail(self.tls!); }
        return n;
    }

    function write(bytes: byte[]): void throws IoError {
        if (lm_tls_write(self.tls!, bytes) < 0) { fail(self.tls!); }
    }

    function flush(): void throws IoError {}

    function close(): void throws IoError {
        lm_tls_close(self.tls!);
        if (self.tcp != null) { self.tcp!.close(); }
    }
}

function fail(t: TlsHandle): void throws IoError {
    let code: int32 = lm_tls_error(t);
    switch (code) {
        case 3 -> throw IoError.Failed("tls: timed out");
        case 4 -> throw IoError.Failed("tls: closed");
        case 5 -> throw IoError.Failed("tls: connection reset");
        default -> throw IoError.Failed("tls: ${lm_tls_error_text(t)}");
    }
}
