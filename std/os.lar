// std.os: the environment the program runs in.
//
//   import std.os;
//   let home: String = os.env("HOME") ?? "/";
//
// The system is std.platform's Platform.current(); what differs between systems is a class for each, in
// std/os/posix.lar, macos.lar and windows.lar.

import std.platform { Platform, OS };
import std.os.posix { PosixSystem };
import std.os.macos { MacOSSystem };
import std.os.windows { WindowsSystem };

// What std.os needs of the system: the static functions of PosixSystem, MacOSSystem and WindowsSystem
// (std/os/posix.lar, macos.lar, windows.lar), chosen by the system.

function hostProcessId(): int64 {
    return switch (Platform.current()) {
        case Linux, MacOS, Unix -> PosixSystem.processId();
        case Windows -> WindowsSystem.processId();
    };
}

function hostCwd(into: byte[]): bool {
    return switch (Platform.current()) {
        case Linux, MacOS, Unix -> PosixSystem.cwd(into);
        case Windows -> WindowsSystem.cwd(into);
    };
}

function hostProgramPath(into: byte[]): void {
    switch (Platform.current()) {
        case Linux, Unix -> PosixSystem.programPath(into);
        case MacOS -> MacOSSystem.programPath(into);
        case Windows -> WindowsSystem.programPath(into);
    }
}

function hostShell(command: String): int32 {
    return switch (Platform.current()) {
        case Linux, MacOS, Unix -> PosixSystem.shell(command);
        case Windows -> WindowsSystem.shell(command);
    };
}

function hostCatchTermination(): void {
    switch (Platform.current()) {
        case Linux, MacOS, Unix -> PosixSystem.catchTermination();
        case Windows -> WindowsSystem.catchTermination();
    }
}

function hostTerminating(): bool {
    return switch (Platform.current()) {
        case Linux, MacOS, Unix -> PosixSystem.terminating();
        case Windows -> WindowsSystem.terminating();
    };
}

/** What C's stdlib.h, string.h and stdio.h give std.os. */
native interface LibC "<stdlib.h>", "<string.h>", "<stdio.h>" {
    type FILE;
    let stdout: FILE;
    function getenv(name: String): String?;
    function fflush(f: FILE): int32;
    function strlen(text: byte*): uint64;
    function exit(code: int32): void;
}

/** The number the system gives this running program (its process id). */
public function processId(): int64 { return hostProcessId(); }

/** The value of an environment variable, or null if it is not set. */
public function env(name: String): String? { return LibC.getenv(name); }

/** A zeroed buffer for C to write a path into. */
function pathBuffer(): byte[*] {
    let b: byte[*] = [];
    for (i in 0..4096) { b.push(0); }
    return b;
}

/** What C wrote into a buffer: up to its first zero byte. */
function cText(b: byte[]): String {
    return stringOfRange(b, 0, LibC.strlen(b) as int32);
}

/** The folder the program runs in. */
public function cwd(): String {
    let b: byte[*] = pathBuffer();
    return hostCwd(b) ? cText(b) : ".";
}

/** Runs a command with the system's shell (sh, or cmd.exe on Windows) and gives its exit code. */
public function run(command: String): int32 {
    LibC.fflush(LibC.stdout);
    return hostShell(command);
}

/** This program's executable (its full path), or "" if it cannot be known. */
public function programPath(): String {
    let b: byte[*] = pathBuffer();
    hostProgramPath(b);
    return cText(b).clone();
}

/** The folder this program's executable is in, or "" if it cannot be known. */
public function programDir(): String {
    let path: String = programPath();
    let cut: int32? = path.lastIndexOf("/");
    let back: int32? = path.lastIndexOf("\\");
    if (back != null && (cut == null || back! > cut!)) { cut = back; }
    return cut != null ? path.substring(0, cut!).clone() : "";
}

/** Ends the program now with this exit code (memories are not freed first). */
public function exit(code: int32): void {
    LibC.fflush(LibC.stdout);
    LibC.exit(code);
}

// ---- ending on request: Ctrl+C, SIGTERM (systemd, docker stop, kill) -------------------------

/**
 * From now on, Ctrl+C and SIGTERM (what systemd, docker stop and kill send) do not end the program at
 * once: they only make terminating() true, so the program can finish what it is doing and end on its own.
 * The servers of std.net look at it: they stop accepting, finish the connections they serve, and run()
 * returns. Nothing changes until this is called.
 */
public function catchTermination(): void { hostCatchTermination(); }

/** Whether Ctrl+C or SIGTERM arrived after catchTermination(). */
public function terminating(): bool { return hostTerminating(); }
