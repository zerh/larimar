// std.os: the environment the program runs in.
//
//   import std.os;
//   let home: String = os.env("HOME") ?? "/";
//
// The system is Platform.current(): OS.Linux, MacOS, Windows or another Unix. What differs between them
// is a class for each, marked with the platform it is for (implements UnixPlatform, LinuxPlatform,
// MacOSPlatform or WindowsPlatform), with the C of that system in its methods: its C reaches only that
// system's build. A switch on Platform.current() chooses the one that runs.

import std.os.posix { PosixSystem };
import std.os.macos { MacOSSystem };
import std.os.windows { WindowsSystem };

/** The systems Larimar runs on (Unix: another Unix, a BSD). */
public enum OS { Linux, MacOS, Windows, Unix }

/**
 * What a class is for: a class that implements one of these is for that platform. Its C (cinclude, ccode,
 * the C bodies of its methods) reaches only that system's build; elsewhere its methods with C panic.
 */
public interface Platform {
    /** The system this program was compiled for. */
    static function current(): OS {
        return switch (platformNumber()) {
            case 1 -> OS.Windows;
            case 2 -> OS.MacOS;
            case 3 -> OS.Linux;
            default -> OS.Unix;
        };
    }

    /** Its name: "linux", "macos", "windows" or "unix". */
    static function name(): String {
        return switch (Platform.current()) {
            case Linux -> "linux";
            case MacOS -> "macos";
            case Windows -> "windows";
            case Unix -> "unix";
        };
    }
}
public interface UnixPlatform extends Platform {}         // Linux, macOS and the other Unix
public interface LinuxPlatform extends UnixPlatform {}
public interface MacOSPlatform extends UnixPlatform {}
public interface WindowsPlatform extends Platform {}

/** Where Larimar learns the system: the C compiler's own macros (with --target, the compiler writes it). */
native function platformNumber(): int32 {
    #if defined(_WIN32)
    return 1;
    #elif defined(__APPLE__)
    return 2;
    #elif defined(__linux__)
    return 3;
    #else
    return 0;
    #endif
}

/** What std.os needs of the system: a class for each platform (std/os/posix.lar, macos.lar, windows.lar). */
public interface System {
    function processId(): int64;
    function cwd(into: byte[]): bool;
    function programPath(into: byte[]): void;
    function shell(command: String): int32;
    function catchTermination(): void;
    function terminating(): bool;
}

let host: System = switch (Platform.current()) {
    case Linux, Unix -> PosixSystem {};
    case MacOS -> MacOSSystem {};
    case Windows -> WindowsSystem {};
};

cinclude "<stdlib.h>";                 // getenv, exit (C declares them: no prototypes of ours)
cinclude "<string.h>";                 // strlen

native type CStream = FILE*;
native const stdout: CStream;
native function getenv(name: String): String?;
native function fflush(f: CStream): int32;
native function strlen(text: byte*): uint64;
native function cExit(code: int32): void = exit;

/** The number the system gives this running program (its process id). */
public function processId(): int64 { return host.processId(); }

/** The value of an environment variable, or null if it is not set. */
public function env(name: String): String? { return getenv(name); }

/** A zeroed buffer for C to write a path into. */
function pathBuffer(): byte[*] {
    let b: byte[*] = [];
    for (i in 0..4096) { b.push(0); }
    return b;
}

/** What C wrote into a buffer: up to its first zero byte. */
function cText(b: byte[]): String {
    return stringOfRange(b, 0, strlen(b) as int32);
}

/** The folder the program runs in. */
public function cwd(): String {
    let b: byte[*] = pathBuffer();
    return host.cwd(b) ? cText(b) : ".";
}

/** Runs a command with the system's shell (sh, or cmd.exe on Windows) and gives its exit code. */
public function run(command: String): int32 {
    fflush(stdout);
    return host.shell(command);
}

/** This program's executable (its full path), or "" if it cannot be known. */
public function programPath(): String {
    let b: byte[*] = pathBuffer();
    host.programPath(b);
    return cText(b).clone();
}

/** The folder this program's executable is in, or "" if it cannot be known. */
public function programDir(): String {
    let path: String = programPath();
    let cut: int32? = path.lastIndexOf("/");
    let back: int32? = path.lastIndexOf("\\");
    if (back != null && (cut == null || back! > cut!)) { cut = back; }
    return cut != null ? path.substring(0, cut!).clone() : "";
}

/** Ends the program now with this exit code (memories are not freed first). */
public function exit(code: int32): void {
    fflush(stdout);
    cExit(code);
}

// ---- ending on request: Ctrl+C, SIGTERM (systemd, docker stop, kill) -------------------------

/**
 * From now on, Ctrl+C and SIGTERM (what systemd, docker stop and kill send) do not end the program at
 * once: they only make terminating() true, so the program can finish what it is doing and end on its own.
 * The servers of std.net look at it: they stop accepting, finish the connections they serve, and run()
 * returns. Nothing changes until this is called.
 */
public function catchTermination(): void { host.catchTermination(); }

/** Whether Ctrl+C or SIGTERM arrived after catchTermination(). */
public function terminating(): bool { return host.terminating(); }
