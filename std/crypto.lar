// std.crypto: hashes, HMAC and secure random bytes, written in Larimar (only the random bytes come from
// the system).
//
//   import std.crypto as Crypto;
//   import std.encoding.hex as Hex;
//   println(Hex.encode(Crypto.sha256("hola".bytes())));       // b221d9db...
//   let mac: byte[*] = Crypto.hmacSha256(key.bytes(), body.bytes());
//   let session: byte[*] = Crypto.randomBytes(32);            // for session ids, CSRF tokens, salts
//
// SHA-1 is broken for signatures: it is here for protocols that need it (the WebSocket handshake). For
// anything new, SHA-256. The results are new lists, created where the caller puts them.

c_code {
#if defined(_WIN32)
    #include <windows.h>
    BOOLEAN NTAPI SystemFunction036(PVOID buffer, ULONG length);     /* RtlGenRandom, in advapi32 */
    static int32_t lm_random_fill(uint8_t* items, int32_t length) {
        return SystemFunction036(items, (ULONG)length) ? 0 : 1;
    }
#elif defined(__APPLE__)
    #include <stdlib.h>
    void arc4random_buf(void* buffer, size_t length);   /* declared here: -std=c99 hides it in stdlib.h */
    static int32_t lm_random_fill(uint8_t* items, int32_t length) {
        arc4random_buf(items, (size_t)length);
        return 0;
    }
#else
    #include <stdio.h>
    static int32_t lm_random_fill(uint8_t* items, int32_t length) {
        FILE* f = fopen("/dev/urandom", "rb");
        if (!f) return 1;
        size_t n = fread(items, 1, (size_t)length, f);
        fclose(f);
        return n == (size_t)length ? 0 : 1;
    }
#endif
}

native function lm_random_fill(buffer: byte[]): int32;

/** n bytes from the system's secure random source (it panics if there is none: it never gives weak bytes). */
public function randomBytes(n: int32): byte[*] {
    let out: byte[*] = zeros(n);
    if (n > 0 && lm_random_fill(out) != 0) { panic("std.crypto: the system gave no random bytes"); }
    return out;
}

/** The SHA-256 of some bytes: 32 bytes. */
public function sha256(data: byte[]): byte[*] {
    let k: uint32[64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ];
    let h: uint32[8] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    let message: byte[*] = padded(data, true);
    let w: uint32[64] = [];
    for (i in 0..64) { w.push(0); }
    let block: int32 = 0;
    while (block < message.length) {
        for (t in 0..16) { w[t] = word(message, block + t * 4); }
        for (t in 16..64) {
            let s0: uint32 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3);
            let s1: uint32 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w[t] = w[t - 16] + s0 + w[t - 7] + s1;
        }
        let a: uint32 = h[0];
        let b: uint32 = h[1];
        let c: uint32 = h[2];
        let d: uint32 = h[3];
        let e: uint32 = h[4];
        let f: uint32 = h[5];
        let g: uint32 = h[6];
        let hh: uint32 = h[7];
        for (t in 0..64) {
            let t1: uint32 = hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (~e & g)) + k[t] + w[t];
            let t2: uint32 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }
        h[0] = h[0] + a;
        h[1] = h[1] + b;
        h[2] = h[2] + c;
        h[3] = h[3] + d;
        h[4] = h[4] + e;
        h[5] = h[5] + f;
        h[6] = h[6] + g;
        h[7] = h[7] + hh;
        block += 64;
    }
    return bigEndian(h);
}

/** The SHA-1 of some bytes: 20 bytes. Only for protocols that ask for it (WebSocket). */
public function sha1(data: byte[]): byte[*] {
    let h: uint32[5] = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0];
    let message: byte[*] = padded(data, true);
    let w: uint32[80] = [];
    for (i in 0..80) { w.push(0); }
    let block: int32 = 0;
    while (block < message.length) {
        for (t in 0..16) { w[t] = word(message, block + t * 4); }
        for (t in 16..80) { w[t] = rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1); }
        let a: uint32 = h[0];
        let b: uint32 = h[1];
        let c: uint32 = h[2];
        let d: uint32 = h[3];
        let e: uint32 = h[4];
        for (t in 0..80) {
            let f: uint32 = 0;
            let k: uint32 = 0;
            if (t < 20) {
                f = (b & c) | (~b & d);
                k = 0x5A827999;
            } else if (t < 40) {
                f = b ^ c ^ d;
                k = 0x6ED9EBA1;
            } else if (t < 60) {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8F1BBCDC;
            } else {
                f = b ^ c ^ d;
                k = 0xCA62C1D6;
            }
            let temp: uint32 = rotl(a, 5) + f + e + k + w[t];
            e = d;
            d = c;
            c = rotl(b, 30);
            b = a;
            a = temp;
        }
        h[0] = h[0] + a;
        h[1] = h[1] + b;
        h[2] = h[2] + c;
        h[3] = h[3] + d;
        h[4] = h[4] + e;
        block += 64;
    }
    return bigEndian(h);
}

/** HMAC-SHA256 (RFC 2104): a signature of `data` with `key`, 32 bytes. For signed cookies and tokens. */
public function hmacSha256(key: byte[], data: byte[]): byte[*] {
    let k: byte[*] = [];
    if (key.length > 64) {
        for (b in sha256(key)) { k.push(b); }
    } else {
        for (b in key) { k.push(b); }
    }
    while (k.length < 64) { k.push(0); }
    let inner: byte[*] = [];
    for (b in k) { inner.push(b ^ 0x36); }
    for (b in data) { inner.push(b); }
    let innerHash: byte[*] = sha256(inner);
    let outer: byte[*] = [];
    for (b in k) { outer.push(b ^ 0x5c); }
    for (b in innerHash) { outer.push(b); }
    return sha256(outer);
}

/** Whether two byte lists are equal, taking the same time wherever they differ (to compare signatures). */
public function sameBytes(a: byte[], b: byte[]): bool {
    if (a.length != b.length) { return false; }
    let diff: byte = 0;
    for (i in 0..a.length) { diff = diff | (a[i] ^ b[i]); }
    return diff == 0;
}

// ---- helpers ----------------------------------------------------------------------------------

function zeros(n: int32): byte[*] {
    let out: byte[*] = [];
    for (i in 0..n) { out.push(0); }
    return out;
}

/** The message with its padding: 0x80, zeros, and its length in bits (big-endian), to a multiple of 64 bytes. */
function padded(data: byte[], bigEndian: bool): byte[*] {
    let out: byte[*] = [];
    for (b in data) { out.push(b); }
    out.push(0x80);
    while (out.length % 64 != 56) { out.push(0); }
    let bits: uint64 = (data.length as uint64) * 8;
    let shift: int32 = 56;
    while (shift >= 0) {
        out.push(((bits >> (shift as uint64)) & 0xff) as byte);
        shift -= 8;
    }
    return out;
}

function word(m: byte[], at: int32): uint32 {
    return ((m[at] as uint32) << 24) | ((m[at + 1] as uint32) << 16) | ((m[at + 2] as uint32) << 8) | (m[at + 3] as uint32);
}

/** The bytes of some 32-bit words, most significant first. */
function bigEndian(words: uint32[]): byte[*] {
    let out: byte[*] = [];
    for (x in words) {
        out.push(((x >> 24) & 0xff) as byte);
        out.push(((x >> 16) & 0xff) as byte);
        out.push(((x >> 8) & 0xff) as byte);
        out.push((x & 0xff) as byte);
    }
    return out;
}

function rotr(x: uint32, n: uint32): uint32 { return (x >> n) | (x << (32 - n)); }
function rotl(x: uint32, n: uint32): uint32 { return (x << n) | (x >> (32 - n)); }
