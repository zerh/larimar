// std.toml: TOML text to Any, and Any to TOML text.
//
//   import std.toml as Toml;
//   let config: Any = Toml.parse(Files.readString("larimar.toml"));
//   println(config.project.name as String ?? "?");
//   println(Toml.stringify({ project: { name: "demo", version: "1.0.0" } }));
//
// The part of TOML that configuration files use: [sections] (also [a.b], a table inside a table),
// key = value, where a value is a "string", a whole number, true or false, or a list of those
// ([...], which may span several lines). Comments start with #. Keys are letters, digits, '_' and '-'.
//
// A section becomes a table with named entries; a list, a table with positions. The entries keep the
// order of the file.

import std.text { isIdentifierPart, isDigit };

/** The text is not valid TOML: the line (from 1) and why. */
public enum TomlError { Invalid(line: int32, why: String) }

/** A message for the error: "line 3: Expected key = value". */
public function message(e: TomlError): String {
    return switch (e) {
        case Invalid { line, why } -> "line ${line}: ${why}";
    };
}

/** The tables of a TOML text: keys before any [section] go in the top table. */
public function parse(text: String): Any throws TomlError {
    let root: Any = {};
    let sectionNames: String[*] = [];
    let currentName: String = "";
    let lines: String[*] = splitLines(text);
    let i: int32 = 0;
    while (i < lines.length) {
        let lineNumber: int32 = i + 1;
        let line: String = stripComment(lines[i]).trim();
        if (line.isEmpty()) {
            i += 1;
            continue;
        }
        if (line.startsWith("[")) {
            if (!line.endsWith("]")) { fail(lineNumber, "Expected ']' to close the section name"); }
            let name: String = line.substring(1, line.length - 1).trim();
            if (!isSectionName(name)) { fail(lineNumber, "Invalid section name [${name}]"); }
            for (seen in sectionNames) {
                if (seen == name) { fail(lineNumber, "Section [${name}] appears twice"); }
            }
            sectionNames.push(name.clone());
            currentName = name.clone();
            tableAt(root, currentName, lineNumber);
            i += 1;
            continue;
        }
        let equals: int32 = line.indexOf("=") ?? -1;
        if (equals < 0) { fail(lineNumber, "Expected key = value"); }
        let key: String = line.substring(0, equals).trim();
        if (!isKey(key)) { fail(lineNumber, "Invalid key '${key}'"); }
        let value: String = line.substring(equals + 1).trim();
        if (value.startsWith("[")) {              // a list may continue on the next lines
            while (!closed(value) && i + 1 < lines.length) {
                i += 1;
                value = "${value} ${stripComment(lines[i]).trim()}";
            }
        }
        let table: Any = tableAt(root, currentName, lineNumber);
        if (table.containsKey(key)) {
            fail(lineNumber, "Key '${key}' appears twice in [${currentName}]");
        }
        table[key] = parseValue(value, lineNumber);
        i += 1;
    }
    return root;
}

/** The TOML text of a table: its plain entries first, then one [section] for each table inside it. */
public function stringify(root: Any): String {
    let sb: StringBuilder = {};
    writeTable(sb, root, "");
    return sb.toString().clone();
}

// =========================================================================================
// Reading
// =========================================================================================

function fail(line: int32, why: String): void throws TomlError {
    throw TomlError.Invalid { line: line, why: why.clone() in default };
}

/** The table of a section ("a.b": the table b inside a), made when it is not there yet. */
function tableAt(root: Any, name: String, line: int32): Any throws TomlError {
    let table: Any = root;
    if (name == "") { return table; }
    for (part in name.split(".")) {
        let inside: Any = table[part];
        if (inside == null) {
            table[part] = {};
        } else if (!isTable(inside)) {
            fail(line, "'${part}' is a value, not a section");
        }
        table = table[part];
    }
    return table;
}

/** A table with named entries (a section), not a list. */
function isTable(v: Any): bool {
    return switch (v) {
        case Any t -> t.length == 0;
        default -> false;
    };
}

function splitLines(text: String): String[*] {
    let out: String[*] = [];
    for (part in text.split("\n")) {
        out.push((part.endsWith("\r") ? part.substring(0, part.length - 1) : part).clone());
    }
    return out;
}

function isKey(key: String): bool {
    if (key.isEmpty()) { return false; }
    for (b in key) {
        if (!isIdentifierPart(b) && b != '-') { return false; }
    }
    return true;
}

function isSectionName(name: String): bool {
    if (name.isEmpty()) { return false; }
    for (part in name.split(".")) {
        if (!isKey(part)) { return false; }
    }
    return true;
}

function isNumber(v: String): bool {
    let digits: int32 = 0;
    for (i, b in v) {
        if ((b == '+' || b == '-') && i == 0) { continue; }
        if (isDigit(b)) { digits += 1; } else if (b != '_') { return false; }
    }
    return digits > 0;
}

const VALUES: String = "use \"text\", a number, true/false or [\"a\", \"b\"]";

function parseValue(v: String, line: int32): Any throws TomlError {
    if (v.startsWith("\"")) { return string(v, line); }
    if (v == "true") { return true; }
    if (v == "false") { return false; }
    if (isNumber(v)) {
        let n: int64? = v.replace("_", "").replace("+", "").toInt();
        if (n == null) { fail(line, "Unknown value '${v}' (${VALUES})"); }
        return n!;
    }
    if (v.startsWith("[")) {
        if (!closed(v)) { fail(line, "Expected ']' to close the list"); }
        let inner: String = v.substring(1, v.lastIndexOf("]") ?? 1).trim();
        let list: Any = {};
        let i: int32 = 0;
        while (i < inner.length) {
            let c: byte = inner[i];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == ',') {
                i += 1;
                continue;
            }
            let end: int32 = c == '"' ? closingQuote(inner, i) : itemEnd(inner, i);
            if (end < 0) { fail(line, "Unterminated string"); }
            let item: String = inner.substring(i, end + 1).trim();
            if (item.startsWith("[")) { fail(line, "A list goes inside a list only as text: [\"a\", \"b\"]"); }
            list.push(parseValue(item, line));
            i = end + 1;
        }
        return list;
    }
    fail(line, "Unknown value '${v}' (${VALUES})");
    return null;
}

/** Where an item of a list that is not a string ends (its last byte). */
function itemEnd(s: String, start: int32): int32 {
    let i: int32 = start;
    while (i + 1 < s.length && s[i + 1] != ',') { i += 1; }
    return i;
}

function string(v: String, line: int32): String throws TomlError {
    let end: int32 = closingQuote(v, 0);
    if (end != v.length - 1) { fail(line, "Invalid string ${v}"); }
    let sb: StringBuilder = {};
    let i: int32 = 1;
    while (i < end) {
        let c: byte = v[i];
        if (c == '\\' && i + 1 < end) {
            i += 1;
            let n: byte = v[i];
            if (n == 'n') { sb.add("\n"); } else if (n == 't') { sb.add("\t"); } else { sb.add(v.substring(i, i + 1)); }
        } else {
            sb.add(v.substring(i, i + 1));
        }
        i += 1;
    }
    return sb.toString().clone();
}

function closingQuote(s: String, open: int32): int32 {
    let i: int32 = open + 1;
    while (i < s.length) {
        if (s[i] == '\\') { i += 1; } else if (s[i] == '"') { return i; }
        i += 1;
    }
    return -1;
}

/** Whether a list's ']' is there (outside its strings). */
function closed(v: String): bool {
    let inString: bool = false;
    let i: int32 = 0;
    while (i < v.length) {
        let c: byte = v[i];
        if (inString && c == '\\') {
            i += 1;
        } else if (c == '"') {
            inString = !inString;
        } else if (!inString && c == ']') {
            return true;
        }
        i += 1;
    }
    return false;
}

function stripComment(line: String): String {
    let inString: bool = false;
    let i: int32 = 0;
    while (i < line.length) {
        let c: byte = line[i];
        if (inString && c == '\\') {
            i += 1;
        } else if (c == '"') {
            inString = !inString;
        } else if (!inString && c == '#') {
            return line.substring(0, i);
        }
        i += 1;
    }
    return line;
}

// =========================================================================================
// Writing
// =========================================================================================

/** The plain entries of a table, then its tables as [name] sections (`prefix` is the name of this one). */
function writeTable(sb: StringBuilder, table: Any, prefix: String): void {
    for (key, value in table.fields) {
        if (!isTable(value) || isEmptyList(value)) {
            sb.add("${key} = ");
            writeValue(sb, value);
            sb.add("\n");
        }
    }
    for (key, value in table.fields) {
        if (isTable(value) && !isEmptyList(value)) {
            let name: String = prefix == "" ? key : "${prefix}.${key}";
            if (hasPlainEntries(value) || !hasTables(value)) {      // a table of only tables needs no header of its own
                if (sb.toString() != "") { sb.add("\n"); }
                sb.add("[${name}]\n");
            }
            writeTable(sb, value, name);
        }
    }
}

function hasPlainEntries(table: Any): bool {
    for (key, value in table.fields) {
        if (!isTable(value) || isEmptyList(value)) { return true; }
    }
    return false;
}

function hasTables(table: Any): bool {
    for (key, value in table.fields) {
        if (isTable(value) && !isEmptyList(value)) { return true; }
    }
    return false;
}

/** An empty table: written as an empty list (it has no section to be). */
function isEmptyList(v: Any): bool {
    if (!isTable(v)) { return false; }
    for (key, value in v.fields) { return false; }
    return true;
}

function writeValue(sb: StringBuilder, v: Any): void {
    switch (v) {
        case String s -> { writeString(sb, s); }
        case bool b -> { sb.add(b ? "true" : "false"); }
        case int64 n -> { sb.add("${n}"); }
        case Any list -> {
            sb.add("[");
            for (i, item in list) {
                if (i > 0) { sb.add(", "); }
                writeValue(sb, item);
            }
            sb.add("]");
        }
        default -> { sb.add("\"\""); }
    }
}

function writeString(sb: StringBuilder, s: String): void {
    sb.add("\"");
    for (b in s) {
        if (b == '"') { sb.add("\\\""); }
        else if (b == '\\') { sb.add("\\\\"); }
        else if (b == '\n') { sb.add("\\n"); }
        else if (b == '\t') { sb.add("\\t"); }
        else { sb.add(stringOfRange([b], 0, 1)); }
    }
    sb.add("\"");
}
