// std.io.files.windows: folders on Windows (_mkdir, FindFirstFile).

import std.io.files { FolderSystem };
import std.os { WindowsPlatform };

public class WindowsFolders implements FolderSystem, WindowsPlatform {
    cinclude "<winsock2.h>";        // before windows.h (it includes it): no clash with the old winsock.h
    cinclude "<windows.h>";
    cinclude "<direct.h>";
    cinclude "<io.h>";

    ccode {
        typedef struct LmFind { HANDLE h; WIN32_FIND_DATAA data; int pending; } LmFind;
    }

    native function makeDirectory(path: String): int32 { return _mkdir(path); }

    native function removeDirectory(path: String): int32 { return _rmdir(path); }

    native function makeWritable(path: String): void { _chmod(path, _S_IWRITE); }

    native function copyPermissions(from: String, to: String): void { (void)from; (void)to; }

    native function listOpen(path: String): int64 {
        size_t n = strlen(path);
        char* pattern = (char*)malloc(n + 3);
        LmFind* f = (LmFind*)calloc(1, sizeof(LmFind));
        if (pattern == NULL || f == NULL) { free(pattern); free(f); return 0; }
        memcpy(pattern, path, n);
        memcpy(pattern + n, "\\*", 3);
        f->h = FindFirstFileA(pattern, &f->data);
        free(pattern);
        if (f->h == INVALID_HANDLE_VALUE) { free(f); return 0; }
        f->pending = 1;
        return (int64_t)(intptr_t)f;
    }

    native function listNext(list: int64, into: byte[]): bool {
        LmFind* f = (LmFind*)(intptr_t)list;
        if (!f->pending && !FindNextFileA(f->h, &f->data)) return false;
        f->pending = 0;
        snprintf((char*)into, (size_t)into_length, "%s", f->data.cFileName);
        return true;
    }

    native function listClose(list: int64): void {
        LmFind* f = (LmFind*)(intptr_t)list;
        FindClose(f->h);
        free(f);
    }
}
