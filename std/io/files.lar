// std.io.files: files and folders: whole files in one call, like Java's Files, and an open File to read
// or write in parts.
//
//   import std.io.files as Files;
//   import std.io.files { File };
//   let text: String = Files.readString("notes.txt");
//   Files.writeString("copy.txt", text);
//   let f: File = Files.open("notes.txt");
//   while (true) { let line: String? = f.readLine(); if (line == null) { break; } ... }
//
// A File closes itself when the memory it lives in is freed (the end of the block that keeps it), so it
// is never left open; close() closes it earlier.
//
// What these functions give lives where the call says (Files.readString(path) in memory), or in
// the memory of the block that keeps it. Everything that can fail throws IoError. Written in Larimar
// over the C functions of the system (stdio, stat, mkdir, opendir; FindFirstFile on Windows).

import std.io { IoError, raise, InputStream, OutputStream };
import std.io as Io;

c_include "<errno.h>";
c_include "<sys/stat.h>";
#when unix
    c_include "<unistd.h>";
    c_include "<dirent.h>";
#when windows
    c_include "<winsock2.h>";        // before windows.h (it includes it): no clash with the old winsock.h
    c_include "<windows.h>";
    c_include "<direct.h>";
    c_include "<io.h>";
#end

/** A C FILE*, closed when its memory is freed. */
extern type FileHandle = c "FILE*" released by fclose;
extern function fclose(f: FileHandle): int32;
extern function fopen(path: String, mode: String): FileHandle?;
extern function fread(into: byte*, size: uint64, count: uint64, f: FileHandle): uint64;
extern function fwrite(from: byte*, size: uint64, count: uint64, f: FileHandle): uint64;
extern function fflush(f: FileHandle): int32;
extern function ferror(f: FileHandle): int32;
extern function fgetc(f: FileHandle): int32;
extern type Untyped;
extern function fgets(into: byte*, size: int32, f: FileHandle): Untyped?;
extern function strlen(text: byte*): uint64;
extern const EOF: int32;

extern type Stat = struct "struct stat" { let st_mode: uint32; let st_size: int64; let st_mtime: int64; };
extern function stat(path: String, into: Stat*): int32;
extern function remove(path: String): int32;
#when unix
    extern function mkdir(path: String, mode: uint32): int32;
    extern function rmdir(path: String): int32;
    extern function chmod(path: String, mode: uint32): int32;
#when windows
    extern function _mkdir(path: String): int32;
    extern function _rmdir(path: String): int32;
    extern function _chmod(path: String, mode: int32): int32;
    extern const _S_IWRITE: int32;
#end

/** A folder being read (Unix), closed when its memory is freed. */
extern type Dir released by closedir;
extern type DirEntry = struct "struct dirent" { let d_name: String; };
extern function opendir(path: String): Dir?;
extern function readdir(d: Dir): DirEntry*;
#when unix
    extern function closedir(d: Dir): int32;
#end

/** A folder being read (Windows), closed when its memory is freed. */
extern type FindHandle released by FindClose;                    // a HANDLE (void*)
extern type FindData = struct "WIN32_FIND_DATAA" { let cFileName: String; };
extern function FindFirstFileA(pattern: String, data: FindData*): FindHandle?;
#when windows
    extern function FindNextFileA(h: FindHandle, data: FindData*): int32;
    extern function FindClose(h: FindHandle): int32;
#end

extern let errno: int32;
extern const ENOENT: int32;
extern const ENOTDIR: int32;
extern const EACCES: int32;
extern const EPERM: int32;
extern const EEXIST: int32;
extern const S_IFMT: uint32;
extern const S_IFDIR: uint32;

/** A message for the error (the same as std.io's): "not found: notes.txt"... */
public function message(e: IoError): String { return Io.message(e); }

/** What went wrong with the last call, as a code of raise. */
function code(): int32 {
    let e: int32 = errno;
    if (e == ENOENT || e == ENOTDIR) { return 1; }
    if (e == EACCES || e == EPERM) { return 2; }
    return 3;
}

/** A buffer of n zero bytes, for fread. */
function bytes(n: int32): byte[*] {
    let b: byte[*] = [];
    for (i in 0..n) { b.push(0); }
    return b;
}

/** The whole file as text. */
public function readString(path: String): String throws IoError {
    let f: FileHandle? = fopen(path, "rb");
    if (f == null) { raise(code(), path); }
    let all: byte[*] = [];
    let chunk: byte[*] = bytes(65536);
    while (true) {
        let n: uint64 = fread(chunk, 1, chunk.length as uint64, f!);
        if (n == 0) { break; }
        for (i in 0..n as int32) { all.push(chunk[i]); }
    }
    let failed: bool = ferror(f!) != 0;
    release(f);
    if (failed) { raise(3, path); }
    return stringOfRange(all, 0, all.length);
}

function writeFile(path: String, text: String, mode: String): void throws IoError {
    let f: FileHandle? = fopen(path, mode);
    if (f == null) { raise(code(), path); }
    let n: uint64 = text.length as uint64;
    let ok: bool = n == 0 || fwrite(text.bytes(), 1, n, f!) == n;
    ok = fflush(f!) == 0 && ok;
    release(f);
    if (!ok) { raise(3, path); }
}

/** Replaces the file with `text`, creating it if needed. */
public function writeString(path: String, text: String): void throws IoError { writeFile(path, text, "wb"); }

/** Adds `text` at the end of the file, creating it if needed. */
public function appendString(path: String, text: String): void throws IoError { writeFile(path, text, "ab"); }

/** 0: nothing there; 1: a file; 2: a folder. */
function kind(path: String): int32 {
    let st: Stat = {};
    if (stat(path, &st) != 0) { return 0; }
    return (st.st_mode & S_IFMT) == S_IFDIR ? 2 : 1;
}

/** Is there a file or a folder with that path? */
public function exists(path: String): bool { return kind(path) != 0; }

public function isFile(path: String): bool { return kind(path) == 1; }

public function isDirectory(path: String): bool { return kind(path) == 2; }

/** When the file was last changed: seconds since 1970 (UTC), or 0 when there is nothing at that path. */
public function modifiedTime(path: String): int64 {
    let st: Stat = {};
    return stat(path, &st) == 0 ? st.st_mtime : 0;
}

/** The size of a file in bytes, or -1 when there is nothing at that path. */
public function size(path: String): int64 {
    let st: Stat = {};
    return stat(path, &st) == 0 ? st.st_size : -1;
}

/** The names of what a folder holds (files and folders, in no particular order). */
public function list(path: String): String[*] throws IoError {
    let names: String[*] = [];
    #when windows
        let data: FindData = {};
        let h: FindHandle? = FindFirstFileA("${path}\\*", &data);
        if (h == null) { raise(isDirectory(path) ? 2 : 1, path); }
        while (true) {
            let n: String = data.cFileName;               // a view of C's text: copied below
            if (n != "." && n != "..") { names.push(n.clone()); }
            if (FindNextFileA(h!, &data) == 0) { break; }
        }
        release(h);
    #else
        let d: Dir? = opendir(path);
        if (d == null) { raise(isDirectory(path) ? 2 : 1, path); }
        while (true) {
            let e: DirEntry* = readdir(d!);
            if (e == null) { break; }
            let n: String = e.d_name;                      // a view of C's text: copied below
            if (n != "." && n != "..") { names.push(n.clone()); }
        }
        release(d);
    #end
    return names;
}

/** Creates one folder; fine if it is already there. */
function makeDirectory(path: String): int32 {
    let r: int32 = 0;
    #when windows
        r = _mkdir(path);
    #else
        r = mkdir(path, 511);                             // 0777, less what the umask takes away
    #end
    if (r == 0) { return 0; }
    return errno == EEXIST && kind(path) == 2 ? 0 : code();
}

/** Creates the folder, and the folders above it that are missing. */
public function createDirectories(path: String): void throws IoError {
    let text: String = path.replace("\\", "/");
    for (i, b in text) {
        // not "C:" (a drive, on Windows): it is not a folder to create
        if (b == '/' && i > 0 && text[i - 1] != ':' && !isDirectory(text.substring(0, i))) { raise(makeDirectory(text.substring(0, i)), path); }
    }
    raise(makeDirectory(text), path);
}

/**
 * Copies a file (replacing `to` if it exists, even a read-only one, like cp -f); on Unix an executable
 * stays executable.
 */
public function copy(from: String, to: String): void throws IoError {
    let input: FileHandle? = fopen(from, "rb");
    if (input == null) { raise(code(), from); }
    if (kind(to) == 1) {                       // a copy kept read-only (Homebrew's libraries): a new file instead
        #when windows
            _chmod(to, _S_IWRITE);
        #end
        remove(to);
    }
    let output: FileHandle? = fopen(to, "wb");
    if (output == null) { raise(code(), to); }
    let chunk: byte[*] = bytes(65536);
    let ok: bool = true;
    while (ok) {
        let n: uint64 = fread(chunk, 1, chunk.length as uint64, input!);
        if (n == 0) { break; }
        ok = fwrite(chunk, 1, n, output!) == n;
    }
    ok = fflush(output!) == 0 && ok;
    release(input);
    release(output);
    if (!ok) { raise(3, from); }
    #when unix
        let st: Stat = {};
        if (stat(from, &st) == 0) { chmod(to, st.st_mode & 4095); }   // the permissions (07777)
    #end
}

/** Deletes a file, or an empty folder. */
public function delete(path: String): void throws IoError {
    let r: int32 = 0;
    if (kind(path) == 2) {
        #when windows
            r = _rmdir(path);
        #else
            r = rmdir(path);
        #end
    } else {
        r = remove(path);
    }
    if (r != 0) { raise(code(), path); }
}

// =========================================================================================
// An open file
// =========================================================================================

/** An open file. */
public class File implements InputStream, OutputStream {
    let file: FileHandle? = null;
    let path: String;
    let lineBuffer: byte[*] = [];             // for readLine (fgets): made the first time, kept

    /** The C file, or an IoError if it was closed. */
    function live(): FileHandle throws IoError {
        if (self.file == null) { throw IoError.Failed("${self.path} (closed)"); }
        return self.file!;
    }

    /** Fills buffer from its start (one fread); how many bytes, 0 at the end. */
    function read(buffer: byte[]): int32 throws IoError {
        let f: FileHandle = self.live();
        if (buffer.length == 0) { return 0; }
        let n: uint64 = fread(buffer, 1, buffer.length as uint64, f);
        if (n == 0 && ferror(f) != 0) { raise(3, self.path); }
        return n as int32;
    }

    /** The next line, without its end (\n, or \r\n); null at the end of the file. */
    function readLine(): String? throws IoError {
        let f: FileHandle = self.live();
        let b: byte[*] = self.lineBuffer;
        if (b.length == 0) {
            for (i in 0..4096) { b.push(0); }
        }
        if (fgets(b, b.length, f) == null) {             // nothing left
            if (ferror(f) != 0) { raise(3, self.path); }
            return null;
        }
        let n: int32 = strlen(b) as int32;
        if (n > 0 && b[n - 1] == '\n') {                 // the whole line: one copy, at its size
            let stop: int32 = n > 1 && b[n - 2] == '\r' ? n - 2 : n - 1;
            return stringOfRange(b, 0, stop);
        }
        let line: byte[*] = [];                          // longer than the buffer: gathered
        for (i in 0..n) { line.push(b[i]); }
        while (fgets(b, b.length, f) != null) {
            let k: int32 = strlen(b) as int32;
            for (i in 0..k) { line.push(b[i]); }
            if (k > 0 && b[k - 1] == '\n') { break; }
        }
        if (line.length > 0 && line[line.length - 1] == '\n') { line.pop(); }
        if (line.length > 0 && line[line.length - 1] == '\r') { line.pop(); }
        return stringOfRange(line, 0, line.length);
    }

    /** What is left of the file, as text. */
    function readAll(): String throws IoError {
        let f: FileHandle = self.live();
        let all: byte[*] = [];
        let chunk: byte[*] = [];
        for (i in 0..65536) { chunk.push(0); }
        while (true) {
            let n: uint64 = fread(chunk, 1, chunk.length as uint64, f);
            if (n == 0) { break; }
            for (i in 0..n as int32) { all.push(chunk[i]); }
        }
        if (ferror(f) != 0) { raise(3, self.path); }
        return stringOfRange(all, 0, all.length);
    }

    function write(bytes: byte[]): void throws IoError {
        let f: FileHandle = self.live();
        if (bytes.length == 0) { return; }
        if (fwrite(bytes, 1, bytes.length as uint64, f) != bytes.length as uint64) { raise(3, self.path); }
    }

    function writeText(text: String): void throws IoError { self.write(text.bytes()); }

    /** Writes what is waiting in C's buffer: an error here is an error writing the file. */
    function flush(): void throws IoError {
        if (fflush(self.live()) != 0) { raise(3, self.path); }
    }

    /** Closes the file now (what is in the buffer is written first); otherwise it is closed when its memory is freed. */
    function close(): void throws IoError {
        if (self.file == null) { return; }
        let ok: bool = fflush(self.file!) == 0;
        release(self.file);
        self.file = null;
        if (!ok) { raise(3, self.path); }
    }
}

/** Opens a file to read it. */
public function open(path: String): File throws IoError { return openWith(path, "rb"); }

/** Creates a file to write it (replacing it if it exists). */
public function create(path: String): File throws IoError { return openWith(path, "wb"); }

/** Opens a file to write at its end (creating it if needed). */
public function append(path: String): File throws IoError { return openWith(path, "ab"); }

function openWith(path: String, mode: String): File throws IoError {
    let f: File = { path: path.clone() };
    f.file = fopen(path, mode);
    if (f.file == null) { raise(code(), path); }
    return f;
}
