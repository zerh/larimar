// std.os.shared.windows: the shared memory of Windows (a named file mapping), and its clock.

import std.os.shared.common;
import std.platform { WindowsPlatform };

/** Shared memory on Windows: a mapping of the paging file, by name; it goes when no program has it open. */
public class WindowsShared implements WindowsPlatform {
    cinclude "<windows.h>";

    ccode {
        #if defined(__TINYC__)
        ULONGLONG WINAPI GetTickCount64(void);
        #endif

        static void lm_shm_sys_name(LmShared* s, const char* name) { snprintf(s->name, sizeof s->name, "Local\\lar.%s", name); }

        static void lm_shm_sys_text(LmShared* s) {
            DWORD e = GetLastError();
            snprintf(s->text, sizeof s->text, "system error %lu", (unsigned long)e);
        }

        static int lm_shm_sys_map(LmShared* s, HANDLE m, size_t size) {
            void* p = MapViewOfFile(m, FILE_MAP_ALL_ACCESS, 0, 0, size);
            if (!p) {
                lm_shm_sys_text(s);
                CloseHandle(m);
                return -5;
            }
            s->sys = (intptr_t)m;
            s->head = (LmShmHead*)p;
            return 0;
        }

        static int lm_shm_sys_create(LmShared* s) {
            unsigned long long size = (unsigned long long)s->size;
            HANDLE m = CreateFileMappingA(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, (DWORD)(size >> 32), (DWORD)size, s->name);
            if (!m) {
                lm_shm_sys_text(s);
                return -5;
            }
            if (GetLastError() == ERROR_ALREADY_EXISTS) {
                CloseHandle(m);
                return -6;
            }
            return lm_shm_sys_map(s, m, s->size);
        }

        static int lm_shm_sys_open(LmShared* s) {
            HANDLE m = OpenFileMappingA(FILE_MAP_ALL_ACCESS, FALSE, s->name);
            if (!m) {
                if (GetLastError() == ERROR_FILE_NOT_FOUND) return -4;
                lm_shm_sys_text(s);
                return -5;
            }
            int r = lm_shm_sys_map(s, m, 0);                 /* 0: all of it */
            if (r != 0) return r;
            MEMORY_BASIC_INFORMATION info;
            s->size = VirtualQuery((void*)s->head, &info, sizeof info) ? (size_t)info.RegionSize : 0;
            return 0;
        }

        static void lm_shm_sys_unlink(LmShared* s) { (void)s; }     /* the name goes with the last handle */

        static void lm_shm_sys_unmap(LmShared* s) {
            if (s->head) UnmapViewOfFile((void*)s->head);
            if (s->sys != -1) CloseHandle((HANDLE)s->sys);
            s->head = NULL;
            s->data = NULL;
            s->sys = -1;
        }

        static int64_t lm_shm_sys_pid(void) { return (int64_t)GetCurrentProcessId(); }

        static int lm_shm_sys_alive(int64_t pid) {
            HANDLE p = OpenProcess(SYNCHRONIZE, FALSE, (DWORD)pid);
            if (!p) return GetLastError() == ERROR_ACCESS_DENIED;
            DWORD r = WaitForSingleObject(p, 0);
            CloseHandle(p);
            return r == WAIT_TIMEOUT;
        }

        static void lm_shm_sys_nap(int step) {
            if (step < 500) {
                SwitchToThread();
            } else {
                Sleep(1);
            }
        }

        static long long lm_shm_sys_now(void) { return (long long)GetTickCount64(); }

        static long long lm_shm_sys_micros(void) {
            static LARGE_INTEGER frequency;
            LARGE_INTEGER now;
            if (frequency.QuadPart == 0) QueryPerformanceFrequency(&frequency);
            QueryPerformanceCounter(&now);
            return (long long)(now.QuadPart / frequency.QuadPart * 1000000 + now.QuadPart % frequency.QuadPart * 1000000 / frequency.QuadPart);
        }
    }

}
