// std.os.shared.common: the ring both systems share: one writer, one reader, in memory both programs map.
// Its own module so that its C comes before the classes of each system, which give it the memory, the
// clock and whether a program still runs (lm_shm_sys_*).
//
// The memory starts with a head (the counts and the state of each side), then the bytes. `head` is how
// many bytes were ever written and `tail` how many were ever read: only the writer moves head and only the
// reader moves tail, each with a release store that the other reads with an acquire load, so no lock is
// needed. What is between them is what can be read; capacity minus that is the room to write.

ccode {
    #define LM_OS_SHARED 1                  /* larimar build: -lrt on Linux (shm_open) */

    #if defined(__GNUC__) || defined(__clang__)
    #define LM_SHM_LOAD(p) __atomic_load_n((p), __ATOMIC_ACQUIRE)
    #define LM_SHM_STORE(p, v) __atomic_store_n((p), (v), __ATOMIC_RELEASE)
    #if defined(__x86_64__) || defined(__i386__)
    #define LM_SHM_PAUSE() __asm__ __volatile__("pause" ::: "memory")
    #elif defined(__aarch64__) || defined(__arm__)
    #define LM_SHM_PAUSE() __asm__ __volatile__("yield" ::: "memory")
    #else
    #define LM_SHM_PAUSE() __asm__ __volatile__("" ::: "memory")
    #endif
    #else                                   /* tcc (x86): its loads and stores keep their order; a fence for the rest */
    static void lm_shm_fence(void) { __asm__ __volatile__("mfence" ::: "memory"); }
    static int64_t lm_shm_load(volatile int64_t* p) { int64_t v = *p; lm_shm_fence(); return v; }
    static void lm_shm_store(volatile int64_t* p, int64_t v) { lm_shm_fence(); *p = v; lm_shm_fence(); }
    #define LM_SHM_LOAD(p) lm_shm_load((volatile int64_t*)(p))
    #define LM_SHM_STORE(p, v) lm_shm_store((volatile int64_t*)(p), (v))
    #define LM_SHM_PAUSE() lm_shm_fence()
    #endif

    #define LM_SHM_MAGIC 0x5352414c          /* "LARS" */
    #define LM_SHM_HEAD 256                  /* the bytes start after the head */

    typedef struct LmShmHead {
        int32_t magic;
        int32_t version;
        int64_t capacity;
        int64_t creator;                     /* the id of the program that created it */
        char pad0[40];
        volatile int64_t head;               /* bytes written, ever: only the writer moves it */
        char pad1[56];
        volatile int64_t tail;               /* bytes read, ever: only the reader moves it */
        char pad2[56];
        volatile int64_t state[2];           /* writer, reader: 0 not there yet, 1 open, 2 closed */
        volatile int64_t pid[2];             /* their programs */
        volatile int64_t ready;              /* 1 once the creator wrote the head */
    } LmShmHead;

    typedef struct LmShared {
        int error;                           /* 0, or what lm_shm_create/open met (the codes of read and write) */
        char text[160];
        int reader;                          /* the side of this program: 1 reader, 0 writer */
        int creator;                         /* this program created the name (and frees it) */
        int closed;
        int unlinked;
        char name[64];                       /* the system's name of the memory */
        LmShmHead* head;
        unsigned char* data;
        int64_t capacity;
        size_t size;
        intptr_t sys;                        /* the system's handle of the memory */
        long long checked;                   /* when the other side was last seen running */
    } LmShared;

    /* What each system gives (std.os.shared.posix, std.os.shared.windows). */
    static int lm_shm_sys_create(LmShared* s);          /* 0, -6 when the name exists, -5 (text) */
    static int lm_shm_sys_open(LmShared* s);            /* 0, -4 when it does not exist, -5 (text) */
    static void lm_shm_sys_unlink(LmShared* s);
    static void lm_shm_sys_unmap(LmShared* s);
    static int64_t lm_shm_sys_pid(void);
    static int lm_shm_sys_alive(int64_t pid);
    static void lm_shm_sys_nap(int step);               /* a short sleep, longer as step grows */
    static long long lm_shm_sys_now(void);              /* ms from a fixed moment */
    static long long lm_shm_sys_micros(void);           /* µs from a fixed moment */
    static void lm_shm_sys_name(LmShared* s, const char* name);

    static LmShared* lm_shm_new(const char* name, int reader) {
        LmShared* s = (LmShared*)calloc(1, sizeof(LmShared));
        if (!s) return NULL;
        s->reader = reader;
        s->sys = -1;
        lm_shm_sys_name(s, name);
        return s;
    }

    /* The other side's state: 0 not there yet, 1 open, 2 closed, 3 its program ended without closing. */
    static int lm_shm_peer(LmShared* s, int force) {
        int other = s->reader ? 0 : 1;
        int st = (int)LM_SHM_LOAD(&s->head->state[other]);
        if (st != 1) return st;
        long long now = lm_shm_sys_now();
        if (force || now - s->checked >= 50) {
            s->checked = now;
            int64_t pid = LM_SHM_LOAD(&s->head->pid[other]);
            if (pid > 0 && !lm_shm_sys_alive(pid)) return 3;
        }
        return 1;
    }

    /* The other side opened it (and freed the name): nothing is left to free if a program ends. */
    static void lm_shm_forget(LmShared* s) {
        if (s->creator && !s->unlinked) {
            lm_shm_sys_unlink(s);
            s->unlinked = 1;
        }
    }

    static void lm_shm_attach(LmShared* s) {
        int me = s->reader ? 1 : 0;
        LM_SHM_STORE(&s->head->pid[me], lm_shm_sys_pid());
        LM_SHM_STORE(&s->head->state[me], 1);
        s->data = (unsigned char*)s->head + LM_SHM_HEAD;
        s->capacity = s->head->capacity;
        s->checked = lm_shm_sys_now();
    }

    static LmShared* lm_shm_create(const char* name, long long capacity, int reader) {
        LmShared* s = lm_shm_new(name, reader);
        if (!s) return NULL;
        s->size = (size_t)(LM_SHM_HEAD + capacity);
        int r = lm_shm_sys_create(s);
        if (r == -6) {                       /* the name is there: a stream of a program that ended is taken back */
            size_t wanted = s->size;
            if (lm_shm_sys_open(s) == 0) {
                int64_t creator = LM_SHM_LOAD(&s->head->creator);
                int stale = LM_SHM_LOAD(&s->head->ready) == 1 && creator > 0 && !lm_shm_sys_alive(creator);
                lm_shm_sys_unmap(s);
                if (!stale) {
                    s->error = -5;
                    snprintf(s->text, sizeof s->text, "the name is in use by another program");
                    return s;
                }
                lm_shm_sys_unlink(s);
            }
            s->size = wanted;
            r = lm_shm_sys_create(s);
        }
        if (r != 0) {
            s->error = r == -6 ? -5 : r;
            if (r == -6) snprintf(s->text, sizeof s->text, "the name is in use by another program");
            return s;
        }
        s->creator = 1;
        LmShmHead* h = s->head;
        h->magic = LM_SHM_MAGIC;
        h->version = 1;
        h->capacity = capacity;
        h->creator = lm_shm_sys_pid();
        h->head = 0;
        h->tail = 0;
        lm_shm_attach(s);
        LM_SHM_STORE(&h->ready, 1);
        return s;
    }

    static LmShared* lm_shm_open(const char* name, int reader, int ms) {
        LmShared* s = lm_shm_new(name, reader);
        if (!s) return NULL;
        long long until = lm_shm_sys_now() + ms;
        int step = 0;
        for (;;) {
            int r = lm_shm_sys_open(s);
            if (r == 0 && LM_SHM_LOAD(&s->head->ready) == 1) break;
            if (r == 0) lm_shm_sys_unmap(s);                 /* created, but its head is not written yet */
            if (r != 0 && r != -4) { s->error = r; return s; }
            if (lm_shm_sys_now() >= until) { s->error = -4; return s; }
            lm_shm_sys_nap(step++);
        }
        LmShmHead* h = s->head;
        if (h->magic != LM_SHM_MAGIC || h->version != 1) {
            lm_shm_sys_unmap(s);
            s->error = -5;
            snprintf(s->text, sizeof s->text, "it is not a stream of Larimar");
            return s;
        }
        int me = reader ? 1 : 0;
        if (LM_SHM_LOAD(&h->state[me]) != 0) {
            lm_shm_sys_unmap(s);
            s->error = -5;
            snprintf(s->text, sizeof s->text, "it already has a %s", reader ? "reader" : "writer");
            return s;
        }
        lm_shm_attach(s);
        lm_shm_sys_unlink(s);                /* both sides are there: the name is not needed any more */
        s->unlinked = 1;
        return s;
    }

    static int lm_shm_error(LmShared* s) { return s->error; }
    static const char* lm_shm_error_text(LmShared* s) { return s->text; }
    static long long lm_shm_capacity(LmShared* s) { return s->head ? s->capacity : 0; }

    /*
     * Waits a little. For the first 100 µs it only spins: an answer usually comes within that, and a nap of
     * the system costs more than it. Then naps that grow, so a side that waits long uses no processor.
     */
    static void lm_shm_wait(int* step, long long* since) {
        if (*step == 0) *since = lm_shm_sys_micros();
        if (*since >= 0) {
            for (int i = 0; i < 64; i++) LM_SHM_PAUSE();
            if (lm_shm_sys_micros() - *since < 100) {
                *step += 1;
                return;
            }
            *since = -1;
            *step = 1;
        }
        lm_shm_sys_nap(*step);
        *step += 1;
    }

    /* Writes all: 0, or -1 (the reader closed it), -2 (time ran out), -3 (the reader's program ended). */
    static int lm_shm_write(LmShared* s, const char* bytes, long long count, int ms) {
        if (!s->head || s->closed) return -1;
        LmShmHead* h = s->head;
        long long until = ms > 0 ? lm_shm_sys_now() + ms : 0;
        int step = 0;
        long long since = 0;
        while (count > 0) {
            int64_t written = h->head;
            int64_t room = s->capacity - (written - LM_SHM_LOAD(&h->tail));
            int peer = lm_shm_peer(s, 0);
            if (peer == 2) return -1;
            if (peer == 3) return -3;
            if (peer == 1) lm_shm_forget(s);
            if (room <= 0) {
                if (until && lm_shm_sys_now() >= until) return -2;
                lm_shm_wait(&step, &since);
                continue;
            }
            step = 0;
            int64_t at = written % s->capacity;
            int64_t n = count < room ? count : room;
            if (n > s->capacity - at) n = s->capacity - at;     /* up to the end of the ring; the rest from its start */
            memcpy(s->data + at, bytes, (size_t)n);
            LM_SHM_STORE(&h->head, written + n);
            bytes += n;
            count -= n;
        }
        return 0;
    }

    /* Reads what is there (waiting for something): the count, 0 at the end, or -2 (time), -3 (the writer ended). */
    static int lm_shm_read(LmShared* s, char* into, int size, int ms) {
        if (!s->head || s->closed) return 0;
        LmShmHead* h = s->head;
        long long until = ms > 0 ? lm_shm_sys_now() + ms : 0;
        int step = 0;
        long long since = 0;
        for (;;) {
            int64_t taken = h->tail;
            int64_t ready = LM_SHM_LOAD(&h->head) - taken;
            if (ready > 0) {
                int64_t at = taken % s->capacity;
                int64_t n = ready < size ? ready : size;
                if (n > s->capacity - at) n = s->capacity - at;
                memcpy(into, s->data + at, (size_t)n);
                LM_SHM_STORE(&h->tail, taken + n);
                return (int)n;
            }
            int peer = lm_shm_peer(s, 0);
            if (peer == 1) lm_shm_forget(s);
            if (peer == 2 || peer == 3) {
                if (LM_SHM_LOAD(&h->head) - taken > 0) continue;     /* it wrote more before it left */
                return peer == 2 ? 0 : -3;
            }
            if (until && lm_shm_sys_now() >= until) return -2;
            lm_shm_wait(&step, &since);
        }
    }

    static long long lm_shm_available(LmShared* s) {
        if (!s->head || s->closed) return 0;
        return LM_SHM_LOAD(&s->head->head) - s->head->tail;
    }

    static void lm_shm_close(LmShared* s) {
        if (!s->head || s->closed) return;
        s->closed = 1;
        LM_SHM_STORE(&s->head->state[s->reader ? 1 : 0], 2);
        if (s->creator && !s->unlinked) {
            lm_shm_sys_unlink(s);
            s->unlinked = 1;
        }
    }

    /* When its memory is freed: closed, unmapped. */
    static void lm_shm_free(LmShared* s) {
        if (!s) return;
        if (s->head) {
            lm_shm_close(s);
            lm_shm_sys_unmap(s);
        }
        free(s);
    }
}
