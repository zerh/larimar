// std.os.shared.posix: the shared memory of Unix (shm_open, mmap), and its clock.

import std.os.shared.common;
import std.platform { UnixPlatform };

/** Shared memory on Unix: a name of shm_open, mapped with mmap. */
public class PosixShared implements UnixPlatform {
    cinclude "<sys/mman.h>";
    cinclude "<sys/stat.h>";
    cinclude "<fcntl.h>";
    cinclude "<unistd.h>";
    cinclude "<signal.h>";
    cinclude "<sys/wait.h>";
    cinclude "<errno.h>";
    cinclude "<time.h>";

    ccode {
        static void lm_shm_sys_name(LmShared* s, const char* name) { snprintf(s->name, sizeof s->name, "/lar.%s", name); }

        static int lm_shm_sys_map(LmShared* s, int fd) {
            void* p = mmap(NULL, s->size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
            close(fd);
            if (p == MAP_FAILED) {
                snprintf(s->text, sizeof s->text, "%s", strerror(errno));
                return -5;
            }
            s->head = (LmShmHead*)p;
            return 0;
        }

        static int lm_shm_sys_create(LmShared* s) {
            int fd = shm_open(s->name, O_RDWR | O_CREAT | O_EXCL, 0600);
            if (fd < 0) {
                if (errno == EEXIST) return -6;
                snprintf(s->text, sizeof s->text, "%s", strerror(errno));
                return -5;
            }
            if (ftruncate(fd, (off_t)s->size) != 0) {
                snprintf(s->text, sizeof s->text, "%s", strerror(errno));
                close(fd);
                shm_unlink(s->name);
                return -5;
            }
            int r = lm_shm_sys_map(s, fd);
            if (r != 0) shm_unlink(s->name);
            return r;
        }

        static int lm_shm_sys_open(LmShared* s) {
            int fd = shm_open(s->name, O_RDWR, 0600);
            if (fd < 0) {
                if (errno == ENOENT) return -4;
                snprintf(s->text, sizeof s->text, "%s", strerror(errno));
                return -5;
            }
            struct stat st;
            if (fstat(fd, &st) != 0 || st.st_size < LM_SHM_HEAD + 1) {       /* created, not sized yet */
                close(fd);
                return -4;
            }
            s->size = (size_t)st.st_size;
            return lm_shm_sys_map(s, fd);
        }

        static void lm_shm_sys_unlink(LmShared* s) { shm_unlink(s->name); }

        static void lm_shm_sys_unmap(LmShared* s) {
            if (s->head) munmap((void*)s->head, s->size);
            s->head = NULL;
            s->data = NULL;
        }

        static int64_t lm_shm_sys_pid(void) { return (int64_t)getpid(); }

        /* Whether a program runs. A child of this one that ended is still there until it is waited for:
           waitid with WNOWAIT sees that without taking its exit code from Process.wait. */
        static int lm_shm_sys_alive(int64_t pid) {
            siginfo_t info;
            memset(&info, 0, sizeof info);
            if (waitid(P_PID, (id_t)pid, &info, WEXITED | WNOHANG | WNOWAIT) == 0) return info.si_pid != (pid_t)pid;
            return kill((pid_t)pid, 0) == 0 || errno == EPERM;
        }

        static void lm_shm_sys_nap(int step) {
            long us = step < 50 ? 20 : step < 500 ? 100 : 1000;          /* 20 µs at first, up to 1 ms */
            struct timespec t = { 0, us * 1000 };
            nanosleep(&t, NULL);
        }

        static long long lm_shm_sys_micros(void) {
            struct timespec t;
            clock_gettime(CLOCK_MONOTONIC, &t);
            return (long long)t.tv_sec * 1000000 + t.tv_nsec / 1000;
        }

        static long long lm_shm_sys_now(void) {
            struct timespec t;
            clock_gettime(CLOCK_MONOTONIC, &t);
            return (long long)t.tv_sec * 1000 + t.tv_nsec / 1000000;
        }
    }

}
