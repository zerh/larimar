// expect: error keeps 'b' (Base), which has fields ('count' of its subclass 'Counting') that other threads could change
class Base { function step(x: int32): void { } }
class Counting extends Base {
    let count: int32 = 0;
    override function step(x: int32): void { self.count += x; }
}

function main(): int32 {
    let b: Base = Counting {};
    let f: (int32) -> void thread safe = b::step;
    return 0;
}
