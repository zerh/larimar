// The compiler's tests of language: when (the programs that run are in tests/cases/language/).
import tests.support.compiler { failsWith, runs };

test function whenAloneOnLine(): void {
    failsWith(raw"""
        function main(): void {
            #when windows println("no");
            #end
        }
        """, "'#when windows' goes alone on its line");
}

// A name only one branch declares does not stay after #end.
test function whenBranchOnly(): void {
    failsWith(raw"""
        function main(): void {
            #when windows
                let onlyHere: int32 = 1;
            #else
                let other: int32 = 2;
            #end
            println("${onlyHere}");
        }
        """, "'onlyHere'");
}

test function whenMisaligned(): void {
    failsWith(raw"""
        function main(): void {
            #when windows
                println("windows");
            #else
                println("other");
              #end
        }
        """, "'#end' does not line up with");
}

test function whenNeverChosen(): void {
    failsWith(raw"""
        function main(): void {
            #when unix
                println("unix");
            #when macos
                println("macos");
            #end
        }
        """, "'#when macos' is never chosen: '#when unix'");
}

// Without every platform covered, what a branch declares cannot stay: some platform would lack it.
test function whenNotCovering(): void {
    failsWith(raw"""
        function main(): void {
            #when macos
                let x: int32 = 1;
            #when windows
                let x: int32 = 1;
            #end
            println("${x}");
        }
        """, "'x'");
}

test function whenOldSuffix(): void {
    failsWith(raw"""
        native function getpid(): int32 when unix;
        function main(): void {}
        """, "put the declaration inside '#when <platform>'");
}

test function whenUnclosed(): void {
    failsWith(raw"""
        function main(): void {
            #when windows
                println("windows");
            #else
                println("other");
        }
        """, "Expected '#end' to close the '#when'");
}

// The platform is chosen when the C is compiled. #when has no block: a name every branch declares,
// with the same type, stays after #end; what one branch declares alone stays in it.
test function whenDirectives(): void {
    runs("tests/cases/language/when_directives.lar", [
        "separator: /",
        "shared after #end: 3",
        "local again: 7",
        "memory: abc",
        "nested: unix",
        "returned: 2",
        "early: 1"
    ]);
}
