// expect: error The initial value of 'total' calls code that uses global 'box'
// A global gets its value in order: what its initial value calls cannot use a later one.
class Box { let n: int32 = 5; }

let total: int32 = count();
let box: Box = {};

function count(): int32 { return box.n; }

function main(): int32 { return total; }
