// A synchronized class can extend another synchronized class: every method, the parent's too, takes the
// same lock, and wait until works in both.
synchronized class Queue {
    let items: int32[*] = [];
    let head: int32 = 0;
    function put(x: int32): void { self.items.push(x); }
    function take(): int32 wait until (self.head < self.items.length) {
        self.head += 1;
        return self.items[self.head - 1];
    }
    function size(): int32 { return self.items.length - self.head; }
}

synchronized class LimitedQueue extends Queue {
    let limit: int32 = 2;
    let dropped: int32 = 0;
    override function put(x: int32): void {
        if (self.size() >= self.limit) { self.dropped += 1; return; }
        super.put(x);
    }
    function lost(): int32 { return self.dropped; }
}

function main(): int32 {
    let q: LimitedQueue = {};
    let producer: Thread = { run: () -> { for (i in 0..5) { q.put(i); } } };
    producer.start();
    producer.join();
    let a: int32 = q.take();
    let b: int32 = q.take();
    let shared: Queue = q;
    println("${a} ${b} ${q.lost()} ${shared.size()}");
    return a == 0 && b == 1 && q.lost() == 3 && shared.size() == 0 ? 0 : 1;
}
