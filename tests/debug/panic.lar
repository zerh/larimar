// expect: panic index 3 out of range
// Also used by debug_test.py: larimar dap stops on a panic and shows its message.
function pick(xs: int32[*], i: int32): int32 {
    return xs[i];
}

function main(): int32 {
    let xs: int32[*] = [1, 2, 3];
    let total: int32 = 0;
    for (i in 0..5) {
        total += pick(xs, i);
    }
    println("${total}");
    return 0;
}
