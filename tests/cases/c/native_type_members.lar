// A C type with members: its fields through its pointer (let), C functions that take it first
// (native function ... = c_name), a native let, a Larimar method and a static native function.
ccode {
    typedef struct Counter { int value; const char* name; } Counter;
    static Counter* counter_new(const char* name) { Counter* c = (Counter*)calloc(1, sizeof(Counter)); c->name = name; return c; }
    static void counter_free(Counter* c) { free(c); }
    static void counter_add(Counter* c, int n) { c->value += n; }
    static int counter_get(Counter* c) { return c->value; }
    static int twice(int x) { return 2 * x; }
}

native type Counter = Counter* {
    let value: int32;
    let label: String = name;
    native function add(n: int32): void = counter_add;
    native let current: int32 = counter_get;
    native function doubled(): int32 = cTwice(self.value);
    function addTwice(n: int32): void { self.add(n); self.add(n); }
    static native function make(name: String): Counter = counter_new;
}

native function counter_free(c: Counter): void;
native const ANSWER: int32 = c"(6 * 7)";
native function cTwice(x: int32): int32 = twice;

function main(): int32 {
    let c: Counter = Counter.make("clicks");
    c.add(3);
    c.addTwice(2);
    c.value += 10;
    println("${c.label}: ${c.value} ${c.current} ${c.doubled()} ${ANSWER} ${cTwice(5)}");
    counter_free(c);
    return 0;
}
