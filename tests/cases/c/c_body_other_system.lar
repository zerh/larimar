// A method of a class for another system: its C is not in this build, so calling it panics.
import std.os { Platform, OS, WindowsPlatform, UnixPlatform };

class WindowsOnly implements WindowsPlatform {
    native function ticks(): int64 { return (int64_t)GetTickCount64(); }
}

class UnixOnly implements UnixPlatform {
    native function pid(): int64 { return (int64_t)getpid(); }
}

function main(): int32 {
    if (Platform.current() == OS.Windows) {
        let u: UnixOnly = {};
        println("${u.pid()}");
    } else {
        let w: WindowsOnly = {};
        println("${w.ticks()}");
    }
    return 0;
}
