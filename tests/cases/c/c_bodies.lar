// Methods whose body is C, in a class for each system (implements UnixPlatform / WindowsPlatform), chosen with a
// switch on Platform.current(). The C of the other system never reaches this build.
import std.os { Platform, OS, UnixPlatform, WindowsPlatform };

interface Greeter {
    function twice(x: int32): int32;
    function label(name: String, items: byte[]): String;
}

class UnixGreeter implements Greeter, UnixPlatform {
    cinclude "<unistd.h>";

    ccode {
        static int32_t lm_doubled(int32_t x) { return 2 * x; }
    }

    override native function twice(x: int32): int32 { return lm_doubled(x); }

    override native function label(name: String, items: byte[]): String {
        static char out[64];
        snprintf(out, sizeof out, "%s:%d:%d", name, (int)items_length, (int)items[0]);
        return out;
    }
}

class WindowsGreeter implements Greeter, WindowsPlatform {
    cinclude "<windows.h>";

    override native function twice(x: int32): int32 { return (int32_t)GetTickCount64() * 0 + 2 * x; }

    override native function label(name: String, items: byte[]): String { return "windows"; }
}

let greeter: Greeter = switch (Platform.current()) {
    case Windows -> WindowsGreeter {};
    case Linux, MacOS, Unix -> UnixGreeter {};
};

/** A plain function with a C body; lar"name" reaches Larimar from it. */
native function plusBonus(a: int32): int32 { return a + lar"bonus"(); }

function bonus(): int32 { return 100; }

function main(): int32 {
    let b: byte[*] = [7, 8, 9];
    println("${greeter.twice(21)} ${greeter.label("x", b)} ${plusBonus(1)}");
    return 0;
}
