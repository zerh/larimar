// A macro with named arguments: "(name)" calls the function it hides, with a native struct literal; a
// String? goes to C as NULL when it is null.
ccode {
    struct sum_args { int a; int b; };
    static int sum(struct sum_args s) { return s.a + s.b; }
    #define sum(...) sum((struct sum_args){__VA_ARGS__})
    static void greet(const char* who) { printf("hello, %s\n", who ? who : "nobody"); }
}
native struct SumArgs = c"struct sum_args" { let a: int32; let b: int32; }
native function sum(args: SumArgs): int32 = c"(sum)";
native function greet(who: String?): void;
function main(): int32 {
    let s: SumArgs = { a: 3, b: 4 };
    println("${s.a} ${s.b} ${sum(s)}");
    greet("world");
    greet(null);
    return 0;
}
