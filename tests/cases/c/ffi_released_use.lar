c_code {
    static int open_thing(void) { return 1; }
    static void close_thing(int t) { (void)t; }
    static int use_thing(int t) { return t; }
}
native type Thing = int released by close_thing;
native function open_thing(): Thing?;
native function close_thing(t: Thing): void;
native function use_thing(t: Thing): int32;

function main(): int32 {
    let t: Thing? = open_thing();
    release(t);
    return use_thing(t!);
}
