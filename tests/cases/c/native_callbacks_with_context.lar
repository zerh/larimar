// A callback with a Context: a Larimar function (with what it captures) goes to C, which gives the
// Context back; an export function goes as it is; one that C keeps is declared 'in default'.
ccode {
    typedef void (*item_fn)(int32_t index, const char* name, void* data);
    static void for_each_name(item_fn f, void* data) {
        const char* names[] = { "uno", "dos", "tres" };
        for (int32_t i = 0; i < 3; i++) f(i, names[i], data);
    }
    typedef int (*busy_fn)(void* data, int tries);
    static busy_fn kept_fn;
    static void* kept_data;
    static void set_busy(busy_fn f, void* data) { kept_fn = f; kept_data = data; }
    static int fire_busy(int tries) { return kept_fn(kept_data, tries); }
}

native type ItemFn = (int32, String, Context) -> void;
native function for_each_name(f: ItemFn, data: Context): void;

native type BusyFn = (Context, int32) -> int32;
native function set_busy(f: BusyFn in default, data: Context): void;
native function fire_busy(tries: int32): int32;

export function show(index: int32, name: String, data: Context): void { println("export ${index} ${name}"); }

class Totals { let count: int32 = 0; }

function main(): int32 {
    let prefix: String = "->";
    let totals: Totals = {};
    for_each_name((i, name) -> {
        totals.count += 1;
        println("${prefix} ${i} ${name.toUpperCase()}");
    });
    println("count ${totals.count}");
    for_each_name(show);
    let limit: Totals = Totals { count: 5 } in default;
    set_busy((tries) -> { return tries < limit.count ? 1 : 0; });
    println("${fire_busy(2)} ${fire_busy(7)}");
    return 0;
}
