// The levels of the binary operators, loosest to tightest: || && comparisons | ^ & << >> + - * / %.
class Animal { }
class Dog extends Animal { }
function main(): int32 {
    let a: Animal = Dog {};
    let x: int32 = 1 + 2 * 3;
    let b: bool = 1 < 2 && 3 > 2 || false;
    let bits: int32 = 1 | 2 & 0;
    let sh: int32 = 3 << 1 & 7;
    let isIt: bool = a is Dog && x == 7;
    let mixed: int32 = 1 + 2 * 3 << 1 >> 1 ^ 2 | 1;
    let cmp: bool = 1 + 1 == 3;
    let mod: int32 = 17 % 5 / 1;
    println("${x} ${b} ${bits} ${sh} ${isIt} ${mixed} ${cmp} ${mod}");
    return 0;
}
