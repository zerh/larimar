// list.sort(): numbers and Strings in their natural order; sort(compare) with a comparator, stable.
class User {
    let name: String;
    let age: int32;
}

function names(users: User[*]): String {
    let out: String[*] = [];
    for (u in users) { out.push("${u.name}:${u.age}"); }
    return out.join(" ");
}

function main(): int32 {
    let nums: int32[*] = [5, 1, 8, 3, 2];
    nums.sort();
    println("${nums[0]} ${nums[1]} ${nums[2]} ${nums[3]} ${nums[4]}");

    let words: String[*] = ["luisa", "eva", "luis", "ana"];
    words.sort();
    println(words.join(" "));

    let decimals: float64[*] = [9.0, 2.5, 1.5];
    decimals.sort();
    println("${decimals[0]} ${decimals[1]} ${decimals[2]}");

    let users: User[*] = [User { name: "Eva", age: 30 }, User { name: "Ana", age: 25 }, User { name: "Luis", age: 30 }];
    let byAgeDescending: (User, User) -> int32 = (a: User, b: User) -> { return b.age - a.age; };
    users.sort(byAgeDescending);            // stable: Eva stays before Luis
    println(names(users));
    users.sort((a: User, b: User) -> { return a.name.compareTo(b.name); });
    println(names(users));

    let fixed: int32[3] = [1, 2, 3];
    fixed.sort((a: int32, b: int32) -> { return b - a; });
    println("${fixed[0]} ${fixed[1]} ${fixed[2]}");

    let letters: String[*] = ["x", "z", "y"];
    letters.sort((a: String, b: String) -> { return b.compareTo(a); });
    println(letters.join(" "));

    let empty: int32[*] = [];
    empty.sort();
    println("${empty.length}");
    return 0;
}
