// A decimal is written with the fewest digits that read back as the same value.
function main(): int32 {
    let f: float32 = 0.1;
    let big: float64 = 1e20;
    let zero: float64 = 0.0;
    let third: float64 = 1.0 / 3.0;
    let half: float32 = 1.5;
    println("${f} ${0.1 * 3.0} ${2.0} ${100.0} ${1234567.0} ${big} ${1e-5} ${0.0001} ${-0.0}");
    let back: float64 = "${0.1 * 3.0}".toFloat() ?? 0.0;
    println("${third} ${zero / zero} ${1.0 / zero} ${-1.0 / zero} ${half} ${back == 0.1 * 3.0}");
    return 0;
}
