// Structs de C por valor en listas.
ccode {
    typedef struct Rect { float w, h; } Rect;
    static float area(Rect r) { return r.w * r.h; }
}
native struct Rect { let w: float32; let h: float32; };
native function area(r: Rect): float32;
function main(): int32 {
    let rs: Rect[*] = [{ w: 3, h: 4 }, { w: 5, h: 6 }];
    let total: float32 = 0;
    for (r in rs) { total += area(r); }
    println("${total}");
    return 0;
}
