// Regresión: Reader y copy usaban un byte[4096] de longitud 0 y no leían nada.
import std.io { MemoryInputStream, MemoryOutputStream, Reader, copy };
import std.io { IoError };
function main(): int32 throws IoError {
    let r: Reader = { from: MemoryInputStream { data: "uno\ndos\r\ntres" } };
    while (true) {
        let l: String? = r.readLine();
        if (l == null) { break; }
        println("<${l}>");
    }
    let out: MemoryOutputStream = {};
    copy(MemoryInputStream { data: "copiado" }, out);
    println(out.toString());
    return 0;
}
