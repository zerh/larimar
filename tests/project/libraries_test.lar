// Libraries written in Larimar. A program names the library's folder in [dependencies] and compiles its source
// with its own: one C, one runtime, the whole language on both sides. larimar build of a library checks it.
// Each test writes its projects in build/test/ and builds them with the compiler under test.
import std.test { check, checkInt, skip };
import std.os.process { Process, ProcessError };
import std.io.files as Files;
import std.io { IoError };
import std.io.path as Paths;
import std.os;
import std.platform { Platform };
import tests.support.compiler { compiler, failsWith, runs, caseFile };

/** The library of the tests: texts, a class, a text that may be null. */
const LIBRARY: String = raw"""
    /** Counts the words of a text. */
    public function wordCount(text: String): int32 {
        let n: int32 = 0;
        for (w in text.split(" ")) {
            if (w != "") { n += 1; }
        }
        return n;
    }

    /** The text with its first letter in upper case. */
    public function title(text: String): String {
        if (text == "") { return ""; }
        return "${text.substring(0, 1).toUpperCase()}${text.substring(1)}";
    }

    public function firstWord(text: String?): String? {
        if (text == null) { return null; }
        for (w in text!.split(" ")) {
            if (w != "") { return w.clone(); }
        }
        return null;
    }

    /** Counts words as they come. */
    public class Counter {
        /** The words counted. */
        let words: int32 = 0;
        let name: String = "";
        let texts: String[*] = [];

        function add(text: String): void {
            self.words += wordCount(text);
            self.texts.push(text.clone());
        }

        function last(): String? {
            if (self.texts.length == 0) { return null; }
            return self.texts[self.texts.length - 1].clone();
        }

        function copy(): Counter { return Counter { words: self.words, name: "${self.name} (copy)" }; }
    }

    public function newCounter(name: String): Counter { return Counter { name: name.clone() }; }

    public function total(c: Counter): int32 { return c.words; }

    public function answer(): int32 { return 42; }
    """;

/** A Larimar program that uses the library. */
const LARIMAR_PROGRAM: String = raw"""
    import textkit;
    import textkit { Counter };

    function main(): int32 {
        let c: Counter = textkit.newCounter("mine");
        c.add("one two");
        c.add("three");
        println("${textkit.wordCount("a b  c")} ${textkit.title("larimar")} ${textkit.firstWord("  two words") ?? "-"} ${textkit.total(c)} ${c.last() ?? "-"} ${textkit.answer()}");
        let d: Counter = c.copy();
        println("${d.words} ${d.name}");
        println(textkit.firstWord(null) ?? "null");
        for (i in 0..3) { println(textkit.title("x${i}")); }
        return 0;
    }
    """;

/** Runs a program: its exit code, and what it printed (errors too) into `output`. */
function execute(program: String, args: String[*], output: String[*]): int32 {
    let p: Process = { program, args, mergeErrors: true };
    try {
        p.start();
        output.push(p.readAll(120000));
        return p.wait(30000) ?? -1;
    } catch (ProcessError e) {
        output.push("cannot run ${program}");
        return -1;
    }
}

/** Runs the compiler (`larimarc <args>`). */
function larimarc(args: String[*], output: String[*]): int32 { return execute(compiler(), args, output); }

/** Deletes a folder of an earlier run, with all it has. */
function clean(dir: String): void throws IoError {
    if (!Files.isDirectory(dir)) { return; }
    for (f in Files.list(dir)) {
        let path: String = Paths.join(dir, f);
        if (Files.isDirectory(path)) { clean(path); } else { Files.delete(path); }
    }
    Files.delete(dir);
}

/** Writes the library's project in build/test/<folder>: its larimar.toml and src/textkit.lar. */
function writeLibrary(folder: String, extra: String): String throws IoError {
    let dir: String = Paths.absolute("build/test/${folder}");
    clean(dir);
    Files.createDirectories(Paths.join(dir, "src"));
    Files.writeString(Paths.join(dir, "larimar.toml"), "[project]\nname = \"textkit\"\nversion = \"1.0.0\"\nkind = \"library\"\nmain = \"src/textkit.lar\"\n");
    Files.writeString(Paths.join(dir, "src/textkit.lar"), "${LIBRARY}${extra}");
    return dir;
}

/** Writes a program in build/test/<folder>, with this larimar.toml after [project] and this main. */
function writeProgram(folder: String, toml: String, main: String) : String throws IoError {
    let dir: String = Paths.absolute("build/test/${folder}");
    clean(dir);
    Files.createDirectories(Paths.join(dir, "src"));
    Files.writeString(Paths.join(dir, "larimar.toml"), "[project]\nname = \"app\"\n\n${toml}");
    Files.writeString(Paths.join(dir, "src/main.lar"), main);
    return dir;
}

/** Writes a library project (a name, its main module, and what goes after [project]). */
function writeNamedLibrary(folder: String, name: String, source: String, toml: String): String throws IoError {
    let dir: String = Paths.absolute("build/test/${folder}");
    clean(dir);
    Files.createDirectories(Paths.join(dir, "src"));
    Files.writeString(Paths.join(dir, "larimar.toml"), "[project]\nname = \"${name}\"\nkind = \"library\"\nmain = \"src/${name}.lar\"\n\n${toml}");
    Files.writeString(Paths.join(dir, "src/${name}.lar"), source);
    return dir;
}

const LARIMAR_OUTPUT: String = "3 Larimar two 3 three 42\n3 mine (copy)\nnull\nX0\nX1\nX2\n";

function onlyLinuxOrMac(): bool {
    if (Platform.name() == "windows") {
        skip("the libraries are tested on Linux and macOS");
        return false;
    }
    return true;
}

// ---- for Larimar programs: the library's source, compiled with the program -----------------------------

// [dependencies] names the library's folder, and the program compiles its source with its own: one C, one runtime.
test function aLibraryIsUsedAsSource(): void throws IoError {
    if (!onlyLinuxOrMac()) { return; }
    let lib: String = writeLibrary("lib-source", "");
    let app: String = writeProgram("lib-source-app", "[dependencies]\ntextkit = \"${lib}\"\n", LARIMAR_PROGRAM);
    let output: String[*] = [];
    checkInt(0, larimarc(["run", app], output));
    check(output.join("").endsWith(LARIMAR_OUTPUT), "the program uses the library: ${output.join("")}");
    output.clear();
    checkInt(0, larimarc(["check", Paths.join(app, "src/main.lar")], output));
    check(!Files.isDirectory(Paths.join(lib, "build")), "nothing is built in the library's folder");
}

// The language is the same on both sides: interfaces the program implements, lists, enums, throws.
test function theWholeLanguageCrosses(): void throws IoError {
    if (!onlyLinuxOrMac()) { return; }
    let lib: String = writeNamedLibrary("lib-language", "shapes", raw"""
        public interface Shape {
            function area(): float64;
            function name(): String;
        }
        public enum ShapeError { Empty, Negative(what: String) }

        /** The names of the shapes, the largest first. */
        public function largest(shapes: Shape[*]): String[*] throws ShapeError {
            if (shapes.length == 0) { throw ShapeError.Empty; }
            let out: String[*] = [];
            for (s in shapes) {
                if (s.area() < 0.0) { throw ShapeError.Negative(s.name().clone()); }
            }
            let taken: bool[*] = [];
            for (s in shapes) { taken.push(false); }
            while (out.length < shapes.length) {
                let best: int32 = -1;
                for (i, s in shapes) {
                    if (!taken[i] && (best < 0 || s.area() > shapes[best].area())) { best = i; }
                }
                taken[best] = true;
                out.push(shapes[best].name().clone());
            }
            return out;
        }

        public class Square implements Shape {
            let side: float64;
            override function area(): float64 { return self.side * self.side; }
            override function name(): String { return "square ${self.side}"; }
        }
        """, "");
    let app: String = writeProgram("lib-language-app", "[dependencies]\nshapes = \"${lib}\"\n", raw"""
        import shapes;
        import shapes { Shape, Square, ShapeError };

        class Circle implements Shape {
            let r: float64;
            override function area(): float64 { return 3.0 * self.r * self.r; }
            override function name(): String { return "circle ${self.r}"; }
        }

        function main(): int32 {
            let all: Shape[*] = [Square { side: 2.0 }, Circle { r: 2.0 }, Square { side: 1.0 }];
            try {
                println(shapes.largest(all).join(", "));
                let none: Shape[*] = [];
                shapes.largest(none);
            } catch (ShapeError e) {
                switch (e) {
                    case Empty -> println("no shapes");
                    case Negative { what } -> println("negative ${what}");
                }
            }
            return 0;
        }
        """);
    let output: String[*] = [];
    checkInt(0, larimarc(["run", app], output));
    check(output.join("").endsWith("circle 2.0, square 2.0, square 1.0\nno shapes\n"), "interfaces, lists and errors cross: ${output.join("")}");
}

// A library's modules are <name> and <name>.<part>: they never meet the program's.
test function aLibraryHasItsParts(): void throws IoError {
    if (!onlyLinuxOrMac()) { return; }
    let lib: String = writeNamedLibrary("lib-parts", "words", raw"""
        import words.count as Count;
        public function describe(text: String): String { return "${Count.of(text)} words"; }
        """, "");
    Files.createDirectories(Paths.join(lib, "src/words"));
    Files.writeString(Paths.join(lib, "src/words/count.lar"), raw"""
        public function of(text: String): int32 {
            let n: int32 = 0;
            for (w in text.split(" ")) {
                if (w != "") { n += 1; }
            }
            return n;
        }
        """);
    let app: String = writeProgram("lib-parts-app", "[dependencies]\nwords = \"${lib}\"\n", raw"""
        import words;
        import words.count as Count;
        function main(): int32 {
            println("${words.describe("uno dos tres")} ${Count.of("a b")}");
            return 0;
        }
        """);
    let output: String[*] = [];
    checkInt(0, larimarc(["run", app], output));
    check(output.join("").endsWith("3 words 2\n"), "its parts: ${output.join("")}");
    // the program has a module with the library's name too
    Files.writeString(Paths.join(app, "src/words.lar"), "public function describe(text: String): String { return text; }\n");
    output.clear();
    checkInt(1, larimarc(["build", app], output));
    check(output.join("").contains("Module 'words' is of the library 'words' of [dependencies], and the project has a file with its name too"), "a name of both: ${output.join("")}");
}

// A library names its own libraries in its [dependencies]; a program names only the ones it imports.
test function aLibraryUsesItsOwnPackages(): void throws IoError {
    if (!onlyLinuxOrMac()) { return; }
    let tiny: String = writeNamedLibrary("lib-deep-tiny", "tiny", raw"""
        let calls: int32 = 0;
        public function twice(n: int32): int32 {
            calls += 1;
            return n * 2;
        }
        public function uses(): int32 { return calls; }
        """, "");
    let four: String = writeNamedLibrary("lib-deep-four", "four", raw"""
        import tiny;
        public function times(n: int32): int32 { return tiny.twice(tiny.twice(n)); }
        """, "[dependencies]\ntiny = \"../lib-deep-tiny\"\n");
    let app: String = writeProgram("lib-deep-app", "[dependencies]\nfour = \"${four}\"\n", raw"""
        import four;
        import tiny;
        function main(): int32 {
            println("${four.times(3)} ${tiny.twice(1)} ${tiny.uses()}");
            return 0;
        }
        """);
    let output: String[*] = [];
    checkInt(0, larimarc(["run", app], output));
    check(output.join("").endsWith("12 2 3\n"), "one tiny for both: ${output.join("")}");
    // two libraries called the same, in two folders
    let other: String = writeNamedLibrary("lib-deep-tiny2", "tiny", "public function twice(n: int32): int32 { return n; }\n", "");
    let clash: String = writeProgram("lib-deep-clash", "[dependencies]\nfour = \"${four}\"\ntiny = \"${other}\"\n", "function main(): int32 { return 0; }\n");
    output.clear();
    checkInt(1, larimarc(["build", clash], output));
    check(output.join("").contains("two libraries are called 'tiny'"), "two tiny: ${output.join("")}");
    check(Files.isDirectory(tiny), "the first tiny is there");
}

// What [dependencies] names is checked: a library's folder, with that name.
test function dependenciesAreChecked(): void throws IoError {
    let program: String = writeProgram("lib-not-a-library", "", "function main(): int32 { return 0; }\n");
    let named: String = writeNamedLibrary("lib-other-name", "other", "public function one(): int32 { return 1; }\n", "");
    let cases: String[] = [
        "textkit = \"libs/none\"|libs/none has no larimar.toml",
        "textkit = \"${program}\"|is a program, not a library",
        "textkit = \"${named}\"|the library in ${named} is called 'other'",
        "textkit = 3|textkit in [dependencies] is the folder of the library"
    ];
    for (c in cases) {
        let parts: String[*] = c.split("|");
        let dir: String = writeProgram("lib-checked", "[dependencies]\n${parts[0]}\n", "function main(): int32 { return 0; }\n");
        let output: String[*] = [];
        checkInt(1, larimarc(["build", dir], output));
        check(output.join("").contains(parts[1]), "${parts[0]}: ${output.join("")}");
    }
}

// A library written in Larimar has no C of its own, as a program has none: C is std's.
test function aLibraryHasNoCOfItsOwn(): void throws IoError {
    let lib: String = writeNamedLibrary("lib-with-c", "fast", raw"""
        native function abs(x: int32): int32;
        public function size(x: int32): int32 { return abs(x); }
        """, "");
    let app: String = writeProgram("lib-with-c-app", "[dependencies]\nfast = \"${lib}\"\n", "import fast;\nfunction main(): int32 { return fast.size(-1); }\n");
    let output: String[*] = [];
    checkInt(1, larimarc(["build", app], output));
    check(output.join("").contains("native function is only for the standard library"), "C in a library: ${output.join("")}");
}

// [project] unsafe_c = true opens native interface to a project or a library (and nothing else of C): the
// program that uses it is built with that C, and every build says where it comes from.
test function unsafeCIsSaidEveryTime(): void throws IoError {
    if (!onlyLinuxOrMac()) { return; }
    let lib: String = writeNamedLibrary("lib-unsafe", "cubes", raw"""
        native interface LibM "<math.h>" {
            type Cell = c"int*";
            function cbrt(x: float64): float64;
        }
        public function side(volume: float64): float64 { return LibM.cbrt(volume); }
        """, "");
    Files.writeString(Paths.join(lib, "larimar.toml"), "[project]\nname = \"cubes\"\nkind = \"library\"\nmain = \"src/cubes.lar\"\nunsafe_c = true\n");
    let app: String = writeProgram("lib-unsafe-app", "[dependencies]\ncubes = \"${lib}\"\n", raw"""
        import cubes;
        function main(): int32 {
            println("${cubes.side(27.0)}");
            return 0;
        }
        """);
    let output: String[*] = [];
    checkInt(0, larimarc(["run", app], output));
    let all: String = output.join("");
    check(all.contains("note: unsafe C (native interface) from: cubes"), "it says where the C is from: ${all}");
    check(all.contains("type Cell (int*) has no 'released by'"), "and what nothing frees: ${all}");
    check(all.endsWith("3.0\n"), "it runs: ${all}");
    // without unsafe_c, a native interface is std's
    let own: String = writeProgram("lib-unsafe-own", "", "native interface LibM \"<math.h>\" { function cbrt(x: float64): float64; }\nfunction main(): int32 { return LibM.cbrt(8.0) as int32; }\n");
    output.clear();
    checkInt(1, larimarc(["build", own], output));
    check(output.join("").contains("or for a project with [project] unsafe_c = true"), "the program has none: ${output.join("")}");
    // and unsafe_c opens native interface only: ccode is still std's
    Files.writeString(Paths.join(own, "larimar.toml"), "[project]\nname = \"app\"\nunsafe_c = true\n");
    Files.writeString(Paths.join(own, "src/main.lar"), "ccode { static int one(void) { return 1; } }\nfunction main(): int32 { return 0; }\n");
    output.clear();
    checkInt(1, larimarc(["build", own], output));
    check(output.join("").contains("ccode is only for the standard library"), "ccode stays std's: ${output.join("")}");
}

// The library and the program share one runtime, and their names do not meet: each module has its own.
test function aLibraryAndItsProgramShareOneRuntime(): void throws IoError {
    if (!onlyLinuxOrMac()) { return; }
    let lib: String = writeNamedLibrary("lib-runtime", "bgkit", raw"""
        synchronized class Total {
            let sum: int32 = 0;
            function add(n: int32): void { self.sum += n; }
            function get(): int32 { return self.sum; }
        }
        let seen: String[*] = [] in default;

        public function work(label: String): int32 {
            seen.push(label.clone() in default);
            let total: Total = { } in default;
            let count: int32 = seen.length;
            let t: Thread = { run: () -> { total.add(count); } } in default;
            t.start();
            t.join();
            return total.get();
        }
        """, "");
    let app: String = writeProgram("lib-runtime-app", "[dependencies]\nbgkit = \"${lib}\"\n", raw"""
        import bgkit;
        let seen: String[*] = [] in default;
        function main(): int32 {
            seen.push("a");
            let t: Thread = { run: () -> { println("in a thread"); } } in default;
            t.start();
            t.join();
            println("${bgkit.work("x")} ${bgkit.work("y")} ${seen.length}");
            return 0;
        }
        """);
    let output: String[*] = [];
    checkInt(0, larimarc(["run", app], output));
    check(output.join("").endsWith("in a thread\n1 2 1\n"), "the library and the program, each with its own names: ${output.join("")}");
}

test function theTestsOfALibraryUseItsRules(): void throws IoError {
    if (!onlyLinuxOrMac()) { return; }
    let dir: String = writeLibrary("lib-tests", "");
    Files.createDirectories(Paths.join(dir, "tests"));
    Files.writeString(Paths.join(dir, "tests/textkit_test.lar"), """
        import textkit;
        import std.test { checkInt };
        test function counts(): void {
            let c: textkit.Counter = textkit.newCounter("t");
            c.add("a b");
            checkInt(2, textkit.total(c));
        }
        """);
    let log: String = Paths.join(dir, "test-output.txt");
    checkInt(0, os.run("cd '${dir}' && '${compiler()}' test > '${log}' 2>&1"));
    let text: String = Files.readString(log);
    check(text.contains("1 passed, 0 failed"), "the library's tests: ${text}");
}

// [c] says which C compiler builds the program, and its flags: the C itself is std's.
test function cIsOnlyTheCompiler(): void throws IoError {
    let dir: String = writeProgram("lib-c-keys", "[c]\nflags = [\"-O2\"]\nsources = [\"x.c\"]\n\n[c.linux]\ninclude_paths = [\"i\"]\n", "function main(): int32 { return 0; }\n");
    let output: String[*] = [];
    checkInt(1, larimarc(["build", dir], output));
    let text: String = output.join("");
    check(text.contains("unknown key 'sources' in [c] (keys: [compiler, flags])"), "sources: ${text}");
    check(text.contains("unknown key 'include_paths' in [c.linux]"), "include_paths: ${text}");
}

// larimar build of a library checks it: its errors are said, and nothing is made.
test function aLibraryIsChecked(): void throws IoError {
    let dir: String = writeLibrary("lib-checked-only", "");
    let output: String[*] = [];
    checkInt(0, larimarc(["build", dir], output));
    check(output.join("").contains("checked textkit"), "a library is checked: ${output.join("")}");
    check(!Files.isDirectory(Paths.join(dir, "build")), "and nothing is built");
    Files.writeString(Paths.join(dir, "src/textkit.lar"), "public function broken(): int32 { return \"x\"; }\n");
    output.clear();
    checkInt(1, larimarc(["build", dir], output));
    check(output.join("").contains("src/textkit.lar:1]: Return value: expected int32 but got String"), "its errors: ${output.join("")}");
}

// ---- a library's rules, and the C of std ---------------------------------------------------------------

test function aLibraryHasNoMain(): void throws IoError {
    let dir: String = writeLibrary("lib-main", "\nfunction main(): int32 { return 0; }\n");
    let output: String[*] = [];
    checkInt(1, larimarc(["build", dir], output));
    check(output.join("").contains("A library has no main"), "main in a library: ${output.join("")}");
}

test function releasedByGoesOnTexts(): void {
    failsWith(raw"""
        native function count(): int32 released by free;
        native function free(text: String): void;
        function main(): int32 { return count(); }
        """, "'released by' after a native function goes on a text that C makes");
}

test function aReleaserIsCalledOnlyByTheCompiler(): void {
    failsWith(raw"""
        native function strdup(text: String): String released by free;
        native function free(text: String): void;
        function main(): int32 {
            free("x");
            return 0;
        }
        """, "'free' releases the texts that C gives");
}

// A text that C makes with malloc: copied into the memory of the call (a buffer too), then freed.
test function aTextOfCIsCopiedAndReleased(): void {
    runs(caseFile("released_text.lar", raw"""
        ccode {
            #include <stdio.h>
            #include <stdlib.h>
            static char* make_text(int n) {
                char* p = (char*)malloc(32);
                snprintf(p, 32, "text %d", n);
                return p;
            }
            static char* maybe_text(int n) { return n > 0 ? make_text(n) : NULL; }
        }
        native function make_text(n: int32): String released by free;
        native function maybe_text(n: int32): String? released by free;
        native function free(text: String): void;

        function made(n: int32): String { return make_text(n); }

        function main(): int32 {
            for (i in 0..1000) {
                let t: String = make_text(i);
                if (i == 999) { println(t); }
            }
            println(made(7));
            println(maybe_text(0) ?? "null");
            println(maybe_text(2) ?? "null");
            let buffer: byte[64] = [];
            let b: String = make_text(5) in buffer;
            println(b);
            return 0;
        }
        """), ["text 999", "text 7", "null", "text 2", "text 5"]);
}
