test function onlyALibraryGivesItsClassesToC(): void {
    failsWith(raw"""
        public class Box { let n: int32 = 0; }
        export function make(): Box { return Box {}; }
        function main(): int32 { return 0; }
        """, "only a library ([project] kind = \"library\") gives C its objects");
}

test function releasedByGoesOnTexts(): void {
    failsWith(raw"""
        native function count(): int32 released by free;
        native function free(text: String): void;
        function main(): int32 { return count(); }
        """, "'released by' after a native function goes on a text that C makes");
}

test function aReleaserIsCalledOnlyByTheCompiler(): void {
    failsWith(raw"""
        native function strdup(text: String): String released by free;
        native function free(text: String): void;
        function main(): int32 {
            free("x");
            return 0;
        }
        """, "'free' releases the texts that C gives");
}

// A text that C makes with malloc: copied into the memory of the call (a buffer too), then freed.
test function aTextOfCIsCopiedAndReleased(): void {
    runs(caseFile("released_text.lar", raw"""
        ccode {
            #include <stdio.h>
            #include <stdlib.h>
            static char* make_text(int n) {
                char* p = (char*)malloc(32);
                snprintf(p, 32, "text %d", n);
                return p;
            }
            static char* maybe_text(int n) { return n > 0 ? make_text(n) : NULL; }
        }
        native function make_text(n: int32): String released by free;
        native function maybe_text(n: int32): String? released by free;
        native function free(text: String): void;

        function made(n: int32): String { return make_text(n); }

        function main(): int32 {
            for (i in 0..1000) {
                let t: String = make_text(i);
                if (i == 999) { println(t); }
            }
            println(made(7));
            println(maybe_text(0) ?? "null");
            println(maybe_text(2) ?? "null");
            let buffer: byte[64] = [];
            let b: String = make_text(5) in buffer;
            println(b);
            return 0;
        }
        """), ["text 999", "text 7", "null", "text 2", "text 5"]);
}

// export function f(...) = c_name: its C name; a String or String? result is a copy that C frees.
test function anExportGivesCATextToFree(): void {
    runs(caseFile("export_text.lar", raw"""
        export function greet(name: String?): String = lar_greet {
            return "hi ${name ?? "nobody"}";
        }
        export function shout(name: String): String? {
            return name == "" ? null : name.toUpperCase();
        }
        ccode {
            #include <stdio.h>
            #include <stdlib.h>
            static void use_them(void) {
                for (int i = 0; i < 1000; i++) {
                    char* a = lar_greet("ana");
                    char* b = lar_greet(NULL);
                    char* c = shout("x");
                    if (i == 999) printf("%s / %s / %s / %s\n", a, b, c, shout("") ? "text" : "NULL");
                    free(a);
                    free(b);
                    free(c);
                }
            }
        }
        native function use_them(): void;
        function main(): int32 {
            use_them();
            return 0;
        }
        """), ["hi ana / hi nobody / X / NULL"]);
}
