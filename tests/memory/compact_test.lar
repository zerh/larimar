// The compiler's tests of memory: compact (the programs that run are in tests/cases/memory/).
import tests.support.compiler { failsWith, panics };

test function compactDataOfTheBlock(): void {
    failsWith(raw"""
        import std.memory as Memory;
        function main(): int32 {
            let world: byte[*] = [] in heap;
            let names: String[*] = [] in world;
            Memory.compact(world);
            let label: String = "x".toUpperCase();      // in the memory of the block, not in 'world'
            names.push(label);
            return 0;
        }
        """, "keeps data of another memory of this block in 'world', and compact() moves only what lives in 'world'");
}

test function compactGlobalMemory(): void {
    failsWith(raw"""
        import std.memory as Memory;
        let cache: byte[*] = [] in heap;
        function main(): int32 {
            Memory.compact(cache);
            return 0;
        }
        """, "Memory.compact() works on memories declared in a function: declare 'cache' in main");
}

test function compactInsideFor(): void {
    failsWith(raw"""
        import std.memory as Memory;
        function main(): int32 {
            let world: byte[*] = [] in heap;
            let names: String[*] = [] in world;
            for (n in names) { Memory.compact(world); }
            return 0;
        }
        """, "Memory.compact() cannot run inside a 'for' over a list, a table or a text");
}

test function compactLambdas(): void {
    failsWith(raw"""
        import std.memory as Memory;
        function main(): int32 {
            let world: byte[*] = [] in heap;
            let actions: (() -> int32)[*] = [] in world;
            Memory.compact(world);
            return 0;
        }
        """, "Memory.compact(world) cannot move 'actions': it holds a lambda, which compact() cannot move");
}

test function compactParameter(): void {
    failsWith(raw"""
        import std.memory as Memory;
        function clean(m: byte[*]): void { Memory.compact(m); }
        function main(): int32 { return 0; }
        """, "Memory.compact(m) needs the memory's own name: 'm' is a parameter, and could be any memory");
}

test function compactVariableOutsideIt(): void {
    failsWith(raw"""
        import std.memory as Memory;
        function main(): int32 {
            let world: byte[*] = [] in heap;
            let names: String[*] = [] in world;
            let title: String = "x".toUpperCase();
            Memory.compact(world);
            return 0;
        }
        """, "Memory.compact(world): 'title' lives in the memory of this block and may point into 'world'");
}

test function limitStopsTheProgram(): void {
    panics("tests/cases/memory/limit_stops_the_program.lar", "memory 'cache' passed its limit of 64.0 KB");
}
