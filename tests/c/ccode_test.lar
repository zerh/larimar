// The compiler's tests of c: c code (the programs that run are in tests/cases/c/).
import tests.support.compiler { failsWith, runs, panics, generatedC, hasWord };
import std.test { check };

// Names of the C library (log, exit, abs, time...) get a '_' in the C: clang treats them as built-ins.
test function cLibraryNames(): void {
    runs("tests/cases/c/c_library_names.lar", [
        "1 2 1 3 4 5 6"
    ]);
}

test function larNameUnknown(): void {
    failsWith(raw"""
        ccode {
            static int32_t both(int32_t a) { return lar"nope"(a); }
        }
        native function both(a: int32): int32;
        function main(): int32 { return both(1); }
        """, "lar\"nope\" in ccode: 'nope' is not a function, type or global of Larimar seen here");
}

// The old way to give a function a body of C: now it is native function f(): T { C }.
test function cBodyNeedsNative(): void {
    failsWith(raw"""
        function hack(): int32 ccode { return 1; }
        function main(): int32 { return 0; }
        """, "A body of C belongs to a native function");
}

// Una export function se queda aunque nadie la llame desde el programa: es para C de fuera.
test function exportKeptWithoutCallers(): void {
    runs("tests/cases/c/export_kept_without_callers.lar", [
        "listo"
    ]);
    let c: String = generatedC("tests/cases/c/export_kept_without_callers.lar");
    check(hasWord(c, "lm_api_version"), "the generated C should contain lm_api_version");
}

// lar"name" in ccode: the C name of a Larimar function (a module's: lar"module.name").
test function larNamesInCCode(): void {
    runs("tests/cases/c/lar_names_in_ccode.lar", [
        "25"
    ]);
}

// Solo llega al C lo que el programa usa: ni los métodos de String que no llama, ni los tipos que solo
// aparecen en sus firmas, ni el ccode de la biblioteca estándar que nadie usa.
test function unusedStdNotEmitted(): void {
    runs("tests/cases/c/unused_std_not_emitted.lar", [
        "HOLA true"
    ]);
    let c: String = generatedC("tests/cases/c/unused_std_not_emitted.lar");
    check(hasWord(c, "String_startsWith"), "the generated C should contain String_startsWith");
    check(!hasWord(c, "String_trimEnd"), "the generated C should not contain String_trimEnd");
    check(!hasWord(c, "String_lastIndexOf"), "the generated C should not contain String_lastIndexOf");
    check(!hasWord(c, "Opt_i64"), "the generated C should not contain Opt_i64");
    check(!hasWord(c, "List_s"), "the generated C should not contain List_s");
    check(!hasWord(c, "byte_text_new"), "the generated C should not contain byte_text_new");
}

// El ccode del programa se copia entero, aunque Larimar no use cada cosa directamente
// (aquí, un puntero a función global que solo usa otra función de C).
test function userCCodeStaysWhole(): void {
    runs("tests/cases/c/user_ccode_stays_whole.lar", [
        "7",
        "12"
    ]);
    let c: String = generatedC("tests/cases/c/user_ccode_stays_whole.lar");
    check(hasWord(c, "sumar"), "the generated C should contain sumar");
}

// native function f(...): T { C }: methods and functions whose body is C; a class for one system
// (implements UnixPlatform, WindowsPlatform...) puts its C only in that system's build.
test function cBodies(): void {
    runs("tests/cases/c/c_bodies.lar", [
        "42 x:3:7 101"
    ]);
    let c: String = generatedC("tests/cases/c/c_bodies.lar");
    check(c.contains("#if defined(_WIN32)\n#include <windows.h>"), "the header of the Windows class only on Windows");
}

test function cBodyOfAnotherSystem(): void {
    panics("tests/cases/c/c_body_other_system.lar", "is for");
}

// The platform of a class follows the hierarchy: LinuxPlatform is a UnixPlatform, so both say linux.
test function narrowerPlatform(): void {
    let c: String = generatedC("tests/cases/c/platform_narrower.lar");
    check(c.contains("#if defined(__linux__)"), "the subclass is for linux");
    check(c.contains("#if !defined(_WIN32)"), "its superclass is for every Unix");
}

test function oneSystemPerClass(): void {
    failsWith(raw"""
        import std.os { UnixPlatform, WindowsPlatform };
        class Both implements UnixPlatform, WindowsPlatform {}
        function main(): int32 { return 0; }
        """, "A class is for one system");
}
