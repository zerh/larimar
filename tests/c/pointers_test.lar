// The compiler's tests of c: pointers (the programs that run are in tests/cases/c/).
import tests.support.compiler { failsWith, runs };

test function ffiAddressOnlyInCalls(): void {
    failsWith(raw"""
        function main(): int32 {
            let x: int32 = 1;
            let p: int32* = &x;
            return 0;
        }
        """, "'&' gives a pointer for C: it is only allowed as an argument of a native function");
}

// C without ccode-wrappers: pointers to C structs (a linked list), out parameters (&x), constants and
// macros (native const), a C global (native let), C strings in structs, arrays where C takes T*, `when`.
test function ffiPointers(): void {
    runs("tests/cases/c/ffi_pointers.lar", [
        "list: 3 nodes, sum 60",
        "out params: 7 and 42",
        "constants: 3 / limit 100 / size 8",
        "global: 5 -> 6",
        "names: uno dos",
        "array as pointer: 10",
        "platform: ok",
        "renamed: 9",
        "maybe: null and \"hola\""
    ]);
}

// A T[] of numbers given to C arrives as a pointer to the elements and their count, and C can write in it.
test function slicesToC(): void {
    runs("tests/cases/c/slices_to_c.lar", [
        "4 ABCD",
        "3 ABC",
        "10"
    ]);
}
