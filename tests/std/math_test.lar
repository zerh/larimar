// std.math: C's functions by their names, and Random: the same sequence for the same seed.
import std.test { check, checkInt };
import std.math as Math;
import std.math { Random };

test function functions(): void {
    check(Math.sqrt(81.0) == 9.0 && Math.pow(2.0, 10.0) == 1024.0, "sqrt and pow");
    check(Math.floor(2.7) == 2.0 && Math.ceil(2.1) == 3.0 && Math.round(2.5) == 3.0 && Math.abs(-4.0) == 4.0, "rounding and abs");
    check(Math.min(1.0, 2.0) == 1.0 && Math.max(1.0, 2.0) == 2.0, "min and max");
    check(Math.abs(Math.sin(Math.PI)) < 0.000001 && Math.abs(Math.log(Math.E) - 1.0) < 0.000001, "PI and E");
}

test function randomRepeats(): void {
    let a: Random = { seed: 42 };
    let b: Random = { seed: 42 };
    let other: Random = { seed: 43 };
    let same: bool = true;
    let differs: bool = false;
    for (i in 0..1000) {
        let x: int32 = a.below(6);
        same = same && x == b.below(6) && x >= 0 && x < 6;
        differs = differs || x != other.below(6);
        let f: float64 = a.fraction();
        b.fraction();
        other.fraction();
        same = same && f >= 0.0 && f < 1.0;
    }
    check(same, "the same seed gives the same numbers, within their range");
    check(differs, "another seed gives others");
}
